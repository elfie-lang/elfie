use "../format/main" as Formatter;
use "../generation/data";
use "../generation/main" as Generation;
use "../interpret/data";
use "../lexer/main" as Lexer;
use "../lsp/main" as Lsp;
use "../mcp/data" as McpData;
use "../mcp/main" as Mcp;
use "../parser/data";
use "../parser/main" as Parser;
use "../query/data";
use "../query/main" as Query;
use "../workspace/data";
use "../workspace/main" as Loader;
use "./data";
use "./style" as Style;
use "elfie/system/file" as Files;
use "elfie/system/json" as Json;
use "elfie/system/path";
use "elfie/system/process" as Process;
use "elfie/system/time" as Time;

// Decision: --root is made absolute, so every path and ELFIE_ROOT built from it names the same
// place from any directory.
// Decision: --tree followed by a file still reads as the tree command, so what the parser stage
// shipped keeps working.
fn parse(arguments: string[]): `The invocation the arguments spell, or the usage error they make` => Invocation | string {
  @acceptanceCriteria
    .add({
      situation = [`An argument does not begin with a dash`, `No argument is --help, -h, or --version`],
      behavior = `The first argument that does not begin with a dash and is not the value that --root, --tree, --target, --jobs, or --color takes names the [[Command]]`,
    })
    .add({
      situation = [
        `No argument that does not begin with a dash is given`,
        `No argument is --version`,
        `--root, --tree, --target, or --jobs is not the last argument`,
      ],
      behavior = `The command is help`,
    })
    .add({ situation = `--help or -h is among the arguments`, behavior = `The command is help` })
    .add({
      situation = [`--version is among the arguments`, `No argument is --help or -h`],
      behavior = `The command is version`,
    })
    .add({
      situation = `--root followed by a directory, or --root= and the directory, is among the arguments`,
      behavior = `[[Invocation.root]] is that directory made absolute against [[Process.currentDirectory]]`,
    })
    .add({
      situation = [
        `No --root is among the arguments`,
        `[[Files.exists]] finds elfie.json in a directory at or above [[Process.currentDirectory]]`,
      ],
      behavior = `[[Invocation.root]] is the nearest directory at or above [[Process.currentDirectory]] where [[Files.exists]] finds elfie.json`,
    })
    .add({
      situation = [
        `No --root is among the arguments`,
        `[[Files.exists]] finds elfie.json in no directory at or above [[Process.currentDirectory]]`,
      ],
      behavior = `[[Invocation.root]] is [[Process.currentDirectory]]`,
    })
    .add({
      situation = `--tree followed by a file is among the arguments`,
      behavior = `The invocation is the tree command with that file`,
    })
    .add({
      behavior = `Every argument beginning with two dashes other than --root, --tree, --help, and --version is an option`,
    })
    .add({
      situation = `An option other than --root is written --name=value`,
      behavior = `The option gives the text value`,
    })
    .add({
      situation = `--target or --jobs is followed by a value`,
      behavior = `The option of that name gives that value`,
    })
    .add({
      situation = `--color is followed by auto, always, or never`,
      behavior = `The option color gives that value`,
    })
    .add({
      situation = `--color is written with no equals sign and is not followed by auto, always, or never`,
      behavior = `The option color gives true`,
    })
    .add({
      situation = `--color is written with no equals sign and is not followed by auto, always, or never`,
      behavior = `The argument after --color is not its value`,
    })
    .add({
      situation = `--color=value is among the arguments, and the value is not one of [[Style.ColorChoice]]`,
      behavior = `Returns a usage message reading --color must be auto, always, or never`,
    })
    .add({
      situation = `--jobs is among the arguments, and its value is not a whole number of at least 1`,
      behavior = `Returns a usage message reading --jobs must be a whole number of at least 1`,
    })
    .add({
      situation = `An option other than --root, --tree, --help, --version, --target, --jobs, and --color is written --name, with no equals sign`,
      behavior = `The option gives true`,
    })
    .add({
      situation = `An option other than --root, --tree, --help, --version, --target, --jobs, and --color is written --name, with no equals sign`,
      behavior = `The argument after the option is not its value`,
    })
    .add({
      situation = `No argument is --help, -h, or --version`,
      behavior = `Every argument that does not begin with a dash, other than the one naming the command and the value --root, --target, --jobs, or --color takes, is positional`,
    })
    .add({
      situation = `--help, -h, or --version is among the arguments`,
      behavior = `The invocation has no positional arguments`,
    })
    .add({
      situation = `The argument naming the command is not one of [[Command]]`,
      behavior = `Returns a usage message naming the argument`,
    })
    .add({
      situation = [
        `--root, --tree, --target, or --jobs is the last argument, with no value after it`,
        `No argument is --help, -h, or --version`,
      ],
      behavior = `Returns a usage message naming the option`,
    });

  @test(
    {
      input = [[`check`]],
      expect = Invocation@like(`check with no arguments and the root found from the current directory`),
    },
    { input = [[`--tree`, `def/a.lfy`]], expect = Invocation@like(`tree with the one argument def/a.lfy`) },
    { input = [[`frobnicate`]], expect = string@like(`A usage message naming frobnicate`) },
    { input = [[`check`, `--color=sometimes`]], expect = string@like(`A usage message naming --color`) },
    { input = [[`--color`, `never`, `check`]], expect = Invocation@like(`check with the option color never`) },
    { input = [[`--color`, `check`]], expect = Invocation@like(`check with the option color true`) },
    { input = [[`--json`, `check`]], expect = Invocation@like(`check with the option json true`) },
    { input = [[`--target`, `rust`, `compile`]], expect = Invocation@like(`compile with the option target rust`) },
    { input = [[`compile`, `--jobs`, `0`]], expect = string@like(`A usage message naming --jobs`) },
  );
}

fn main(arguments: string[]): `Run one command and return its exit code` => number {
  // Decision: every command is a thin driver over the stage it belongs to, and the process exits
  // with a code from [[ExitCode]] so agents and scripts can read the outcome without parsing text.
  // Decision: the diagnostic line below is the CLI's own contract. elfie_problems states its own
  // line for the agent server; the two surfaces are kept apart on purpose and happen to agree.
  @acceptanceCriteria
    .add({ situation = `[[parse]] returns a usage message`, behavior = `The message is printed to standard error` })
    .add({
      situation = `[[parse]] returns a usage message`,
      behavior = `The help text follows the message on standard error`,
    })
    .add({ situation = `[[parse]] returns a usage message`, behavior = `Returns [[ExitCode.usage]]` })
    .add({
      situation = [`--json is given`, `The command is check, format, compile, or verify`],
      behavior = `Each result is printed to standard output as one line, [[Json.stringify]] of it in [[Json.Layout.compact]], instead of as text`,
    })
    .add({
      situation = `--json is not given`,
      behavior = `A [[Diagnostic]] is printed as the file, a colon, the line, a colon, the column, a colon, a space, the stage, a space, the severity, a colon, a space, and the message`,
    });

  // Color and layout
  // Decision: color is decided once per stream, standard output and standard error apart, and every
  // piece of text is painted by what it means rather than by a color named where it is printed, so
  // the whole CLI reads as one palette and a person scanning a long compile finds the failures by
  // their color alone.
  // Decision: color is for a person at a terminal and changes no word of what is printed, so every
  // criterion that names a line's text holds with color on or off, and a script splitting a line
  // on spaces reads the same fields. The text layout (columns, glyphs, empty lines between
  // batches) is for a person too; a script reads --json, whose lines are unchanged.
  // Decision: color never reaches a file, a pipe, JSON, or compile.log, so what a script or an agent
  // reads is the same text it read before color existed.
  @acceptanceCriteria
    .add({
      situation = `--json is not given`,
      behavior = `Text for standard output is painted with [[Style.paint]], on when [[Style.colorsOn]] of the --color choice and [[Process.Stream.output]] is true`,
    })
    .add({
      situation = `--json is not given`,
      behavior = `Text for standard error is painted with [[Style.paint]], on when [[Style.colorsOn]] of the --color choice and [[Process.Stream.error]] is true`,
    })
    .add({ behavior = `Whether a stream is colored is decided once per run` })
    .add({ situation = `--color is not given`, behavior = `The --color choice is auto` })
    .add({ situation = `The option color gives true`, behavior = `The --color choice is always` })
    .add({ situation = `--json is given`, behavior = `Nothing is painted on either stream` })
    .add({
      behavior = `Every line [[Files.append]] to elfie-requests/compile.log is the line as printed with colors off`,
    })
    .add({
      situation = `A [[Diagnostic]] is printed without --json`,
      behavior = [
        `The file, line, and column with their colons are painted subject`,
        `The stage is painted muted`,
        `The severity is painted in [[Style.severityTone]] of it`,
        `The message is plain`,
      ],
    })
    .add({
      behavior = `A usage message, or any other message the CLI itself prints to standard error, begins with elfie:, painted failure, then a space and the message`,
    })
    .add({
      situation = `A message the CLI prints to standard error begins with a path`,
      behavior = `The path is painted subject`,
    });

  // help, version
  @acceptanceCriteria
    .add({ situation = `help`, behavior = `Prints a usage line` })
    .add({
      situation = `help`,
      behavior = `Prints, under the heading commands:, each value of [[Command]] with its description`,
    })
    .add({
      situation = `help`,
      behavior = `Prints, under the heading options:, each global option with one line of description, --json, --root, --target, --no-verify, --strict, --jobs, and --color among them`,
    })
    .add({ situation = `help`, behavior = `Returns [[ExitCode.success]]` })
    .add({
      situation = `help`,
      behavior = `Every description starts in the same column, each command name and option before it padded with [[Style.padded]]`,
    })
    .add({
      situation = `help`,
      behavior = [
        `The usage line and the headings commands: and options: are painted subject`,
        `Each command name and each option is painted active`,
        `Each description is plain`,
      ],
    })
    .add({ situation = `version`, behavior = `Prints the version of the executable` })
    .add({ situation = `version`, behavior = `Returns [[ExitCode.success]]` });

  // init
  // Decision: nothing ignores elfie-compile itself or elfie-compile/maps, because the maps are
  // checked in; only the cache is ignored.
  @acceptanceCriteria
    .add({
      situation = [`init`, `[[Files.exists]] does not find elfie.json in the root`, `An argument is given`],
      behavior = `[[Files.write]] of elfie.json in the root naming the project after the argument`,
    })
    .add({
      situation = [`init`, `[[Files.exists]] does not find elfie.json in the root`, `No argument is given`],
      behavior = `[[Files.write]] of elfie.json in the root naming the project after the root directory`,
    })
    .add({
      situation = [`init`, `[[Files.exists]] does not find elfie.json in the root`],
      behavior = `[[Files.createDirectory]] of the source directory and of elfie-compile/maps under the root`,
    })
    .add({
      situation = [`init`, `[[Files.exists]] does not find elfie.json in the root`, `The root has no .gitignore`],
      behavior = `[[Files.write]] of .gitignore in the root holding one line reading /elfie-compile/cache/`,
    })
    .add({
      situation = [
        `init`,
        `[[Files.exists]] does not find elfie.json in the root`,
        `The root's .gitignore has no line reading /elfie-compile/cache/`,
      ],
      behavior = `That line is [[Files.append]] to it, on a line of its own, and nothing else in it changes`,
    })
    .add({
      situation = `init`,
      behavior = `No line init writes to .gitignore ignores elfie-compile or elfie-compile/maps`,
    })
    .add({
      situation = [`init`, `[[Files.exists]] does not find elfie.json in the root`],
      behavior = `Returns [[ExitCode.success]]`,
    })
    .add({
      situation = [`init`, `[[Files.exists]] finds elfie.json in the root`],
      behavior = `Returns [[ExitCode.failure]]`,
    });

  // check
  // Decision: check with --strict fails on anything stale too, so one command checks that the
  // definitions bind cleanly and that every output is up to date.
  @acceptanceCriteria
    .add({
      situation = [`check`, `No files are given as arguments`],
      behavior = `Prints every diagnostic of [[Query.diagnosticsOf]] of [[Loader.load]] of the root`,
    })
    .add({
      situation = [`check`, `Files are given as arguments`],
      behavior = `Prints, for each file given, the diagnostics of [[Query.diagnosticsOf]] of [[Loader.load]] of the root and that file`,
    })
    .add({
      situation = [`check`, `No files are given as arguments`, `No diagnostic of the program is an error`],
      behavior = `[[Generation.plan]] is made from [[Generation.sourceMapsOf]] the workspace, with no stems requested, and with the violated units of the last [[McpData.GlobalReview]] as its violated units`,
    })
    .add({
      situation = [
        `check`,
        `No files are given as arguments`,
        `No diagnostic of the program is an error`,
        `A unit of the plan has a [[Unit.reason]]`,
      ],
      behavior = `The unit is printed as a stale unit: a warning of stage generation at its source file, naming the target, the unit, and the description of its [[Unit.reason]]`,
    })
    .add({
      situation = [`check`, `No files are given as arguments`, `No diagnostic of the program is an error`],
      behavior = `Each of [[Plan.problems]] is printed as an error of stage generation at its node`,
    })
    .add({
      situation = [`check`, `No files are given as arguments`, `No diagnostic of the program is an error`],
      behavior = `Each of [[Plan.moves]] is printed as information of stage generation at the file of [[Move.origin]], naming the target, the identifiers of [[Move.entities]], the stem of [[Move.into]], and [[Move.cause]]`,
    })
    .add({
      situation = [
        `check`,
        `No files are given as arguments`,
        `No diagnostic of the program is an error`,
        `[[Workspace.targets]] is empty`,
      ],
      behavior = `One line of information of stage generation at the root says the program declares no target and nothing will be built`,
    })
    .add({
      situation = [`check`, `No diagnostic of the program is an error`],
      behavior = `The last line counts the files, the problems, and the stale units`,
    })
    .add({
      situation = `check`,
      behavior = `Every error or warning diagnostic printed, and every one of [[Plan.problems]], counts among the problems`,
    })
    .add({
      situation = `check`,
      behavior = `A line of information counts as neither a problem nor a stale unit, with or without --strict`,
    })
    .add({ situation = [`check`, `An error is printed`], behavior = `Returns [[ExitCode.problems]]` })
    .add({
      situation = [`check`, `No error is printed`, `--strict is not given`],
      behavior = `Returns [[ExitCode.success]]`,
    })
    .add({
      situation = [`check with --strict`, `A warning is printed, a stale unit included`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({
      situation = [`check with --strict`, `No error and no warning is printed`],
      behavior = `Returns [[ExitCode.success]]`,
    })
    .add({
      situation = `check without --json`,
      behavior = `In the last line the count of files is plain, the problems are [[Style.tally]] in failure, and the stale units are [[Style.tally]] in warning`,
    })
    .add({
      situation = [`check without --json`, `A stale unit is printed`],
      behavior = [
        `Its target and unit are painted subject`,
        `The description of its [[Unit.reason]] is painted in [[Style.reasonTone]] of it`,
      ],
    });

  // format
  @acceptanceCriteria
    .add({
      situation = [`format`, `Files are given as arguments`],
      behavior = `The files formatted are the files given`,
    })
    .add({
      situation = [`format`, `No files are given as arguments`],
      behavior = `The files formatted are every file of [[Files.list]] of each of [[Workspace.sourceDirectories]], recursively, whose [[Path.extension]] is lfy`,
    })
    .add({
      situation = `format`,
      behavior = `The formatted text of a file is [[Formatter.format]] of [[Parser.parse]] of [[Lexer.lex]] of [[Files.read]] of it`,
    })
    .add({
      situation = [`format without --check`, `The formatted text of a file formatted differs from its text`],
      behavior = `That file is replaced by [[Files.write]] of its formatted text`,
    })
    .add({ situation = `format with --check`, behavior = `Nothing is written` })
    .add({
      situation = [`format with --check`, `The formatted text of a file formatted differs from its text`],
      behavior = `The file is printed`,
    })
    .add({
      situation = [`format with --check`, `The formatted text of a file formatted differs from its text`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({
      situation = [`format without --check and without --json`, `A file is written`],
      behavior = `It is printed as formatted, painted success, a space, and the file`,
    })
    .add({
      situation = [`format with --check and without --json`, `A file would change`],
      behavior = `The file printed is painted warning`,
    })
    .add({ situation = `format on a file whose tree has errors`, behavior = `The errors of its tree are printed` })
    .add({ situation = `format on a file whose tree has errors`, behavior = `The file is left as it is` })
    .add({ situation = `format on a file whose tree has errors`, behavior = `Returns [[ExitCode.problems]]` });

  // tree, tokens
  @acceptanceCriteria
    .add({
      situation = `tree`,
      behavior = `Prints [[Parser.parse]] of [[Lexer.lex]] of [[Files.read]] of the one file given, one node or token per line, indented by its depth`,
    })
    .add({ situation = `tree`, behavior = `A node's line reads its rule and its token range` })
    .add({
      situation = `tree`,
      behavior = `A token's line reads its rule and its value with escapes applied, never its raw characters`,
    })
    .add({
      situation = [`tree`, `The tree of the file given holds an [[ErrorNode]]`],
      behavior = `Each [[ErrorNode]] is printed with what it expected`,
    })
    .add({
      situation = [`tree`, `The tree of the file given holds an [[ErrorNode]]`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({
      situation = `tokens`,
      behavior = `Prints [[Lexer.lex]] of [[Files.read]] of the one file given, one token per line as its line, column, rule, and value`,
    })
    .add({
      situation = `tree or tokens`,
      behavior = [
        `A rule is painted active`,
        `A token's value is painted success`,
        `A token range, line, or column is painted muted`,
      ],
    })
    .add({
      situation = [`tree`, `The tree of the file given holds an [[ErrorNode]]`],
      behavior = `Each [[ErrorNode]] and what it expected are painted failure`,
    });

  // compile
  // Decision: the compiler is never handed a program with problems.
  // Decision: a cycle among files that no move resolves has no order to build in, so compile
  // refuses a plan with problems.
  @acceptanceCriteria
    .add({ situation = `compile`, behavior = `The program compiled is [[Loader.load]] of the root` })
    .add({
      situation = [`compile`, `A diagnostic of the loaded program is an error`],
      behavior = `The diagnostics of the loaded program are printed`,
    })
    .add({
      situation = [`compile`, `A diagnostic of the loaded program is an error`],
      behavior = `No compiler runs and nothing is generated`,
    })
    .add({
      situation = [`compile`, `A diagnostic of the loaded program is an error`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({
      situation = [`compile or verify with --target`, `--target names no target of [[Workspace.targets]]`],
      behavior = `A usage message naming the identifiers of [[Workspace.targets]] is printed`,
    })
    .add({
      situation = [`compile or verify with --target`, `--target names no target of [[Workspace.targets]]`],
      behavior = `Nothing is compiled or reviewed`,
    })
    .add({
      situation = [`compile or verify with --target`, `--target names no target of [[Workspace.targets]]`],
      behavior = `Returns [[ExitCode.usage]]`,
    })
    .add({
      situation = `compile`,
      behavior = `The units generated and their batches are those of [[Generation.plan]] made from [[Generation.sourceMapsOf]] the workspace, with the violated units of the last [[McpData.GlobalReview]] as its violated units`,
    })
    .add({
      situation = [`compile`, `[[Plan.problems]] is not empty`],
      behavior = `Each of [[Plan.problems]] is printed as an error of stage generation at its node`,
    })
    .add({ situation = [`compile`, `[[Plan.problems]] is not empty`], behavior = `Nothing is generated` })
    .add({
      situation = [`compile`, `[[Plan.problems]] is not empty`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({
      situation = `compile with --target`,
      behavior = `The source maps are [[Generation.sourceMapsOf]] the workspace for the target --target names`,
    })
    .add({
      situation = `compile with --target`,
      behavior = `Only units of the target --target names are generated`,
    })
    .add({ situation = `compile with --target`, behavior = `No map file of another target changes` })
    .add({
      situation = [
        `compile without --dry-run`,
        `A planned target's maps were read from source-map.json under its [[Target.outputDirectory]]`,
      ],
      behavior = `Before any batch runs, each unit's maps from that file are recorded in its map file by [[Generation.record]]`,
    })
    .add({
      situation = [`compile without --dry-run`, `Every unit's maps from a source-map.json were recorded`],
      behavior = `That source-map.json is removed by [[Files.remove]] before any batch runs`,
    })
    .add({
      situation = [`compile without --dry-run`, `A unit's maps from a source-map.json could not be recorded`],
      behavior = `That source-map.json is not removed`,
    })
    // A map file belongs to no unit when its definition file was deleted, moved, or no longer
    // builds for the target.
    .add({
      situation = [
        `compile without --dry-run`,
        `A map file under the folder of a planned target belongs to no unit of the plan`,
      ],
      behavior = `The map file is removed by [[Files.remove]] before any batch runs`,
    })
    .add({
      situation = `compile without --all`,
      behavior = `[[Generation.plan]] is made with the stems given as arguments as its requested units`,
    })
    .add({
      situation = `compile with --all`,
      behavior = `[[Generation.plan]] is made with the stem of every unit as its requested units`,
    })
    .add({
      situation = `compile`,
      behavior = `Each of [[Plan.moves]] is printed as a move line: the word move, the target, the stem of [[Move.origin]], the word into, the stem of [[Move.into]], the identifiers of [[Move.entities]] in brackets, the word for, and [[Move.cause]]`,
    })
    .add({
      situation = [`compile without --json`, `A move line is printed`],
      behavior = [
        `The target and the words move, into, and for are painted muted`,
        `The two stems are painted subject`,
        `The identifiers and [[Move.cause]] are plain`,
      ],
    })
    .add({ situation = `compile with --dry-run`, behavior = `Nothing is generated` })
    .add({
      situation = `compile with --dry-run`,
      behavior = `Each planned unit is printed on a line reading its target, [[Unit.stem]], its reason or up to date, and the stems of its dependencies`,
    })
    .add({
      situation = `compile with --dry-run`,
      behavior = `Each batch is printed on a line reading the word batch, its identifier, and the stems it holds`,
    })
    .add({
      situation = `compile with --dry-run`,
      behavior = `The move lines come first, then the unit lines, then the batch lines`,
    })
    .add({
      situation = `compile with --dry-run and without --json`,
      behavior = [
        `In a unit's line the target is painted muted`,
        `In a unit's line the stem is painted subject`,
        `In a unit's line the reason is painted in [[Style.reasonTone]] of it`,
        `In a unit's line the dependencies are painted muted`,
      ],
    })
    .add({
      situation = `compile with --dry-run and without --json`,
      behavior = [
        `In a batch's line the word batch is painted muted`,
        `In a batch's line the identifier is painted subject`,
        `In a batch's line the stems are painted muted`,
      ],
    })
    .add({
      situation = [`compile without --dry-run and without --json`, `[[Plan.moves]] is not empty`],
      behavior = `The move lines follow the planned line, each indented four spaces`,
    });

  // Progress
  // Decision: progress is a stream of one-line events rather than a redrawn screen, so it reads the
  // same in a terminal, in a log, and as JSON lines for a script.
  @acceptanceCriteria
    .add({ situation = `compile`, behavior = `Every step of a compile prints one [[Progress]] line as it happens` })
    .add({ situation = `compile with --json`, behavior = `Each [[Progress]] is one result` })
    .add({ situation = `compile`, behavior = `The first [[Progress]] line of a compile is planned` })
    .add({
      situation = `compile`,
      behavior = `The message of the planned line counts the units planned, the batches, and the moves`,
    })
    .add({ situation = `compile`, behavior = `The last [[Progress]] line of a compile is finished` })
    .add({
      situation = `compile`,
      behavior = `The message of the finished line is the count of units accepted and the word accepted, the count of units rejected and the word rejected, the count of batches blocked and the word blocked, and the count of batches failed and the word failed, each count and its word separated by a space and the four separated by a comma and a space`,
    })
    .add({
      situation = `compile without --json`,
      behavior = `The columns of a [[Progress]] line are separated by two spaces`,
    })
    .add({
      situation = `compile without --json`,
      behavior = `A [[Progress]] line begins with the counter, the time, and the step, in that order`,
    })
    .add({
      situation = `compile without --json`,
      behavior = `A [[Progress]] line ends with the first line of [[Progress.message]]`,
    })
    .add({
      situation = `compile without --json`,
      behavior = [
        `The counter is [, done right aligned to the width of total, /, total, and ]`,
        `The counter is painted muted`,
      ],
    })
    .add({
      situation = `compile without --json`,
      behavior = [
        `The time is [[Style.duration]] of [[Time.elapsed]] since the compile began, right aligned to six columns`,
        `The time is painted muted`,
      ],
    })
    .add({
      situation = `compile without --json`,
      behavior = [
        `The step is [[Style.glyphOf]] the step, a space, and the step's name`,
        `The step is painted in [[Style.toneOf]] the step`,
        `The step is padded with [[Style.padded]] to the longest name of [[Step]] with its glyph`,
      ],
    })
    .add({
      situation = [`compile without --json`, `The [[Progress.batch]] of a step is set`],
      behavior = `Its [[Progress]] line reads the batch, painted subject, after the step`,
    })
    .add({
      situation = [
        `compile without --json`,
        `The [[Progress.unit]] of a step is set and is not its [[Progress.batch]]`,
      ],
      behavior = `Its [[Progress]] line reads the unit after the batch`,
    })
    .add({
      situation = [`compile without --json`, `The [[Progress.unit]] of a step is its [[Progress.batch]]`],
      behavior = `The unit is not repeated after the batch`,
    })
    .add({
      situation = [`compile without --json`, `The step is rejected, failed, blocked, or clarification`],
      behavior = `The message is painted in [[Style.toneOf]] the step`,
    })
    .add({
      situation = [
        `compile without --json`,
        `The step is planned, requesting, resuming, rewording, building, compiling, checking, accepted, verifying, globalVerifying, or retrying`,
      ],
      behavior = `The message is plain`,
    })
    .add({
      situation = [`compile without --json`, `The step is reviewed or globalReviewed`],
      behavior = `The message begins with [[Style.tally]] of the satisfied in success, the violated in failure, and the unverifiable in warning, separated by a comma and a space`,
    })
    .add({
      situation = [
        `compile`,
        `The step is reviewed`,
        `[[ReviewRequest.carried]] of the batch's last review request is not empty`,
      ],
      behavior = `The message ends with a comma, a space, the count of [[ReviewRequest.carried]], a space, and the word carried`,
    })
    .add({
      situation = [
        `compile`,
        `The step is reviewed`,
        `[[ReviewRequest.carried]] of the batch's last review request is empty`,
      ],
      behavior = `The message ends with the count of unverifiable reviews and its word`,
    })
    .add({
      situation = [`compile without --json`, `The message of a reviewed line counts carried verdicts`],
      behavior = `That count and its word are [[Style.tally]] of them in muted`,
    })
    .add({
      situation = [`compile without --json`, `The step is finished`],
      behavior = `In the message each count and its word is [[Style.tally]] of them: accepted in success, rejected in failure, blocked in warning, and failed in failure`,
    })
    .add({
      situation = [
        `compile without --json`,
        `A [[Progress]] line is the first line of a batch after the first batch, or is finished, or is globalVerifying`,
      ],
      behavior = `An empty line is printed and logged before it`,
    })
    .add({
      situation = [`compile without --json`, `The step is finished`, `Nothing was rejected, blocked, or failed`],
      behavior = `Its glyph and name are painted success`,
    })
    .add({
      situation = [`compile without --json`, `The step is finished`, `Something was rejected, blocked, or failed`],
      behavior = `Its glyph and name are painted failure`,
    })
    .add({
      situation = [`compile without --json`, `The step is finished`, `A batch did not complete`],
      behavior = `The finished line is followed by one line, indented four spaces, reading did not complete:, a space, and the identifiers of the batches that did not complete, separated by a comma and a space`,
    })
    .add({
      situation = [`compile without --json`, `The step is finished`, `A batch did not complete`],
      behavior = `The line listing the batches that did not complete is painted warning`,
    })
    .add({
      situation = [`compile without --json`, `Problems, a reason, or a question are printed`],
      behavior = `They follow the [[Progress]] line they belong to, one problem or line of text per line, each indented four spaces`,
    })
    .add({
      situation = [`compile without --json`, `A problem is printed`],
      behavior = [`It begins with - and a space`, `It is painted failure`],
    })
    .add({
      situation = [`compile without --json`, `A reason or a question is printed`],
      behavior = `It is painted warning`,
    })
    .add({
      situation = [`compile without --json`, `Every unit is up to date`],
      behavior = `One line saying every unit is up to date is printed, painted success`,
    })
    .add({
      situation = [`compile or verify`, `The compiler or the verifier writes a line`],
      behavior = `The line, as [[Process.stream]] passes it to onLine, is shown as it arrives, prefixed by the identifier of its batch, or by global for the global review`,
    })
    .add({
      situation = `compile or verify without --json`,
      behavior = [
        `The prefix of a line from the compiler or the verifier is two spaces, the batch, a space, │, and a space`,
        `The line itself is shown exactly as the command wrote it`,
      ],
    })
    .add({
      situation = [
        `compile or verify without --json`,
        `A line from the compiler or the verifier came from [[Process.Stream.output]]`,
      ],
      behavior = `Its prefix is painted muted`,
    })
    .add({
      situation = [
        `compile or verify without --json`,
        `A line from the compiler or the verifier came from [[Process.Stream.error]]`,
      ],
      behavior = `Its prefix is painted warning`,
    })
    .add({
      situation = `compile or verify`,
      behavior = `Every [[Progress]] line, every line the compiler or the verifier writes, and every report is [[Files.append]] to elfie-requests/compile.log under the root`,
    });

  // Running batches together
  // Decision: batches that do not depend on each other run at the same time, each in its own copy
  // of the root, because compilers editing one tree break each other's builds and tests. A batch's
  // work reaches the root only once its outputs are accepted and reviewed, merged file by file, so
  // the root only ever holds work that passed.
  // Decision: in copies, review is off the critical path. A dependent starts once its dependencies'
  // units are accepted structurally, in a copy that takes their accepted changes, while their
  // verifier runs. It is merged only after they are, so the root still holds only reviewed work.
  // Being done is not being merged: a done batch may still wait for its own dependencies, so what
  // a dependent waits for, and takes, is decided by whether a batch's files are merged into the
  // root, through every batch its dependencies took changes from as well.
  // Decision: a retry is made from the plan its first run was, so the interface text
  // [[SourceMap.signature]] hashes cannot differ between them; what can differ is the code a
  // dependent was built against. So when a dependency is merged with changes other than those a
  // dependent took, the dependent's build and tests decide whether its results stand, and it runs
  // again when they fail or the target cannot run them.
  // Decision: in place there is one tree, so batches run one at a time and a dependent starts only
  // once its dependencies are done.
  // Decision: a batch run in a copy that ends rejected keeps its changes, and the next compile of
  // the same batch starts from them while its units' code and criteria are as they were, so its
  // work is not lost. They are kept in elfie-compile/cache, because losing them costs only time. In
  // place the root already keeps them. Kept work was rejected and never accepted, so a request that
  // starts from it says so and carries the problems that rejected it.
  // Decision: when the compile stops, the runs still going are stopped too, because nothing they
  // could produce would be merged.
  // Decision: no git variable is added to the environment of the compiler, the verifier, or a
  // test, so a repository one of them creates elsewhere stays its own.
  @acceptanceCriteria
    .add({ situation = `compile without --jobs`, behavior = `--jobs is 4` })
    .add({
      situation = [`compile`, `--jobs is 1, or the root is not a git repository`],
      behavior = `A batch starts only once every batch holding a dependency of one of its units is done`,
    })
    .add({
      situation = [`compile`, `--jobs is more than 1`, `The root is a git repository`],
      behavior = `A batch starts only once every batch that holds a dependency of one of its units, directly or through the units of other batches, has its files merged into the root, or has every unit accepted by [[Generation.accept]] and is neither running the compiler nor about to run it again`,
    })
    .add({
      situation = `compile`,
      behavior = `At most --jobs batches are running the compiler, the verifier, or a command of the target at once`,
    })
    .add({ situation = `compile`, behavior = `Among the batches that can start, they start in plan order` })
    .add({
      situation = [`compile`, `--jobs is 1, or the root is not a git repository`],
      behavior = `Batches run one at a time, in plan order`,
    })
    .add({
      situation = [`compile`, `--jobs is 1, or the root is not a git repository`],
      behavior = `The batch's directory is the root itself`,
    })
    .add({
      situation = [`compile`, `--jobs is more than 1`, `The root is a git repository`],
      behavior = `The batch's directory is a copy at elfie-compile/cache/batches/<batch> under the root, made when the batch starts`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`, `A directory is at its path when the batch starts`],
      behavior = `That directory is removed before the copy is made`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`],
      behavior = `The copy holds every file of the root that git tracks or would track, except those under elfie-compile/cache and elfie-requests, as [[Process.run]] of git ls-files --cached --others --exclude-standard lists them in the root`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`],
      behavior = `Each file is copied to the same path in the copy, byte for byte, keeping whether it is executable`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`],
      behavior = `A batch's accepted changes are each file of its copy that differs from its base, was added, or was removed, with what the copy held for it the last time every unit of the batch was accepted`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `A batch that holds a dependency of one of its units, directly or through the units of other batches, does not have its files merged into the root when the batch starts`,
      ],
      behavior = `Once the root's files are copied, the accepted changes of each such batch are merged into the copy, in plan order, as a batch's files are merged into the root`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `The accepted changes of such a batch cannot be merged into the copy without a conflict`,
      ],
      behavior = [`The copy is removed`, `The batch starts only once that batch has its files merged into the root`],
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`],
      behavior = `What each file of the copy holds once the accepted changes it takes are merged in, and before any kept work is taken, is kept as the batch's base`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `elfie-compile/cache/kept/<batch>.json under the root names the batch's target and the stems of its units in batch order`,
        `For each unit, the hash and the requirements the file gives it are the SHA-256 of [[Unit.text]] and the SHA-256 of its local criterion and test ids, taken as [[SourceMap.requirements]] takes them`,
      ],
      behavior = [
        `The batch takes its kept work`,
        `After the base is kept, each file the kept work holds is merged into the copy as the three-way merge, given by [[Process.run]] of git merge-file, of what the copy holds for it and its kept text, against its kept base`,
        `A kept file whose merge has a conflict is left as the copy holds it, and that is neither a rejection nor a reason to run the batch again`,
        `One resuming progress line counts the files taken and the files left`,
      ],
    })
    .add({
      situation = [
        `compile`,
        `elfie-compile/cache/kept/<batch>.json under the root does not name the batch's target and the stems of its units in batch order, or gives a unit a hash or requirements that are no longer its own`,
      ],
      behavior = `The batch takes nothing from it`,
    })
    .add({
      situation = [`compile`, `A batch took its kept work`],
      behavior = [
        `[[Request.instructions]] of each request for the batch in the compile ends with a line saying that its existing outputs hold work a run rejected and that was never accepted`,
        `That line is followed by the problems the kept work holds, one per line`,
      ],
    })
    .add({
      situation = [
        `compile without --dry-run`,
        `A file under elfie-compile/cache/kept for a planned target names a stem that is no unit of the plan`,
      ],
      behavior = `The file is removed by [[Files.remove]] before any batch runs`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`],
      behavior = `Git run in the copy reads the root's history, through a .git file in the copy reading gitdir:, a space, and the absolute path of the root's git directory`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`],
      behavior = `No git variable is added to the environment of the compiler or the verifier`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`, `The batch's files are not merged into the root`],
      behavior = `The root holds none of the batch's changes`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `The batch is done`,
        `Every batch whose accepted changes its copy took has its files merged into the root, and the files its merge wrote into the root hold, for each of the accepted changes the copy took, what that change held`,
      ],
      behavior = `Every file of the copy outside elfie-compile, elfie-requests, and its .git file that differs from the base, was added, or was removed, is merged into the root`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `A batch whose accepted changes its copy took does not have its files merged into the root`,
      ],
      behavior = `Nothing of the batch is merged into the root`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `The batch is done`,
        `A batch whose accepted changes its copy took has its files merged into the root, and the files its merge wrote into the root do not hold, for some accepted change the copy took, what that change held`,
      ],
      behavior = [
        `Each file that batch's merge wrote into the root is merged into the copy, as a batch's file is merged into the root, with what the copy took for that file as the base`,
        `The base of the batch takes the files that batch's merge wrote into the root in place of those it took`,
        `The target's build and test commands then run in the copy, as they run for a batch whose units all have the reason dependency`,
      ],
    })
    .add({
      situation = [
        `compile`,
        `The build and test commands run in a batch's copy because a batch it took accepted changes from was merged with other files`,
        `Both succeed`,
      ],
      behavior = `The batch is merged into the root as a done batch is`,
    })
    .add({
      situation = [
        `compile`,
        `A batch is done, and a batch whose accepted changes its copy took was merged with other files`,
        `Those files cannot be merged into the batch's copy without a conflict, the build or the test command fails in it, or the target has no line for build or for test`,
      ],
      behavior = [
        `Nothing of the batch is merged into the root`,
        `A retrying progress line names the batch whose files differ`,
        `The batch runs again from a new copy, which takes its changes as kept work is taken, and its runs of the compiler and the verifier are counted afresh`,
      ],
    })
    // Decision: a batch that runs again after it was done is like any batch that runs again, so the
    // batches that took its accepted changes wait for its merge and are checked against it, and the
    // global review waits for both.
    .add({
      situation = [`compile`, `A batch that was done runs again`],
      behavior = [
        `It is no longer done`,
        `A batch that took its accepted changes is merged only as the rules for a batch whose accepted changes it took say, against what its merge after it runs again writes`,
      ],
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `A batch whose accepted changes its copy took stops without its files merged into the root`,
      ],
      behavior = [
        `Nothing of the batch is merged into the root`,
        `A run of the compiler, the verifier, or a command of the target that is running for the batch is stopped, with every process of its group, and what it gives is ignored`,
        `The batch stops as a batch that depends on a stopped batch does`,
      ],
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`, `The batch is done`],
      behavior = `A file the batch added is merged only when git would track it, as [[Process.run]] of git ls-files --others --exclude-standard lists it in the copy`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`, `The batch is done`],
      behavior = `A path of the base counts as removed only when nothing is at that path in the copy`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`, `The batch's files are merged into the root`],
      behavior = `The batch's source maps are recorded by [[Generation.record]] in the root`,
    })
    .add({
      situation = [`compile`, `The batch's directory is a copy`, `The batch's source maps are recorded in the root`],
      behavior = `The copy is removed`,
    })
    .add({
      situation = [`compile`, `A batch's source maps are recorded by [[Generation.record]]`],
      behavior = `elfie-compile/cache/kept/<batch>.json under the root is removed when it exists, whatever the batch's directory`,
    })
    // Decision: a unit that writes a file another unit has markers in, such as lib.rs, or that moves
    // another unit's markers into new files by splitting a module, leaves that unit's recorded maps
    // pointing at regions that moved. So once a batch's maps are recorded, the maps of every other
    // unit with markers in its files are read again from the files as they are, carrying over
    // everything acceptance recorded, the hash of its own regions included. Nothing that decides
    // whether a unit is planned changes, and a region another unit's lines were put under no
    // longer matches that hash, so it is never kept as it is on it.
    .add({
      situation = [
        `compile, with or without --accept`,
        `The source maps of a batch's units are recorded by [[Generation.record]], whether after a run of the compiler, after a first run that skipped it, or with --accept`,
      ],
      behavior = `The batch's co-owners are the units of the batch's target that are not of the batch and that have a marker of their own, as [[SourceMap]] defines one, in a file the recorded maps name as [[SourceMap.output]], or whose map file names such a file or a file a map of the batch's units named before they were recorded`,
    })
    .add({
      situation = [
        `compile, with or without --accept`,
        `The source maps of a batch's units are recorded by [[Generation.record]]`,
        `The batch has a co-owner`,
      ],
      behavior = [
        `Once the maps of every unit of the batch that has them recorded are recorded, in the root, each co-owner's maps are [[Generation.rederive]] of the workspace, the co-owner, and the maps its map file holds, read as [[Generation.sourceMapsOf]] reads a map file but whether or not their outputs exist`,
        `Those maps are recorded for the co-owner by [[Generation.record]]`,
        `Each co-owner's maps are re-derived once for the batch`,
      ],
    })
    .add({
      situation = [
        `compile, with or without --accept`,
        `A co-owner's maps are re-derived after a batch's source maps are recorded`,
      ],
      behavior = [
        `No compiler or verifier runs for the co-owner`,
        `No review record file of the co-owner changes`,
        `No file but the co-owner's map file is written for it`,
      ],
    })
    .add({
      situation = [
        `compile, with or without --accept`,
        `A co-owner's maps are re-derived after a batch's source maps are recorded`,
        `The regions of the co-owner's own markers with one [[Marker.file]], [[Marker.entity]], and [[Marker.requirement]] span more output lines in total in the re-derived maps than in the maps they replace`,
      ],
      behavior = [
        `The re-derived maps are recorded all the same`,
        `A message printed to standard error names the co-owner, the batch, and the marker, and says another unit's lines may now lie in the co-owner's region`,
      ],
    })
    .add({
      situation = [`A file is merged into the root`, `The root's file still holds what the base holds`],
      behavior = `The root's file becomes the copy's, keeping whether it is executable, or is removed when the copy removed it`,
    })
    .add({
      situation = [`A file is merged into the root`, `Another batch changed the root's file since the base was taken`],
      behavior = `The root's file holds the changes of both batches: the three-way merge of the root's file and the copy's against the base, as [[Process.run]] of git merge-file gives it`,
    })
    .add({
      situation = `A file cannot be merged into the root without a conflict`,
      behavior = `The batch runs again from a new copy once no other batch is running`,
    })
    .add({
      situation = `A file cannot be merged into the root without a conflict`,
      behavior = `Nothing of the batch is merged into the root`,
    })
    .add({
      situation = `A file cannot be merged into the root without a conflict`,
      behavior = `A retrying progress line names the file`,
    })
    .add({
      situation = `A file cannot be merged into the root without a conflict`,
      behavior = `The conflict is not a rejection of the batch`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `The batch stops rejected, blocked, failed, or with a question`,
      ],
      behavior = `Nothing of the batch is merged into the root`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `The batch stops rejected, blocked, failed, or with a question`,
      ],
      behavior = `The copy is left in place for a person to read`,
    })
    .add({
      situation = [
        `compile`,
        `The batch's directory is a copy`,
        `The batch stops rejected, by a second rejected outcome of the compiler or by a second verifier's report holding a violated review or an unplaced violation`,
      ],
      behavior = `Its kept work is [[Files.write]] to elfie-compile/cache/kept/<batch>.json under the root, replacing what that file held, before its copy is left in place`,
    })
    .add({
      situation = `A batch's kept work is written`,
      behavior = [
        `It is [[Json.stringify]] of one object with the keys target, units, problems, and files`,
        `target reads the batch's [[Target.identifier]]`,
        `units lists, for each unit in batch order, one object with the keys stem, reading its [[Unit.stem]], hash, reading the SHA-256 of its [[Unit.text]] as lowercase hex, and requirements, reading the SHA-256 of its local criterion and test ids, taken as [[SourceMap.requirements]] takes them`,
        `problems lists the problems of the rejection that stopped the batch, in the order they were printed`,
        `files lists in path order one object for each file of the copy that would be merged into the root were the batch done, with the keys path, base reading what the base holds for it or null when the batch added it, and text reading what the copy holds for it or null when the batch removed it`,
      ],
    })
    .add({
      situation = [`compile`, `The batch's directory is the root`],
      behavior = `No kept work is written or taken for the batch, because a rejected batch's outputs are left on disk in the root`,
    })
    .add({ situation = [`compile`, `The compile stops`], behavior = `No batch starts after that` })
    .add({
      situation = [`compile`, `The compile stops`],
      behavior = [
        `Every run of the compiler, the verifier, or a command of the target still running for a batch is stopped, with every process of its group, and what it gives is ignored`,
        `Nothing of a batch whose run was stopped is merged into the root or recorded`,
      ],
    })
    .add({
      situation = [`compile`, `Lines of two batches running at once arrive together`],
      behavior = `Each line is shown and logged whole, never mixed with another, prefixed by its own batch`,
    })
    .add({
      situation = [`compile`, `Every batch is done`],
      behavior = `The global review runs in the root, after every batch has been merged and no batch is to run again`,
    });

  // The environment of the compiler and the verifier
  // Decision: ELFIE names this executable, so an agent server the compiler or the verifier starts
  // itself, when it does not use the hosted one, is this same program.
  @acceptanceCriteria
    .add({
      situation = `The compiler or the verifier is run, by compile or by verify`,
      behavior = [
        `ELFIE_ROOT in its environment is the directory it runs in`,
        `ELFIE in its environment is the path of the running executable`,
        `ELFIE_MCP_CONFIG in its environment is the absolute path of the MCP config file of the run's hosted session`,
        `ELFIE_COMMAND_TOOLS in its environment is the names among [[McpData.Host.offered]] of the run's hosted session that are elfie_build, elfie_test, elfie_lint, or elfie_format, in the order [[McpData.Host.offered]] gives them, joined by spaces; empty when there is none`,
      ],
    })
    .add({
      situation = `The compiler or the verifier is run on a batch, by compile or by verify`,
      behavior = [
        `ELFIE_BATCH in its environment is the identifier of the batch`,
        `ELFIE_UNITS in its environment is the stems of the batch's units, separated by spaces`,
      ],
    })
    .add({
      situation = `The verifier is run for the global review, by compile or by verify`,
      behavior = [
        `ELFIE_BATCH in its environment is global`,
        `ELFIE_UNITS in its environment is the stems, separated by spaces, of every unit whose source maps hold a [[Marker]] whose [[Marker.requirement]] is the id of a global criterion or test`,
      ],
    })
    .add({
      situation = `compile runs the verifier for the global review`,
      behavior = `A unit's source maps, for ELFIE_UNITS, are those this compile accepted for it when it has any, and its [[Unit.outputs]] otherwise`,
    })
    .add({
      situation = `verify runs the verifier for the global review`,
      behavior = `A unit's source maps, for ELFIE_UNITS, are its [[Unit.outputs]]`,
    });

  // Agent sessions of the compiler and the verifier
  // Decision: each run is given an agent session id, the id of the compiler's or the verifier's own
  // conversation (not the hosted session of the agent server), and a retry that answers problems
  // resumes the agent session of the run before it, so it keeps what the first attempt already read
  // instead of reading it again. The retry's request, problems appended, is still given on standard
  // input, and the run is counted as before. Whether and how the id is used is the compiler or
  // verifier command's business; the CLI only names it, and a command may start afresh instead.
  // Decision: an agent session is kept under the directory it ran in, so only a run in the same
  // directory resumes; a batch that runs again from a new copy starts afresh.
  // Decision: only a retry that answers problems resumes: one after a rejected outcome, or after a
  // review that found a violation. A run that failed, was stopped, or ended without every verdict
  // may have left a session that is broken or too long to continue, so its retry starts afresh.
  // Decision: a resumed agent session keeps the id it was resumed by, so a third run resumes the
  // session the second one continued, not the second one's own unused id.
  @acceptanceCriteria
    .add({
      situation = `The compiler or the verifier is run, by compile or by verify`,
      behavior = `ELFIE_SESSION in its environment is an agent session id new for the run: a version 4 UUID made from the operating system's secure random source, spelled as 36 lowercase characters in the 8-4-4-4-12 form`,
    })
    .add({
      situation = [
        `compile`,
        `The compiler or the verifier is run on a batch as a resuming run, which is exactly one of three: the compiler's run once more after its run's outcome was rejected; the compiler's run once more after the verifier's report on the batch held a violated review or an unplaced violation, the compiler having run on the batch before; and the verifier's run once more after that run of the compiler is accepted`,
        `The run of the same one of them on the batch before it was in the same directory: the copy of the batch made when the batch last started, or the root`,
      ],
      behavior = `ELFIE_RESUME in its environment is the agent session id of that run before it: its ELFIE_RESUME when it had one, and its ELFIE_SESSION otherwise`,
    })
    .add({
      situation = [
        `The compiler or the verifier is run, by compile or by verify`,
        `It is no resuming run, or the run of the same one of them on the batch before it was in another directory; no resuming run is a first run, the compiler's first run after a first run that skipped it as a reworded-only or dependency-only batch's may, a run of a batch that runs again from a new copy, a run for the global review, a run of a batch the global review planned, a run once more after a failed run or an exit code of -1, or the verifier's run once more after a run that ended without every verdict`,
      ],
      behavior = `ELFIE_RESUME is not in its environment, even when the environment compile or verify was started in holds it`,
    });

  // The hosted agent server
  // Decision: one host serves every run of a compile or verify, each run through a session of its
  // own, so batches running at once never see each other's work and the CLI learns each run's
  // verdicts, and each compiler run's submitted outcome, from the session that recorded them.
  @acceptanceCriteria
    .add({
      situation = `compile or verify runs the compiler or the verifier`,
      behavior = `[[Mcp.host]] is called once, before the first run`,
    })
    .add({
      situation = `compile or verify runs neither the compiler nor the verifier`,
      behavior = `[[Mcp.host]] is not called`,
    })
    .add({
      situation = `compile or verify called [[Mcp.host]]`,
      behavior = `[[McpData.Host.stop]] of it is called once, after the last run has returned and before the command returns, whatever the outcome`,
    })
    .add({
      situation = `[[Mcp.host]] fails`,
      behavior = [`Its failure is printed`, `No compiler or verifier runs`, `Returns [[ExitCode.failure]]`],
    })
    .add({
      situation = `The compiler or the verifier is run, by compile or by verify`,
      behavior = `[[McpData.Host.open]] is called for the run just before it starts, with a [[McpData.Binding]] whose [[McpData.Binding.directory]] is the directory the run is in, whose [[McpData.Binding.plan]] is the plan the command made, and whose [[McpData.Binding.program]] is the program it lowered and planned`,
    })
    .add({
      situation = `The compiler is run on a batch`,
      behavior = `The run's [[McpData.Binding]] has the role compiler, the batch, the request the run's input was made from, no review, and no source maps`,
    })
    .add({
      situation = `The verifier is run on a batch`,
      behavior = `The run's [[McpData.Binding]] has the role verifier, the batch, the review request given as its input, and the source maps that review request was made with`,
    })
    .add({
      situation = `The verifier is run for the global review`,
      behavior = `The run's [[McpData.Binding]] has the role verifier, no batch, the global review request given as its input, and the source maps that review request was made with`,
    })
    .add({
      situation = `The compiler or the verifier is run, by compile or by verify`,
      behavior = `The MCP config file of the run's session is [[Files.write]] to elfie-requests/<batch>.<role>.mcp.json under the root before it starts, where <batch> is the batch identifier or global and <role> is compiler or verifier`,
    })
    .add({
      situation = `The MCP config file of a session is written`,
      behavior = `It holds [[Json.stringify]] of one object with the key mcpServers, holding one object with the key elfie, holding the keys type reading http, url reading the session's URL, and headers holding the key Authorization reading Bearer, a space, and [[McpData.Host.token]]`,
    })
    .add({
      situation = `A run of the compiler or the verifier returns its [[Process.Exit]]`,
      behavior = `[[McpData.Host.close]] of the run's session URL is called before the run's outcome is read`,
    })
    .add({
      situation = `A run of the compiler or the verifier returns its [[Process.Exit]]`,
      behavior = `The run's MCP config file is removed, since the token it holds no longer opens anything`,
    });

  // Running the compiler
  // Decision: with --accept, a compiler that worked through the agent server has its work
  // recorded.
  @acceptanceCriteria
    .add({
      situation = [`compile`, `elfie.json names a compiler`],
      behavior = [
        `Each run of a batch is one [[Process.stream]] of the command elfie.json names under compiler`,
        `Its input is [[Request.instructions]] of [[Generation.request]] for the batch, given hosted true`,
        `Its directory is the batch's directory`,
      ],
    })
    .add({
      situation = [
        `compile`,
        `The root is a git repository`,
        `The source of a unit at its last accepted generation is recoverable from it through [[Process.run]] of git`,
      ],
      behavior = `The previous text [[Generation.request]] is given for that unit is that source as git holds it, never lowered`,
    })
    .add({
      situation = [`compile`, `The root is a git repository`],
      behavior = `The source of a unit at its last accepted generation is the most recent revision of its file, as git holds it, that its outputs were accepted from as [[SourceMap]] defines one, its text lowered as [[Generation.changes]] binds a previous text`,
    })
    .add({
      situation = [
        `compile`,
        `The root is a git repository`,
        `A revision of a unit's file lowers to [[SourceMap.hash]] of its outputs but its local criterion and test ids do not hash to [[SourceMap.requirements]] of its outputs, as one that only reworded a criterion does`,
      ],
      behavior = `That revision is not the source of the unit at its last accepted generation`,
    })
    .add({
      situation = [
        `compile`,
        `The root is a git repository`,
        `The source of a unit at its last accepted generation is not recoverable`,
        `Git holds the unit's hash-matched source, as [[SourceMap]] defines one, its text lowered as [[Generation.changes]] binds a previous text`,
      ],
      behavior = [
        `The previous text [[Generation.request]] is given for that unit is the hash-matched source as git holds it, never lowered`,
        `[[Generation.request]] is given the unit's [[File.path]] among hashMatched`,
      ],
    })
    .add({
      situation = [`compile`, `[[Generation.request]] is given a unit's previous text`],
      behavior = `It is given the unit's [[File.path]] among hashMatched exactly when that text is the unit's hash-matched source and not its source at its last accepted generation`,
    })
    .add({
      situation = `[[Process.stream]] of the compiler for a batch returns its [[Process.Exit]]`,
      behavior = `Each unit of the batch is accepted or rejected by the [[Verdict]] of [[Generation.accept]] on the files of [[Files.list]] of [[Target.outputDirectory]] in the batch's directory, recursively skipping every directory named target, .git, or node_modules, whose [[Files.read]] text carries a [[Marker]] for the unit, with the source maps recorded for the target's other units, as the map files in the batch's directory hold them, as recorded, and with every other file of that listing, as [[Files.read]] reads it there, as elsewhere`,
    })
    .add({
      situation = `[[Process.stream]] of the compiler for a batch returns its [[Process.Exit]]`,
      behavior = `How the run ended is [[Generation.outcomeOf]] of [[Process.Exit.stdout]] as the report, the verdicts of the batch's units, and [[McpData.SessionRecord.submission]] of what [[McpData.Host.close]] returned for the run's session as submitted`,
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is accepted`,
      behavior = `Each unit's [[Verdict.outputs]] are [[Files.write]] back in the batch's directory`,
    })
    .add({
      situation = [
        `compile`,
        `[[Generation.outcomeOf]] of a batch's compiler run is accepted`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
      ],
      behavior = `The batch is verified`,
    })
    .add({
      situation = [
        `compile`,
        `[[Generation.outcomeOf]] of a batch's compiler run is accepted`,
        `elfie.json names no verifier, or --no-verify is given`,
      ],
      behavior = [
        `Each unit's [[Verdict.sourceMaps]] are recorded by [[Generation.record]]: at once when the batch's directory is the root, and only once its files are merged into the root when it is a copy`,
        `The batch counts as done`,
      ],
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is rejected`,
      behavior = `The problems are printed`,
    })
    .add({
      situation = [
        `compile`,
        `[[Generation.outcomeOf]] of a batch's compiler run is rejected for the first time in the compile`,
      ],
      behavior = `The batch is run once more with the problems appended to [[Request.instructions]]`,
    })
    .add({
      situation = [
        `compile without --continue`,
        `[[Generation.outcomeOf]] of a batch's compiler run is rejected for the second time in the compile`,
      ],
      behavior = `The compile stops`,
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is blocked`,
      behavior = `The reason is printed`,
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is blocked`,
      behavior = `The reason is [[Files.write]] to elfie-requests/<batch>.blocked.md under the root`,
    })
    .add({
      situation = [`compile without --continue`, `[[Generation.outcomeOf]] of a batch's compiler run is blocked`],
      behavior = `The compile stops`,
    })
    // A person answers a question by editing the definitions, or by writing the answer below the
    // question in its file.
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is clarification`,
      behavior = `The question is printed`,
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is clarification`,
      behavior = `The question is [[Files.write]] to elfie-requests/<batch>.question.md under the root`,
    })
    .add({
      situation = [
        `compile without --continue`,
        `[[Generation.outcomeOf]] of a batch's compiler run is clarification`,
      ],
      behavior = `The compile stops`,
    })
    .add({
      situation = [
        `compile`,
        `elfie-requests/<batch>.question.md under the root holds an answer written below the question`,
      ],
      behavior = `The compile of that batch [[Files.read]] the answer and appends it to the batch's instructions`,
    })
    .add({
      situation = [
        `compile`,
        `For the first time in the compile, [[Generation.outcomeOf]] of a batch's compiler run is failed, or [[Process.Exit.code]] of that run is -1`,
      ],
      behavior = `The batch is run once more`,
    })
    .add({
      situation = [
        `compile without --continue`,
        `For the second time in the compile, [[Generation.outcomeOf]] of a batch's compiler run is failed, or [[Process.Exit.code]] of that run is -1`,
      ],
      behavior = `The compile stops`,
    })
    .add({
      situation = [
        `compile with --continue`,
        `A batch is stopped by a second rejection or failure, a block, or a question`,
      ],
      behavior = `Only the batches that depend on one of its units are stopped`,
    })
    .add({
      situation = [
        `compile with --continue`,
        `A batch is stopped by a second rejection or failure, a block, or a question`,
      ],
      behavior = `The batches that depend on none of its units still run`,
    })
    .add({ situation = [`compile`, `Every batch was accepted`], behavior = `Returns [[ExitCode.success]]` })
    .add({
      situation = [`compile`, `A batch was rejected, blocked, or asked a question`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({ situation = [`compile`, `A command could not run`], behavior = `Returns [[ExitCode.failure]]` })
    // Without a compiler, the requests are for a compiler run by hand.
    .add({
      situation = [`compile`, `elfie.json names no compiler`],
      behavior = `The request of each batch, [[Generation.request]] given hosted false, is [[Files.write]] to elfie-requests under the root, one file per batch named by its identifier`,
    })
    .add({
      situation = [`compile`, `elfie.json names no compiler`],
      behavior = `Returns [[ExitCode.success]]`,
    })
    .add({ situation = `compile with --accept`, behavior = `No compiler is run` })
    .add({
      situation = `compile with --accept`,
      behavior = `The outputs of each planned unit, the files of [[Files.list]] of [[Target.outputDirectory]], recursively skipping every directory named target, .git, or node_modules, whose text carries a [[Marker]] for the unit, are checked with [[Generation.accept]], with the source maps recorded for the target's other units, as the map files in the batch's directory hold them, as recorded, and with every other file of that listing as elsewhere`,
    })
    .add({
      situation = [`compile with --accept`, `[[Generation.accept]] accepts a planned unit`],
      behavior = `Its [[Verdict.outputs]] are [[Files.write]] back, normalized`,
    })
    .add({
      situation = [`compile with --accept`, `[[Generation.accept]] accepts a planned unit`],
      behavior = `Its [[Verdict.sourceMaps]] are recorded by [[Generation.record]]`,
    })
    .add({
      situation = [`compile with --accept`, `[[Generation.accept]] rejects a planned unit`],
      behavior = `Returns [[ExitCode.problems]]`,
    });

  // Steps without the compiler
  // Decision: what needs no judgment is done by the CLI. A criterion or test reworded in place keeps
  // its position but not its id, so before every request its markers are moved to the new id by
  // the rule elfie_mark's rename uses, and the request marks it reworded instead of new.
  // Decision: a batch whose units differ only in reworded ids goes from the rewritten markers
  // straight to acceptance and review, because its code did not change and the review asks about
  // every reworded one. It does so only when a verifier will run, since nothing else would read
  // the new text against the code. A violation sends it to the compiler as its run once more.
  // Decision: a batch whose units all have the reason dependency runs the target's build and test
  // before any compiler. When both pass, its code still fits the interfaces it depends on, so its
  // outputs are accepted as they are and recorded against the new interfaces, and no verifier runs,
  // since no code changed and its review records still hold. Both paths apply only when every unit
  // of the batch qualifies, because a batch with any other unit needs the compiler anyway.
  // Decision: both paths keep outputs as they are, so both apply only to outputs whose unit's own
  // regions still hold the code accepted, as [[SourceMap.text]] records it, and never to a batch that
  // took kept work, which was rejected and never reviewed. Only the unit's own regions are compared,
  // so another unit writing elsewhere in a shared file, such as lib.rs, does not send it to the
  // compiler, while an edit inside one of its regions, or lines put under one of its markers, does.
  // Decision: the reworded-only path needs the source at the last accepted generation, never only
  // the hash-matched one, since it moves markers by pairing old ids with new.
  // Decision: markers are rewritten only when a run of the compiler or the reworded-only path follows,
  // never for requests written for a compiler run by hand. In place the rewritten ids sit in the root
  // until the batch is accepted; that is intended, since they name criteria the unit has.
  // Decision: the counts that decide a retry (the first or second rejected outcome, the first or
  // second failed run, the first or second verifier's report) count runs of the compiler and of the
  // verifier only; a first run that skipped the compiler is not a run of it.
  @acceptanceCriteria
    .add({
      situation = [
        `compile`,
        `A batch's first run skipped the compiler, as a reworded-only or a dependency-only batch's may`,
      ],
      behavior = `The skipped run counts as no run of the compiler in any count that decides whether the batch is run once more or stops`,
    })
    .add({
      situation = [
        `compile without --dry-run and without --accept`,
        `elfie.json names a compiler`,
        `The source of a unit at its last accepted generation is recoverable through git`,
      ],
      behavior = `Before each call of [[Generation.request]] for its batch, each output that [[Generation.rename]] gives is [[Files.write]] at its path in the batch's directory, given the unit, the files of [[Files.list]] of [[Target.outputDirectory]] in the batch's directory, recursively, whose [[Files.read]] text carries a [[Marker]] for the unit, and the [[Rewording.replaces]] of each of [[Generation.reworded]] of the workspace, the unit, and that source, mapped to its [[Rewording.id]]`,
    })
    .add({
      situation = [
        `compile with --accept`,
        `The source of a planned unit at its last accepted generation is recoverable through git`,
      ],
      behavior = `Before its outputs are checked, each output that [[Generation.rename]] gives is [[Files.write]] at its path in the root, given the unit, its outputs as they are checked, and the [[Rewording.replaces]] of each of [[Generation.reworded]] of the workspace, the unit, and that source, mapped to its [[Rewording.id]]`,
    })
    .add({
      situation = [`compile`, `An output of a unit is written for its reworded criteria and tests`],
      behavior = `One rewording progress line for the unit counts its reworded criteria and tests and the outputs written`,
    })
    // Reworded only
    .add({
      situation = [
        `compile without --accept`,
        `elfie.json names a compiler and a verifier`,
        `--no-verify is not given`,
        `Every unit of a batch is in [[Request.rewordedOnly]] of the request made for its first run`,
        `Every output of the batch's units, read in the batch's directory before any of its markers is rewritten, has its unit's own region text hash to [[SourceMap.text]] of its map`,
        `The previous text of every unit of the batch is its source at its last accepted generation, not only its hash-matched source`,
        `The batch took no kept work`,
      ],
      behavior = [
        `The compiler does not run for the batch's first run`,
        `Each unit of the batch is accepted or rejected by the [[Verdict]] of [[Generation.accept]] on its outputs in the batch's directory, as after a run of the compiler`,
      ],
    })
    .add({
      situation = [
        `compile without --accept`,
        `Every unit of a batch is in [[Request.rewordedOnly]] of the request made for its first run, and the compiler did not run for it`,
        `Every unit of the batch is accepted`,
      ],
      behavior = [
        `Each unit's [[Verdict.outputs]] are [[Files.write]] back in the batch's directory`,
        `The batch is verified, as after a compiler run whose outcome is accepted`,
      ],
    })
    .add({
      situation = [
        `compile without --accept`,
        `Every unit of a batch is in [[Request.rewordedOnly]] of the request made for its first run, and the compiler did not run for it`,
        `A unit of the batch is rejected`,
      ],
      behavior = [
        `The problems are printed`,
        `The compiler runs on the batch as its first run, and the rejection counts toward no retry`,
      ],
    })
    .add({
      situation = [
        `compile`,
        `The first verifier's report on a batch whose units were accepted without a run of the compiler holds a violated review or an unplaced violation`,
      ],
      behavior = `The batch's run once more is the compiler's first run on it, with the problems appended to [[Request.instructions]]`,
    })
    .add({
      situation = [
        `compile`,
        `Every unit of a batch is in [[Request.rewordedOnly]] of its first request`,
        `elfie.json names no verifier, or --no-verify is given`,
      ],
      behavior = `The compiler runs on the batch as on any batch`,
    })
    // Dependency only
    .add({
      situation = [
        `compile without --accept`,
        `elfie.json names a compiler`,
        `Every unit of a batch has the reason dependency`,
        `[[Target.commands]] of the batch's target holds a command with a line for the build operation and one with a line for the test operation`,
        `Every output of the batch's units, read in the batch's directory, has its unit's own region text hash to [[SourceMap.text]] of its map`,
        `The batch took no kept work`,
      ],
      behavior = [
        `Before the compiler would first run on the batch, a building progress line is printed and the build command runs in the batch's directory`,
        `When the build command succeeds, the test command runs there next`,
      ],
    })
    .add({
      situation = `compile runs the build or the test command of a target on a batch`,
      behavior = [
        `The command's line runs as elfie_build or elfie_test runs it given no filter and no scope: through the platform shell, as [[Process.stream]] runs a command, with no input, in [[Target.outputDirectory]] of the target under the batch's directory`,
        `Its environment sets RUN_SCRIPT to [[Target.scriptRunner]] of the target, or to the empty string when that is undefined, and sets TESTS and SCOPE to the empty string`,
        `It and every process of its group are stopped 30 minutes after it started, if it has not ended`,
        `It succeeds when its exit code is 0`,
      ],
    })
    .add({
      situation = [
        `compile without --accept`,
        `Every unit of a batch has the reason dependency`,
        `The build and the test command both succeed on the batch before the compiler runs`,
      ],
      behavior = [
        `The compiler does not run for the batch's first run`,
        `Each unit of the batch is accepted or rejected by the [[Verdict]] of [[Generation.accept]] on its outputs in the batch's directory, as after a run of the compiler`,
      ],
    })
    .add({
      situation = [
        `compile without --accept`,
        `Every unit of a batch has the reason dependency`,
        `The build and the test command both succeed on the batch before the compiler runs`,
        `Every unit of the batch is accepted`,
      ],
      behavior = [
        `The batch is accepted on its build and test`,
        `Each unit's [[Verdict.outputs]] are [[Files.write]] back in the batch's directory`,
        `No verifier runs on the batch`,
        `Each unit's [[Verdict.sourceMaps]] are recorded by [[Generation.record]]: at once when the batch's directory is the root, and only once its files are merged into the root when it is a copy`,
        `No review record file of the batch's units changes`,
        `The batch is done`,
      ],
    })
    .add({
      situation = [
        `compile without --accept`,
        `Every unit of a batch has the reason dependency`,
        `The build or the test command fails on the batch before the compiler runs, or a unit is rejected after both succeed`,
      ],
      behavior = [
        `A building progress line says which command failed and its exit code, or which unit was rejected`,
        `The compiler runs on the batch as its first run, and the failure counts toward no retry`,
      ],
    })
    .add({
      situation = [
        `compile without --accept`,
        `Every unit of a batch has the reason dependency`,
        `The batch's target has no line for the build operation or none for the test operation`,
      ],
      behavior = `The compiler runs on the batch as on any batch, and no build or test command runs first`,
    })
    .add({
      situation = `compile compares an output of a batch's units with [[SourceMap.text]] of its map`,
      behavior = [
        `The unit's own region text is computed as [[SourceMap]] defines it and hashed as SHA-256, as lowercase hex`,
        `Both sides are read in the batch's directory: the output, and the unit's maps from its map file there, so maps re-derived by [[Generation.rederive]] before the copy was made, or in place before the comparison, count`,
      ],
    })
    .add({
      situation = [
        `compile`,
        `Not every unit of a batch is in [[Request.rewordedOnly]] of its request, and not every unit of it has the reason dependency`,
      ],
      behavior = `The compiler runs on the batch as on any batch`,
    })
    .add({
      situation = [
        `compile`,
        `Every unit of a batch is in [[Request.rewordedOnly]] of its first request, or every unit of it has the reason dependency`,
        `An output of the batch's units, read in the batch's directory before any of its markers is rewritten, has its unit's own region text hash to other than [[SourceMap.text]] of its map, or the batch took kept work`,
      ],
      behavior = `The compiler runs on the batch as on any batch, and no build or test command runs first`,
    });

  // Verifying
  // Decision: the verifier is a second agent that never writes, run after structural acceptance,
  // with the source maps accept derived but before [[Generation.record]] records them, so that
  // every criterion can be pointed at the region of output that claims to satisfy it and a batch
  // the review rejects stays planned; a compiler judging its own work is not a check, and a review that names no
  // line of output is not evidence.
  // Decision: a batch's review asks only about the criteria and tests whose verdict is not carried
  // by its review records, and an empty review runs no verifier: the verdicts carried are those of
  // code that has not changed since it was judged satisfied.
  // Decision: the counts after a review are of what this review judged, so a person sees how much
  // was reviewed; what was carried is counted apart.
  @acceptanceCriteria
    .add({
      situation = [
        `compile`,
        `A batch's units are accepted by [[Generation.accept]]`,
        `The batch was not accepted on its build and test`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
      ],
      behavior = `The batch's review request is [[Generation.review]] of the plan, the batch, the source maps [[Generation.accept]] derived, the batch's directory, and the records [[Generation.reviewsOf]] gives in the root for each unit of the batch, in batch order`,
    })
    .add({
      situation = [
        `compile`,
        `A batch's units are accepted by [[Generation.accept]]`,
        `The batch was not accepted on its build and test`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
        `[[ReviewRequest.asked]] of the batch's review request is not empty`,
      ],
      behavior = `A verifying progress line is printed before the verifier runs on the batch`,
    })
    .add({
      situation = [
        `compile`,
        `A batch's units are accepted by [[Generation.accept]]`,
        `The batch was not accepted on its build and test`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
        `[[ReviewRequest.asked]] of the batch's review request is not empty`,
      ],
      behavior = [
        `The verifier runs once for the batch, as [[Process.stream]] of the command elfie.json names under verifier`,
        `Its input is [[ReviewRequest.instructions]] of the batch's review request`,
        `Its directory is the batch's directory`,
      ],
    })
    .add({
      situation = [
        `compile`,
        `A batch's units are accepted by [[Generation.accept]]`,
        `The batch was not accepted on its build and test`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
        `[[ReviewRequest.asked]] of the batch's review request is empty`,
      ],
      behavior = [
        `No verifier runs on the batch`,
        `One reviewed progress line is printed, counting no reviews and the verdicts of [[ReviewRequest.carried]] as carried`,
        `The source maps [[Generation.accept]] derived for the batch are recorded by [[Generation.record]] for each unit: at once when the batch's directory is the root, and only once its files are merged into the root when it is a copy`,
        `The batch is done`,
      ],
    })
    .add({
      situation = `compile or verify runs the verifier on a batch or for the global review`,
      behavior = `[[Process.Exit.stdout]] of the run, whole, is read by [[Generation.reviewOf]], with [[ReviewRequest.asked]] of its review request as asked and [[McpData.SessionRecord.reviews]] of what [[McpData.Host.close]] returned for its session as recorded`,
    })
    .add({
      situation = [
        `compile without --accept`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
        `A batch's source maps are recorded by [[Generation.record]]`,
        `A verifier was run on the batch, or a review request was made for it`,
      ],
      behavior = `Each unit's review records are recorded in the root by [[Generation.recordReviews]]: for each local criterion and test of the unit, sorted by id, the record made from the review of its id in the batch's last verifier run, else its record in [[ReviewRequest.carried]] of the batch's last review request, else none`,
    })
    .add({
      situation = [`compile`, `--no-verify is given, or elfie.json names no verifier`],
      behavior = `No review record file changes`,
    })
    .add({ situation = `compile with --accept`, behavior = `No review record file changes` })
    .add({
      situation = [`compile`, `The step is reviewed`],
      behavior = `The counts of satisfied, violated, and unverifiable are of the reviews of the batch's last verifier run, and a verdict of [[ReviewRequest.carried]] is counted only as carried`,
    })
    .add({
      situation = [`compile or verify`, `[[Generation.reviewOf]] reads the verifier's report on a batch`],
      behavior = `[[ReviewReport.reviews]] is [[Files.write]] as [[Json.stringify]] of it in [[Json.Layout.readable]] to elfie-requests/<batch>.reviews.json under the root`,
    })
    .add({
      situation = [`compile`, `[[Generation.reviewOf]] reads the verifier's report on a batch`],
      behavior = `One reviewed progress line follows`,
    })
    .add({
      situation = [
        `compile`,
        `A batch's units are accepted by [[Generation.accept]]`,
        `The batch was not accepted on its build and test`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
      ],
      behavior = `A unit's map file changes only after its batch's review holds no violated review and no unplaced violation, or after a review request that asked nothing`,
    })
    .add({
      situation = [
        `compile`,
        `The verifier's report on a batch holds no violated review`,
        `[[ReviewReport.unplaced]] of it is empty`,
      ],
      behavior = [
        `The source maps [[Generation.accept]] derived for the batch are recorded by [[Generation.record]] for each unit: at once when the batch's directory is the root, and only once its files are merged into the root when it is a copy`,
        `The batch is done`,
      ],
    })
    .add({
      situation = [`compile`, `The verifier's report on a batch holds an unverifiable review`],
      behavior = `The unverifiable review never rejects the batch`,
    })
    .add({
      situation = [`compile`, `The verifier's report on a batch holds a violated review`],
      behavior = `The batch is rejected with one problem per violated review reading failure at, a space, [[Review.file]], a colon, [[Review.line]], a colon, a space, [[Review.note]], a space, and [[Review.evidence]] in parentheses`,
    })
    .add({
      situation = [`compile`, `[[ReviewReport.unplaced]] of the verifier's report on a batch is not empty`],
      behavior = `The batch is rejected with one problem per unplaced line reading failure at a criterion the verifier did not name, a colon, a space, the note of the line, a space, and its evidence in parentheses`,
    })
    .add({
      situation = [`compile`, `The verifier's report on a batch holds a violated review or an unplaced violation`],
      behavior = `The problems are printed`,
    })
    .add({
      situation = [
        `compile`,
        `The first verifier's report on a batch in the compile holds a violated review or an unplaced violation`,
      ],
      behavior = `The batch is run once more with the problems appended to [[Request.instructions]], even when it was already run once more for a rejected outcome`,
    })
    .add({
      situation = [
        `compile`,
        `A batch run once more because the verifier's report on it held a violated review or an unplaced violation is accepted by [[Generation.accept]]`,
      ],
      behavior = `The verifier is run on it once more, with [[Generation.review]] of the plan, the batch, the source maps [[Generation.accept]] derived for its new outputs, the batch's directory, and records: none when the first run's report held an unplaced violation, and otherwise the records the first review request was made with, each review of the first run replacing the record of its id with the record made from it`,
    })
    .add({
      situation = [
        `compile`,
        `The second verifier's report on a batch in the compile holds a violated review or an unplaced violation`,
      ],
      behavior = `The batch stops as rejected`,
    })
    .add({
      situation = [
        `compile`,
        `The second verifier's report on a batch in the compile holds a violated review or an unplaced violation`,
      ],
      behavior = `The batch's source maps are not recorded, and its outputs are left on disk`,
    })
    .add({
      situation = [`compile or verify`, `[[ReviewReport.missing]] of the verifier's report on a batch is not empty`],
      behavior = `One line under its reviewed line names each missing id as not reviewed, and each counts as unverifiable in the counts`,
    })
    .add({
      situation = [
        `compile or verify`,
        `The first run of the verifier on a batch ends with no review in [[ReviewReport.reviews]], or with an id in [[ReviewReport.missing]] and either no line of [[Process.Exit.stdout]] reading ELFIE: REVIEWED or [[Process.Exit.code]] -1`,
      ],
      behavior = `The verifier is run once more on the batch`,
    })
    .add({
      situation = [
        `compile or verify`,
        `The verifier is run once more on a batch because its first run ended without every verdict`,
      ],
      behavior = `The review request of the second run is made as the first was, but with the records the first was made with, each review of the first run whose status is satisfied replacing the record of its id with the record made from it`,
    })
    .add({
      situation = [
        `compile`,
        `A run of the verifier on a batch ends with at least one review in [[ReviewReport.reviews]], and with [[ReviewReport.missing]] empty or with a line of [[Process.Exit.stdout]] reading ELFIE: REVIEWED and [[Process.Exit.code]] other than -1`,
        `[[ReviewReport.problems]] of the run is not empty`,
      ],
      behavior = `The problems are printed under its reviewed line`,
    })
    .add({
      situation = [
        `compile`,
        `A run of the verifier on a batch ends with at least one review in [[ReviewReport.reviews]], and with [[ReviewReport.missing]] empty or with a line of [[Process.Exit.stdout]] reading ELFIE: REVIEWED and [[Process.Exit.code]] other than -1`,
        `[[ReviewReport.problems]] of the run is not empty`,
      ],
      behavior = `The run stands, and the verifier is not run again for its problems`,
    })
    .add({
      situation = [
        `compile`,
        `The second run of the verifier on a batch ends with no review in [[ReviewReport.reviews]], or with an id in [[ReviewReport.missing]] and either no line of [[Process.Exit.stdout]] reading ELFIE: REVIEWED or [[Process.Exit.code]] -1`,
      ],
      behavior = `Its problems are printed as a failed progress line`,
    })
    .add({
      situation = [
        `compile`,
        `The second run of the verifier on a batch ends with no review in [[ReviewReport.reviews]], or with an id in [[ReviewReport.missing]] and either no line of [[Process.Exit.stdout]] reading ELFIE: REVIEWED or [[Process.Exit.code]] -1`,
      ],
      behavior = `The batch is verified with the reviews parsed from that run, as if its report had been complete`,
    })
    .add({
      situation = [`compile`, `--no-verify is given, or elfie.json names no verifier`],
      behavior = [`No verifier runs`, `No reviews file is written`],
    })
    .add({
      situation = [
        `compile without --dry-run`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
        `A review record file under elfie-compile/reviews/<target> for a planned target belongs to no unit of the plan`,
      ],
      behavior = `The review record file is removed by [[Files.remove]] before any batch runs`,
    });

  // Global review
  // Decision: a global criterion or test is reviewed once for the whole program, after every batch,
  // because every unit may answer for it and no single batch sees them all.
  @acceptanceCriteria
    .add({
      situation = [
        `compile`,
        `Every batch of the compile has been handled`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
        `A batch was accepted, or the SHA-256 of the ids of [[Program.criteria]] and [[Program.tests]] of [[Plan.program]] differs from [[McpData.GlobalReview.requirements]] of the last [[McpData.GlobalReview]]`,
      ],
      behavior = `A globalVerifying progress line is printed before the verifier runs for the global review`,
    })
    .add({
      situation = [
        `compile`,
        `Every batch of the compile has been handled`,
        `elfie.json names a verifier`,
        `--no-verify is not given`,
        `A batch was accepted, or the SHA-256 of the ids of [[Program.criteria]] and [[Program.tests]] of [[Plan.program]] differs from [[McpData.GlobalReview.requirements]] of the last [[McpData.GlobalReview]]`,
      ],
      behavior = [
        `The verifier runs once for the global review, as [[Process.stream]] of the command elfie.json names under verifier`,
        `Its input is [[ReviewRequest.instructions]] of [[Generation.globalReview]] of the plan and every source map, recorded or held`,
      ],
    })
    .add({
      situation = [`compile or verify`, `[[Generation.reviewOf]] reads the verifier's report on the global review`],
      behavior = `A [[McpData.GlobalReview]] holding that report and the SHA-256 of the global ids reviewed is [[Files.write]] to elfie-requests/global.reviews.json under the root`,
    })
    .add({
      situation = [`compile`, `[[Generation.reviewOf]] reads the verifier's report on the global review`],
      behavior = `One globalReviewed progress line follows`,
    })
    .add({
      situation = [`compile`, `The first global review of the compile holds a violated review`],
      behavior = `One problem per violated review is printed, reading failure at, a space, global, a colon, a space, [[Review.note]], a space, and [[Review.evidence]] in parentheses`,
    })
    .add({
      situation = [`compile`, `The first global review of the compile holds a violated review`],
      behavior = `The units whose markers answered for a violated review are planned with reason violated and compiled once more in the same compile, their batches handled as any other`,
    })
    .add({
      situation = [`compile`, `The first global review of the compile holds a violated review`],
      behavior = `The global review runs once more after the units it planned are compiled`,
    })
    .add({
      situation = [`compile`, `The second global review of the compile holds a violated review`],
      behavior = `The compile stops`,
    })
    .add({
      situation = [`compile`, `The second global review of the compile holds a violated review`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({
      situation = [`compile`, `The second global review of the compile holds a violated review`],
      behavior = `The next compile plans the units whose markers answered for a violated review with reason violated`,
    })
    .add({
      situation = `No global criterion or test exists`,
      behavior = [`No global review runs`, `elfie-requests/global.reviews.json is not written`],
    });

  // verify
  // Decision: verify is compile without the compiler: the same plan, the same review request, the
  // same verifier, so a person can ask for an opinion on outputs already recorded.
  @acceptanceCriteria
    .add({
      situation = `verify`,
      behavior = `The outputs reviewed are those of [[Generation.sourceMapsOf]] [[Loader.load]] of the root`,
    })
    .add({
      situation = `verify`,
      behavior = [
        `Nothing is compiled`,
        `No output is written`,
        `Nothing under elfie-compile is recorded, moved, or removed`,
      ],
    })
    .add({
      situation = [`verify`, `A diagnostic of the loaded program is an error`],
      behavior = `Every error diagnostic is printed`,
    })
    .add({
      situation = [`verify`, `A diagnostic of the loaded program is an error`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({
      situation = [`verify`, `No diagnostic of the loaded program is an error`, `Stems are given`],
      behavior = `The units reviewed are those the stems given name, through [[Generation.plan]] made with every stem given as a requested unit`,
    })
    .add({
      situation = [`verify`, `No diagnostic of the loaded program is an error`, `No stem is given`],
      behavior = `Every unit whose [[Unit.outputs]] is not empty is reviewed, through [[Generation.plan]] made with all of them requested`,
    })
    .add({
      situation = [`verify`, `[[Plan.problems]] is not empty`],
      behavior = `[[Plan.problems]] is neither printed nor counted in the exit code, and the review goes on`,
    })
    .add({
      situation = `verify with --target`,
      behavior = `Only units of the target --target names are reviewed`,
    })
    .add({
      situation = [`verify`, `A stem given names a unit whose [[Unit.outputs]] is empty`],
      behavior = `The stem is printed as having nothing to review`,
    })
    .add({
      situation = [`verify`, `A stem given names a unit whose [[Unit.outputs]] is empty`],
      behavior = `The unit is not reviewed, and the exit code does not change for it`,
    })
    // Decision: verify never changes a review record, so what it asks about is what the last compile
    // left unreviewed, and --full asks about everything.
    .add({
      situation = [`verify without --full`, `A stem is given, or --global is not given`],
      behavior = `The review request of a batch is [[Generation.review]] of the plan, the batch, the source maps, the root, and the records [[Generation.reviewsOf]] gives for each unit of the batch, in batch order`,
    })
    .add({
      situation = [`verify with --full`, `A stem is given, or --global is not given`],
      behavior = `The review request of a batch is [[Generation.review]] of the plan, the batch, the source maps, the root, and no records`,
    })
    .add({
      situation = [`verify`, `elfie.json names a verifier`, `A stem is given, or --global is not given`],
      behavior = `The verifier runs on each batch of [[Plan.batches]] that holds a requested unit and whose review request has a [[ReviewRequest.asked]] that is not empty`,
    })
    .add({
      situation = [
        `verify`,
        `elfie.json names a verifier`,
        `A batch holds a requested unit`,
        `[[ReviewRequest.asked]] of its review request is empty`,
      ],
      behavior = `No verifier runs on the batch, and its counts line counts no reviews`,
    })
    .add({
      situation = [`verify`, `elfie.json names a verifier`, `A stem is given, or --global is not given`],
      behavior = [`At most --jobs batches are reviewed at once`, `The batches start in plan order`],
    })
    .add({
      situation = [
        `verify`,
        `elfie.json names a verifier`,
        `The verifier runs on a batch`,
      ],
      behavior = [
        `The run is one [[Process.stream]] of the command elfie.json names under verifier`,
        `Its input is [[ReviewRequest.instructions]] of the batch's review request`,
        `Its directory is the root`,
      ],
    })
    .add({
      situation = [`verify`, `elfie.json names a verifier`, `No stem is given, or --global is given`],
      behavior = `After any batches are reviewed, the verifier runs once for the global review`,
    })
    .add({
      situation = [`verify`, `elfie.json names a verifier`, `The verifier runs for the global review`],
      behavior = [
        `The run is one [[Process.stream]] of the command elfie.json names under verifier`,
        `Its input is [[ReviewRequest.instructions]] of [[Generation.globalReview]] of the plan and the source maps`,
        `Its directory is the root`,
      ],
    })
    .add({ situation = [`verify with --global`, `No stem is given`], behavior = `No batch is reviewed` })
    .add({ situation = `verify with --json`, behavior = `Each [[Review]] is one result` })
    .add({
      situation = `verify without --json`,
      behavior = `Each review is printed as its status, a space, [[Review.file]], a colon, [[Review.line]], a space, [[Review.entity]], a colon, a space, and [[Review.note]]`,
    })
    .add({
      situation = `verify without --json`,
      behavior = `After each batch one line gives the counts of satisfied, violated, and unverifiable`,
    })
    .add({
      situation = [`verify without --json`, `[[ReviewRequest.carried]] of a batch's review request is not empty`],
      behavior = `Its counts line ends with a comma, a space, and [[Style.tally]] of the count of [[ReviewRequest.carried]] and the word carried in muted`,
    })
    .add({
      situation = `verify`,
      behavior = `A carried verdict is never printed as a review, and is counted only as carried`,
    })
    .add({
      situation = `verify without --json`,
      behavior = [
        `A review's status is painted in [[Style.statusTone]] of it and padded with [[Style.padded]] to the longest status of [[ReviewStatus]]`,
        `A review's file and line are painted subject`,
        `A review's entity and note are plain`,
      ],
    })
    .add({
      situation = `verify without --json`,
      behavior = `The counts line after each batch begins with [[Style.tally]] of the satisfied in success, the violated in failure, and the unverifiable in warning, separated by a comma and a space`,
    })
    .add({
      situation = [`verify`, `elfie.json names a verifier`, `A review is violated`],
      behavior = `Returns [[ExitCode.problems]]`,
    })
    .add({
      situation = [`verify`, `elfie.json names a verifier`, `The verifier could not be started`],
      behavior = `Returns [[ExitCode.failure]]`,
    })
    .add({
      situation = [
        `verify`,
        `elfie.json names a verifier`,
        `No review is violated, and the verifier was started or no review request asked anything`,
      ],
      behavior = `Returns [[ExitCode.success]]`,
    })
    // Without a verifier, the review requests are for a verifier run by hand.
    .add({
      situation = [`verify`, `elfie.json names no verifier`],
      behavior = `The review request of each batch is [[Files.write]] to elfie-requests under the root, named by the batch identifier with the extension .review.md`,
    })
    .add({
      situation = [`verify`, `elfie.json names no verifier`],
      behavior = `Returns [[ExitCode.success]]`,
    });

  // Compile data
  // Decision: a missing folder under elfie-compile is created, so a project cloned without
  // elfie-compile/cache, or without elfie-compile at all, compiles.
  // Decision: the kept work of a rejected batch is the one thing in elfie-compile/cache that changes
  // a request, since a batch that takes it starts from its own earlier outputs; losing it costs only
  // the time to write them again.
  @acceptanceCriteria
    .add({
      situation = `elfie-compile/cache under the root has been deleted`,
      behavior = `A command makes the same [[Plan]] as it would with the folder in place`,
    })
    .add({
      situation = `elfie-compile/cache under the root has been deleted`,
      behavior = `A command makes the same requests as it would with the folder in place, except for the existing outputs of a batch that would have taken kept work`,
    })
    .add({
      situation = `A command writes under elfie-compile and the folder it writes into is missing`,
      behavior = `The folder is created`,
    });

  // lsp, mcp
  @acceptanceCriteria
    .add({ situation = `lsp`, behavior = `Returns [[Lsp.serve]] of the root` })
    .add({ situation = `mcp`, behavior = `Returns [[Mcp.serve]] of the root` });

  @test(
    {
      input = [[`check`, `--root`, string@like(`A root whose def holds a.lfy reading: const y = z;`)]],
      expect = number@like(`1, after printing def/a.lfy:1:10: binder error: and the message`),
    },
    {
      input = [[`format`, `--check`, `--root`, string@like(`A root whose def holds a.lfy reading: const   x=1;`)]],
      expect = number@like(`1, after printing def/a.lfy, and the file unchanged`),
    },
    {
      input = [
        [
          `compile`,
          `--dry-run`,
          `--root`,
          string@like(`A root with one target that global's targets hold and one file`),
        ],
      ],
      expect = number@like(`0, after printing one unit with reason fresh and one batch holding it`),
    },
    {
      input = [
        [
          `compile`,
          `--target`,
          `wasm`,
          `--root`,
          string@like(`A root with the one target rust`),
        ],
      ],
      expect = number@like(`2, after a usage message naming rust, with nothing compiled`),
    },
    {
      input = [
        [
          `compile`,
          `--root`,
          string@like(
            `A root with one target, def/a.lfy declaring A with a criterion on line 3, a compiler that writes an output with a marker for A and ends with ELFIE: DONE, and a verifier that writes one review of def/a.lfy line 3 for A with status violated, evidence crates/a/src/a.rs:4-6, and note returns 0 for an empty list, then ELFIE: REVIEWED`,
          ),
        ],
      ],
      expect = number@like(
        `1, after the problem failure at def/a.lfy:3: returns 0 for an empty list (crates/a/src/a.rs:4-6), the compiler run a second time with it, and the batch rejected`,
      ),
    },
    {
      input = [
        [
          `verify`,
          `a`,
          `--root`,
          string@like(
            `A root with one target, def/a.lfy declaring A with a criterion on line 3, the output for a recorded in elfie-compile/maps/rust/a.json, and a verifier that writes one review of def/a.lfy line 3 for A with status violated and note returns 0 for an empty list, then ELFIE: REVIEWED`,
          ),
        ],
      ],
      expect = number@like(
        `1, after printing violated def/a.lfy:3 A: returns 0 for an empty list, with no compiler run`,
      ),
    },
    {
      input = [
        [
          `compile`,
          `--root`,
          string@like(
            `A root with one target rust, def holding a.lfy and b.lfy, both recorded in elfie-compile/maps/rust, a.lfy edited since, and a compiler and verifier that accept a's batch`,
          ),
        ],
      ],
      expect = number@like(
        `0, after compiling a alone, with elfie-compile/maps/rust/a.json rewritten and b.json byte for byte as it was`,
      ),
    },
    {
      input = [
        [
          `compile`,
          `--dry-run`,
          `--root`,
          string@like(`A root with one target rust whose maps are all recorded and elfie-compile/cache deleted`),
        ],
      ],
      expect = number@like(`0, after printing every unit as up to date`),
    },
    {
      input = [
        [
          `compile`,
          `--jobs`,
          `1`,
          `--root`,
          string@like(
            `A root with one target rust whose build and test command lines both exit 0, a compiler and a verifier that would each fail the test if run, def holding a.lfy using ./b and b.lfy, both recorded in elfie-compile/maps/rust, with the dependency hash a.json records for b differing from the hash of b's interface now`,
          ),
        ],
      ],
      expect = number@like(
        `0, after a building line for a and an accepted line, with neither the compiler nor the verifier run, elfie-compile/maps/rust/a.json recording b's interface hash as it is now, and no review record file changed`,
      ),
    },
    {
      input = [
        [
          `compile`,
          `--jobs`,
          `2`,
          `--root`,
          string@like(
            `A git root with one target rust whose build and test command lines both exit 0, def holding b.lfy and a.lfy using ./b in different directories so they are two batches, both edited since recorded, a compiler that writes each unit's output once and the same way every run, and a verifier that is still reviewing b when a's compiler starts and finds nothing violated`,
          ),
        ],
      ],
      expect = number@like(
        `0, after a's batch starts in a copy holding b's accepted output before b's review ends, b is merged into the root first, a is merged after it without any build or test run, and both maps are recorded`,
      ),
    },
    {
      input = [
        [
          `compile`,
          `--jobs`,
          `2`,
          `--root`,
          string@like(
            `The same root, with a verifier whose first review of b finds one criterion violated, and a compiler whose run once more on b rewrites the body of one function in b's output`,
          ),
        ],
      ],
      expect = number@like(
        `0, after a's batch starts against b's first accepted output, b runs once more and is merged, a building line for a, a's copy taking b's output as merged, then a merged after the build and test pass, with a's compiler run once`,
      ),
    },
  );
}
