use "../format/main" as Formatter;
use "../generation/data";
use "../generation/main" as Generation;
use "../interpret/data";
use "../lexer/main" as Lexer;
use "../lsp/main" as Lsp;
use "../mcp/main" as Mcp;
use "../parser/data";
use "../parser/main" as Parser;
use "../query/data";
use "../query/main" as Query;
use "../workspace/data";
use "../workspace/main" as Loader;
use "./data";
use "elfie/system/file" as Files;
use "elfie/system/json" as Json;
use "elfie/system/path";
use "elfie/system/process" as Process;
use "elfie/system/time" as Time;

fn parse(arguments: string[]): `The invocation the arguments spell, or the usage error they make` => Invocation | string {
  @acceptanceCriteria
    .add({
      situation = [`An argument does not begin with a dash`, `No argument is --help, -h, or --version`],
      behavior = `The first argument that does not begin with a dash names the [[Command]]`,
    })
    .add({
      situation = [`No argument that does not begin with a dash is given`, `No argument is --version`],
      behavior = `The command is help`,
    })
    .add({ situation = `--help or -h is among the arguments`, behavior = `The command is help` })
    .add({ situation = `--version is among the arguments`, behavior = `The command is version` })
    .add({
      situation = `--root followed by a directory, or --root= and the directory, is among the arguments`,
      behavior = `That directory is [[Invocation.root]]`,
    })
    .add({
      situation = [
        `No --root is among the arguments`,
        `[[Files.exists]] finds elfie.json in a directory at or above [[Process.currentDirectory]]`,
      ],
      behavior = `[[Invocation.root]] is the nearest directory at or above [[Process.currentDirectory]] where [[Files.exists]] finds elfie.json`,
    })
    .add({
      situation = [
        `No --root is among the arguments`,
        `[[Files.exists]] finds elfie.json in no directory at or above [[Process.currentDirectory]]`,
      ],
      behavior = `[[Invocation.root]] is [[Process.currentDirectory]]`,
    })
    .add({
      situation = `--tree followed by a file is among the arguments`,
      behavior = `The invocation is the tree command with that file, so what the parser stage shipped keeps working`,
    })
    .add({
      behavior = `Every argument beginning with two dashes other than --root, --tree, --help, and --version is an option`,
    })
    .add({
      situation = `An option other than --root is written --name=value`,
      behavior = `The option gives the text value`,
    })
    .add({
      situation = `--target is followed by a value`,
      behavior = `The option target gives that value, since it is the one option besides --root that takes a following value`,
    })
    .add({
      situation = `An option other than --root, --tree, --help, --version, and --target is written --name, with no equals sign`,
      behavior = `It is a flag and gives true, never taking the next argument, so --json check still names the check command`,
    })
    .add({
      behavior = `Every argument that does not begin with a dash, other than the one naming the command and the value --root or --target takes, is positional`,
    })
    .add({
      situation = `The command is not one of [[Command]], or an option's value is missing`,
      behavior = `Returns a usage message naming the argument`,
    });

  @test(
    {
      input = [[`check`]],
      expect = Invocation@like(`check with no arguments and the root found from the current directory`),
    },
    { input = [[`--tree`, `def/a.lfy`]], expect = Invocation@like(`tree with the one argument def/a.lfy`) },
    { input = [[`frobnicate`]], expect = string@like(`A usage message naming frobnicate`) },
  );
}

fn main(arguments: string[]): `Run one command and return its exit code` => number {
  // Decision: every command is a thin driver over the stage it belongs to, and the process exits
  // with a code from [[ExitCode]] so agents and scripts can read the outcome without parsing text.
  @acceptanceCriteria
    .add({
      situation = `[[parse]] returns a usage message`,
      behavior = `It is printed to standard error with the help text and the code is usage`,
    })
    .add({
      situation = `--json is given to any command that prints results`,
      behavior = `The command prints them as JSON lines instead of text, one object per result, each [[Json.stringify]] on one line`,
    })
    .add({
      behavior = `A [[Diagnostic]] is printed as the file, a colon, the line, a colon, the column, a colon, the stage, the severity, and the message`,
    });

  // help, version
  @acceptanceCriteria
    .add({
      situation = `help`,
      behavior = `Prints every command of [[Command]], verify among them, with one line of description and the global options, --no-verify and --strict among them, and returns success`,
    })
    .add({ situation = `version`, behavior = `Prints the version of the executable and returns success` });

  // init
  @acceptanceCriteria
    .add({
      situation = [`init`, `[[Files.exists]] does not find elfie.json in the root`, `An argument is given`],
      behavior = `[[Files.write]] of elfie.json in the root naming the project after the argument, and [[Files.createDirectory]] of the source directory`,
    })
    .add({
      situation = [`init`, `[[Files.exists]] does not find elfie.json in the root`, `No argument is given`],
      behavior = `[[Files.write]] of elfie.json in the root naming the project after the directory, and [[Files.createDirectory]] of the source directory`,
    })
    .add({
      situation = [`init`, `[[Files.exists]] finds elfie.json in the root`],
      behavior = `Returns failure`,
    });

  // check
  @acceptanceCriteria
    .add({
      situation = [`check`, `No files are given as arguments`],
      behavior = `[[Loader.load]] of the root, then every [[Query.diagnosticsOf]] printed`,
    })
    .add({
      situation = [`check`, `Files are given as arguments`],
      behavior = `[[Loader.load]] of the root, then every [[Query.diagnosticsOf]] of the files given as arguments only printed`,
    })
    .add({ situation = [`check`, `A printed diagnostic is an error`], behavior = `The code is problems` })
    .add({
      situation = [`check`, `No printed diagnostic is an error`, `--strict is not given`],
      behavior = `The code is success`,
    })
    .add({
      situation = `check with no files given, and the program has no errors`,
      behavior = `[[Generation.plan]] is made with no stems requested, from the source maps in source-map.json under each [[Target.outputDirectory]] and the stems the last global review in elfie-requests/global.reviews.json found violated, and each unit that is not up to date is printed as a warning of stage generation at its source file, naming the target, the unit, and the description of its [[Unit.reason]]; the last line counts the files, the problems, and the stale units`,
    })
    .add({
      situation = `check with --strict`,
      behavior = `The code is problems when anything at all is printed as a warning or error, a stale unit included, so one command checks that the definitions bind cleanly and that every output is up to date`,
    });

  // format
  @acceptanceCriteria
    .add({
      situation = [`format`, `Files are given as arguments`],
      behavior = `Each file given is [[Files.read]], lexed, and parsed`,
    })
    .add({
      situation = [`format`, `No files are given as arguments`],
      behavior = `Every file of [[Files.list]] of the source directory, recursively, whose [[Path.extension]] is lfy, is [[Files.read]], lexed, and parsed`,
    })
    .add({
      situation = [
        `format without --check`,
        `[[Formatter.format]] of the tree of a file being formatted differs from its text`,
      ],
      behavior = `That file is replaced by [[Files.write]] of [[Formatter.format]] of its tree`,
    })
    .add({ situation = `format with --check`, behavior = `Nothing is written` })
    .add({
      situation = [`format with --check`, `Files are given as arguments`],
      behavior = `Each file given whose [[Formatter.format]] of its tree differs from its text is printed`,
    })
    .add({
      situation = [`format with --check`, `No files are given as arguments`],
      behavior = `Each file under the source directory whose [[Path.extension]] is lfy and whose [[Formatter.format]] of its tree differs from its text is printed`,
    })
    .add({
      situation = [`format with --check`, `[[Formatter.format]] of the tree of a file checked differs from its text`],
      behavior = `The code is problems`,
    })
    .add({
      situation = `format on a file whose tree has errors`,
      behavior = `Its errors are printed, it is left as it is, and the code is problems`,
    });

  // tree, tokens
  @acceptanceCriteria
    .add({
      situation = `tree`,
      behavior = `Prints [[Parser.parse]] of [[Lexer.lex]] of [[Files.read]] of the one file given, one node or token per line indented by depth, a node as its rule and its token range, a token as its rule and its value`,
    })
    .add({
      situation = [`tree`, `The tree of the file given holds an [[ErrorNode]]`],
      behavior = `Each [[ErrorNode]] is printed with what it expected, and the code is problems`,
    })
    .add({
      situation = `tokens`,
      behavior = `Prints [[Lexer.lex]] of [[Files.read]] of the one file given, one token per line as its line, column, rule, and value`,
    });

  // compile
  @acceptanceCriteria
    .add({ situation = `compile`, behavior = `[[Loader.load]] of the root` })
    .add({
      situation = [`compile`, `A diagnostic of the loaded program is an error`],
      behavior = `The diagnostics are printed and the code is problems, because the compiler is never handed a program with problems`,
    })
    .add({
      situation = `compile`,
      behavior = `The source maps of each target are [[Json.parse]] of [[Files.read]] of source-map.json, [[Path.join]] to [[Target.outputDirectory]], dropping any whose output [[Files.exists]] no longer finds, and [[Generation.plan]] is made with them and with the stems of the units the last global review, read from elfie-requests/global.reviews.json under the root, found violated as the violated units`,
    })
    .add({
      situation = [`compile`, `A target has no source-map.json under its [[Target.outputDirectory]]`],
      behavior = `[[Generation.plan]] is made with no source maps for that target`,
    })
    .add({
      situation = `compile without --all`,
      behavior = `[[Generation.plan]] is made with the stems given as arguments as the requested units`,
    })
    .add({ situation = `compile with --all`, behavior = `[[Generation.plan]] is made with every unit requested` })
    .add({
      situation = `compile with --target`,
      behavior = `[[Generation.plan]] is limited to the one target --target names`,
    })
    .add({
      behavior = `The last global review is [[Json.parse]] of [[Files.read]] of elfie-requests/global.reviews.json under the root: the SHA-256 of the ids of every global criterion and test it reviewed, and its [[ReviewReport]]. Its violated units are the stems of every unit whose outputs hold a [[Marker]] whose [[Marker.requirement]] is the id of a violated review`,
    })
    .add({
      situation = `compile or check, and elfie-requests/global.reviews.json under the root is missing`,
      behavior = `There is no last global review`,
    })
    .add({
      situation = `compile with --dry-run`,
      behavior = `Each planned unit is printed as its target, [[Unit.stem]], its reason or up to date, and the stems of its dependencies, then each batch with the stems it holds, and nothing is generated`,
    });

  // Progress
  // Decision: progress is a stream of one-line events rather than a redrawn screen, so it reads the
  // same in a terminal, in a log, and as JSON lines for a script.
  @acceptanceCriteria
    .add({ behavior = `Every step of a compile prints one [[Progress]] line as it happens` })
    .add({
      situation = `compile without --json`,
      behavior = `Each [[Progress]] line reads the step, done over total, [[Time.elapsed]] since the compile began, and the message`,
    })
    .add({
      situation = [`compile without --json`, `The [[Progress.batch]] of a step is set`],
      behavior = `Its [[Progress]] line reads the batch after the step`,
    })
    .add({
      situation = [`compile without --json`, `The [[Progress.unit]] of a step is set`],
      behavior = `Its [[Progress]] line reads the unit after the step and the batch`,
    })
    .add({
      situation = `compile with --json`,
      behavior = `Each [[Progress]] line is [[Json.stringify]] of the [[Progress]] on one line`,
    })
    .add({
      behavior = `The first [[Progress]] line of a compile is planned, with the count of units planned and of batches; the last is finished, with the count accepted, rejected, blocked, and failed`,
    })
    .add({
      behavior = `While the compiler runs on a batch, each line [[Process.stream]] passes to its onLine is shown as it arrives, prefixed by the batch, and [[Process.Exit.stdout]] is the report`,
    })
    .add({
      behavior = `Every progress line and report is [[Files.append]] to elfie-requests/compile.log under the root, never under an output directory, so a run can be read after the fact and no output is ever mistaken for the CLI's own files`,
    });

  // Running the compiler
  @acceptanceCriteria
    .add({
      behavior = `The compiler is the command elfie.json names under compiler; it is [[Process.stream]] once per batch in plan order, with [[Request.instructions]] of [[Generation.request]] as its input, the root as its directory, and ELFIE_ROOT, ELFIE_BATCH, and ELFIE_UNITS (the stems, space separated) as its environment`,
    })
    .add({
      situation = [
        `compile`,
        `The root is a git repository and the source of a unit at its last accepted generation is recoverable from it through [[Process.run]] of git`,
      ],
      behavior = `[[Request.previous]] holds, for that unit, [[LoweredFile.text]] of that source, lowered as [[Generation.changes]] binds a previous text`,
    })
    .add({
      situation = `[[Process.stream]] of the compiler for a batch returns its [[Process.Exit]]`,
      behavior = `For each unit of the batch, [[Generation.accept]] runs on the files of [[Files.list]] of [[Target.outputDirectory]], recursively, whose [[Files.read]] text carries a [[Marker]] for the unit; [[Generation.outcomeOf]] is read from [[Process.Exit.stdout]], the report, and the verdicts`,
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is accepted`,
      behavior = `Each unit's [[Verdict.outputs]] are [[Files.write]] back, and its [[SourceMap]]s replace the unit's in source-map.json, [[Files.write]] as [[Json.stringify]] pretty`,
    })
    .add({
      situation = [
        `compile`,
        `[[Generation.outcomeOf]] of a batch's compiler run is accepted`,
        `elfie.json names a verifier and --no-verify is not given`,
      ],
      behavior = `The batch is verified`,
    })
    .add({
      situation = [
        `compile`,
        `[[Generation.outcomeOf]] of a batch's compiler run is accepted`,
        `elfie.json names no verifier, or --no-verify is given`,
      ],
      behavior = `The batch counts as done`,
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is rejected`,
      behavior = `The problems are printed`,
    })
    .add({
      situation = [
        `compile`,
        `[[Generation.outcomeOf]] of a batch's compiler run is rejected for the first time in the compile`,
      ],
      behavior = `The batch is run once more with the problems appended to [[Request.instructions]]`,
    })
    .add({
      situation = [
        `compile without --continue`,
        `[[Generation.outcomeOf]] of a batch's compiler run is rejected for the second time in the compile`,
      ],
      behavior = `The compile stops`,
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is blocked`,
      behavior = `The reason is printed and [[Files.write]] to elfie-requests/<batch>.blocked.md under the root, and the compile stops`,
    })
    .add({
      situation = `[[Generation.outcomeOf]] of a batch's compiler run is clarification`,
      behavior = `The question is printed and [[Files.write]] to elfie-requests/<batch>.question.md under the root, and the compile stops; the person answers by editing the definitions, or by writing the answer below the question in that file`,
    })
    .add({
      situation = [
        `compile`,
        `elfie-requests/<batch>.question.md under the root holds an answer written below the question`,
      ],
      behavior = `The compile of that batch [[Files.read]] the answer and appends it to the batch's instructions`,
    })
    .add({
      situation = [
        `compile`,
        `For the first time in the compile, [[Generation.outcomeOf]] of a batch's compiler run is failed, or [[Process.Exit.code]] of that run is -1 because the command could not be started`,
      ],
      behavior = `The batch is run once more`,
    })
    .add({
      situation = [
        `compile without --continue`,
        `For the second time in the compile, [[Generation.outcomeOf]] of a batch's compiler run is failed, or [[Process.Exit.code]] of that run is -1 because the command could not be started`,
      ],
      behavior = `The compile stops`,
    })
    .add({
      situation = [
        `compile with --continue`,
        `A batch is stopped by a second rejection or failure, a block, or a question`,
      ],
      behavior = `Only the batches that depend on one of its units are stopped; independent batches still run`,
    })
    .add({
      situation = `compile with --continue`,
      behavior = `The finished line lists every batch that did not complete`,
    })
    .add({ situation = [`compile`, `Every batch was accepted`], behavior = `The code is success` })
    .add({
      situation = [`compile`, `A batch was rejected, blocked, or asked a question`],
      behavior = `The code is problems`,
    })
    .add({ situation = [`compile`, `A command could not run`], behavior = `The code is failure` })
    .add({
      situation = `compile, and elfie.json names no compiler`,
      behavior = `The request of each batch is [[Files.write]] to elfie-requests under the root, one file per batch named by its identifier, for a compiler run by hand; the code is success`,
    })
    .add({
      situation = `compile with --accept`,
      behavior = `No compiler is run; the outputs already under [[Target.outputDirectory]] for each planned unit, the files of [[Files.list]] of it, recursively, whose text carries a [[Marker]] for the unit, are checked with [[Generation.accept]] and written back normalized`,
    })
    .add({
      situation = [`compile with --accept`, `[[Generation.accept]] accepts a planned unit`],
      behavior = `The [[SourceMap]]s of its outputs are recorded in source-map.json, so a compiler that worked through the agent server has its work recorded`,
    })
    .add({
      situation = [`compile with --accept`, `[[Generation.accept]] rejects a planned unit`],
      behavior = `The code is problems`,
    });

  // Verifying
  // Decision: the verifier is a second agent that never writes, run after structural acceptance,
  // with the source maps accept derived but before they are recorded, so that every criterion can
  // be pointed at the region of output that claims to satisfy it and a batch the review rejects
  // stays planned; a compiler judging its own work is not a check, and a review that names no
  // line of output is not evidence.
  @acceptanceCriteria
    .add({
      situation = `A batch's units are accepted by [[Generation.accept]], elfie.json names a verifier, and --no-verify is not given`,
      behavior = `A verifying progress line is printed, then the verifier, the command elfie.json names under verifier, is [[Process.stream]] once for the batch with [[ReviewRequest.instructions]] of [[Generation.review]] of the plan, the batch, and the source maps [[Generation.accept]] derived, held but not yet recorded, as its input, the root as its directory, and ELFIE_ROOT, ELFIE_BATCH, and ELFIE_UNITS (the batch's stems, space separated) as its environment; each line it writes is shown as it arrives prefixed by the batch, and [[Process.Exit.stdout]] whole is read by [[Generation.reviewOf]]`,
    })
    .add({
      situation = `[[Generation.reviewOf]] reads the verifier's report on a batch`,
      behavior = `[[ReviewReport.reviews]] is [[Files.write]] as [[Json.stringify]] pretty to elfie-requests/<batch>.reviews.json under the root, replacing an earlier file, and one reviewed progress line follows, whose message is the counts of satisfied, violated, and unverifiable reviews`,
    })
    .add({
      situation = `The verifier's report on a batch holds no violated review`,
      behavior = `The source maps [[Generation.accept]] derived for the batch, held until the review, are recorded in source-map.json and the batch is done`,
    })
    .add({
      situation = [`compile`, `The verifier's report on a batch holds an unverifiable review`],
      behavior = `The unverifiable review is counted in the reviewed line and never rejects the batch`,
    })
    .add({
      situation = `The verifier's report on a batch holds a violated review`,
      behavior = `The batch is rejected with one problem per violated review reading failure at, a space, [[Review.file]], a colon, [[Review.line]], a colon, a space, [[Review.note]], a space, and [[Review.evidence]] in parentheses; the problems are printed and the batch is run once more with them appended to [[Request.instructions]], even when it was already run once more for a rejected outcome`,
    })
    .add({
      situation = `A batch run once more because the verifier's report on it held a violated review is accepted by [[Generation.accept]]`,
      behavior = `The verifier is run on it once more, with [[Generation.review]] of the plan, the batch, and the source maps [[Generation.accept]] derived for its new outputs`,
    })
    .add({
      situation = [
        `compile`,
        `A batch was run once more because the verifier's report on it held a violated review, and the verifier's report on that later run holds a violated review too`,
      ],
      behavior = `The batch stops as rejected, which the finished line and the code count as a rejection, and its source maps are not recorded, so its outputs stay on disk and the unit stays planned`,
    })
    .add({
      situation = [
        `compile`,
        `The first run of the verifier on a batch ends with [[ReviewReport.problems]] not empty, with no line of [[Process.Exit.stdout]] reading ELFIE: REVIEWED, or with [[Process.Exit.code]] -1`,
      ],
      behavior = `The verifier run failed, and it is run once more on the batch`,
    })
    .add({
      situation = [
        `compile`,
        `A run of the verifier on a batch, made once more because the run before it failed, ends with [[ReviewReport.problems]] not empty, with no line of [[Process.Exit.stdout]] reading ELFIE: REVIEWED, or with [[Process.Exit.code]] -1`,
      ],
      behavior = `Its problems are printed as a failed progress line, and the batch is verified with the reviews parsed from that run as if its report had been complete`,
    })
    .add({
      situation = `compile, and either --no-verify is given or elfie.json names no verifier`,
      behavior = `No verifier runs, nothing is reviewed, no reviews file is written, and a batch is done and its source maps recorded when its units are accepted`,
    })
    .add({
      behavior = `verifying and reviewed are [[Progress]] lines like every other step; every line of the verifier's output and its report are [[Files.append]] to elfie-requests/compile.log under the root`,
    })
    .add({
      situation = `compile with --json`,
      behavior = `Each verifying and reviewed line is printed as [[Json.stringify]] of its [[Progress]]`,
    });

  // Global review
  // Decision: a global criterion or test is reviewed once for the whole program, after every batch,
  // because every unit may answer for it and no single batch sees them all.
  @acceptanceCriteria
    .add({
      situation = `Every batch of a compile has been handled, a verifier is named, --no-verify is not given, and either a batch was accepted or the SHA-256 of the ids of [[Program.criteria]] and [[Program.tests]] of [[Plan.program]] differs from the one the last global review recorded`,
      behavior = `A globalVerifying progress line is printed, then the verifier is [[Process.stream]] once with [[ReviewRequest.instructions]] of [[Generation.globalReview]] of the plan and every source map, recorded or held, as its input, the root as its directory, and ELFIE_ROOT, ELFIE_BATCH set to global, and ELFIE_UNITS set to the stems, space separated, of every unit whose outputs hold a [[Marker]] whose [[Marker.requirement]] is a global id as its environment, each line it writes shown as it arrives and [[Files.append]] to elfie-requests/compile.log under the root; its report is read by [[Generation.reviewOf]]`,
    })
    .add({
      situation = `[[Generation.reviewOf]] reads the verifier's report on the global review`,
      behavior = `elfie-requests/global.reviews.json under the root is [[Files.write]] with the SHA-256 of the global ids reviewed and the [[ReviewReport]], replacing an earlier file, and one globalReviewed progress line follows with the counts of satisfied, violated, and unverifiable reviews`,
    })
    .add({
      situation = `The first global review of a compile holds a violated review`,
      behavior = `One problem per violated review is printed as failure at, a space, global, a colon, a space, [[Review.note]], and [[Review.evidence]] in parentheses; the units whose markers answered for it are planned with reason violated and compiled once more in the same compile, their batches handled as any other, and the global review runs once more after them`,
    })
    .add({
      situation = `The global review run once more in a compile, after the units a violated global review planned were compiled, again holds a violated review`,
      behavior = `The compile stops there; the code is problems, and the next compile plans those units with reason violated`,
    })
    .add({
      situation = `No global criterion or test exists`,
      behavior = `No global review runs and no file is written`,
    });

  // verify
  // Decision: verify is compile without the compiler: the same plan, the same review request, the
  // same verifier, so a person can ask for an opinion on outputs already recorded.
  @acceptanceCriteria
    .add({
      situation = `verify`,
      behavior = `[[Loader.load]] of the root and the source maps of each target read from source-map.json under [[Target.outputDirectory]], dropping any whose output [[Files.exists]] no longer finds; nothing is compiled and no output is written`,
    })
    .add({
      situation = [`verify`, `A target has no source-map.json under its [[Target.outputDirectory]]`],
      behavior = `That target has no source maps`,
    })
    .add({
      situation = [`verify`, `A diagnostic of the loaded program is an error`],
      behavior = `Every error diagnostic is printed and verify ends with the code problems`,
    })
    .add({
      situation = [`verify`, `No diagnostic of the loaded program is an error`, `Stems are given`],
      behavior = `[[Generation.plan]] is made with every stem given as a requested unit`,
    })
    .add({
      situation = [`verify`, `No diagnostic of the loaded program is an error`, `No stem is given`],
      behavior = `[[Generation.plan]] is made with every unit whose [[Unit.outputs]] is not empty requested`,
    })
    .add({
      situation = `verify with --target`,
      behavior = `[[Generation.plan]] is limited to the one target --target names`,
    })
    .add({
      situation = `verify, and a stem given names a unit whose [[Unit.outputs]] is empty`,
      behavior = `It is printed as having nothing to review and left out, and the code does not change for it`,
    })
    .add({
      situation = `verify, elfie.json names a verifier, and --global is not given without a stem`,
      behavior = `For each batch of [[Plan.batches]] holding a requested unit, in plan order, [[Generation.review]] of the plan, the batch, and the source maps is built and the verifier, the command elfie.json names under verifier, is [[Process.stream]] with its [[ReviewRequest.instructions]] as input, the root as its directory, and ELFIE_ROOT, ELFIE_BATCH, and ELFIE_UNITS as its environment; each line it writes is shown as it arrives prefixed by the batch and [[Files.append]] to elfie-requests/compile.log under the root, its report is read by [[Generation.reviewOf]], and [[ReviewReport.reviews]] is [[Files.write]] to elfie-requests/<batch>.reviews.json under the root, replacing an earlier file`,
    })
    .add({
      situation = [
        `verify, elfie.json names a verifier, and --global is not given without a stem`,
        `A run of the verifier on a batch has [[ReviewReport.problems]] not empty, has no line reading ELFIE: REVIEWED, or has [[Process.Exit.code]] -1`,
      ],
      behavior = `That run is made once more`,
    })
    .add({
      situation = `verify with no stem, or with --global, and elfie.json names a verifier`,
      behavior = `After any batches are reviewed, [[Generation.globalReview]] of the plan and the source maps is built and the verifier is [[Process.stream]] once with its [[ReviewRequest.instructions]] as input, the root as its directory, and ELFIE_ROOT, ELFIE_BATCH set to global, and ELFIE_UNITS set to the stems, space separated, of every unit whose outputs hold a [[Marker]] whose [[Marker.requirement]] is a global id as its environment, its report read by [[Generation.reviewOf]], and elfie-requests/global.reviews.json under the root [[Files.write]] with the SHA-256 of the global ids reviewed and the [[ReviewReport]]`,
    })
    .add({ situation = `verify with --global and no stem`, behavior = `No batch is reviewed` })
    .add({
      situation = `verify without --json`,
      behavior = `Each review is printed as its status, a space, [[Review.file]], a colon, [[Review.line]], a space, [[Review.entity]], a colon, a space, and [[Review.note]]`,
    })
    .add({
      situation = `verify`,
      behavior = `After each batch one line gives the counts of satisfied, violated, and unverifiable`,
    })
    .add({
      situation = `verify with --json`,
      behavior = `Each review is printed as [[Json.stringify]] of the [[Review]] on one line`,
    })
    .add({
      situation = [`verify, and elfie.json names a verifier`, `A review is violated`],
      behavior = `The code is problems`,
    })
    .add({
      situation = [`verify, and elfie.json names a verifier`, `The verifier could not be started`],
      behavior = `The code is failure`,
    })
    .add({
      situation = [`verify, and elfie.json names a verifier`, `The verifier was started and no review is violated`],
      behavior = `The code is success`,
    })
    .add({
      situation = `verify, and elfie.json names no verifier`,
      behavior = `The review request of each batch is [[Files.write]] to elfie-requests under the root, named by the batch identifier with the extension .review.md, for a verifier run by hand; the code is success`,
    });

  // lsp, mcp
  @acceptanceCriteria
    .add({ situation = `lsp`, behavior = `Returns [[Lsp.serve]] of the root` })
    .add({ situation = `mcp`, behavior = `Returns [[Mcp.serve]] of the root` });

  @test(
    {
      input = [[`check`, `--root`, string@like(`A root whose def holds a.lfy reading: const y = z;`)]],
      expect = number@like(`1, after printing def/a.lfy:1:10: binder error and the message`),
    },
    {
      input = [[`format`, `--check`, `--root`, string@like(`A root whose def holds a.lfy reading: const   x=1;`)]],
      expect = number@like(`1, after printing def/a.lfy, and the file unchanged`),
    },
    {
      input = [
        [
          `compile`,
          `--dry-run`,
          `--root`,
          string@like(`A root with one target whose marker global carries and one file`),
        ],
      ],
      expect = number@like(`0, after printing one unit with reason fresh and one batch holding it`),
    },
    {
      input = [
        [
          `compile`,
          `--root`,
          string@like(
            `A root with one target, def/a.lfy declaring A with a criterion on line 3, a compiler that writes an output with a marker for A and ends with ELFIE: DONE, and a verifier that writes one review of def/a.lfy line 3 for A with status violated, evidence crates/a/src/a.rs:4-6, and note returns 0 for an empty list, then ELFIE: REVIEWED`,
          ),
        ],
      ],
      expect = number@like(
        `1, after a reviewed line counting 0 satisfied, 1 violated, 0 unverifiable, the problem failure at def/a.lfy:3: returns 0 for an empty list (crates/a/src/a.rs:4-6), a retrying line, the compiler run a second time with that problem appended to its instructions, the verifier run a second time, and the batch rejected`,
      ),
    },
    {
      input = [
        [
          `compile`,
          `--root`,
          string@like(
            `The same root with a verifier that writes one review of def/a.lfy line 3 for A with status satisfied and no ELFIE: REVIEWED line`,
          ),
        ],
      ],
      expect = number@like(
        `0, after the verifier ran twice, a failed line for its second report, a reviewed line counting 1 satisfied, 0 violated, 0 unverifiable, and elfie-requests/a.reviews.json holding that review`,
      ),
    },
    {
      input = [
        [
          `compile`,
          `--no-verify`,
          `--root`,
          string@like(`The same root`),
        ],
      ],
      expect = number@like(`0, after the compiler ran once, no verifier ran, and no reviews file was written`),
    },
    {
      input = [
        [
          `verify`,
          `a`,
          `--root`,
          string@like(
            `The same root with the output for a recorded in source-map.json and a verifier that writes one review of def/a.lfy line 3 for A with status satisfied and note covered by a test, then ELFIE: REVIEWED`,
          ),
        ],
      ],
      expect = number@like(
        `0, after printing satisfied def/a.lfy:3 A: covered by a test, then 1 satisfied, 0 violated, 0 unverifiable, with no compiler run`,
      ),
    },
    {
      input = [
        [
          `verify`,
          `a`,
          `--root`,
          string@like(
            `The same root with the output for a recorded in source-map.json and a verifier that writes one review of def/a.lfy line 3 for A with status violated, evidence src/a.rs:4-6, and note returns 0 for an empty list, then ELFIE: REVIEWED`,
          ),
        ],
      ],
      expect = number@like(
        `1, the problems code, after printing violated def/a.lfy:3 A: returns 0 for an empty list, then 0 satisfied, 1 violated, 0 unverifiable, with no compiler run and elfie-requests/a.reviews.json holding the review`,
      ),
    },
  );
}
