use "elfie/system/process" as Process;
use "elfie/system/time" as Time;

enum Command: `What the command line can do` {
  help = `help`,
  version = `version`,
  init = `init`,
  check = `check`,
  format = `format`,
  tree = `tree`,
  tokens = `tokens`,
  compile = `compile`,
  verify = `verify`,
  lsp = `lsp`,
  mcp = `mcp`,
}

enum ExitCode: `What the process ends with, through [[Process.exit]]` {
  success: `Done, and nothing to report` = 0,
  problems: `Done, and problems were found or outputs rejected` = 1,
  usage: `The arguments could not be read` = 2,
  failure: `Something the command relies on failed` = 3,
}

d Invocation: `One parsed command line` {
  $command: `What to do` = Command;
  $root: `The project directory` = string;
  $arguments: `The positional arguments after the command, in order` = string[];
  $options: `Named options by name without their dashes; true for a flag, the text for a valued option` = object;
}

enum Step: `What a compile is doing, as progress reports it` {
  planned = `the plan is made`,
  requesting = `a batch's request is being assembled`,
  compiling = `the compiler is running on a batch`,
  checking = `the outputs of a unit are being checked`,
  accepted = `a unit was accepted and recorded`,
  rejected = `a unit was rejected`,
  verifying = `the verifier is running on a batch whose units were accepted`,
  reviewed = `the verifier reviewed a batch`,
  retrying = `the compiler is running a batch again with the problems`,
  blocked = `the compiler could not proceed`,
  clarification = `the compiler asked a question`,
  failed = `the compiler command failed`,
  finished = `the compile is over`,
}

d Progress: `One line of what a compile is doing, for a person or a script watching` {
  $step: `What is happening` = Step;
  $batch: `The batch it concerns; undefined for the plan and the end` = string | undefined;
  $unit: `The unit it concerns; undefined when it concerns a whole batch` = string | undefined;
  $done: `Units accepted so far` = number;
  $total: `Units planned` = number;
  $elapsed: `Seconds since the compile began, as [[Time.elapsed]] from its start gives them` = number;
  $message: `The detail: the reason a unit is planned, a problem, a question, the count of batches, or for reviewed the counts of satisfied, violated, and unverifiable reviews, in that order` = string;
}
