use "../generation/data";
use "../query/data";
use "./data";
use "elfie/system/process" as Process;

// Decision: color is decided once per stream, standard output and standard error apart, and every
// piece of text is painted by what it means rather than by a color named where it is printed, so
// the whole CLI reads as one palette and a person scanning a long compile finds the failures by
// their color alone.
// Decision: color never reaches a file, a pipe, JSON, or compile.log, so what a script or an agent
// reads is the same text it read before color existed; only a person at a terminal sees escapes.

enum ColorChoice: `When the CLI colors what it prints; each value is the word --color takes` {
  auto: `Color a stream only when the environment and the stream allow it, as [[colorsOn]] decides` = `auto`,
  always: `Color both streams` = `always`,
  never: `Color neither stream` = `never`,
}

enum Tone: `What a piece of printed text means; its value is the ANSI SGR parameters that color it` {
  success: `Something done or satisfied, in green` = `32`,
  failure: `An error, a rejection, or a violation, in red` = `31`,
  warning: `Something a person must look at that is not an error, in yellow` = `33`,
  active: `Work under way or a name to act on, in cyan` = `36`,
  subject: `What a line is about: a file, a batch, a unit, in bold` = `1`,
  muted: `Detail read only when wanted: counters, times, prefixes, dependencies, in dim` = `2`,
}

// Decision: CLICOLOR_FORCE keeps color on with auto, so a person can keep color through a pager.
/// choice: what --color asked for
/// stream: the stream the text is printed to
fn colorsOn(choice: ColorChoice, stream: Process.Stream): `Whether text printed to one stream is colored` => boolean {
  @acceptanceCriteria
    .add({ situation = `[[choice]] is always`, behavior = `Returns true` })
    .add({ situation = `[[choice]] is never`, behavior = `Returns false` })
    .add({
      situation = [`[[choice]] is auto`, `[[Process.environment]] gives NO_COLOR as any text but the empty one`],
      behavior = `Returns false`,
    })
    .add({
      situation = [`[[choice]] is auto`, `[[Process.environment]] gives TERM as dumb`],
      behavior = `Returns false`,
    })
    .add({
      situation = [
        `[[choice]] is auto`,
        `[[Process.environment]] gives NO_COLOR as undefined or empty`,
        `[[Process.environment]] gives TERM as anything but dumb`,
        `[[Process.environment]] gives CLICOLOR_FORCE as any text but the empty one and 0`,
      ],
      behavior = `Returns true`,
    })
    .add({
      situation = [
        `[[choice]] is auto`,
        `[[Process.environment]] gives NO_COLOR as undefined or empty`,
        `[[Process.environment]] gives TERM as anything but dumb`,
        `[[Process.environment]] gives CLICOLOR_FORCE as undefined, empty, or 0`,
      ],
      behavior = `Returns [[Process.isTerminal]] of [[stream]]`,
    });

  @test(
    { input = [ColorChoice.always, Process.Stream.output], expect = true },
    { input = [ColorChoice.never, Process.Stream.error], expect = false },
    {
      input = [ColorChoice.auto, Process.Stream.output],
      expect = boolean@like(`false while standard output is piped and CLICOLOR_FORCE is not set`),
    },
  );
}

// Decision: the reset always follows painted text, so no color runs past it.
/// text: what is printed
/// tone: what it means
/// on: whether the stream it goes to is colored, as [[colorsOn]] decides
fn paint(text: string, tone: Tone, on: boolean): `Text wrapped in the escapes that color it by its tone, or left as it is` => string {
  @acceptanceCriteria
    .add({
      situation = [`[[on]] is true`, `[[text]] is not empty`],
      behavior = `Returns the escape character, [, the value of [[tone]], m, [[text]], and the escape character, [, 0, m`,
    })
    .add({ situation = `[[on]] is false`, behavior = `Returns [[text]] unchanged` })
    .add({ situation = `[[text]] is empty`, behavior = `Returns [[text]] unchanged` });

  @test(
    { input = [`ok`, Tone.success, true], expect = `\u001b[32mok\u001b[0m` },
    { input = [`ok`, Tone.success, false], expect = `ok` },
    { input = [``, Tone.failure, true], expect = `` },
  );
}

/// text: what is padded, painted or not
/// columns: the width to fill
fn padded(text: string, columns: number): `Text followed by spaces up to a width, so the columns after it line up` => string {
  @acceptanceCriteria
    .add({
      situation = `[[text]] takes fewer than [[columns]] columns`,
      behavior = `Appends spaces until the result takes [[columns]] columns`,
    })
    .add({ situation = `[[text]] takes [[columns]] columns or more`, behavior = `Returns [[text]] unchanged` })
    .add({ behavior = `Each character takes one column, however many bytes it has` })
    .add({
      behavior = `Escape sequences that begin with the escape character and [ and end with m take no columns`,
    });

  @test(
    { input = [`ab`, 4], expect = `ab  ` },
    { input = [`abcdef`, 4], expect = `abcdef` },
    { input = [`\u001b[1mab\u001b[0m`, 4], expect = `\u001b[1mab\u001b[0m  ` },
    { input = [`✓ ok`, 5], expect = `✓ ok ` },
  );
}

/// seconds: a length of time, as [[Progress.elapsed]] holds it
fn duration(seconds: number): `A length of time, short enough to scan in a column` => string {
  @acceptanceCriteria
    .add({
      situation = `[[seconds]] is under 60`,
      behavior = `Returns the seconds to one decimal and s, as 12.3s`,
    })
    .add({
      situation = `[[seconds]] is 60 or more and under 3600`,
      behavior = `Returns the whole minutes, m, the remaining whole seconds as two digits, and s, as 2m05s`,
    })
    .add({
      situation = `[[seconds]] is 3600 or more`,
      behavior = `Returns the whole hours, h, the remaining whole minutes as two digits, and m, as 1h02m`,
    })
    .add({ behavior = `Every part is truncated, never rounded up` });

  @test(
    { input = [0.42], expect = `0.4s` },
    { input = [12.34], expect = `12.3s` },
    { input = [59.99], expect = `59.9s` },
    { input = [125], expect = `2m05s` },
    { input = [3725], expect = `1h02m` },
  );
}

/// step: what a compile is doing
fn toneOf(step: Step): `The tone a progress line of a step is painted in` => Tone {
  @acceptanceCriteria
    .add({
      situation = `[[step]] is [[Step.accepted]], [[Step.reviewed]], or [[Step.globalReviewed]]`,
      behavior = `Returns [[Tone.success]]`,
    })
    .add({ situation = `[[step]] is [[Step.rejected]] or [[Step.failed]]`, behavior = `Returns [[Tone.failure]]` })
    .add({
      situation = `[[step]] is [[Step.retrying]], [[Step.blocked]], or [[Step.clarification]]`,
      behavior = `Returns [[Tone.warning]]`,
    })
    .add({
      situation = `[[step]] is [[Step.requesting]], [[Step.compiling]], [[Step.checking]], [[Step.verifying]], or [[Step.globalVerifying]]`,
      behavior = `Returns [[Tone.active]]`,
    })
    .add({ situation = `[[step]] is [[Step.planned]] or [[Step.finished]]`, behavior = `Returns [[Tone.subject]]` });

  @test(
    { input = [Step.accepted], expect = Tone.success },
    { input = [Step.rejected], expect = Tone.failure },
    { input = [Step.clarification], expect = Tone.warning },
    { input = [Step.compiling], expect = Tone.active },
  );
}

// Decision: each step has a glyph, so the eye finds the outcomes in a long compile without reading.
/// step: what a compile is doing
fn glyphOf(step: Step): `One character that marks a progress line's step` => string {
  @acceptanceCriteria
    .add({ situation = `[[step]] is [[Step.planned]] or [[Step.finished]]`, behavior = `Returns ◆` })
    .add({ situation = `[[step]] is [[Step.requesting]] or [[Step.checking]]`, behavior = `Returns ·` })
    .add({
      situation = `[[step]] is [[Step.compiling]], [[Step.verifying]], or [[Step.globalVerifying]]`,
      behavior = `Returns ▸`,
    })
    .add({
      situation = `[[step]] is [[Step.accepted]], [[Step.reviewed]], or [[Step.globalReviewed]]`,
      behavior = `Returns ✓`,
    })
    .add({ situation = `[[step]] is [[Step.rejected]] or [[Step.failed]]`, behavior = `Returns ✗` })
    .add({ situation = `[[step]] is [[Step.retrying]]`, behavior = `Returns ↻` })
    .add({ situation = `[[step]] is [[Step.blocked]]`, behavior = `Returns ■` })
    .add({ situation = `[[step]] is [[Step.clarification]]`, behavior = `Returns ?` });

  @test(
    { input = [Step.accepted], expect = `✓` },
    { input = [Step.failed], expect = `✗` },
    { input = [Step.compiling], expect = `▸` },
  );
}

/// severity: how bad a diagnostic is
fn severityTone(severity: Severity): `The tone a diagnostic's severity is painted in` => Tone {
  @acceptanceCriteria
    .add({ situation = `[[severity]] is [[Severity.error]]`, behavior = `Returns [[Tone.failure]]` })
    .add({ situation = `[[severity]] is [[Severity.warning]]`, behavior = `Returns [[Tone.warning]]` })
    .add({
      situation = `[[severity]] is [[Severity.information]] or [[Severity.hint]]`,
      behavior = `Returns [[Tone.active]]`,
    });

  @test({ input = [Severity.error], expect = Tone.failure }, { input = [Severity.hint], expect = Tone.active });
}

/// status: what a verifier found
fn statusTone(status: ReviewStatus): `The tone a review's status is painted in` => Tone {
  @acceptanceCriteria
    .add({ situation = `[[status]] is [[ReviewStatus.satisfied]]`, behavior = `Returns [[Tone.success]]` })
    .add({ situation = `[[status]] is [[ReviewStatus.violated]]`, behavior = `Returns [[Tone.failure]]` })
    .add({ situation = `[[status]] is [[ReviewStatus.unverifiable]]`, behavior = `Returns [[Tone.warning]]` });

  @test(
    { input = [ReviewStatus.satisfied], expect = Tone.success },
    { input = [ReviewStatus.violated], expect = Tone.failure },
  );
}

/// reason: why a unit needs generating, or undefined when it is up to date
fn reasonTone(reason: Reason | undefined): `The tone a unit's reason, or up to date, is painted in` => Tone {
  @acceptanceCriteria
    .add({ situation = `[[reason]] is [[Reason.requested]]`, behavior = `Returns [[Tone.active]]` })
    .add({ situation = `[[reason]] is [[Reason.fresh]]`, behavior = `Returns [[Tone.success]]` })
    .add({
      situation = `[[reason]] is [[Reason.changed]], [[Reason.requirements]], or [[Reason.dependency]]`,
      behavior = `Returns [[Tone.warning]]`,
    })
    .add({ situation = `[[reason]] is [[Reason.violated]]`, behavior = `Returns [[Tone.failure]]` })
    .add({ situation = `[[reason]] is undefined`, behavior = `Returns [[Tone.muted]]` });

  @test(
    { input = [Reason.changed], expect = Tone.warning },
    { input = [Reason.violated], expect = Tone.failure },
    { input = [undefined], expect = Tone.muted },
  );
}

// Decision: a count of 0 is muted, so a summary shows at a glance which counts matter.
/// count: how many
/// label: what was counted, as rejected
/// tone: the tone the count is painted in when it is not 0
/// on: whether the stream is colored
fn tally(count: number, label: string, tone: Tone, on: boolean): `A count and what it counts, painted only when it is worth noticing` => string {
  @acceptanceCriteria
    .add({
      situation = `[[count]] is not 0`,
      behavior = `Returns [[paint]] of [[count]], a space, and [[label]], in [[tone]]`,
    })
    .add({
      situation = `[[count]] is 0`,
      behavior = `Returns [[paint]] of [[count]], a space, and [[label]], in [[Tone.muted]]`,
    });

  @test(
    { input = [2, `rejected`, Tone.failure, true], expect = `\u001b[31m2 rejected\u001b[0m` },
    { input = [0, `rejected`, Tone.failure, true], expect = `\u001b[2m0 rejected\u001b[0m` },
    { input = [0, `rejected`, Tone.failure, false], expect = `0 rejected` },
  );
}
