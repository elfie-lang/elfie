use "../grammar/main" as Grammar;
use "../grammar/rules/expression";
use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../grammar/terminals/punctuation";
use "../grammar/traits" as GrammarTraits;
use "../lexer/data";
use "./components";
use "./data";
use "./traits";

fn parse(tokens: Token[], rule: is GrammarTraits.rule = SourceFile): `Turn a token list into a lossless tree for a rule (the whole file by default)` => Tree {
  @acceptanceCriteria
    .add({
      behavior = [
        `[[Tree.tokens]] is [[tokens]] unchanged`,
        `[[Tree.root]] is a node for [[rule]] that covers every token exactly once`,
        `[[Tree.errors]] lists every [[ErrorNode]] in the tree`,
        `A rule is attempted at most once per token index + minimum`,
      ],
    })
    .add({ behavior = `[[rule]] is the rule the caller wants satisfied: [[SourceFile]] for a file, [[Statement]] to reparse one statement, [[Expression]] for a snippet`, })
    .add({
      situation = `Tokens are left over after [[rule]] is satisfied`,
      behavior = `They become one [[ErrorNode]] at the end of the root`,
    })
    .add({
      situation = [
        `[[rule]] is an [[alternationList]]`,
        `Tokens are left over or trivia precedes the item`,
      ],
      behavior = `[[Tree.root]] is a node for [[rule]] holding the trivia, the item, and the [[ErrorNode]]`,
    });

  // The grammar document is the only grammar the parser knows
  const grammar: `EBNF of every rule` = Grammar.grammarDocument();
  @acceptanceCriteria
    .add({
      behavior = [
        `Reads a bare name inside a rule as the rule with that identifier`,
        `Reads the categories and [[GrammarTraits.binding]] from the rules and sets none of them`,
        `Parses against the following rules only: \n\n {{grammar}}`,
      ],
    });

  // Rules
  @acceptanceCriteria
    .add({ situation = `A [[terminal]] is referenced`, behavior = `It is satisfied by one token whose [[Token.rule]] is that terminal`, })
    .add({ situation = `Any other rule is referenced`, behavior = `It is satisfied by a node whose children are what its elements produced, in order`, })
    .add({
      situation = [
        `Tokens of a [[trivia]] rule sit between two elements`,
        `No special handling rules exist for that trivia with the surrounding tokens`,
      ],
      behavior = `They are taken as children of the open node`,
    })
    .add({ situation = `A token without a [[Token.rule]] sits between two elements`, behavior = `It is taken as an [[ErrorNode]] of one token`, });

  // Selection
  @acceptanceCriteria
    .add({ situation = `[[Statement]] is referenced`, behavior = `The candidates are [[GrammarTraits.statement@entities]]`, })
    .add({ situation = `[[Expression]] is referenced`, behavior = `The candidates are [[GrammarTraits.primary@entities]] and [[GrammarTraits.prefix@entities]]`, })
    .add({
      situation = [
        `An alternation inside a rule's syntax is reached`,
        `At least one alternative is not a [[GrammarTraits.primary]], [[GrammarTraits.prefix]], [[GrammarTraits.infix]], or [[GrammarTraits.postfix]] rule`,
        `The alternation is not the syntax of [[Statement]] or [[Expression]]`,
      ],
      behavior = `The candidates are its alternatives`,
    })
    .add({ behavior = `The next token that is not [[trivia]] selects every candidate it can begin`, })
    .add({ situation = `One candidate is selected for the next token`, behavior = `That candidate is tried`, })
    .add({ situation = `More than one candidate is selected for the next token`, behavior = `They are tried in [[triedBefore]] order, each only when the one before it fails there`, })
    .add({
      situation = `Every alternative of an alternation is a [[GrammarTraits.primary]], [[GrammarTraits.prefix]], [[GrammarTraits.infix]], or [[GrammarTraits.postfix]] rule`,
      behavior = [
        `The alternation is satisfied by one [[Expression]] parsed with a minimum one below the lowest binding power among its [[GrammarTraits.infix]] and [[GrammarTraits.postfix]] alternatives, or 0 when it has none`,
        `That [[Expression]] begins with one of the alternation's [[GrammarTraits.primary]] or [[GrammarTraits.prefix]] alternatives`,
        `The rule of the node that [[Expression]] produces is one of the alternatives`,
        `No candidate is selected among the alternatives, and [[triedBefore]] does not order them`,
      ],
    })
    .add({
      situation = `An optional element is reached`,
      behavior = [
        `It is tried when the next token that is not [[trivia]] can begin it, and skipped otherwise`,
        `When it fails it is skipped; a later failure never revisits the choice`,
      ],
    })
    .add({
      situation = `A repetition is reached`,
      behavior = `Another iteration is tried while the next token that is not [[trivia]] can begin the repeated element; an iteration that fails leaves its tokens and ends the repetition`,
    });

  // Expressions
  @acceptanceCriteria
    .add({ behavior = `Operands and tail expressions of an operation are parsed with that operation's power as the minimum`, })
    .add({ situation = `An operation's power is greater than the minimum in force, or equal to it with right associativity`, behavior = `The operation applies to the left operand`, })
    .add({ situation = `An [[Expression]] is an element of a rule that is not an operation, or follows [[GroupOpen]] or [[ListOpen]]`, behavior = `It is parsed with minimum 0`, });

  // Errors
  @acceptanceCriteria
    .add({ situation = `A [[recoverable]] rule cannot continue after taking a token, or the input ends inside it`, behavior = `It closes with an [[ErrorNode]] as that component says`, })
    .add({ situation = `A rule without [[recoverable]] cannot be satisfied`, behavior = `It produces nothing and leaves its tokens to the rule that referenced it`, });

  @test(
    {
      input = [[], Expression],
      expect = Tree@like(`An [[Expression]] root covering no token and having no children`),
    },
    {
      input = [Token[]@like(`The lexing of: a - b - c`), Expression],
      expect = Tree@like(`An [[AdditiveOperation]] root whose left operand is the [[AdditiveOperation]] of a and b and whose right operand is c; no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: -a ** b`), Expression],
      expect = Tree@like(`A [[PowerOperation]] root whose left operand is the [[NegateOperation]] of a and whose right operand is b, because [[NegateOperation]] binds tighter than [[Power]]`),
    },
    {
      input = [Token[]@like(`The lexing of: x : T = 1`), Expression],
      expect = Tree@like(`An [[Assignment]] root whose left side is the [[Definition]] of x as T and whose right side is 1, because [[Definition]] binds tighter than a [[setter]]`),
    },
    {
      input = [Token[]@like(`The lexing of: a ? b : c ? e : f`), Expression],
      expect = Tree@like(`A [[Conditional]] root testing a, yielding b, and otherwise yielding a nested [[Conditional]] that tests c`),
    },
    {
      input = [[]],
      expect = Tree@like(`A [[SourceFile]] root with no children, covering no token, and no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: use "../grammar/main" as Grammar;`)],
      expect = Tree@like(`A [[SourceFile]] root holding one [[Use]] whose children are the use keyword, a [[StringLiteral]] holding the [[DoubleQuoteString]], the as keyword, the identifier Grammar, and the semicolon; no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: if (a) { b; } else c;`)],
      expect = Tree@like(`A [[SourceFile]] root holding one [[If]] whose condition is a [[Group]] around a, whose branch is a [[Block]] holding the [[ExpressionStatement]] b, and whose [[Else]] holds the [[ExpressionStatement]] c; no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: for (const x in list) { }`)],
      expect = Tree@like(`A [[SourceFile]] root holding one [[For]] with the constant [[Declared]] x, a [[ForInOf]] over list, and an empty [[Block]]; no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: (x: string, tail?: string) => x;`)],
      expect = Tree@like(`A [[SourceFile]] root holding one [[ExpressionStatement]] whose expression is an [[InlineFunction]] with two [[Parameter]] items, the [[DefinitionClause]] of x as string and the [[DefinitionClause]] of the [[QuestionMark]] tail as string, and the body x; no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: \`a\{{b\}}\[[c.e\]]\`;`)],
      expect = Tree@like(`A [[SourceFile]] root holding one [[ExpressionStatement]] whose expression is a [[Template]] with a body token, a [[TemplateExecution]] holding the [[Name]] b, and a [[TemplateReference]] holding the [[Member]] e of c; no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: const = 1; let y = 2;`)],
      expect = Tree@like(`A [[SourceFile]] root holding a [[VariableDeclaration]] whose expression is an [[ErrorNode]] covering = 1 with [[ErrorNode.expected]] [[Identifier]], followed by a complete [[VariableDeclaration]] of y; one error`),
    },
  );

  // Rule Beginning
  @acceptanceCriteria
    .add({ situation = `The rule is an [[GrammarTraits.infix]] or [[GrammarTraits.postfix]]`, behavior = `It can begin with no terminal; it continues an expression`, })
    .add({
      situation = `The rule is not an [[GrammarTraits.infix]] or [[GrammarTraits.postfix]]`,
      behavior = [
        `It can begin with a terminal when a token of that terminal can be the first token it covers`,
        `Its syntax is followed through references, through every alternative, and past every element that can be satisfied without taking a token`,
      ],
    })
    .add({ behavior = `[[trivia]] tokens and tokens without a [[Token.rule]] never begin a rule; the next token is read past them`, });

  for (const rule in GrammarTraits.statement@entities, GrammarTraits.primary@entities, GrammarTraits.prefix@entities) {
    where (`A statement or expression begins`) and (`The next token that is not [[trivia]] has a [[Token.rule]] that [[&rule]] can begin with`) -> `[[&rule]] is tried`;
  }
  for (const rule in GrammarTraits.infix@entities, GrammarTraits.postfix@entities) {
    where (`The next token is the operator of [[&rule]] and its binding power continues the expression`) -> `A node for [[&rule]] is built from the left operand, the operator, and what follows`;
  }
}

global@acceptanceCriteria
  .add({
    behavior = [
      `For every terminal, the statement rules it can begin are completely ordered by [[triedBefore]]`,
      `For every terminal, the primary and prefix rules it can begin are completely ordered by [[triedBefore]]`,
      `For every terminal and every alternation inside a rule's syntax, the alternatives it can begin are completely ordered by [[triedBefore]]`,
      `Every alternative of an alternation inside a rule's syntax that shares a first terminal with another alternative of that alternation is a single rule reference`,
    ],
    sideEffects = [
      `[[parse]] cannot be compiled unless [[triedBefore]] covers all necessary information`,
      `Every failing terminal or alternation is reported with the candidates it selects as a compile time error`,
    ],
  });
