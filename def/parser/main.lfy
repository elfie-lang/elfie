use "../grammar/main" as Grammar;
use "../grammar/rules/expression";
use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../grammar/terminals/punctuation";
use "../grammar/traits" as GrammarTraits;
use "../lexer/data";
use "./data";
use "./traits";

/// tokens: the tokens of one file or snippet, as the lexer delivered them
/// rule: the rule to satisfy: [[SourceFile]] for a file, [[Statement]] to reparse one statement, [[Expression]] for a snippet
fn parse(tokens: Token[], rule: is GrammarTraits.rule = SourceFile): `Turn a token list into a lossless tree for a rule (the whole file by default)` => Tree {
  @acceptanceCriteria
    .add({ behavior = `[[Tree.tokens]] is [[tokens]] unchanged` })
    .add({ behavior = `[[Tree.root]] is a node for [[rule]] that covers every token exactly once` })
    .add({ behavior = `A rule is attempted at most once per token index + minimum` })
    .add({
      situation = `[[tokens]] parse with no [[ErrorNode]]`,
      behavior = `The call ends in time linear in the number of [[tokens]]`,
    })
    .add({
      situation = `Tokens are left over after [[rule]] is satisfied`,
      behavior = `They become one [[ErrorNode]] at the end of the root`,
    });

  // The grammar document is the only grammar the parser knows
  const grammar: `EBNF of every rule` = Grammar.grammarDocument();
  @acceptanceCriteria
    .add({ behavior = `Reads a bare name inside a rule as the rule with that identifier` })
    .add({ behavior = `Reads the categories and [[GrammarTraits.binding]] from the rules and sets none of them` })
    .add({ behavior = `Parses against the following rules only: \n\n {{grammar}}` });

  // Rules
  @acceptanceCriteria
    .add({
      situation = `A [[GrammarTraits.terminal]] is referenced`,
      behavior = `It is satisfied by one token whose [[Token.rule]] is that terminal`,
    })
    .add({
      situation = `A rule that is not a [[GrammarTraits.terminal]] is referenced`,
      behavior = `It is satisfied by a node whose children are what its elements produced, in order`,
    })
    .add({
      situation = `A token without a [[Token.rule]] sits between two elements`,
      behavior = `It is taken as an [[ErrorNode]] of one token`,
    });

  // Selection
  @acceptanceCriteria
    .add({
      situation = `[[Statement]] is referenced`,
      behavior = `The candidates are [[GrammarTraits.statement@entities]]`,
    })
    .add({
      situation = `[[Expression]] is referenced`,
      behavior = `The candidates are [[GrammarTraits.primary@entities]] and [[GrammarTraits.prefix@entities]]`,
    })
    .add({
      situation = [
        `An alternation inside a rule's syntax is reached`,
        `At least one alternative is not a [[GrammarTraits.primary]], [[GrammarTraits.prefix]], [[GrammarTraits.infix]], or [[GrammarTraits.postfix]] rule`,
        `The alternation is not the syntax of [[Statement]] or [[Expression]]`,
      ],
      behavior = `The candidates are its alternatives`,
    })
    .add({ behavior = `The next token that is not [[trivia]] selects every candidate it can begin` })
    .add({
      behavior = [
        `Choice is ordered (PEG): the first alternative that matches is taken`,
        `Later alternatives are never tried for that span`,
      ],
    })
    .add({
      behavior = `The alternatives of a choice among candidates are the selected candidates, in [[triedBefore]] order`,
    })
    .add({
      behavior = `A later failure never revisits a choice, including whether an optional element was taken and how many iterations a repetition took`,
    })
    .add({
      situation = [
        `Every alternative of an alternation is a [[GrammarTraits.primary]], [[GrammarTraits.prefix]], [[GrammarTraits.infix]], or [[GrammarTraits.postfix]] rule`,
        `At least one alternative of the alternation is a [[GrammarTraits.infix]] or [[GrammarTraits.postfix]] rule`,
      ],
      behavior = `The [[Expression]] that satisfies the alternation is parsed with a minimum one below the lowest binding power among its [[GrammarTraits.infix]] and [[GrammarTraits.postfix]] alternatives`,
    })
    .add({
      situation = [
        `Every alternative of an alternation is a [[GrammarTraits.primary]], [[GrammarTraits.prefix]], [[GrammarTraits.infix]], or [[GrammarTraits.postfix]] rule`,
        `No alternative of the alternation is a [[GrammarTraits.infix]] or [[GrammarTraits.postfix]] rule`,
      ],
      behavior = `The [[Expression]] that satisfies the alternation is parsed with minimum 0`,
    })
    .add({
      situation = `Every alternative of an alternation is a [[GrammarTraits.primary]], [[GrammarTraits.prefix]], [[GrammarTraits.infix]], or [[GrammarTraits.postfix]] rule`,
      behavior = [
        `The alternation is satisfied by one [[Expression]]`,
        `That [[Expression]] begins with one of the alternation's [[GrammarTraits.primary]] or [[GrammarTraits.prefix]] alternatives`,
        `The rule of the node that [[Expression]] produces is one of the alternatives`,
        `No candidate is selected among the alternatives`,
        `[[triedBefore]] does not order the alternatives`,
      ],
    })
    .add({
      situation = `An optional element is reached`,
      behavior = `It is a choice between the element and nothing, in that order`,
    })
    .add({
      situation = `A repetition is reached`,
      behavior = `It is greedy: it stops only at the first iteration whose element does not match`,
    })
    .add({
      situation = [
        `A repetition stops`,
        `Its rule is not [[recoverable]], an element after the repetition can begin with the next token that is not [[trivia]], or the input has ended`,
      ],
      behavior = `The repetition ends`,
    });

  // Expressions: precedence climbing over binding power
  @acceptanceCriteria
    .add({
      behavior = `Operations are grouped by precedence climbing: an operation takes the expression on its left as its left operand only when its power is greater than the minimum in force, or equal to it with right associativity`,
    })
    .add({
      situation = `An operand or tail expression of an operation does not follow [[GroupOpen]] or [[ListOpen]]`,
      behavior = `Its minimum is that operation's power`,
    })
    .add({
      situation = `An [[Expression]] is an element of a rule that is not an operation, or follows [[GroupOpen]] or [[ListOpen]]`,
      behavior = `Its minimum is 0`,
    })
    .add({
      situation = `The next token is the operator of a [[GrammarTraits.postfix]] rule and of a [[GrammarTraits.infix]] rule, as [[LessThan]] is of [[Generic]] and of [[RelationalOperation]]`,
      behavior = `Source that the postfix rule matches is read as the postfix rule and never as the infix rule`,
    })
    .add({
      situation = `A criterion of an operation makes it no match when the expression is parsed for a particular rule, as [[Generic]] is no match for [[Reference]]`,
      behavior = `An attempt for that rule is distinct from an attempt at the same token index and minimum for another rule`,
    });

  // Errors
  @acceptanceCriteria
    .add({
      situation = [`A rule cannot be satisfied`, `The rule is not [[recoverable]], or it has taken no token`],
      behavior = `It does not match, and takes no token`,
    });

  @test(
    {
      input = [[], Expression],
      expect = Tree@like(`An [[Expression]] root covering no token and having no children`),
    },
    {
      input = [Token[]@like(`The lexing of: a - b - c`), Expression],
      expect = Tree@like(
        `An [[AdditiveOperation]] root whose left operand is the [[AdditiveOperation]] of a and b and whose right operand is c; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: a + b * c`), Expression],
      expect = Tree@like(
        `An [[AdditiveOperation]] root whose left operand is a and whose right operand is the [[MultiplicativeOperation]] of b and c; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: a * b + c`), Expression],
      expect = Tree@like(
        `An [[AdditiveOperation]] root whose left operand is the [[MultiplicativeOperation]] of a and b and whose right operand is c; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: a ** b ** c`), Expression],
      expect = Tree@like(
        `A [[PowerOperation]] root whose left operand is a and whose right operand is the [[PowerOperation]] of b and c, because [[Power]] is right associative; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: f(x) + 1`), Expression],
      expect = Tree@like(
        `An [[AdditiveOperation]] root whose left operand is the [[Call]] of f whose [[Items]] hold x, and whose right operand is 1; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: -1`), Expression],
      expect = Tree@like(`A [[NegateOperation]] root whose operand is the [[Number]] 1; no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: x = - 1;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding an [[ExpressionStatement]] of the [[Name]] x whose [[ErrorNode]] covers = - 1 with [[ErrorNode.expected]] [[Semicolon]], because a space after [[Minus]] keeps it from being a [[NegateOperation]]; one error`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: a b`), Expression],
      expect = Tree@like(
        `An [[Expression]] root holding the [[Name]] a and then an [[ErrorNode]] covering b; one error`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: -a ** b`), Expression],
      expect = Tree@like(
        `A [[PowerOperation]] root whose left operand is the [[NegateOperation]] of a and whose right operand is b, because [[NegateOperation]] binds tighter than [[Power]]`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: x : T = 1`), Expression],
      expect = Tree@like(
        `An [[Assignment]] root whose left side is the [[Definition]] of x as T and whose right side is 1, because [[Definition]] binds tighter than a [[GrammarTraits.setter]]`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: a < b > c`), Expression],
      expect = Tree@like(
        `A [[RelationalOperation]] root whose left operand is the [[RelationalOperation]] of a and b and whose right operand is c, because the identifier c cannot follow a [[Generic]]; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: f<string>(x)`), Expression],
      expect = Tree@like(
        `A [[Call]] root whose left operand is the [[Generic]] of f with the one type argument string and whose [[Items]] hold x; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: a ? b : c ? e : f`), Expression],
      expect = Tree@like(
        `A [[Conditional]] root testing a, yielding b, and otherwise yielding a nested [[Conditional]] that tests c`,
      ),
    },
    {
      input = [[]],
      expect = Tree@like(`A [[SourceFile]] root with no children, covering no token, and no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: use "../grammar/main" as Grammar;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[Use]] whose children are the use keyword, a [[StringLiteral]] holding the [[DoubleQuoteString]], the as keyword, the identifier Grammar, and the semicolon; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: if (a) { b; } else c;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[If]] whose condition is a [[Group]] around a, whose branch is a [[Block]] holding the [[ExpressionStatement]] b, and whose [[Else]] holds the [[ExpressionStatement]] c; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: for (const x in list) { }`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[For]] with the constant [[Declared]] x, a [[ForInOf]] over list, and an empty [[Block]]; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: (x: string, tail?: string) => x;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[ExpressionStatement]] whose expression is an [[InlineFunction]] with two [[Parameter]] items, the [[DefinitionClause]] of x as string and the [[DefinitionClause]] of the [[QuestionMark]] tail as string, and the body x; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: \`a\{{b\}}\[[c.e\]]\`;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[ExpressionStatement]] whose expression is a [[Template]] with a body token, a [[TemplateExecution]] holding the [[Name]] b, and a [[TemplateReference]] holding the [[Member]] e of c; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: const = 1; let y = 2;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding a [[VariableDeclaration]] whose expression is an [[ErrorNode]] covering = 1 with [[ErrorNode.expected]] [[Identifier]] and no [[ErrorNode.keyword]], followed by a complete [[VariableDeclaration]] of y; one error`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: const d = 1;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding a [[VariableDeclaration]] whose [[ErrorNode]] covers d = 1 with [[ErrorNode.expected]] [[Identifier]] and [[ErrorNode.keyword]] the token d; one error`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: x = c ?? d;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding an [[ExpressionStatement]] whose [[ErrorNode]] covers ?? d with [[ErrorNode.keyword]] the token d; one error`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: const = f(a; b); let y = 2;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding a [[VariableDeclaration]] whose [[ErrorNode]] covers = f(a; b), past the [[Semicolon]] inside the parentheses, followed by a complete [[VariableDeclaration]] of y; one error`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: let # y = 1; where # is a token without a [[Token.rule]]`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[VariableDeclaration]] of y whose [[ErrorNode]] covers the token # alone, between the let keyword and the [[Declared]] y; one error`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: { a = 1 };`)],
      expect = Tree@like(
        `A [[SourceFile]] root whose first statement is a [[Block]], not an [[Object]], holding an [[ExpressionStatement]] of the [[Assignment]] a = 1 whose [[ErrorNode]] expects [[Semicolon]], followed by an [[ErrorNode]] covering the [[Semicolon]] after the block; two errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: d A: (a) => b;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[DataDeclaration]] whose [[DefinitionClause]] holds a [[FunctionType]] with the [[Parameters]] a and the return type b, not a [[TypeGroup]]; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: x. is T;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[ExpressionStatement]] of a [[Traits]] whose left expression is the [[Member]] x. with no [[MemberName]], because a space follows the [[ValueAccessor]]; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: /// doc, a new line, // note, a new line, d A {}`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[DataDeclaration]] of A whose [[Node.documentation]] holds the [[Documentation]] /// doc, with the [[Comment]] between them; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: d List<T>;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[DataDeclaration]] of List whose [[TypeParameters]] hold the one [[TypeParameter]] T; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: fn map<T, U>(list: List<T>, transform: (item: T) => U) => List<U>;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[AgentFunctionDeclaration]] whose [[Signature]] is map with the [[TypeParameters]] T and U and two [[Parameter]] items, list typed as the [[TypeItem]] List with the [[TypeArguments]] T and transform typed as the [[FunctionType]] from item of T to U, and whose return type is the [[TypeItem]] List with the [[TypeArguments]] U; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: d A: List<List<T>>;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[DataDeclaration]] whose [[DefinitionClause]] holds the [[TypeItem]] List whose [[TypeArguments]] hold the [[TypeItem]] List with the [[TypeArguments]] T, each [[GreaterThan]] closing one list; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: $items = List<T>;`)],
      expect = Tree@like(
        `A [[SourceFile]] root holding one [[ExpressionStatement]] of an [[Assignment]] whose right side is the [[Generic]] of the [[Name]] List with the type argument T; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: a < b`), Expression],
      expect = Tree@like(`A [[RelationalOperation]] root of a and b; no errors`),
    },
    {
      input = [Token[]@like(`The lexing of: List<T>=x`), Expression],
      expect = Tree@like(
        `A [[RelationalOperation]] root on [[GreaterThanOrEqual]] whose left operand is the [[RelationalOperation]] of List and T and whose right operand is x, not a [[Generic]]; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: x.f<T>(y)`), Expression],
      expect = Tree@like(
        `A [[Call]] root whose left expression is the [[Generic]] of the [[Member]] f of x with the type argument T, and whose [[Items]] hold y; no errors`,
      ),
    },
    {
      input = [Token[]@like(`The lexing of: a + f<T>(x)`), Expression],
      expect = Tree@like(
        `An [[AdditiveOperation]] root whose left operand is a and whose right operand is the [[Call]] of the [[Generic]] of f with the type argument T; no errors`,
      ),
    },
  );

  // Rule Beginning
  // Decision: an infix or postfix rule continues an expression, so it never begins one.
  @acceptanceCriteria
    .add({
      situation = `The rule is an [[GrammarTraits.infix]] or [[GrammarTraits.postfix]]`,
      behavior = `It can begin with no terminal`,
    })
    .add({
      situation = [
        `The rule is not an [[GrammarTraits.infix]] or [[GrammarTraits.postfix]]`,
        `A token of a terminal can be the first token it covers`,
      ],
      behavior = `It can begin with that terminal`,
    })
    .add({ behavior = `No [[trivia]] token and no token without a [[Token.rule]] begins a rule` });
}
