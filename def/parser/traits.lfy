use "../grammar/terminals/comment";
use "../grammar/terminals/literal";
use "../grammar/terminals/punctuation";
use "../grammar/traits";
use "./data";

ace const brackets: `Token pairs that nest, with the first token opening and the second closing` = [
  [GroupOpen, GroupClose],
  [ListOpen, ListClose],
  [BlockOpen, BlockClose],
  [ExecutionOpen, ExecutionClose],
  [ReferenceOpen, ReferenceClose],
];

with brackets {
  @acceptanceCriteria
    .add({
      behavior = `A token is at the same [[brackets]] depth as the first token an [[ErrorNode]] covers when every bracket pair opened between the two tokens, that first token included, also closes between them`,
    });
}

ace function listed(rules: (is rule)[]) {
  return rules.map((rule) => `[[&rule]]`).join(`, `);
}

trait trivia: `Has little to no semantic meaning` {
  where (`Tokens satisfying {{@identifier}} sit between two elements of a rule that references no [[body]] terminal`) and (`No explicit exception is given in the tokens for how to handle {{@identifier}}`) -> `They become children of that rule's node and satisfy no element`;
}

trait documented: `Attaches the [[Documentation]] written for it` {
  $documentation: `The [[Documentation]] nodes that precede this node with only [[trivia]] between; empty when there are none` = Node[];
}

trait triedBefore(other: is rule): `Comes ahead of another rule in the order of choice wherever both could begin at the same token` {
  where (`Source reads as both {{@identifier}} and [[&other]] from the same token`) -> `It is read as {{@identifier}}`;
}

trait recoverable(...sync: (is terminal)[]): `Closes with an error node instead of failing once it has taken a token` {
  where (`A required element of {{@identifier}} cannot be satisfied after the rule has taken a token`) and (`A later token is one of {{listed(
    sync,
  )}} at the same [[brackets]] depth`) -> `An [[ErrorNode]] naming the terminals that could begin the element in [[ErrorNode.expected]] covers the tokens up to the next {{listed(
    sync,
  )}} at the same [[brackets]] depth; the remaining elements are then tried there as if optional`;
  where (`A required element of {{@identifier}} cannot be satisfied after the rule has taken a token`) and (`No later token is one of {{listed(
    sync,
  )}} at the same [[brackets]] depth`) -> `An [[ErrorNode]] naming the terminals that could begin the element in [[ErrorNode.expected]] covers the tokens up to the end of the input; the remaining elements are then tried there as if optional`;
  where (`An [[ErrorNode]] of {{@identifier}} is covering tokens up to a later token`) and (`A closing token of [[brackets]] closes a bracket opened before the first token the [[ErrorNode]] covers`) -> `The [[ErrorNode]] ends before it, as if it were one of {{listed(
    sync,
  )}}`;
  where (`A repetition of {{@identifier}} stops on one of {{listed(sync)}} that no element after the repetition can begin with`) -> `An [[ErrorNode]] covers that token alone, and the repetition continues after it`;
  where (`A repetition of {{@identifier}} stops on a token that no element after the repetition can begin with and that is not one of {{listed(
    sync,
  )}}`) -> `An [[ErrorNode]] covers that token and the tokens after it up to the next token that begins the repeated element, begins an element after the repetition, or is one of {{listed(
    sync,
  )}}; the repetition continues there`;
  @acceptanceCriteria.add({ behavior = `[[ErrorNode.expected]] follows its definition in every case` });
}
