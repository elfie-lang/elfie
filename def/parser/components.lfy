use "../grammar/rules/expression";
use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../grammar/terminals/comment";
use "../grammar/terminals/literal";
use "../grammar/terminals/punctuation";
use "../grammar/terminals/space";
use "../grammar/traits";
use "./main";
use "./traits";

// Trivia
trivia.apply(Space);
trivia.apply(NewLine);
trivia.apply(Comment);
trivia.apply(Documentation);

// Every statement can have documentation and should be recoverable
for (const rule in statement@entities) {
  documented.apply(rule);
  recoverable.apply(rule, Semicolon, BlockOpen, BlockClose);
}
recoverable.apply(SourceFile, Semicolon, BlockOpen, BlockClose);

// Narrower recovery
recoverable.apply(Parameters, GroupClose);
recoverable.apply(Arguments, GroupClose);
recoverable.apply(Call, GroupClose);
recoverable.apply(List, ListClose);
recoverable.apply(Index, ListClose);
recoverable.apply(TemplateReference, ReferenceClose);
recoverable.apply(TemplateExecution, ExecutionClose);

// What to try for first when things begin with the same token
triedBefore.apply(Block, Expression, ExpressionStatement);
triedBefore.apply(FunctionDeclaration, ExpressionStatement);
triedBefore.apply(TraitDeclaration, ExpressionStatement);
triedBefore.apply(Object, Type);
triedBefore.apply(TypeValue, TypeGroup);
triedBefore.apply(InlineFunction, Group);
triedBefore.apply(ConditionGroup, Group);

global
  @acceptanceCriteria
  .add({ behavior = `For every terminal, the statement rules it can begin are completely ordered by [[triedBefore]]` })
  .add({
    behavior = `For every terminal, the primary and prefix rules it can begin are completely ordered by [[triedBefore]]`,
  })
  .add({
    behavior = `For every terminal and every alternation inside a rule's syntax, the alternatives it can begin are completely ordered by [[triedBefore]]`,
  })
  .add({
    situation = `A terminal or an alternation can begin candidates that [[triedBefore]] does not completely order`,
    behavior = [
      `[[parse]] is not compiled`,
      `A compile time error names the terminal or alternation and the candidates it selects`,
    ],
  });
