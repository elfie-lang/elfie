use "./precedence";

// Rule definitions
type Rule: `EBNF form of one grammar rule` {
  identifier: `Name of the rule` = string,
  syntax: `Right hand side of the rule in ISO EBNF` = string,
  text: `The whole rule line` = string,
}

trait rule(syntax: string): `A grammar rule` {
  $rule: `EBNF form of this rule` = Rule;
  .rule = {
    identifier = @identifier,
    syntax = syntax,
    text = `{{@identifier}} = {{syntax}} ;`,
  };

  @acceptanceCriteria
    .add({ behavior = `Is satisfied by source that matches {{.rule.text}}` })
    .add({
      behavior = `The written order of alternatives inside [[syntax]] does not decide which alternative is chosen`,
    });
}

// Helper functions

/// items: the rules referenced, in order
/// separator: what is written between two references
ace function alternation(items: (is rule)[], separator: string = ` | `): `A reference to each of [[items]], joined by [[separator]]` -> string {
  return items.map((item) => `[[&item]]`).join(separator);
}

/// text: the characters the terminal matches
ace function quoted(text: string): `[[text]] as an EBNF terminal string, in single quotes when it holds a double quote and in double quotes otherwise` -> string {
  return text.includes('"')? `'{{text}}'`: `"{{text}}"`;
}

/// excluded: the rules whose characters end the body
/// escapes: the escapes the body accepts
ace function bodySyntax(excluded: (is rule)[], escapes: (is escape)[]): `The EBNF of a body: any number of characters that are not [[excluded]], or of [[escapes]]` -> string {
  const plain = `( Character - ( {{alternation(excluded)}} ) )`;
  return alternation(escapes) == ``? `(: {{plain}} :)`: `(: {{plain}} | {{alternation(escapes)}} :)`;
}

// Terminals
trait terminal(syntax: string) extends rule(syntax): `A rule matched against characters and delivered as a single token` {
  @acceptanceCriteria.add({ behavior = `The token created for it records this rule` });
}

trait keyword(text: string) extends terminal(quoted(text)): `A word with fixed meaning in the grammar` {
  @acceptanceCriteria.add({ behavior = `{{text}} cannot be an identifier` });
}

trait reserved(text: string) extends keyword(text): `A keyword no rule uses yet` {}

trait punctuation(text: string) extends terminal(quoted(text)): `Punctuation with specific meaning` {}
trait setter(text: string) extends punctuation(text), binding(Level.assignment, 'right'): `Assigns, possibly after combining with the current value` {}
trait relational(text: string) extends punctuation(text), binding(Level.relational): `Orders two values` {}
trait equality(text: string) extends punctuation(text), binding(Level.equality): `Compares two values` {}
trait additive(text: string) extends punctuation(text), binding(Level.additive): `Adds or subtracts` {}
trait multiplicative(text: string) extends punctuation(text), binding(Level.multiplicative): `Multiplies or divides` {}

trait boundary(text: string) extends terminal(quoted(text)): `A symbol that opens or closes a region whose contents are text rather than code` {}

trait escape(syntax: string, becomes: string) extends terminal(syntax): `A sequence inside a text body that stands for other characters` {
  where (`Matched inside a body that lists this escape`) -> `Its characters are replaced by {{becomes}} in the token value`;
  @acceptanceCriteria.add({
    behavior = `It is matched only inside a [[body]] that lists it, never as a token of its own`,
  });
}

trait body(excluded: (is rule)[], escapes: (is escape)[] = []) extends terminal(bodySyntax(excluded, escapes)): `Text between boundaries: any character except the excluded ones, plus the listed escapes` {
  @acceptanceCriteria.add({ situation = `Matches no characters at all`, behavior = `No token is created` });
}

// Binding power
trait binding(precedence: number, associativity: 'left' | 'right' | null = 'left'): `How tightly an operator, or a rule that overrides its operator, groups with its neighbors` {
  $precedence: `Binding power; a higher value binds tighter` = precedence@type;
  .precedence = precedence;
  $associativity: `How two of the same precedence group: left, right, or not at all (null)` = associativity@type;
  .associativity = associativity;

  match .associativity {
    'left' -> @acceptanceCriteria.add({ behavior = `a b c reads as (a b) c` }),
    'right' -> @acceptanceCriteria.add({ behavior = `a b c reads as a (b c)` }),
    null -> @acceptanceCriteria.add({ behavior = `a b c is not valid` }),
  }
}

// Categories/groupings
trait alternationList(...items: (is rule)[]) extends rule(alternation(items)): `A set of rules, any one of which satisfies this rule` {
  @acceptanceCriteria.add({ behavior = `No token records {{@identifier}} as its rule` });
}

trait statement(syntax: string) extends rule(syntax): `A rule that is or can be a top level statement` {}

trait primary(syntax: string) extends rule(syntax): `An expression rule that begins with its own token` {}

trait prefix(operator: is rule) extends rule(`[[&operator]] , [[Expression]]`): `An operator followed by the expression it applies to` {
  @acceptanceCriteria
    .add({
      situation = `{{@identifier}} has no [[binding]]`,
      behavior = `Binds as the token that satisfied [[operator]] does`,
    });
}

trait infix(operator: is rule) extends rule(`[[Expression]] , [[&operator]] , [[Expression]]`): `Two expressions joined by an operator` {
  @acceptanceCriteria
    .add({
      situation = `{{@identifier}} has no [[binding]]`,
      behavior = `Binds as the token that satisfied [[operator]] does`,
    });
}

trait postfix(operator: is rule, tail?: string) extends rule(
  tail == undefined? `[[Expression]] , [[&operator]]`: `[[Expression]] , [[&operator]] , {{tail}}`,
): `An expression followed by an operator and, when [[tail]] is given, more syntax` {
  @acceptanceCriteria
    .add({
      situation = `{{@identifier}} has no [[binding]]`,
      behavior = `Binds as the token that satisfied [[operator]] does`,
    });
}

// One of the few cases where space matters: "-1" and "- 1", ".is" and ". is" read differently.
trait unspaced(after: is rule): `Sensitive to space after [[after]]` {
  where (`Space, a line break, a comment, or documentation directly follows the token that satisfied [[&after]]`) -> `{{@identifier}} ends at that token`;
}
