use "../precedence";
use "../terminals/identifier";
use "../terminals/keyword";
use "../terminals/literal";
use "../terminals/punctuation";
use "../traits";

ace function listOf(syntax: string, wrapper?: 'group' | 'list' | 'object'): `Creates a EBNF list separated by commas` -> string {
  return `( {{syntax}} ) , (: [[Comma]] , ( {{syntax}} ) :) , (/ [[Comma]] /)`;
}

// Helpers: rules other rules are built from

d MemberName is alternationList(Identifier, TypeKeyword): `A name after an accessor; The type keyword is allowed because it is a context property` {}
d TraitUse is rule(`[[Identifier]] , (: [[ValueAccessor]] , [[Identifier]] :) , (/ [[Arguments]] /)`): `A trait, with arguments when it takes any` {}
d TraitUses is rule(listOf(`[[TraitUse]]`)): `One or more traits` {}
d IsClause is rule(`[[IsKeyword]] , [[TraitUses]]`): `Traits applied to a declaration` {}
d ExtendsClause is rule(`[[ExtendsKeyword]] , [[TraitUses]]`): `Traits or data a declaration includes` {}
d DefinitionClause is rule(`[[Colon]] , [[TypeExpression]]`): `A description or type attached to a declaration` {}
d Declared is rule(`[[Identifier]] , (/ [[IsClause]] /) , (/ [[DefinitionClause]] /)`): `A declared name with its traits and definition` {}
d ObjectKey is rule(`[[Declared]] , [[PlainSetter]] , [[Expression]]`): `An object key name with its traits, definition, and value` {}
d Parameter is rule(
  `[[Name]] , (/ [[QuestionMark]] /) , (/ [[DefinitionClause]] /) , (/ [[PlainSetter]] , [[Expression]] /)`,
): `A single parameter` {}
d SpreadParameter is rule(`[[Spread]] , [[Name]] , (/ [[DefinitionClause]] /) , (/ [[PlainSetter]] , [[Expression]] /)`): `A spread parameter` {}
d Parameters is rule(
  `[[GroupOpen]] , (/ ( ( [[Parameter]] , (: [[Comma]] , [[Parameter]] :) , (/ [[Comma]] , [[SpreadParameter]] /) ) | [[SpreadParameter]] ) , (/ [[Comma]] /) /) , [[GroupClose]]`,
): `A parameter list` {}
d TypeParameter is rule(
  `[[Identifier]] , (/ [[ExtendsKeyword]] , [[TypeExpression]] /) , (/ [[PlainSetter]] , [[TypeExpression]] /)`,
): `A name a declaration is generic over, with the type it must extend and its default` {}
d TypeParameters is rule(`[[LessThan]] , {{listOf(`[[TypeParameter]]`)}} , [[GreaterThan]]`): `The type parameters of a declaration, right after its identifier` {}
d TypeArguments is rule(`[[LessThan]] , {{listOf(`[[TypeExpression]]`)}} , [[GreaterThan]]`): `The type arguments of a generic in a type position` {}
d Signature is rule(
  `(/ [[Identifier]] /) , (/ [[TypeParameters]] /) , [[Parameters]] , (/ [[IsClause]] /) , (/ [[DefinitionClause]] /)`,
): `A function's name, type parameters, parameters, traits, and definition` {
  where (`The source is fn map<T, U>(list: List<T>, transform: (item: T) => U) => List<U>;`) -> `The [[Signature]] is map with the [[TypeParameters]] T and U and two [[Parameter]] items: list typed as the [[TypeItem]] List with the [[TypeArguments]] T, and transform typed as the [[FunctionType]] from item of T to U; the return type is List with the [[TypeArguments]] U`;
}
d Items is rule(`(/ {{listOf(`[[Expression]]`)}} /)`): `Zero or more comma separated expressions` {}
d Arguments is rule(`[[GroupOpen]] , [[Items]] , [[GroupClose]]`): `A parenthesized list` {}
d Reference is rule(`( [[Name]] | [[Current]] | [[Dereference]] | [[Member]] | [[Index]] ) `): `A reference chain` {}
d TemplateReference is rule(`[[ReferenceOpen]] , [[Reference]] , [[ReferenceClose]]`): `A reference to a name inside a template or documentation` {}
d TemplateExecution is rule(`[[ExecutionOpen]] , [[Expression]] , [[ExecutionClose]]`): `An expression whose value is written into a template` {}
d TypeValue is alternationList(
  PrimitiveType,
  StringLiteral,
  Template,
  Number,
  Nullish,
  Object,
  List,
  TypePredicate,
  FunctionType,
  Reference,
): `A type value` {}
d FunctionType is rule(`[[Parameters]] , [[DoubleArrowRight]] , [[TypeExpression]]`): `The type of a function: its parameters and what it returns` {}
d TypeGroup is rule(`[[GroupOpen]] , [[TypeExpression]] , [[GroupClose]]`): `A parenthesized type` {
  where (`[[GroupClose]] is followed by [[DoubleArrowRight]]`) -> `Rule cannot be a match; the parentheses are the [[Parameters]] of a [[FunctionType]]`;
}
d TypeItem is rule(
  `( [[TypeValue]] | [[TypeGroup]] ) , (/ [[TypeArguments]] /) , (/ [[ListOpen]] , [[ListClose]] /)`,
): `A type with its type arguments, or an array of it` {
  where (`[[TypeArguments]] follow anything but a [[Reference]]`) -> `Reported after parsing`;
  where (`[[ListOpen]] and [[ListClose]] follow`) -> `The type is the standard library's List with the type before them as its one type argument: T[] is the same type as List<T>`;
  where (`The source is x: List<List<T>>`) -> `The [[TypeItem]] List with the [[TypeArguments]] holding the [[TypeItem]] List with the [[TypeArguments]] T; the two [[GreaterThan]] tokens close one list each`;
}
d TypeExpression is rule(
  `(/ [[BitwiseOr]] | [[Ampersand]] /) , [[TypeItem]] , (: ( [[BitwiseOr]] | [[Ampersand]] ) , [[TypeItem]] :)`,
): `An expression in a type position` {}
d TypeKey is rule(
  `[[Name]] , (/ [[QuestionMark]] /) , (/ [[DefinitionClause]] /) , [[PlainSetter]] , [[TypeExpression]]`,
): `A type key name with its definition and value` {}

// Primaries

d StringLiteral is primary(`[[SingleQuoteString]] | [[DoubleQuoteString]]`): `A string` {}
d Template is primary(
  `[[Backtick]] , (: [[TemplateBody]] | [[TemplateReference]] | [[TemplateExecution]] :) , [[Backtick]]`,
): `A template: text with references and expressions` {}
d Number is primary(`[[NumberLiteral]]`): `A number` {}
d Boolean is primary(`[[TrueKeyword]] | [[FalseKeyword]]`): `A boolean` {}
d Nullish is primary(`[[NullKeyword]] | [[UndefinedKeyword]]`): `Null or undefined` {}
d PrimitiveType is primary(
  `[[BooleanKeyword]] | [[NumberKeyword]] | [[StringKeyword]] | [[ObjectKeyword]] | [[FunctionKeyword]] | [[TraitKeyword]]`,
): `A primitive type used as a value` {}
d Name is primary(`[[Identifier]]`): `A name in scope` {}
d Current is primary(`[[Accessor]] , (/ [[MemberName]] /)`): `A layer of the current entity, or a member of it` {
  where (`[[Space]], [[NewLine]], [[Comment]], or [[Documentation]] exists between [[Accessor]] and [[MemberName]]`) -> `[[MemberName]] is not matched`;
}
d Previous is primary(`[[PreviousStatement]]`): `The entity the previous statement declared` {}
d Group is primary(`[[GroupOpen]] , [[Expression]] , [[GroupClose]]`): `A parenthesized expression` {
  where (`[[GroupClose]] is followed by [[IsKeyword]], [[Colon]], or [[DoubleArrowRight]]`) -> `Rule cannot be a match`;
}
d InlineFunction is primary(
  `[[Parameters]] , (/ [[IsClause]] /) , (/ [[DefinitionClause]] /) , (/ [[SingleArrow]] , [[TypeExpression]] /) , [[DoubleArrowRight]] , ( [[Block]] | [[Expression]] )`,
): `A function written as an expression` {
  @acceptanceCriteria
    .add({ behavior = `A [[BlockOpen]] after the [[DoubleArrowRight]] begins a [[Block]], never an [[Object]]` });
}
d List is primary(`[[ListOpen]] , [[Items]] , [[ListClose]]`): `A list` {}
d Object is primary(`[[BlockOpen]] , (/ {{listOf(`[[ObjectKey]]`)}} /) , [[BlockClose]]`): `An object` {}
d TypePredicate is primary(`[[IsKeyword]] , [[TraitUse]]`): `The type of anything with a trait` {}
d Type is primary(`[[BlockOpen]] , (/ {{listOf(`[[TypeKey]]`)}} /) , [[BlockClose]]`): `A type` {}

// Prefix operations

d NotOperation is prefix(LogicalNot): `Logical not` {}
d NegateOperation is prefix(Minus, true), binding(Level.unary, 'right'): `Negation` {}
d BitwiseNotOperation is prefix(BitwiseNot): `Bitwise not` {}
d Dereference is prefix(Ampersand, true): `The entity a name is bound to` {
  @acceptanceCriteria
    .add({
      situation = `An operand that is not a [[Name]] or [[Current]]`,
      behavior = `Reported after parsing`,
    });
}
d SpreadOperation is prefix(Spread): `Spread, or the rest of a list` {}
d AwaitOperation is prefix(AwaitKeyword): `The value of a promise` {}
d InOperation is prefix(InKeyword): `The values of` {}
d OfOperation is prefix(OfKeyword): `The keys of` {}
d FromOperation is prefix(FromKeyword): `The keys and values of` {}

// Infix operations

d AdditiveOperation is infix(Additive): `Addition, concatenation, or subtraction` {}
d MultiplicativeOperation is infix(Multiplicative): `Multiplication, division, or remainder` {}
d PowerOperation is infix(Power): `Exponentiation` {}
d BitwiseOrOperation is infix(BitwiseOr): `Bitwise or; a union when both sides are types` {}
d BitwiseXorOperation is infix(BitwiseXor): `Bitwise exclusive or` {}
d BitwiseAndOperation is infix(Ampersand), binding(Level.bitwiseAnd): `Bitwise and` {}
d RelationalOperation is infix(Relational): `Ordering comparison` {}
d EqualityOperation is infix(Equality): `Equality comparison` {}
d LogicalAndOperation is infix(LogicalAnd): `Both` {}
d CoalescenceOperation is infix(Coalescence): `Either, or a fallback` {}
d RangeOperation is infix(Spread): `A range` {}
d Assignment is infix(Setter): `Sets the left side` {}

// Postfix operations

d Member is postfix(Accessor, `(/ [[MemberName]] /)`, true): `A member of a layer of the left expression, or that layer itself` {}
d Index is postfix(ListOpen, `(/ [[Expression]] /) , [[ListClose]]`): `An element of the left expression, or with nothing inside, the array type of it` {}
d Call is postfix(GroupOpen, `[[Items]] , [[GroupClose]]`): `Calls the left expression` {}
d Traits is postfix(IsKeyword, `[[TraitUses]]`): `Whether traits are applied to the left expression` {}
d Definition is postfix(Colon, `[[Expression]]`): `Attaches a description or type to the declared left expression` {}
d Cast is postfix(AsKeyword, `[[TypeExpression]]`): `A value read as a type` {}
d Generic is postfix(LessThan, `{{listOf(`[[TypeExpression]]`)}} , [[GreaterThan]]`), binding(
  Level.access,
): `The left expression with type arguments, in an expression position` {
  where (`The token after [[GreaterThan]] that is not [[Space]], [[NewLine]], [[Comment]], or [[Documentation]] is not one of [[Semicolon]], [[Comma]], [[GroupClose]], [[ListClose]], [[BlockClose]], [[PlainSetter]], [[GroupOpen]], [[ValueAccessor]], [[ListOpen]], [[BitwiseOr]], [[Ampersand]], or [[DoubleArrowRight]]`) -> `Rule cannot be a match; [[RelationalOperation]] is the parse of the [[LessThan]]`;
  where (`[[GreaterThanOrEqual]] follows the arguments`) -> `Rule cannot be a match, because the longest match lexes the two characters as one token: List<T>=x compares, it does not assign`;
  where (`The left expression is parsed to satisfy [[Reference]]`) -> `Rule cannot be a match; in a type position the arguments are the [[TypeArguments]] of the [[TypeItem]]`;
  @acceptanceCriteria
    .add({
      behavior = `Binds as [[Member]] and [[Index]] do, so a + f<T>(x) reads as a + (f<T>(x)) and x.f<T>(y) reads as ((x.f)<T>)(y)`,
    });
  where (`The source is $items = List<T>;`) -> `An [[Assignment]] whose right side is the [[Generic]] of the [[Name]] List with the type argument T, because [[Semicolon]] follows the [[GreaterThan]]`;
  where (`The source is f<string>(x)`) -> `A [[Call]] whose left expression is the [[Generic]] of f with the type argument string, because [[GroupOpen]] follows the [[GreaterThan]]`;
  where (`The source is a < b`) -> `A [[RelationalOperation]], because no [[GreaterThan]] follows b`;
  where (`The source is a < b > c`) -> `Two [[RelationalOperation]] nodes reading as (a < b) > c, because the [[Identifier]] c follows the [[GreaterThan]]`;
}
d Conditional is postfix(QuestionMark, `[[Expression]] , [[Colon]] , [[Expression]]`), binding(
  Level.definition,
  'right',
): `Chooses between two values` {
  @acceptanceCriteria
    .add({ behavior = `The [[Colon]] belongs to this rule; the middle expression ends at it` });
}

// The expression sets

d Primary is alternationList(...primary@entities): `Any primary expression` {}
d Prefix is alternationList(...prefix@entities): `Any prefix operation` {}
d Infix is alternationList(...infix@entities): `Any infix operation` {}
d Postfix is alternationList(...postfix@entities): `Any postfix operation` {}
d Expression is alternationList(Primary, Prefix, Infix, Postfix): `Any expression` {
  @acceptanceCriteria
    .add({
      behavior = `Begins with one [[Primary]] or [[Prefix]] and continues with any number of [[Infix]] and [[Postfix]] operations, grouped by their binding power`,
    });
}
