use "./tokens/identifier";
use "./tokens/keyword";
use "./tokens/literal";
use "./tokens/operator";
use "./tokens/separator";
use "./traits";

d ArrowSingleRightExpression is ebnfSyntax(`[[ArrowSingleRightPunctuation]] | [[ArrowSingleRightSingleCharPunctuation]]`) {}

d ArrowSingleLeftExpression is ebnfSyntax(`[[ArrowSingleLeftPunctuation]] | [[ArrowSingleLeftSingleCharPunctuation]]`) {}

d TemplateLiteralReference is ebnfSyntax(`[[ReferenceOpenBoundary]] , [[IdentifierExpression]] , [[ReferenceCloseBoundary]]`): `template literal reference block` {}

d TemplateLiteralExecution is ebnfSyntax(`[[ExecutionOpenBoundary]] , [[Expression]] , [[ExecutionCloseBoundary]]`): `template literal execution block` {}

d TemplateLiteralBody is ebnfSyntax(`(: ( UTF8_CHARACTER - ( [[BacktickBoundary]] | "\\" | [[ReferenceOpenBoundary]] | [[ExecutionOpenBoundary]] ) ) | [[Sequence]] :)`): `template literal body contents` {}

d TemplateLiteral is ebnfSyntax(`[[BacktickBoundary]] , (: [[TemplateLiteralBody]] | [[TemplateLiteralReference]] | [[TemplateLiteralExecution]] :) , [[BacktickBoundary]]`) {}

d LiteralExpression is ebnfSyntax(`[[StringLiteral]] | [[TemplateLiteral]] | [[NumberLiteral]] | [[BooleanLiteral]] | [[NullLiteral]] | [[UndefinedLiteral]] | [[Identifier]]`) {}

d IdentifierAccessorExpression is ebnfSyntax(`[[AccessorPunctuation]] , (/ (/ [[QuestionMarkPunctuation]] /) , [[Identifier]] /)`) {}

d IdentifierReferenceExpression is ebnfSyntax(`[[BitwiseAndPunctuation]] , [[Identifier]]`) {}

d ListAccessExpression is ebnfSyntax(`[[Expression]] , [[ListOpenSeparator]] , ([[Expression]]) , [[ListCloseSeparator]]`) {}

d GroupedExpression is ebnfSyntax(`[[GroupOpenSeparator]] , [[Expression]] , [[GroupCloseSeparator]]`) {}

d NegationExpression is ebnfSyntax(`[[LogicalNotPunctuation]] , [[Expression]]`) {}

d InlineConditionalExpression is ebnfSyntax(`[[Expression]] , [[QuestionMarkPunctuation]] , [[Expression]] , [[DefinitionPunctuation]] , [[Expression]]`) {}

d CoalescenceExpression is ebnfSyntax(`[[Expression]] , ( [[CoalescenceNullPunctuation]] | [[LogicalOrPunctuation]] ) , [[Expression]]`) {}

d ArithmeticExpression is ebnfSyntax(`[[Expression]] , ( [[MathPunctuation]] | [[BitwisePunctuation]] ) , [[Expression]]`) {}

d ComparisonExpression is ebnfSyntax(`[[Expression]] , [[EqualityPunctuation]] , [[Expression]]`) {}

d LogicalExpression is ebnfSyntax(`[[Expression]] , ( [[LogicalAddPunctuation]] | [[LogicalOrPunctuation]] ) , [[Expression]]`) {}

d IdentifierExpression is ebnfSyntax(`[[Expression]] , (: [[IdentifierAccessorExpression]] | [[ListAccessExpression]] :)`) {}

d CallExpression is ebnfSyntax(`[[Expression]] , [[GroupListExpression]]`) {}

d TraitExpression is ebnfSyntax(`[[Identifier]] , (/ [[GroupListExpression]] /)`) {}

d IsExpression is ebnfSyntax(`[[IsKeyword]] , [[TraitExpression]] , (: [[ListContinueSeparator]] , [[TraitExpression]] :) , (/ [[ListContinueSeparator]] /)`) {}

d DefinitionExpression is ebnfSyntax(`[[DefinitionPunctuation]] , [[Expression]]`) {}

d IdentityExpression is ebnfSyntax(`[[Identifier]] , (/ [[IsExpression]] /) , (/ [[DefinitionExpression]] /)`) {}

d FunctionIdentityExpression is ebnfSyntax(`(/ [[Identifier]] /) , [[GroupListExpression]] , (/ [[IsExpression]] /) , (/ [[DefinitionExpression]]  /)`) {}

d PrimitiveExpression is ebnfSyntax(`[[PrimitiveBooleanKeyword]] | [[NullLiteral]] | [[PrimitiveNumberKeyword]] | [[PrimitiveObjectKeyword]] | [[PrimitiveStringKeyword]] | [[UndefinedLiteral]] | [[FunctionKeyword]]`) {}

d CastExpression is ebnfSyntax(`[[Expression]] , [[AsKeyword]] , ( [[IdentifierExpression]] | [[PrimitiveExpression]] )`) {}

d AssignmentExpression is ebnfSyntax(`[[Expression]] , (/ [[IsExpression]] /) , (/ [[DefinitionExpression]] /), (/ [[SetterPunctuation]] , [[Expression]] /)`) {}

d ListExpression is ebnfSyntax(`[[ListOpenSeparator]] , (: [[Expression]] | [[ListContinueSeparator]] :) , [[ListCloseSeparator]]`) {}

d GroupListExpression is ebnfSyntax(`[[GroupOpenSeparator]] , (/ [[Expression]] , (: [[ListContinueSeparator]] , [[Expression]] :) , (/ [[ListContinueSeparator]] /) /) , [[GroupCloseSeparator]]`) {}

d ObjectExpression is ebnfSyntax(`[[BlockOpenSeparator]] , (/ [[AssignmentExpression]] , (: [[ListContinueSeparator]] , [[AssignmentExpression]] :) , (/ [[ListContinueSeparator]] /) /) , [[BlockCloseSeparator]]`) {}

d AwaitExpression is ebnfSyntax(`[[AwaitKeyword]] , [[Expression]]`) {}

d SpreadExpression is ebnfSyntax(`[[SpreadPunctuation]] , [[Expression]]`) {}

d RangeExpression is ebnfSyntax(`[[Expression]] , [[SpreadPunctuation]] , [[Expression]]`) {}

d FromExpression is ebnfSyntax(`[[FromKeyword]] , [[Expression]]`) {}

d OfExpression is ebnfSyntax(`[[OfKeyword]] , [[Expression]]`) {}

d InExpression is ebnfSyntax(`[[InKeyword]] , [[Expression]]`) {}

d TypeOnlyExpression is ebnfSyntax(`[[LiteralExpression]] | [[IdentifierExpression]] | [[ObjectExpression]] | [[ListExpression]]`) {}

d Expression is ebnfSyntax(`[[LiteralExpression]] | [[IdentifierAccessorExpression]] | [[IdentifierReferenceExpression]] | [[ListAccessExpression]] | [[GroupedExpression]] | [[NegationExpression]] | [[ArithmeticExpression]] | [[ComparisonExpression]] | [[LogicalExpression]] | [[IdentifierExpression]] | [[CallExpression]] | [[DefinitionExpression]] | [[CastExpression]] | [[AssignmentExpression]] | [[ListExpression]] | [[GroupListExpression]] | [[ObjectExpression]] | [[AwaitExpression]] | [[SpreadExpression]] | [[RangeExpression]] | [[FromExpression]] | [[OfExpression]] | [[InExpression]]`) {}
