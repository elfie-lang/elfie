use "./traits";

d AccessorValuePunctuation is ebnfSyntax(`"."`), appliesToCurrent: `Accesses the data or value` {}
d AccessorContextPunctuation is ebnfSyntax(`"@"`), appliesToCurrent: `Accesses the context` {}
d AccessorScopePunctuation is ebnfSyntax(`"$"`), appliesToCurrent: `Accesses the scope` {}

d AccessorPunctuation is ebnfSyntax(`[[AccessorValuePunctuation]] | [[AccessorContextPunctuation]] | [[AccessorScopePunctuation]]`), appliesToCurrent: `` {}

d ArrowSingleLeftPunctuation is ebnfSyntax(`"<-"`): `Single arrow left` {}
d ArrowSingleLeftSingleCharPunctuation is ebnfSyntax(`"←"`): `Single arrow left single character` {}
d ArrowSingleRightPunctuation is ebnfSyntax(`"->"`): `Single arrow right` {}
d ArrowSingleRightSingleCharPunctuation is ebnfSyntax(`"→"`): `Single arrow right single character` {}
d ArrowDoubleRightPunctuation is ebnfSyntax(`"=>"`): `Double arrow right` {}
d BitwiseAndPunctuation is ebnfSyntax(`"&"`): `Bitwise AND; Also used for dereferencing to the scope assigned to a variable or alias rather than the variable or alias itself` {}
d BitwiseOrPunctuation is ebnfSyntax(`"|"`): `Bitwise OR` {}
d BitwiseNotPunctuation is ebnfSyntax(`"~"`): `Bitwise NOT` {}
d BitwiseXorPunctuation is ebnfSyntax(`"^"`), notAllowedPostfix(`a non-numeric character`): `Bitwise XOR (when followed by a number)` {}
d CoalescenceNullPunctuation is ebnfSyntax(`"??"`): `Null coalescence` {}
d DefinitionPunctuation is ebnfSyntax(`":"`): `Definition` {}
d EqualityLessThanPunctuation is ebnfSyntax(`"<"`): `Less than` {}
d EqualityLessThanOrEqualPunctuation is ebnfSyntax(`"<="`): `Less than or equal to` {}
d EqualityGreaterThanPunctuation is ebnfSyntax(`">"`): `Greater than` {}
d EqualityGreaterThanOrEqualPunctuation is ebnfSyntax(`">="`): `Greater than or equal to` {}
d EqualityStrictPunctuation is ebnfSyntax(`"=="`): `Equality (Are these two values equal, no auto-casting)` {}
d EqualityUnequalPunctuation is ebnfSyntax(`"!="`): `Inequality` {}
d EqualityReferencePunctuation is ebnfSyntax(`"&="`): `Reference equality (do these refer to the same point in memory)` {}
d EqualityWithCastingPunctuation is ebnfSyntax(`"~="`): `About equal (equality + auto-casting)` {}
d LogicalNotPunctuation is ebnfSyntax(`"!"`): `Logical "not"` {}
d LogicalAddPunctuation is ebnfSyntax(`"&&"`): `Logical "and"` {}
d LogicalOrPunctuation is ebnfSyntax(`"||"`): `Logical "or"` {}
d QuestionMarkPunctuation is ebnfSyntax(`"?"`): `Optional (chaining, type, etc.) or inline conditional` {}
d RefLastPunctuation is ebnfSyntax(`"^^"`): `Previous statement reference` {}
d RefDefineLastPunctuation is ebnfSyntax(`"^^:"`): `Apply a definition to the previous statement` {}
d SetterPlainPunctuation is ebnfSyntax(`"="`): `Setter` {}
d SetterBooleanTogglePunctuation is ebnfSyntax(`"=!"`): `For boolean, set variable to NOT value` {}
d SetterAdditivePunctuation is ebnfSyntax(`"=+"`): `Add or append and re-set variable` {}
d SetterIncrementPunctuation is ebnfSyntax(`"=++"`): `Add 1 to a numeric value and re-set variable` {}
d SetterSubtractivePunctuation is ebnfSyntax(`"=-"`): `Subtract and re-set variable` {}
d SetterDecrementPunctuation is ebnfSyntax(`"=--"`): `Subtract 1 fom a numeric value and re-set variable` {}
d SetterMultiplicativePunctuation is ebnfSyntax(`"=*"`): `Multiply and re-set variable` {}
d SetterPowerPunctuation is ebnfSyntax(`"=**"`): `To power of and re-set variable` {}
d SetterBitwiseAndPunctuation is ebnfSyntax(`"=&"`): `Bitwise AND and re-set variable` {}
d SetterBitwiseOrPunctuation is ebnfSyntax(`"=|"`): `Bitwise OR and re-set variable` {}
d SetterCoalescenceNullPunctuation is ebnfSyntax(`"=??"`): `Set if undefined` {}
d SetterCoalescenceFalseyPunctuation is ebnfSyntax(`"=||"`): `Set if falsey` {}
d SetterCoalescenceTruthyPunctuation is ebnfSyntax(`"=&&"`): `Set if truthy` {}

d BitwisePunctuation is ebnfSyntax(`[[BitwiseAndPunctuation]] | [[BitwiseOrPunctuation]] | [[BitwiseNotPunctuation]] | [[BitwiseXorPunctuation]]`) {}
d EqualityPunctuation is ebnfSyntax(`[[EqualityLessThanPunctuation]] | [[EqualityLessThanOrEqualPunctuation]] | [[EqualityGreaterThanPunctuation]] | [[EqualityGreaterThanOrEqualPunctuation]] | [[EqualityStrictPunctuation]] | [[EqualityUnequalPunctuation]] | [[EqualityReferencePunctuation]] | [[EqualityWithCastingPunctuation]]`): `` {}
d SetterPunctuation is ebnfSyntax(`[[SetterPlainPunctuation]] | [[SetterBooleanTogglePunctuation]] | [[SetterAdditivePunctuation]] | [[SetterIncrementPunctuation]] | [[SetterSubtractivePunctuation]] | [[SetterDecrementPunctuation]] | [[SetterMultiplicativePunctuation]] | [[SetterPowerPunctuation]] | [[SetterBitwiseAndPunctuation]] | [[SetterBitwiseOrPunctuation]] | [[SetterCoalescenceNullPunctuation]] | [[SetterCoalescenceFalseyPunctuation]] | [[SetterCoalescenceTruthyPunctuation]]`): `All punctuation that can set a value` {}

d AddPunctuation is ebnfSyntax(`"+"`): `Addition, concatenation` {}
d SubtractPunctuation is ebnfSyntax(`"-"`): `Subtraction` {}
d MultiplyPunctuation is ebnfSyntax(`"*"`): `Multiplication` {}
d PowerPunctuation is ebnfSyntax(`"**"`): `Power` {}
d ModulusPunctuation is ebnfSyntax(`"%"`): `Modulus` {}
d DividePunctuation is ebnfSyntax(`"/"`): `Division` {}
d SpreadPunctuation is ebnfSyntax(`"..."`): `Spread or range` {}

d MathPunctuation is ebnfSyntax(`[[AddPunctuation]] | [[SubtractPunctuation]] | [[MultiplyPunctuation]] | [[PowerPunctuation]] | [[ModulusPunctuation]] | [[DividePunctuation]]`) {}

