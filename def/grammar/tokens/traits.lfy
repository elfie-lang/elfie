use "../types";

trait ebnfSyntax(syntax: string) {
  $ebnf: `EBNF details for this token` = EBNFSyntax;
  .ebnf = {
    syntax = syntax,
    identifier = @identifier,
    rule = `{{@identifier}} = {{syntax}} ;`,
  }

  @acceptanceCriteria.add({ behavior = `Lexes and parses grammar in the following format (EBNF notation): {{.ebnf.rule}}`});
}

trait appliesToCurrent {
  const isCurrentRef = `Is placed at the start of an expression or statement`;
  const isInGlobalScope = `Is a root level statement`;
  where (isCurrentRef) and !(isInGlobalScope) -> `Applies to the current scope`;
  where (isCurrentRef) and (isInGlobalScope) -> `Applies to the global scope`;
}

trait notAllowedPrefix(...forbidden: string[]) {
  for(const str in forbidden) {
    where (`Token {{.}} is a candidate match for lexer from [[@]]`) and (`Text immediately prior to it is {{str}}`) -> `Is not considered a match`;
  }
}

trait notAllowedPostfix(...forbidden: string[]) {
  for(const str in forbidden) {
    where (`Token {{.}} is a candidate match for lexer from [[@]]`) and (`Text immediately following is {{str}}`) -> `Is not considered a match`;
  }
}
