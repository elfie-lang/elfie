use "./traits";

d AgentDataKeyword is ebnfSyntax(`"d"`): `Agentically defined data structure` {}
d AgentFnKeyword is ebnfSyntax(`"fn"`): `Agentically defined function` {}
d AliasKeyword is ebnfSyntax(`"alias"`): `Alias for identifier` {}
d AndKeyword is ebnfSyntax(`"and"`): `Combine conditions in contexts like the "where" syntax sugar keyword` {}
d AsKeyword is ebnfSyntax(`"as"`): `Casting or aliasing` {}
d AsyncKeyword is ebnfSyntax(`"async"`): `Indicating an asynchronous block wrapped in a Promise` {}
d AwaitKeyword is ebnfSyntax(`"await"`): `Awaiting the completion of a Promise` {}
d BreakKeyword is ebnfSyntax(`"break"`): `Breaking out of loops` {}
d CompileTimeExecutionKeyword is ebnfSyntax(`"ace"`): `Marking a statement or block to be executed at compile time` {}
d ConstKeyword is ebnfSyntax(`"const"`): `Defining constant variables` {}
d ContinueKeyword is ebnfSyntax(`"continue"`): `Completing the block, but not breaking out of it` {}
d DefaultKeyword is ebnfSyntax(`"default"`): `The default action, value, or block` {}
d ElseKeyword is ebnfSyntax(`"else"`): `An else statement or block` {}
d EnumKeyword is ebnfSyntax(`"enum"`): `Defining a variable with enumerated keys and values` {}
d ExtendsKeyword is ebnfSyntax(`"extends"`): `Extending an existing trait or data structure` {}
d ExternalKeyword is ebnfSyntax(`"external"`): `Referencing something external to the code` {}
d ForKeyword is ebnfSyntax(`"for"`): `A loop over iterators when combined with from, of, and in keywords` {}
d FromKeyword is ebnfSyntax(`"from"`): `Referencing a type, variable, or data structures' keys and values` {}
d FunctionKeyword is ebnfSyntax(`"function"`): `An explicitly defined function` {}
d IfKeyword is ebnfSyntax(`"if"`): `An if conditional block or statement` {}
d InKeyword is ebnfSyntax(`"in"`): `Referencing a type, variable, or data structures' values` {}
d IsKeyword is ebnfSyntax(`"is"`): `Marking traits of an expression, block, variable, or value` {}
d LetKeyword is ebnfSyntax(`"let"`): `Defining a mutable variable` {}
d LoopKeyword is ebnfSyntax(`"loop"`): `A basic loop that runs until it encounters a break` {}
d MatchKeyword is ebnfSyntax(`"match"`): `A match expression or block that branches based on condition statements` {}
d MatchallKeyword is ebnfSyntax(`"matchall"`): `A matchall expression or block that applies the results of all condition statements that are true` {}
d OfKeyword is ebnfSyntax(`"of"`): `Referencing a type, variable, or data structures' keys` {}
d OrKeyword is ebnfSyntax(`"or"`): `Branch conditions in contexts like the "where" syntax sugar keyword` {}
d ReturnKeyword is ebnfSyntax(`"return"`): `Return expression that ends execution of a function and returns a value or set of values` {}
d TraitKeyword is ebnfSyntax(`"trait"`): `Group of shared definitions, properties, configuration, and other information that can be easily added to data, functions or other kinds of variables` {}
d TypeKeyword is ebnfSyntax(`"type"`): `Defining a type map` {}
d UseKeyword is ebnfSyntax(`"use"`): `Add the scoped contents of a file, folder, or library to the current scope` {}
d WhileKeyword is ebnfSyntax(`"while"`): `A while loop` {}
d WhereKeyword is ebnfSyntax(`"where"`): `Syntax sugar for @acceptanceCriteria.add` {}
d WithKeyword is ebnfSyntax(`"with"`): `Sets the scope for a block` {}

