use "./literal";
use "./space";
use "./traits";

d CommentBlockOpen is ebnfSyntax(`"/*"`): `a block comment open` {
  @acceptanceCriteria
    .add({ behavior = `Can be nested within other comment blocks` });
}

d CommentBlockClose is ebnfSyntax(`"*/"`): `a block comment close` {}

d CommentBlockBody is ebnfSyntax(`(: UTF8_CHARACTER - ( [[CommentBlockOpen]] | [[CommentBlockClose]] ) :)`): `contents of the comment` {}

d CommentInlineStart is ebnfSyntax(`"//"`): `an inline comment start` {}

d CommentInlineBody is ebnfSyntax(`(: UTF8_CHARACTER - ( [[NewLine]] ) :)`): `contents of the comment` {}

d DocumentationBlockOpen is ebnfSyntax(`"/**"`), notAllowedPostfix(`/`): `a block documentation open` {
  @acceptanceCriteria
    .add({ behavior = `Can be nested within other documentation blocks` });
}

d DocumentationBlockClose is ebnfSyntax(`"**/"`): `a block documentation close` {}

d DocumentationBlockBody is ebnfSyntax(`(: UTF8_CHARACTER - ( [[DocumentationBlockOpen]] | [[DocumentationBlockClose]] | [[ReferenceOpenBoundary]] ) :)`): `contents of the comment` {}

d DocumentationInlineStart is ebnfSyntax(`"///"`): `an inline documentation start` {}

d DocumentationInlineBody is ebnfSyntax(`(: UTF8_CHARACTER - ( [[NewLine]] | [[ReferenceOpenBoundary]] | [[ReferenceCloseBoundary]] ) :)`): `contents of the comment` {}
