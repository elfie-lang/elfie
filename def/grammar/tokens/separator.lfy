use "./traits";

d BlockOpenSeparator is ebnfSyntax(`"{"`): `an open token for a block` {}
d BlockCloseSeparator is ebnfSyntax(`"}"`): `a close token for a block` {}
d GroupOpenSeparator is ebnfSyntax(`"("`): `an open token for a group` {}
d GroupCloseSeparator is ebnfSyntax(`")"`): `a close token for a group` {}
d ListOpenSeparator is ebnfSyntax(`"["`): `an open token for a list` {}
d ListContinueSeparator is ebnfSyntax(`","`): `continue character for next item or statement in list` {}
d ListCloseSeparator is ebnfSyntax(`"]"`): `a close token for a list` {}
d StatementEndSeparator is ebnfSyntax(`";"`): `end character for statements` {}
