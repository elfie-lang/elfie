enum Level: `Binding power of kinds of operations` {
  joiner: `Joining items together in a list` = 1,
  assignment: `Assigning a value` = 2,
  definition: `Defining an item` = 3,
  coalescence: `Coalescing values` = 4,
  logicalAnd = 5,
  bitwiseOr = 6,
  bitwiseXor = 7,
  bitwiseAnd = 8,
  equality: `Equality checks between items` = 9,
  relational: `Relation checks between items` = 10,
  extraction: `Extracting information from an item or value` = 11,
  additive: `Mathmatically additive` = 12,
  multiplicative: `Mathmatically multiplicative` = 13,
  exponentiation = 14,
  wrapper: `Wrapping a statement or expression in a behavior` = 15,
  unary = 16,
  access: `Accesses of value, context, or scope information` = 17,
  reference: `Reference or dereferences` = 18,
  group: `Grouping for controlled precedence` = 19,
}
