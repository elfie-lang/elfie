use "./tokens/keyword";
use "./tokens/operator";
use "./tokens/separator";
use "./expression";
use "./statement";
use "./traits";

d WhereExpression is ebnfSyntax(`( (/ [[LogicalNotPunctuation]] /) , [[GroupOpenSeparator]] , [[WhereExpression]] , [[GroupCloseSeparator]] , (: ( [[AndKeyword]] | [[OrKeyword]] ) , [[WhereExpression]] :) ) | ( (/ [[LogicalNotPunctuation]] /) , [[GroupedExpression]] , (: ( [[AndKeyword]] | [[OrKeyword]] ) , (/ [[LogicalNotPunctuation]] /) , [[GroupedExpression]] :) )`) {
  @acceptanceCriteria
    .add({
      behavior = [
        `[[GroupedExpression]] are evaluated left to right`,
        `Evaluates to a flat list of expressions, regardless of nesting`,
      ],
    })
    .add({
      situation = `Part or all of the [[WhereExpression]] is nested in [[GroupOpenSeparator]] and [[GroupCloseSeparator]]`,
      behavior = `Nested [[WhereExpression]] are evaluated recursively from the most nested to least nested`,
    })
    .add({
      situation = `[[LogicalNotPunctuation]] is used in front of a [[GroupOpenSeparator]] , [[WhereExpression]] , [[GroupCloseSeparator]] grouping`,
      behavior = `Logicl not is distributed to the contents of [[WhereExpression]]`,
      sideEffects = [
        `Done before any [[LogicalNotPunctuation]] evaluations on [[GroupedExpression]]`,
        `Any [[AndKeyword]] in [[WhereExpression]] becomes [[OrKeyword]] to apply the distributive the switch from a logical and to a logical or`,
        `Any [[OrKeyword]] in [[WhereExpression]] becomes [[AndKeyword]] to apply the distributive the switch from a logical or to a logical and`,
      ],
    })
    .add({
      situation = `[[LogicalNotPunctuation]] is used in front of a [[GroupedExpression]]`,
      behavior = `[[GroupedExpression]] is wrapped with a template of the following format \`Not (\{{expression\}})\``,
      sideEffects = [
        `Done before any [[AndKeyword]] or [[OrKeyword]] evaluations`,
      ],
    })
    .add({
      situation = `[[GroupedExpression]] are connected with an [[OrKeyword]]`,
      behavior = `[[GroupedExpression]] are merged into a single entry in the list with the format \`(\{{leftExpression\}}) **or** (\{{rightExpression\}})\` `,
      sideEffects = [
        `Can be done multiple times`,
      ]
    })
    .add({
      situation = `[[GroupedExpression]] are connected with an [[AndKeyword]]`,
      behavior = `[[@acceptanceCriteria.add@args[0].situation]] is a list with all [[GroupedExpression]] as the values`,
    });
}

d WhereStatement is ebnfSyntax(`[[WhereKeyword]] , [[WhereExpression]] , [[ArrowSingleRightExpression]] , [[ExpressionStatement]]`) {
  @acceptanceCriteria
    .add({ behavior = `Syntax sugar that translates to an @acceptanceCriteria.add function call`, })
    .add({ behavior = `[[WhereExpression]] becomes the [[@acceptanceCriteria.add@args[0].situation]]` })
    .add({ behavior = `Expression statement after [[ArrowSingleRightExpression]] becomes the [[@acceptanceCriteria.add@args[0].behavior]] value` });
}
