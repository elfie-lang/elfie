use "../traits";
use "./literal";
use "./space";

d BlockCommentOpen is boundary(`/*`): `Opens a block comment` {}
d BlockCommentClose is boundary(`*/`): `Closes a block comment` {}
d BlockCommentBody is body([BlockCommentOpen, BlockCommentClose]): `Text of a block comment; nested opens and closes are tokens of their own` {}
d LineCommentOpen is boundary(`//`): `Opens a comment that ends with the line` {}
d LineCommentBody is body([NewLine]): `Text of a line comment` {}

d BlockDocumentationOpen is boundary(`/**`): `Opens documentation that ends with its close` {
  where (`Followed immediately by /`) -> `Is a [[BlockCommentOpen]] followed by [[BlockCommentClose]] instead`;
  where (`Followed immediately by */`) -> `Is a [[BlockCommentOpen]] followed by a [[BlockCommentBody]] with the '*' text followed by a [[BlockCommentClose]] instead`;
}
d BlockDocumentationClose is boundary(`**/`): `Closes block documentation` {}
d BlockDocumentationBody is body([BlockDocumentationOpen, BlockDocumentationClose, ReferenceOpen]): `Text of block documentation; references are tokens of their own` {}
d LineDocumentationOpen is boundary(`///`): `Opens documentation that ends with the line` {}
d LineDocumentationBody is body([NewLine, ReferenceOpen, ReferenceClose]): `Text of line documentation` {}

d Comment is rule(
  `( [[BlockCommentOpen]] , (: [[BlockCommentBody]] | [[Comment]] :) , [[BlockCommentClose]] ) | ( [[LineCommentOpen]] , (/ [[LineCommentBody]] /) )`,
): `A comment` {}
d Documentation is rule(
  `( [[BlockDocumentationOpen]] , (: [[BlockDocumentationBody]] | [[TemplateReference]] :) , [[BlockDocumentationClose]] ) | ( [[LineDocumentationOpen]] , (: [[LineDocumentationBody]] | [[TemplateReference]] :) )`,
): `Documentation for the declaration that follows it` {
  @acceptanceCriteria
    .add({
      situation = `A declaration follows the documentation with only [[Space]], [[NewLine]], [[Comment]], or other [[Documentation]] between them`,
      behavior = `Attaches to that declaration, even when it is one of several documentation blocks in a row`,
    })
    .add({
      situation = [
        `No declaration follows the documentation`,
        `It is not one of two or more documentation blocks in a row that were all opened with [[BlockDocumentationOpen]]`,
      ],
      behavior = `Attaches to nothing`,
    })
    .add({
      situation = [
        `No declaration exists between two or more documentation blocks`,
        `Documentation blocks were all opened with [[BlockDocumentationOpen]]`,
        `No declaration follows the last of them`,
      ],
      behavior = `Attaches to the "global" object`,
    })
    .add({
      situation = [
        `[[LineDocumentationOpen]] is the first token`,
        `[[TemplateReference]] is used`,
      ],
      behavior = `A [[NewLine]] inside the [[TemplateReference]] is not trivia`,
    });
}
