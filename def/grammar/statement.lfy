use "./expression";
use "./tokens/identifier";
use "./tokens/keyword";
use "./tokens/literal";
use "./tokens/operator";
use "./tokens/separator";
use "./traits";

d BlockStatement is ebnfSyntax(`[[BlockOpenSeparator]] , (: [[Statement]] :) , [[BlockCloseSeparator]]`) {}

d AgentDataStatement is ebnfSyntax(`[[AgentDataKeyword]] , [[IdentityExpression]] , (/ [[ExtendsKeyword]] , [[GroupListExpression]] /) , ( [[BlockStatement]] | [[StatementEndSeparator]] )`) {}

d AgentFunctionStatement is ebnfSyntax(`[[AgentFnKeyword]] , [[FunctionIdentityExpression]] , (/ [[ArrowDoubleRightPunctuation]] , [[TypeOnlyExpression]] /) , ( [[BlockStatement]] | [[StatementEndSeparator]])`) {}

d AliasStatement is ebnfSyntax(`[[AliasKeyword]] , [[AssignmentExpression]] , [[StatementEndSeparator]]`) {}

d AsyncStatement is ebnfSyntax(`[[AsyncKeyword]] , [[Statement]]`) {}

d BreakStatement is ebnfSyntax(`[[BreakKeyword]] , [[StatementEndSeparator]]`) {}

d AceStatement is ebnfSyntax(`[[CompileTimeExecutionKeyword]] , [[Statement]]`) {}

d VariableStatement is ebnfSyntax(`( [[ConstKeyword]] | [[LetKeyword]] ) , [[AssignmentExpression]] , [[StatementEndSeparator]]`) {}

d ContinueStatement is ebnfSyntax(`[[ContinueKeyword]] , [[StatementEndSeparator]]`) {}

d IfStatement is ebnfSyntax(`[[IfKeyword]] , [[GroupedExpression]] , ( [[ExpressionStatement]] | [[BlockStatement]] ) , (: [[ElseIfStatement]] :) , (/ [[ElseStatement]] /)`) {}

d ElseIfStatement is ebnfSyntax(`[[ElseKeyword]] , [[IfKeyword]] , [[GroupedExpression]] , ( [[ExpressionStatement]] | [[BlockStatement]] )`) {}

d ElseStatement is ebnfSyntax(`[[ElseKeyword]] , ( [[ExpressionStatement]] | [[BlockStatement]] )`) {}

d EnumStatement is ebnfSyntax(`[[EnumKeyword]] , [[IdentityExpression]] , [[ObjectExpression]]`) {}

d ExternalStatement is ebnfSyntax(`[[ExternalKeyword]] , [[AssignmentExpression]] , [[StatementEndSeparator]]`) {}

d ExpressionStatement is ebnfSyntax(`[[Expression]] , [[StatementEndSeparator]]`) {}

d ForFromStatement is ebnfSyntax(`[[ForKeyword]] , [[GroupOpenSeparator]] , (/ [[ConstKeyword]] | [[LetKeyword]] /) , [[IdentityExpression]] , [[ListContinueSeparator]] , [[IdentityExpression]] , [[FromKeyword]] , [[Expression]] , (: [[ListContinueSeparator]] , [[Expression]] :) , (/ [[ListContinueSeparator]] /) , [[GroupCloseSeparator]] , [[BlockStatement]]`) {}

d ForInOfStatement is ebnfSyntax(`[[ForKeyword]] , [[GroupOpenSeparator]] , (/ [[ConstKeyword]] | [[LetKeyword]] /) , [[IdentityExpression]] , ( [[InKeyword]] | [[OfKeyword]] ) , [[Expression]] , (: [[ListContinueSeparator]] , [[Expression]] :) , (/ [[ListContinueSeparator]] /) , [[GroupCloseSeparator]] , [[BlockStatement]]`) {}

d FunctionStatement is ebnfSyntax(`[[FunctionKeyword]] , [[FunctionIdentityExpression]] , (/ [[ArrowSingleRightExpression]] , [[TypeOnlyExpression]] /) , [[BlockStatement]]`) {}

d FunctionInlineStatement is ebnfSyntax(`[[FunctionIdentityExpression]] , (/ [[ArrowSingleRightExpression]] , [[TypeOnlyExpression]] /) , [[ArrowDoubleRightPunctuation]] , ( [[ExpressionStatement]] | [[BlockStatement]] )` ) {}

d LoopStatement is ebnfSyntax(`[[LoopKeyword]] , [[BlockStatement]]`) {}

d MatchStatement is ebnfSyntax(`( [[MatchKeyword]] | [[MatchallKeyword]] ) , [[Expression]] , [[BlockOpenSeparator]] , (/ ( [[Expression]] | [[DefaultKeyword]] ) , [[ArrowDoubleRightPunctuation]] , [[Expression]] , (: [[ListContinueSeparator]] , ( [[Expression]] | [[DefaultKeyword]] ) , [[ArrowDoubleRightPunctuation]] , [[Expression]] :) /) , (/ [[ListContinueSeparator]] /) , [[BlockCloseSeparator]]`) {}

d ReturnStatement is ebnfSyntax(`[[ReturnKeyword]] , [[ExpressionStatement]]`) {}

d TraitStatement is ebnfSyntax(`[[TraitKeyword]] , [[Identifier]] , (/ [[GroupListExpression]] /) , (/ [[ExtendsKeyword]] , [[GroupListExpression]] /) , [[BlockStatement]]`) {}

d TypeStatement is ebnfSyntax(`[[TypeKeyword]] , [[IdentityExpression]] , [[ObjectExpression]]`) {}

d UseStatement is ebnfSyntax(`[[UseKeyword]] , ( [[StringLiteral]] | [[TemplateLiteral]] ) , (/ [[AsKeyword]] , [[Identifier]] /) , [[StatementEndSeparator]]`) {}

d WhileStatement is ebnfSyntax(`[[WhileKeyword]] , [[GroupedExpression]] , [[BlockStatement]]`) {}

d WithStatement is ebnfSyntax(`[[WithKeyword]] , [[IdentifierExpression]] , [[BlockStatement]]`) {}

d Statement is ebnfSyntax(`[[AgentDataStatement]] | [[AgentFunctionStatement]] | [[AliasStatement]] | [[AsyncStatement]] | [[BreakStatement]] | [[AceStatement]] | [[VariableStatement]] | [[ContinueStatement]] | [[IfStatement]] | [[EnumStatement]] | [[ExternalStatement]] | [[ExpressionStatement]] | [[ForFromStatement]] | [[ForInOfStatement]] | [[FunctionStatement]] | [[FunctionInlineStatement]] | [[LoopStatement]] | [[MatchStatement]] | [[ReturnStatement]] | [[TraitStatement]] | [[TypeStatement]] | [[UseStatement]] | [[WhileStatement]] | [[WithStatement]]`) {}
