use "elfie/target";
use "platforms";
use "rust" as Rust;

/// The targets of this repository. Every definition is built for rust, which global's targets
/// hold; the const keeps the name the maps folder elfie-compile/maps/rust was recorded under.

ace const rust: `The Elfie compiler, as a Cargo workspace of four crates` = targetOf({
  output = "crates",
  language = Rust.rust,
  // Decision: the release builds x86_64-pc-windows-msvc beside the Linux and macOS targets, so
  // the target lists windows too; code that only one of them can run is spelled for each.
  platforms = [posix, windows],
  ecosystem = Rust.cargo,
  layout = Rust.cargoWorkspace.layer(
    { lsp = "crates/elfie-lsp/src", mcp = "crates/elfie-mcp/src", cli = "crates/elfie-cli/src" },
    "crates/elfie-core/src",
    ["cli"],
  ),
  dependencies = [
    { name = "unicode-ident", version = "1" },
    { name = "serde_json", version = "1" },
    { name = "sha2", version = "0.11" },
    { name = "tokio", version = "1" },
    { name = "tower-lsp", version = "0.20" },
    { name = "rmcp", version = "3" },
    { name = "axum", version = "0.8" },
    { name = "regex", version = "1" },
    { name = "getrandom", version = "0.4" },
    { name = "clap", version = "4" },
  ],
});

// Guidance only this repository needs
// Decision: units are compiled one at a time and the workspace must build after each, so a unit may
// leave a stub in a later unit's code, which only that unit's own compile replaces; clippy and a
// test that reaches a stub are held to at the end of a compile, when no stub is left.
rust
  @acceptanceCriteria
  .add({
    situation = `A unit's outputs are accepted, with other units of the compile still to come`,
    behavior = [
      `cargo build for the whole workspace passes`,
      `Every test cargo test runs for the whole workspace passes or fails only by reaching a stub`,
    ],
  })
  .add({
    situation = `A compile ends`,
    behavior = `cargo build, cargo test, and cargo clippy for the whole workspace pass without warnings`,
  })
  .add({ behavior = `cargo check --target x86_64-pc-windows-msvc for the whole workspace passes without warnings` });

// Module size
// Decision: a unit's module of 8,000 to 10,000 lines costs every compiler and verifier that reads
// it, so a file that would exceed 2,000 lines is split into submodule files. The guidance applies
// when a unit is next compiled; changing it re-plans no unit, because guidance is no part of a
// unit's text, criteria, or interfaces, so modules are split one unit at a time.
rust
  @acceptanceCriteria
  .add({
    situation = `An output file of a unit would hold more than 2,000 lines, counting the unit's code and tests together, wherever they are`,
    behavior = `The unit's code is split into submodules of that file's module, each in a file of its own where Rust looks for it: beside a mod.rs, lib.rs, or main.rs, and otherwise in a directory named after the module`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `Each submodule is declared with a mod line in the module file, with no #[path] attribute`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `Each output file of the unit, the module file and every submodule's file, holds at most 2,000 lines`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `Each submodule holds the code of one or more entities of the unit, or one concern of an entity too large for one file, with the data, types, and helpers only that code uses`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `Of the unit's own code, the module file holds only the mod declarations of its submodules, the pub use lines other units need, helpers more than one submodule uses, and the crate's entry point when the module file is main.rs; every line other units or the layout put in it stays`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `Every path by which another unit reached an item of the module before the split still reaches it, through a pub use in the module file, so no other unit's output changes`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `The unit's tests are split the same way: each file of tests holds the tests of one or more entities, or of one concern of an entity too large for one file, is declared under #[cfg(test)], and holds at most 2,000 lines`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `A submodule's file is named in snake_case after the entity it holds or the concern its code shares, and is neither another unit's output nor the path a stem of the target's source directory would spell`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `Each marker moves with the code it marks, and keeps its source path, entity, and requirement id`,
  })
  .add({
    situation = `A unit's code is split into submodules`,
    behavior = `A submodule's file begins with a marker before any item`,
  });

// Repository facts a compiler would otherwise rediscover
rust@knowledge.add({
  topic = `This repository: Cargo package names and scopes, no cargo fmt, shared outputs, tests that load def/`,
  kind = KnowledgeKind.reference,
  source = "def/knowledge/repository.md",
  quote = true,
});

// Decision: committed code is not rustfmt-clean, so cargo fmt never runs here.
rust@commands.add({ operation = Operation.format });

global@targets.add(rust);
