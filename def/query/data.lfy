use "../grammar/rules/expression";
use "../grammar/terminals/comment";
use "../grammar/terminals/identifier";
use "../grammar/terminals/keyword";
use "../grammar/terminals/space";
use "../lexer/data";
use "../model/data";
use "../model/main" as Binder;
use "../model/traits";
use "../parser/data";

d Position: `A place in a file's text` {
  $line: `The line, counting from 1 as [[Token.line]] does` = number;
  $column: `The column within the line, counting characters from 0 as [[Token.column]] does` = number;
  @acceptanceCriteria
    .add({ behavior = `A position in a file belongs to the token of that file whose range covers it` })
    .add({
      situation = [
        `The position is exactly between two tokens`,
        `The earlier token is an [[Identifier]], a [[Keyword]], or a [[MemberName]]`,
      ],
      behavior = `A position between two tokens belongs to the earlier token`,
    })
    .add({
      situation = [
        `The position is exactly between two tokens`,
        `The earlier token is not an [[Identifier]], a [[Keyword]], or a [[MemberName]]`,
      ],
      behavior = `A position between two tokens belongs to the later token`,
    })
    .add({ situation = `The position is past the end of its file`, behavior = `It belongs to no token` })
    .add({ behavior = `A [[Node]] contains a position when it covers the token the position belongs to` });
}

d Range: `A run of text in one file` {
  $file: `The file's path, as [[Token.file]] holds it` = string;
  $start: `Where it begins` = Position;
  $end: `The position just after the last character; equal to [[Range.start]] when empty` = Position;
  @acceptanceCriteria
    .add({ behavior = `The range of a [[Token]] is in its [[Token.file]]` })
    .add({ behavior = `The range of a [[Token]] starts at its [[Token.line]] and [[Token.column]]` })
    .add({
      behavior = `The range of a [[Token]] ends just after the last character of its [[Token.raw]], each [[NewLine]] inside it ending a line`,
    })
    .add({
      behavior = `The range of a [[Node]] or an [[ErrorNode]] runs from the start of the range of the first token it covers to the end of the range of the last`,
    })
    .add({
      situation = `A [[Node]] or an [[ErrorNode]] covers no token`,
      behavior = `Its range is empty, at the position where it would start`,
    });
}

enum Severity: `How bad a diagnostic is` {
  error = `error`,
  warning = `warning`,
  information = `information`,
  hint = `hint`,
}

d Diagnostic: `One problem, placed` {
  $range: `Where it is` = Range;
  $severity: `How bad it is` = Severity;
  $stage: `Who reported it` = Stage;
  $message: `What and why` = string;
}

d Hover: `Everything an editor or agent shows for one entity` {
  $range: `The identifier of the entity's declaration, as [[declaring]] finds it` = Range;
  $kind: `The kind of the entity's symbol` = SymbolKind;
  $identifier: `The entity's name` = string;
  $definition: `[[Entity.definition]] with every template reference and execution resolved for the entity` = string | undefined;
  $type: `[[Entity.type]] as [[typeTextOf]] spells it; undefined when there is none` = string | undefined;
  $owner: `The identifier of the declaration that lists a type parameter or declares a member; undefined for anything else` = string | undefined;
  $traits: `The identifier of each of [[Entity.traits]] in application order; builtin among them for a native thing` = string[];
  $documentation: `The text of the [[Documentation]] attached to the declaration, without the boundaries and with references kept as written` = string | undefined;
  $criteria: `[[Binder.criteriaOf]] the entity` = Criterion[];
}

enum CompletionKind: `What a completion offers when it does not name a declaration` {
  keyword = `keyword`,
  path = `path`,
  context = `context`,
}

d Completion: `One thing that could be typed at a position` {
  $label: `What is shown and inserted` = string;
  $kind: `What it offers` = SymbolKind | CompletionKind;
  $detail: `The definition, when there is one` = string | undefined;
}

d Outline: `One declaration in the outline of a file` {
  $name: `The declared name` = string;
  $kind: `The kind of the declaration` = SymbolKind;
  $range: `The whole declaration, its [[Documentation]] included` = Range;
  $selectionRange: `The identifier alone` = Range;
  $children: `Members and the declarations nested in its body, in order` = Outline[];
}

d Edit: `One replacement in one file` {
  $range: `What is replaced` = Range;
  $text: `What replaces it` = string;
}

// Semantic tokens

enum TokenType: `What a semantic token stands for; the protocol's own kinds where one fits, and data and trait where Elfie has no equivalent there` {
  namespace = `namespace`,
  data = `data`,
  _trait = `trait`,
  _type = `type`,
  _enum = `enum`,
  enumMember = `enumMember`,
  _function = `function`,
  parameter = `parameter`,
  typeParameter = `typeParameter`,
  variable = `variable`,
  property = `property`,
}

enum TokenModifier: `What refines a semantic token` {
  declaration = `declaration`,
  agentic = `agentic`,
  readonly = `readonly`,
  context = `context`,
  scope = `scope`,
  value = `value`,
  documentation = `documentation`,
  unresolved = `unresolved`,
}

d SemanticToken: `One name in a file, classified by what it resolves to` {
  $range: `The token that spells the name` = Range;
  $type: `What it stands for` = TokenType;
  $modifiers: `What refines it, in [[TokenModifier]] order; empty when nothing does` = TokenModifier[];
}
