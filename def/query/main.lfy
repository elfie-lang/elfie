// Lookup Queries

/// file: relative to [[Workspace.root]], as [[File.path]] is
fn symbolAt(workspace: Workspace, file: string, position: Position): `The symbol declared or used at a position` => Symbol | undefined {
  @acceptanceCriteria
    .add({
      situation = [
        `The token [[position]] belongs to is an [[Identifier]] or a keyword standing as a [[MemberName]]`,
        `The token is not inside a [[TemplateReference]]`,
        `A node containing [[position]] declares or resolves to a symbol whose name that token spells`,
      ],
      behavior = `Returns the symbol that [[Binder.resolve]] gives for the innermost such node`,
    })
    .add({
      situation = [
        `The token [[position]] belongs to is an [[Identifier]] or a keyword standing as a [[MemberName]]`,
        `The token is not inside a [[TemplateReference]]`,
        `No node containing [[position]] declares or resolves to a symbol whose name that token spells`,
      ],
      behavior = `Returns undefined`,
    })
    .add({
      situation = `The token [[position]] belongs to is inside a [[TemplateReference]], including one inside [[Documentation]]`,
      behavior = `Returns the symbol of the [[Usage]] of the [[Reference]]`,
    })
    .add({
      situation = [
        `The token [[position]] belongs to is the [[DoubleQuoteBody]] or [[SingleQuoteBody]] of a [[Use]]`,
        `The [[Use]] has an [[AsKeyword]]`,
      ],
      behavior = `Returns the module symbol the [[Use]] declares`,
    })
    .add({
      situation = [
        `The token [[position]] belongs to is the [[DoubleQuoteBody]] or [[SingleQuoteBody]] of a [[Use]]`,
        `The [[Use]] has no [[AsKeyword]]`,
      ],
      behavior = `Returns undefined`,
    })
    .add({
      situation = `[[file]] is not in [[Workspace.files]], or [[position]] belongs to no token`,
      behavior = `Returns undefined`,
    })
    .add({
      situation = `The token [[position]] belongs to is none of these: an [[Identifier]], a keyword standing as a [[MemberName]], a token inside a [[TemplateReference]], the [[DoubleQuoteBody]] or [[SingleQuoteBody]] of a [[Use]]`,
      behavior = `Returns undefined`,
    });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y = A;`),
        `def/a.lfy`,
        Position@like(`on the A after the equals sign`),
      ],
      expect = Symbol@like(`The symbol A of kind data`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y: \`See \[[A\]]\` = 1;`),
        `def/a.lfy`,
        Position@like(`on the A inside the template reference`),
      ],
      expect = Symbol@like(`The symbol A of kind data`),
    },
  );
}

// Definition Queries

fn definitionOf(workspace: Workspace, file: string, position: Position): `Where the symbol at a position is declared` => Range | undefined {
  @acceptanceCriteria
    .add({
      situation = `[[position]] is on the path of a [[Use]]`,
      behavior = `Returns an empty range at line 1, column 0 of the file the [[Use]] resolved to in [[Source.uses]]`,
    })
    .add({
      situation = [
        `[[position]] is not on the path of a [[Use]]`,
        `[[symbolAt]] is a module symbol`,
      ],
      behavior = `Returns an empty range at line 1, column 0 of the file its [[Use]] resolved to in [[Source.uses]]`,
    })
    .add({
      situation = [
        `[[position]] is not on the path of a [[Use]]`,
        `[[symbolAt]] is neither undefined nor a module symbol`,
      ],
      behavior = `Returns the [[Range]] of the identifier that spells the name in [[Symbol.node]] of [[symbolAt]], as [[namedBy]] finds it`,
    })
    .add({
      situation = [
        `[[position]] is not on the path of a [[Use]]`,
        `[[symbolAt]] is undefined`,
      ],
      behavior = `Returns undefined`,
    });

  @test(
    {
      input = [
        Workspace@like(`Two files: def/a.lfy reading: use "./b"; and def/b.lfy reading: d B {}`),
        `def/a.lfy`,
        Position@like(`inside the path ./b`),
      ],
      expect = Range@like(`Empty, at line 1, column 0 of def/b.lfy`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} alias C = A; const y = C;`),
        `def/a.lfy`,
        Position@like(`on the C after the last equals sign`),
      ],
      expect = Range@like(`The C of the alias declaration, not the declared A`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: trait t { $m = string; } d A is t { $n = A$m; }`),
        `def/a.lfy`,
        Position@like(`on the m after the dollar sign`),
      ],
      expect = Range@like(`The m inside the body of trait t`),
    },
  );
}

/// includeDeclaration: whether the range of the symbol's declaration comes first
fn referencesTo(workspace: Workspace, file: string, position: Position, includeDeclaration: boolean = true): `Every place the symbol at a position is used` => Range[] {
  @acceptanceCriteria
    .add({
      situation = [
        `[[symbolAt]] is not undefined`,
        `[[includeDeclaration]] is true`,
      ],
      behavior = `Returns the range [[definitionOf]] gives, then one range per [[Usage]] in [[Binder.usagesOf]] the symbol, in [[Workspace.files]] order, then by [[Range.start]]`,
    })
    .add({
      situation = [
        `[[symbolAt]] is not undefined`,
        `[[includeDeclaration]] is false`,
      ],
      behavior = `Returns one range per [[Usage]] in [[Binder.usagesOf]] the symbol, in [[Workspace.files]] order, then by [[Range.start]]`,
    })
    .add({
      situation = `A [[Usage]] in [[Binder.usagesOf]] the symbol is not of a layer itself`,
      behavior = `The range of that usage covers the token that spells the name`,
    })
    .add({
      situation = `A [[Usage]] in [[Binder.usagesOf]] the symbol is of a layer itself`,
      behavior = `The range of that usage covers the accessor`,
    })
    .add({ situation = `[[symbolAt]] is undefined`, behavior = `Returns an empty list` });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y = ^^; const z = A;`),
        `def/a.lfy`,
        Position@like(`on the declared A`),
      ],
      expect = Range[]@like(`The declared A, then the two carets, then the A after the last equals sign`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y = A;`),
        `def/a.lfy`,
        Position@like(`on the declared A`),
        false,
      ],
      expect = Range[]@like(`One range: the A after the equals sign`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} alias C = A; const y = C;`),
        `def/a.lfy`,
        Position@like(`on the declared A`),
      ],
      expect = Range[]@like(
        `The declared A, then the A after alias C's equals sign, then the C after the last equals sign`,
      ),
    },
  );
}

fn sourceOf(workspace: Workspace, entity: Entity): `The text that declares an entity` => string {
  @acceptanceCriteria
    .add({
      behavior = `The joined [[Token.raw]] of every token [[Entity.node]] covers, with the text of its [[documented]] nodes before it`,
    })
    .add({ situation = `[[entity]] is the anonymous entity of a file`, behavior = `The whole file` })
    .add({
      situation = `[[entity]] is a member added by a trait`,
      behavior = `The member statement inside the trait body`,
    });
}

fn semanticTokensOf(workspace: Workspace, file: string): `Every name of a file, classified by meaning for an editor to color` => SemanticToken[] {
  // Which tokens
  @acceptanceCriteria
    .add({ behavior = `One [[SemanticToken]] per token that spells a declared name or a used name` })
    .add({ behavior = `Keywords, punctuation, strings, numbers, and comments get no [[SemanticToken]]` })
    .add({ behavior = `Tokens are in position order and never overlap` })
    .add({ situation = `[[file]] is not in [[Workspace.files]]`, behavior = `Returns an empty list` });

  // Type
  @acceptanceCriteria
    .add({
      situation = `The token declares or resolves to a symbol whose kind has a [[TokenType]] of the same name`,
      behavior = `[[SemanticToken.type]] is the [[TokenType]] of the same name as the kind`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind.agentFunction]]`,
      behavior = `[[SemanticToken.type]] is [[TokenType._function]]`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind.loopVariable]] or [[SymbolKind._external]]`,
      behavior = `[[SemanticToken.type]] is [[TokenType.variable]]`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind.member]]`,
      behavior = `[[SemanticToken.type]] is [[TokenType.property]], whatever the member's value is`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind._module]]`,
      behavior = `[[SemanticToken.type]] is [[TokenType.namespace]]`,
    })
    .add({
      situation = `The token declares or resolves to an alias`,
      behavior = `[[SemanticToken.type]] is that of the entity the alias is bound to`,
    })
    .add({
      situation = [
        `The token is the [[MemberName]] after a [[ContextAccessor]]`,
        `It names a member of a kind data other than the left side's`,
      ],
      behavior = `[[SemanticToken.type]] is [[TokenType.property]]`,
    })
    .add({
      situation = [
        `The token neither declares nor resolves to a symbol`,
        `The binder added a [[Problem]] at it`,
      ],
      behavior = [
        `[[SemanticToken.type]] is [[TokenType.variable]]`,
        `unresolved is among its modifiers`,
      ],
    })
    .add({
      situation = [
        `The token neither declares nor resolves to a symbol`,
        `The binder added no [[Problem]] at it`,
        `It names no member of any kind data`,
      ],
      behavior = `It gets no [[SemanticToken]]`,
    });

  // Modifiers
  @acceptanceCriteria
    .add({ situation = `The token spells the name in a declaration`, behavior = `declaration is among its modifiers` })
    .add({
      situation = `The token does not spell the name in a declaration`,
      behavior = `declaration is not among its modifiers`,
    })
    .add({
      situation = `The token declares or resolves to an entity declared with [[AgentDataKeyword]] or [[AgentFunctionKeyword]]`,
      behavior = `agentic is among the modifiers of every token of that entity, declaration and use alike`,
    })
    .add({
      situation = `The token declares or resolves to a variable declared with [[ConstKeyword]]`,
      behavior = `readonly is among the token's modifiers`,
    })
    .add({ situation = `The token follows a [[ContextAccessor]]`, behavior = `context is among its modifiers` })
    .add({
      situation = `The token follows a [[ScopeAccessor]] or [[ParentScopeAccessor]]`,
      behavior = `scope is among its modifiers`,
    })
    .add({
      situation = `The token follows a [[ValueAccessor]] or [[OptionalValueAccessor]]`,
      behavior = `value is among its modifiers`,
    })
    .add({
      situation = `The token is inside a [[TemplateReference]], a [[TemplateExecution]], or [[Documentation]]`,
      behavior = `documentation is among its modifiers`,
    })
    .add({ behavior = `Modifiers are in [[TokenModifier]] order and each appears once` });

  @test(
    {
      input = [Workspace@like(`One file a.lfy reading: d A { $x: \`d\` = string; } const y = A$x;`), `def/a.lfy`],
      expect = SemanticToken[]@like(
        `Among them: y as variable with declaration and readonly, and the x after the dollar sign as property with scope`,
      ),
    },
    {
      input = [
        Workspace@like(
          `One file a.lfy reading: fn f(): \`See \[[g\]]\` => number { @acceptanceCriteria.add({ behavior = \`b\` }); }`,
        ),
        `def/a.lfy`,
      ],
      expect = SemanticToken[]@like(
        `Among them: g as variable with documentation and unresolved, and acceptanceCriteria as property with context; none for add`,
      ),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d Box<T> { $item: \`d\` = T; } const b = Box<string>;`),
        `def/a.lfy`,
      ],
      expect = SemanticToken[]@like(
        `Among them: the T in Box<T> as typeParameter with declaration, and the T after the equals sign as typeParameter with no modifiers; none for string`,
      ),
    },
  );
}

// Hover Queries

fn hoverOf(workspace: Workspace, entity: Entity): `Everything shown for one entity` => Hover {
  @acceptanceCriteria
    .add({ behavior = `[[Hover.range]] covers the identifier of the entity's declaration, as [[namedBy]] finds it` })
    .add({
      situation = `[[entity]] is not a member`,
      behavior = `[[Hover.kind]] is [[Symbol.kind]] of [[Entity.symbol]]`,
    })
    .add({ situation = `[[entity]] is a member`, behavior = `[[Hover.kind]] is [[SymbolKind.member]]` })
    .add({ situation = `[[entity]] is not anonymous`, behavior = `[[Hover.identifier]] is [[Entity.identifier]]` })
    .add({
      situation = `[[entity]] is anonymous`,
      behavior = `[[Hover.identifier]] is the text of the first line of [[Entity.node]]`,
    })
    .add({
      situation = `[[entity]] is not a type parameter`,
      behavior = `[[Hover.definition]] is [[Entity.definition]] with its templates resolved for the entity as [[Binder.criteriaOf]] resolves those of a criterion`,
    })
    .add({
      situation = `[[entity]] is not a type parameter`,
      behavior = `[[Hover.type]] is [[typeTextOf]] [[Entity.type]]`,
    })
    .add({
      situation = `[[entity]] is a type parameter`,
      behavior = `[[Hover.owner]] is the identifier of the declaration whose [[TypeParameters]] lists it`,
    })
    .add({
      situation = `[[entity]] is a member`,
      behavior = `[[Hover.owner]] is the identifier of its [[Kinds.Member.owner]]`,
    })
    .add({ situation = `[[entity]] is neither a type parameter nor a member`, behavior = `[[Hover.owner]] is undefined` })
    .add({
      behavior = `[[Hover.documentation]] is the joined text of the [[documented]] nodes of the declaration, each line without its opener and closer and without one leading space`,
    })
    .add({ behavior = `Template references in [[Hover.documentation]] are kept as written` })
    .add({
      situation = `[[entity]] is not a type parameter`,
      behavior = `[[Hover.traits]] is the identifier of each of [[Entity.traits]], in application order`,
    })
    .add({ situation = `[[entity]] is a native data or fn`, behavior = `[[builtin]] is among [[Hover.traits]]` })
    .add({
      situation = `[[entity]] is not a type parameter`,
      behavior = `[[Hover.criteria]] is [[Binder.criteriaOf]] the entity`,
    })
    .add({
      situation = `[[entity]] is a type parameter`,
      behavior = `[[Hover.definition]] is undefined, and [[Hover.traits]] and [[Hover.criteria]] are empty`,
    })
    .add({
      situation = [
        `[[entity]] is a type parameter`,
        `It has a constraint, the type after its [[ExtendsKeyword]]`,
      ],
      behavior = `[[Hover.type]] is [[typeTextOf]] that constraint`,
    })
    .add({
      situation = [
        `[[entity]] is a type parameter`,
        `It has no [[ExtendsKeyword]] constraint`,
      ],
      behavior = `[[Hover.type]] is undefined`,
    });
}

fn hoverAt(workspace: Workspace, file: string, position: Position): `Everything shown for the symbol at a position` => Hover | undefined {
  @acceptanceCriteria
    .add({ behavior = `Returns [[hoverOf]] the entity of [[symbolAt]]` })
    .add({ situation = `[[symbolAt]] is undefined`, behavior = `Returns undefined` });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: /// Doc\nd A: \`An A\` {} const y = A;`),
        `def/a.lfy`,
        Position@like(`on the A after the equals sign`),
      ],
      expect = Hover@like(`kind data, identifier A, definition An A, documentation Doc, no criteria`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d Item {} d Box<T extends Item> { $item: \`d\` = T; }`),
        `def/a.lfy`,
        Position@like(`on the T after the equals sign`),
      ],
      expect = Hover@like(`kind typeParameter, identifier T, type Item, owner Box, no definition, no criteria`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y = A@definition;`),
        `def/a.lfy`,
        Position@like(`on definition`),
      ],
      expect = Hover@like(
        `kind member, identifier definition, owner Entity, the range of definition in the library file that declares [[Prelude.Entity]], and the definition and type of [[Prelude.Entity.definition]]`,
      ),
    },
  );
}

// Recommendation Queries

ace function afterToken(tokens: string): `A completion context set by the token written before the position` -> string {
  return `The nearest token before the position that is not [[trivia]], the identifier characters typed before the position aside, is {{tokens}}`;
}

enum CompletionContext: `Where a completion is asked` {
  usePath = `The position is inside the string of a [[Use]]`,
  context = afterToken(`a [[ContextAccessor]]`),
  scope = afterToken(`a [[ScopeAccessor]]`),
  parentScope = afterToken(`a [[ParentScopeAccessor]]`),
  value = afterToken(`a [[ValueAccessor]] or an [[OptionalValueAccessor]]`),
  traitName = afterToken(
    `an [[IsKeyword]], the [[ExtendsKeyword]] of an [[ExtendsClause]], or a [[Comma]] inside [[TraitUses]]`,
  ),
  prose = `The position is inside a [[TemplateReference]] or [[Documentation]]`,
  typeName = afterToken(
    `the [[Colon]] of a [[DefinitionClause]] or [[Definition]], the [[LessThan]] or a [[Comma]] of [[TypeArguments]] or of [[Generic]], or the [[ExtendsKeyword]] or [[PlainSetter]] of a [[TypeParameter]]`,
  ),
  statement = `A [[Statement]] can begin at the position`,
  expression = `An [[Expression]] can begin at the position`,
}

// Decision: the contexts are tried in order and the first that holds decides, so each criterion below
// names one context and none has to negate the others.
/// file: relative to [[Workspace.root]], as [[File.path]] is
fn completionsAt(workspace: Workspace, file: string, position: Position): `What could be typed at a position` => Completion[] {
  // Every context
  @acceptanceCriteria
    .add({
      behavior = `The completion context at [[position]] is the first value of [[CompletionContext]], in order, that holds there`,
    })
    .add({
      behavior = `Only completions whose label begins with the identifier characters typed before [[position]] are returned, compared case sensitively`,
    })
    .add({ behavior = `No two completions have the same label` })
    .add({
      behavior = `Completions from a nearer scope come before those from an enclosing scope, then in file order, then those of kind [[CompletionKind.keyword]]`,
    })
    .add({ situation = `No value of [[CompletionContext]] holds at [[position]]`, behavior = `Returns an empty list` });

  // Layers
  @acceptanceCriteria
    .add({
      situation = [
        `The completion context is [[CompletionContext.context]]`,
        `The [[Member]] has a left side`,
      ],
      behavior = `One completion of kind [[CompletionKind.context]] per member of [[Prelude.Entity]], then one per member of the data for the kind of the entity the left side resolves to, each labelled by the member's name`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.context]]`,
        `The accessor has no left side`,
      ],
      behavior = `One completion of kind [[CompletionKind.context]] per member of [[Prelude.Entity]], then one per member of the data for the kind of [[Scope.current]] of the scope that holds the position, each labelled by the member's name`,
    })
    .add({
      situation = `The completion context is [[CompletionContext.scope]]`,
      behavior = `The members of [[Scope.current]] of the scope that holds the position`,
    })
    .add({
      situation = `The completion context is [[CompletionContext.parentScope]]`,
      behavior = `The members of [[Scope.current]] of [[Scope.parent]] of the scope that holds the position`,
    });

  // Values
  @acceptanceCriteria
    .add({
      situation = [
        `The completion context is [[CompletionContext.value]]`,
        `The left side of the [[Member]] resolves to a module`,
      ],
      behavior = `The module's symbols`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.value]]`,
        `The left side of the [[Member]] resolves to an entity that is not a module, an enum, or an object, and whose value is not a string, a number, or a list`,
      ],
      behavior = `The entity's own members, then the members of its kind data whose value is a function`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.value]]`,
        `The left side of the [[Member]] resolves to an enum`,
      ],
      behavior = `The enum's keys`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.value]]`,
        `The left side of the [[Member]] resolves to an object`,
      ],
      behavior = `The object's keys, then the members of [[Objects.Object]]`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.value]]`,
        `The left side of the [[Member]] resolves to an entity whose value is a string`,
      ],
      behavior = `The entity's own members, then every member of [[Strings.String]]`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.value]]`,
        `The left side of the [[Member]] resolves to an entity whose value is a number`,
      ],
      behavior = `The entity's own members, then every member of [[Numbers.Number]]`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.value]]`,
        `The left side of the [[Member]] resolves to an entity whose value is a list`,
      ],
      behavior = `The entity's own members, then every member of [[Lists.List]]`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.value]]`,
        `The left side of the [[Member]] resolves to nothing`,
      ],
      behavior = `Returns an empty list`,
    });

  // Names
  @acceptanceCriteria
    .add({
      situation = [
        `The completion context is [[CompletionContext.usePath]]`,
        `The path begins with a dot`,
      ],
      behavior = `Of kind [[CompletionKind.path]]: the directories and the .lfy files without their extension under the directory the path names so far, relative to the file's directory`,
    })
    .add({
      situation = [
        `The completion context is [[CompletionContext.usePath]]`,
        `The path does not begin with a dot`,
      ],
      behavior = `Of kind [[CompletionKind.path]]: the identifier of each [[Package]], then the directories and the .lfy files without their extension under the directory the path names so far, relative to that package's root`,
    })
    .add({
      situation = `The completion context is [[CompletionContext.traitName]]`,
      behavior = `Every symbol of kind [[SymbolKind._trait]] visible from the position, plus the module symbols`,
    })
    // Decision: rule identifiers are offered because a reference found nowhere in scope resolves to a rule.
    .add({
      situation = `The completion context is [[CompletionContext.prose]]`,
      behavior = `Every name visible from the position, then every [[rule]] entity's identifier`,
    })
    .add({
      situation = `The completion context is [[CompletionContext.typeName]]`,
      behavior = `Every symbol of kind [[SymbolKind.data]], [[SymbolKind._type]], [[SymbolKind._enum]], [[SymbolKind._trait]], or [[SymbolKind.typeParameter]] visible from the position, then the primitive type keywords`,
    })
    .add({
      situation = `The completion context is [[CompletionContext.statement]]`,
      behavior = `Every name visible from the position, then the keyword that begins each [[statement]] rule`,
    })
    .add({
      situation = `The completion context is [[CompletionContext.expression]]`,
      behavior = `Every name visible from the position, then the value keywords true, false, null, and undefined, then the primitive type keywords`,
    });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A { $x = string; } const y = A@`),
        `def/a.lfy`,
        Position@like(`just after the at sign`),
      ],
      expect = Completion[]@like(
        `One per member of [[Prelude.Entity]], identifier, definition, and like among them, each of kind [[CompletionKind.context]] with the member's definition as detail; no A or y`,
      ),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: const s = "x"; const y = s.`),
        `def/a.lfy`,
        Position@like(`just after the dot`),
      ],
      expect = Completion[]@like(
        `One per member of [[Strings.String]], length and trim among them, each of kind [[SymbolKind.member]]; no s or y`,
      ),
    },
    {
      input = [Workspace@like(`One file a.lfy reading: trait t {} d A is `), `def/a.lfy`, Position@like(`at the end`)],
      expect = Completion[]@like(`t alone, of kind trait`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d Item {} d Box<T> { $pair: \`d\` = Box<`),
        `def/a.lfy`,
        Position@like(`just after the less-than sign`),
      ],
      expect = Completion[]@like(
        `T of kind typeParameter, Item and Box of kind data, then the primitive type keywords; no pair`,
      ),
    },
    {
      input = [
        Workspace@like(`Two files: def/a.lfy reading: use "./"; and def/b.lfy, empty`),
        `def/a.lfy`,
        Position@like(`just after the slash`),
      ],
      expect = Completion[]@like(`a and b, each of kind [[CompletionKind.path]]`),
    },
    {
      input = [
        Workspace@like(
          `Two files: def/a.lfy reading: d A: \`See \[[Wo\]]\` {} and def/b.lfy reading: trait rule {} d Word is rule {}`,
        ),
        `def/a.lfy`,
        Position@like(`just after Wo`),
      ],
      expect = Completion[]@like(`Word alone, although def/a.lfy does not use def/b.lfy`),
    },
  );
}

/// file: the only file whose diagnostics are returned, relative to [[Workspace.root]]; every file's when left out
fn diagnosticsOf(workspace: Workspace, file?: string): `Every problem of the program, placed` => Diagnostic[] {
  @acceptanceCriteria
    .add({
      situation = `A [[LoadProblem]] has a path`,
      behavior = `An error of stage loader at an empty range at line 1, column 0 of that path`,
    })
    .add({
      situation = `A [[LoadProblem]] has no path`,
      behavior = `An error of stage loader at an empty range at line 1, column 0 of elfie.json under [[Workspace.root]], whether or not that file exists`,
    })
    .add({
      situation = [
        `A [[Token]] has no [[Token.rule]]`,
        `[[Token.raw]] of the token is not empty`,
      ],
      behavior = `An error of stage lexer at the token, whose message is invalid text`,
    })
    .add({
      situation = [
        `A [[Token]] has no [[Token.rule]]`,
        `[[Token.raw]] of the token is empty`,
      ],
      behavior = `An error of stage lexer at the token, whose message names the mode left open`,
    })
    .add({
      situation = `An [[ErrorNode]] without [[ErrorNode.keyword]] is in a tree`,
      behavior = `An error of stage parser at the node, whose message lists [[ErrorNode.expected]] and the text found`,
    })
    .add({
      situation = `An [[ErrorNode]] with [[ErrorNode.keyword]] is in a tree`,
      behavior = `An error of stage parser at [[ErrorNode.keyword]], whose message is the token's text followed by: is a keyword and cannot be a name`,
    })
    .add({
      situation = `A [[Problem]] is in [[Workspace.problems]]`,
      behavior = `An error at [[Problem.node]] with [[Problem.message]], of stage [[Problem.stage]]`,
    })
    // Decision: a file that declares nothing of its own, as the main file of the package elfie does, only
    // re-exports what it uses, so its uses are never warned about.
    .add({
      situation = [
        `A [[Use]] without [[AsKeyword]] imports symbols of which none is used in the file, or one with [[AsKeyword]] whose module symbol is never used`,
        `The file holding the [[Use]] declares a symbol of its own`,
      ],
      behavior = `A warning of stage binder at the [[Use]]`,
    })
    .add({ behavior = `Diagnostics are in [[Workspace.files]] order, then by [[Range.start]], with elfie.json first` });

  @test(
    {
      input = [Workspace@like(`One file a.lfy reading: const y = z;`)],
      expect = Diagnostic[]@like(`One error of stage binder at z`),
    },
    {
      input = [Workspace@like(`One file a.lfy reading: const = 1;`), `def/a.lfy`],
      expect = Diagnostic[]@like(`One error of stage parser at the equals sign expecting [[Identifier]]`),
    },
    {
      input = [
        Workspace@like(`Two files: def/a.lfy reading: use "./b"; const y = 1; and def/b.lfy reading: d B {}`),
      ],
      expect = Diagnostic[]@like(`One warning of stage binder at the use of ./b`),
    },
    {
      input = [Workspace@like(`Two files: def/a.lfy reading: use "./b"; and def/b.lfy reading: d B {}`)],
      expect = Diagnostic[]@like(`None`),
    },
  );
}

// Search Queries

fn outlineOf(workspace: Workspace, file: string): `The declarations of one file, nested as written` => Outline[] {
  @acceptanceCriteria
    .add({
      behavior = `One [[Outline]] per symbol declared in the file scope, in order, except module symbols and the symbols a [[Use]] imports`,
    })
    .add({
      behavior = `[[Outline.children]] holds the members of a data, trait, type, or enum declaration, then every declaration nested in its body, in order`,
    })
    .add({ behavior = `Parameters and loop variables are in no [[Outline.children]]` })
    .add({ situation = `[[file]] is not in [[Workspace.files]]`, behavior = `Returns an empty list` });

  @test({
    input = [
      Workspace@like(
        `One file a.lfy reading: d A { $x = string; fn f(p: string) { const q = 1; } } function g(r: number) { for (const i in [1]) { const s = i; } }`,
      ),
      `def/a.lfy`,
    ],
    expect = Outline[]@like(
      `A, whose children are x then f, f having child q; then g, having child s; no p, r, or i anywhere`,
    ),
  });
}

fn findSymbols(workspace: Workspace, query: string): `Declarations across the program whose name contains a text` => Outline[] {
  @acceptanceCriteria
    .add({
      situation = `[[query]] is not empty`,
      behavior = `Every [[Outline]] of every file, flattened, whose name contains [[query]] ignoring case`,
    })
    .add({
      situation = [
        `[[query]] is not empty`,
        `An [[Outline]] is a child of another [[Outline]]`,
      ],
      behavior = `Its name is its parent's name, a dot, and its own`,
    })
    .add({ situation = `[[query]] is empty`, behavior = `Every top level declaration of every file` })
    .add({
      behavior = `Files without a [[File.package]] come first, then package files, each in [[Workspace.files]] order`,
    });

  @test({
    input = [
      Workspace@like(
        `A program file def/a.lfy reading: d Alpha { $beta = string; } and a package file main.lfy reading: d Beta {}`,
      ),
      `beta`,
    ],
    expect = Outline[]@like(`Alpha.beta, then Beta`),
  });
}

// Decision: entities of the same name in different files are all returned; the reader tells them apart by file.
/// name: an identifier, or an owner's identifier, a dot, and a member's name; either may follow a file path and a colon
fn find(workspace: Workspace, name: string): `Entities by the name an agent would spell` => Entity[] {
  @acceptanceCriteria
    .add({
      situation = `What follows any file path and colon in [[name]] is an identifier`,
      behavior = `Every entity whose symbol has that name in a file scope`,
    })
    .add({
      situation = `What follows any file path and colon in [[name]] is an owner's identifier, a dot, and a member's name`,
      behavior = `Every member of that name of an entity whose symbol has the owner's identifier in a file scope`,
    })
    .add({ situation = `[[name]] begins with a file path and a colon`, behavior = `Only that file's scope is searched` })
    .add({
      behavior = `Entities of files without a [[File.package]] come first, then those of package files, each in [[Workspace.files]] order, then in declaration order`,
    });

  @test(
    {
      input = [Workspace@like(`Two files: def/a.lfy reading: d A {} and def/b.lfy reading: d A {}`), `A`],
      expect = Entity[]@like(`The A of def/a.lfy, then the A of def/b.lfy`),
    },
    {
      input = [
        Workspace@like(`Two files: def/a.lfy reading: d A { $x = string; } and def/b.lfy reading: d A {}`),
        `A.x`,
      ],
      expect = Entity[]@like(`One: the member x of the A of def/a.lfy`),
    },
    {
      input = [Workspace@like(`Two files: def/a.lfy reading: d A {} and def/b.lfy reading: d A {}`), `def/b.lfy:A`],
      expect = Entity[]@like(`One: the A of def/b.lfy`),
    },
  );
}

// Action Queries

fn renameAt(workspace: Workspace, file: string, position: Position, name: string): `The edits that rename the symbol at a position everywhere, or why it cannot be renamed` => Edit[] | string {
  @acceptanceCriteria
    .add({ situation = `[[symbolAt]] is undefined`, behavior = `Returns a reason saying nothing is declared here` })
    .add({
      situation = `[[name]] is not an [[Identifier]], or is a [[Keyword]]`,
      behavior = `Returns a reason naming the rule`,
    })
    // Decision: a name already visible would capture the renamed symbol's usages or be captured by them.
    .add({
      situation = `A symbol named [[name]] is already visible from the declaring scope, or from the scope of any [[Usage]] of the symbol`,
      behavior = `Returns a reason naming that symbol's file and line`,
    })
    .add({
      situation = [
        `[[symbolAt]] is not undefined`,
        `[[name]] is an [[Identifier]] and not a [[Keyword]]`,
        `No symbol named [[name]] is visible from the declaring scope or from the scope of any [[Usage]] of the symbol`,
      ],
      behavior = `One [[Edit]] replaces the identifier of the declaration, and one replaces the name token of every [[Usage]] in [[Binder.usagesOf]] the symbol, references in templates and [[Documentation]] included`,
    })
    .add({
      situation = `The symbol is a module symbol`,
      behavior = `Only the name after [[AsKeyword]] and its usages change; the file is not renamed`,
    })
    .add({ behavior = `Edits are in [[Workspace.files]] order, then by [[Range.start]], and never overlap` });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y: \`See \[[A\]]\` = A;`),
        `def/a.lfy`,
        Position@like(`on the declared A`),
        `B`,
      ],
      expect = Edit[]@like(`Three edits: the declaration, the reference in the template, and the value`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y = A;`),
        `def/a.lfy`,
        Position@like(`on the declared A`),
        `const`,
      ],
      expect = string@like(`A reason saying const is a keyword`),
    },
  );
}
