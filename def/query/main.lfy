use "../grammar/rules/expression";
use "../grammar/rules/statement";
use "../grammar/terminals/comment";
use "../grammar/terminals/identifier";
use "../grammar/terminals/keyword";
use "../grammar/terminals/literal";
use "../grammar/terminals/punctuation";
use "../grammar/traits";
use "../lexer/data";
use "../model/data";
use "../model/main" as Binder;
use "../model/traits";
use "../parser/data";
use "../parser/traits";
use "../workspace/data";
use "./data";
use "elfie/prelude/builtin";
use "elfie/prelude/entity" as Prelude;
use "elfie/prelude/kinds" as Kinds;
use "elfie/values/list" as Lists;
use "elfie/values/number" as Numbers;
use "elfie/values/object" as Objects;
use "elfie/values/string" as Strings;

// Lookup Queries

fn rangeOf(workspace: Workspace, node: Node | Token): `Where a node or token sits` => Range {
  @acceptanceCriteria
    .add({ behavior = `[[Range.file]] is [[Token.file]] of the first token covered` })
    .add({ behavior = `[[Range.start]] is [[Token.line]] and [[Token.column]] of the first token covered` })
    .add({
      behavior = `[[Range.end]] is the position just after the last character of [[Token.raw]] of the last token covered, with every [[NewLine]] inside the tokens ending a line`,
    })
    .add({
      situation = `[[node]] covers no token`,
      behavior = `The range is empty at the position the node would start at`,
    });
}

fn tokenAt(workspace: Workspace, file: string, position: Position): `The token under a position` => Token | undefined {
  @acceptanceCriteria
    .add({ behavior = `[[file]] is relative to [[Workspace.root]], as [[File.path]] is` })
    .add({ behavior = `Returns the token of [[file]] whose range covers [[position]]` })
    .add({
      situation = [
        `[[position]] is exactly between two tokens`,
        `The earlier token is an [[Identifier]], a [[Keyword]], or a [[MemberName]]`,
      ],
      behavior = `It belongs to the earlier token`,
    })
    .add({
      situation = [
        `[[position]] is exactly between two tokens`,
        `The earlier token is not an [[Identifier]], a [[Keyword]], or a [[MemberName]]`,
      ],
      behavior = `It belongs to the later token`,
    })
    .add({
      situation = `[[file]] is not in [[Workspace.files]] or [[position]] is past the end of the file`,
      behavior = `Returns undefined`,
    });
}

fn nodesAt(workspace: Workspace, file: string, position: Position): `Every node covering a position, outermost first` => Node[] {
  @acceptanceCriteria
    .add({
      behavior = `The first node is [[Tree.root]] of the file and each next node is a child of the one before it; the last holds [[tokenAt]] as a direct child`,
    })
    .add({ situation = `[[tokenAt]] is undefined`, behavior = `Returns an empty list` });
}

fn symbolAt(workspace: Workspace, file: string, position: Position): `The symbol declared or used at a position` => Symbol | undefined {
  @acceptanceCriteria
    .add({
      situation = `[[tokenAt]] is an [[Identifier]] or a keyword standing as a [[MemberName]]`,
      behavior = `Walking [[nodesAt]] innermost outward, the first node for which [[Binder.resolve]] gives a symbol, and whose name that token spells, gives the symbol`,
    })
    .add({
      situation = `[[tokenAt]] is inside a [[TemplateReference]], including one inside [[Documentation]]`,
      behavior = `The [[Usage]] of the [[Reference]] gives the symbol, so references in prose resolve like code`,
    })
    .add({
      situation = [
        `[[tokenAt]] is the [[DoubleQuoteBody]] or [[SingleQuoteBody]] of a [[Use]]`,
        `The [[Use]] has an [[AsKeyword]]`,
      ],
      behavior = `Returns the module symbol the [[Use]] declares`,
    })
    .add({
      situation = [
        `[[tokenAt]] is the [[DoubleQuoteBody]] or [[SingleQuoteBody]] of a [[Use]]`,
        `The [[Use]] has no [[AsKeyword]]`,
      ],
      behavior = `Returns undefined`,
    })
    .add({
      situation = `[[tokenAt]] is undefined, or is not an [[Identifier]], not a keyword standing as a [[MemberName]], not inside a [[TemplateReference]], and not the [[DoubleQuoteBody]] or [[SingleQuoteBody]] of a [[Use]]`,
      behavior = `Returns undefined`,
    });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y = A;`),
        `def/a.lfy`,
        Position@like(`on the A after the equals sign`),
      ],
      expect = Symbol@like(`The symbol A of kind data`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y: \`See \[[A\]]\` = 1;`),
        `def/a.lfy`,
        Position@like(`on the A inside the template reference`),
      ],
      expect = Symbol@like(`The symbol A of kind data`),
    },
  );
}

// Definition Queries

fn definitionOf(workspace: Workspace, file: string, position: Position): `Where the symbol at a position is declared` => Range | undefined {
  @acceptanceCriteria
    .add({
      situation = `[[symbolAt]] is not undefined and is not a module symbol, and the position is not on the path of a [[Use]]`,
      behavior = `Returns [[rangeOf]] the identifier that spells the name in the declaring node of [[symbolAt]], as [[declaring]] finds it`,
    })
    .add({
      situation = `The symbol is a module symbol, or the position is on the path of a [[Use]]`,
      behavior = `Returns an empty range at line 1, column 0 of the file the [[Use]] resolved to in [[Source.uses]]`,
    })
    .add({
      situation = `The symbol is an alias`,
      behavior = `Returns the [[AliasDeclaration]], not what it aliases`,
    })
    .add({
      situation = `The symbol is a member added by a trait`,
      behavior = `Returns the member statement inside the trait body`,
    })
    .add({ situation = `[[symbolAt]] is undefined`, behavior = `Returns undefined` });
}

fn referencesTo(workspace: Workspace, file: string, position: Position, includeDeclaration: boolean = true): `Every place the symbol at a position is used` => Range[] {
  @acceptanceCriteria
    .add({ behavior = `One range per [[Usage]] in [[Binder.usagesOf]] the symbol` })
    .add({
      situation = `A [[Usage]] in [[Binder.usagesOf]] the symbol is not of a layer itself`,
      behavior = `The range of that usage covers the token that spells the name`,
    })
    .add({
      situation = `A [[Usage]] in [[Binder.usagesOf]] the symbol is of a layer itself`,
      behavior = `The range of that usage covers the accessor`,
    })
    .add({ situation = `[[includeDeclaration]] is true`, behavior = `The range [[definitionOf]] gives is first` })
    .add({ behavior = `Ranges are in [[Workspace.files]] order, then by [[Range.start]]` })
    .add({ situation = `[[symbolAt]] is undefined`, behavior = `Returns an empty list` });
}

fn sourceOf(workspace: Workspace, entity: Entity): `The text that declares an entity` => string {
  @acceptanceCriteria
    .add({
      behavior = `The joined [[Token.raw]] of every token the declaring node covers, with the text of its [[documented]] nodes before it`,
    })
    .add({ situation = `[[entity]] is the anonymous entity of a file`, behavior = `The whole file` })
    .add({
      situation = `[[entity]] is a member added by a trait`,
      behavior = `The member statement inside the trait body`,
    });
}

fn semanticTokensOf(workspace: Workspace, file: string): `Every name of a file, classified by meaning for an editor to color` => SemanticToken[] {
  // Which tokens
  @acceptanceCriteria
    .add({
      behavior = `One [[SemanticToken]] per token that spells a declared name or a used name, a member of a kind data after the [[ContextAccessor]] among them; keywords, punctuation, strings, numbers, and comments get none`,
    })
    .add({ behavior = `Tokens are in position order and never overlap` })
    .add({ situation = `[[file]] is not in [[Workspace.files]]`, behavior = `Returns an empty list` });

  // Type
  @acceptanceCriteria
    .add({ behavior = `[[SemanticToken.type]] follows the kind of the symbol the token declares or resolves to` })
    .add({
      situation = `The token declares or resolves to a symbol whose kind has a [[TokenType]] of the same name`,
      behavior = `[[SemanticToken.type]] is the [[TokenType]] of the same name as the kind`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind.agentFunction]]`,
      behavior = `[[SemanticToken.type]] is [[TokenType._function]]`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind.loopVariable]] or [[SymbolKind._external]]`,
      behavior = `[[SemanticToken.type]] is [[TokenType.variable]]`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind.member]]`,
      behavior = `[[SemanticToken.type]] is [[TokenType.property]]`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind._module]]`,
      behavior = `[[SemanticToken.type]] is [[TokenType.namespace]]`,
    })
    .add({
      situation = `The token declares or resolves to a symbol of kind [[SymbolKind.typeParameter]]`,
      behavior = `The type is [[TokenType.typeParameter]] wherever the name appears, in the [[TypeParameters]] that lists it, in a type position, and in an expression alike`,
    })
    .add({
      situation = [
        `The token declares or resolves to a symbol of kind [[SymbolKind.typeParameter]]`,
        `The token is the name in the [[TypeParameter]] that declares it`,
      ],
      behavior = `declaration is among the token's modifiers`,
    })
    .add({
      situation = [
        `The token declares or resolves to a symbol of kind [[SymbolKind.typeParameter]]`,
        `The token is not the name in the [[TypeParameter]] that declares it`,
      ],
      behavior = `declaration is not among the token's modifiers`,
    })
    .add({
      situation = `The token declares or resolves to an alias`,
      behavior = `The type is that of the entity the alias is bound to`,
    })
    .add({
      situation = `The token resolves to a member of a kind data or of a base data, as [[Binder.bind]] resolves the [[ContextAccessor]] and the [[ValueAccessor]], or names a member of a kind data other than the entity's`,
      behavior = `The type is property, whatever the member's value is`,
    })
    .add({ situation = `The token resolves to nothing`, behavior = `The type is variable` })
    .add({
      situation = `The token is a member of something the model does not know, so the binder reported no [[Problem]] there`,
      behavior = `It gets no token: it is not a name of the program`,
    });

  // Modifiers
  @acceptanceCriteria
    .add({ situation = `The token spells the name in a declaration`, behavior = `declaration is among its modifiers` })
    .add({
      situation = `The token declares or resolves to an entity declared with [[AgentDataKeyword]] or [[AgentFunctionKeyword]]`,
      behavior = `agentic is among the modifiers of every token of that entity, declaration and use alike`,
    })
    .add({
      situation = `The token declares or resolves to a variable declared with [[ConstKeyword]]`,
      behavior = `readonly is among the token's modifiers`,
    })
    .add({ situation = `The token follows a [[ContextAccessor]]`, behavior = `context is among its modifiers` })
    .add({
      situation = `The token follows a [[ScopeAccessor]] or [[ParentScopeAccessor]]`,
      behavior = `scope is among its modifiers`,
    })
    .add({
      situation = `The token follows a [[ValueAccessor]] or [[OptionalValueAccessor]]`,
      behavior = `value is among its modifiers`,
    })
    .add({
      situation = `The token is inside a [[TemplateReference]], a [[TemplateExecution]], or [[Documentation]]`,
      behavior = `documentation is among its modifiers`,
    })
    .add({ situation = `The token resolves to nothing`, behavior = `unresolved is among its modifiers` })
    .add({ behavior = `Modifiers are in [[TokenModifier]] order and each appears once` });

  @test(
    {
      input = [Workspace@like(`One file a.lfy reading: d A { $x: \`d\` = string; } const y = A$x;`), `def/a.lfy`],
      expect = SemanticToken[]@like(
        `A as data with declaration and agentic; x as property with declaration; y as variable with declaration and readonly; A as data with agentic; x as property with scope`,
      ),
    },
    {
      input = [
        Workspace@like(
          `One file a.lfy reading: fn f(): \`See \[[g\]]\` => number { @acceptanceCriteria.add({ behavior = \`b\` }); }`,
        ),
        `def/a.lfy`,
      ],
      expect = SemanticToken[]@like(
        `f as function with declaration and agentic; g as variable with documentation and unresolved; acceptanceCriteria as property with context; no token for add, since it is not a name in the program`,
      ),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d Box<T> { $item: \`d\` = T; } const b = Box<string>;`),
        `def/a.lfy`,
      ],
      expect = SemanticToken[]@like(
        `Box as data with declaration and agentic; T as typeParameter with declaration; item as property with declaration; T as typeParameter with no modifiers; b as variable with declaration and readonly; Box as data with agentic; no token for string`,
      ),
    },
  );
}

// Hover Queries

fn typeTextOf(workspace: Workspace, entity: Entity | undefined): `How a type is spelled wherever a query shows one` => string | undefined {
  @acceptanceCriteria
    .add({ situation = `[[entity]] is undefined`, behavior = `Returns undefined` })
    .add({
      situation = [
        `[[entity]] is defined, has no [[Entity.typeArguments]], and is not the entity of a [[FunctionType]]`,
        `[[entity]] is a declaration or a primitive`,
      ],
      behavior = `It is spelled by its identifier`,
    })
    .add({
      situation = [
        `[[entity]] is defined, has no [[Entity.typeArguments]], and is not the entity of a [[FunctionType]]`,
        `[[entity]] is a type parameter`,
      ],
      behavior = `It is spelled by its name`,
    })
    .add({
      situation = [
        `[[entity]] is defined, has no [[Entity.typeArguments]], and is not the entity of a [[FunctionType]]`,
        `[[entity]] is a type that declares no name`,
      ],
      behavior = `It is spelled by the source text of its type expression`,
    })
    .add({
      situation = `[[entity]] has [[Entity.typeArguments]] and is not [[Lists.List]] with one of [[Entity.typeArguments]]`,
      behavior = `The identifier, then a less-than sign, then each argument as [[typeTextOf]] spells it, joined by a comma and a space, then a greater-than sign`,
    })
    .add({
      situation = [
        `[[entity]] is [[Lists.List]] with one of [[Entity.typeArguments]]`,
        `The argument is not a function type, a union, or an intersection`,
      ],
      behavior = `The argument as [[typeTextOf]] spells it, then square brackets, so the sugar wins in display`,
    })
    .add({
      situation = [
        `[[entity]] is [[Lists.List]] with one of [[Entity.typeArguments]]`,
        `The argument is a function type, a union, or an intersection`,
      ],
      behavior = `The argument as [[typeTextOf]] spells it, parenthesized, then square brackets, so the sugar wins in display`,
    })
    .add({
      situation = `[[entity]] is the entity of a [[FunctionType]]`,
      behavior = `A parenthesized list of its parameters, joined by a comma and a space, then a space, a double arrow, a space, and [[FnEntity.output]] as [[typeTextOf]] spells it`,
    })
    .add({
      situation = [
        `[[entity]] is the entity of a [[FunctionType]]`,
        `A parameter of it is neither optional nor spread`,
      ],
      behavior = `That parameter is spelled as its name, a colon, a space, and its type as [[typeTextOf]] spells it`,
    })
    .add({
      situation = [
        `[[entity]] is the entity of a [[FunctionType]]`,
        `A parameter of it is optional`,
      ],
      behavior = `That parameter is spelled as its name, a question mark, a colon, a space, and its type as [[typeTextOf]] spells it`,
    })
    .add({
      situation = [
        `[[entity]] is the entity of a [[FunctionType]]`,
        `A parameter of it is a spread one`,
      ],
      behavior = `That parameter is spelled as three dots, its name, a colon, a space, and its type as [[typeTextOf]] spells it`,
    })
    .add({
      situation = `A member's type is read on a left side with [[Entity.typeArguments]]`,
      behavior = `What is spelled is the type after the substitution [[Binder.bind]] describes, so item of a Box of string spells string`,
    });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: d Box<T> {} const b = Box<string>;`),
        Entity@like(`The type of b`),
      ],
      expect = `Box<string>`,
    },
    {
      input = [
        Workspace@like(
          `One file a.lfy reading: d Box<T> { $items: \`d\` = T[]; $map: \`e\` = (transform: (item: T) => T) => T[]; }`,
        ),
        Entity@like(`The type of the parameter transform`),
      ],
      expect = `(item: T) => T`,
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d Box<T> { $items: \`d\` = T[]; }`),
        Entity@like(`The type of the member items`),
      ],
      expect = `T[]`,
    },
  );
}

fn hoverOf(workspace: Workspace, entity: Entity): `Everything shown for one entity` => Hover {
  @acceptanceCriteria
    .add({ behavior = `[[Hover.range]] covers the identifier of the entity's declaration, as [[declaring]] finds it` })
    .add({ situation = `[[entity]] is not a member`, behavior = `[[Hover.kind]] is the kind of the entity's symbol` })
    .add({ situation = `[[entity]] is a member`, behavior = `[[Hover.kind]] is [[SymbolKind.member]]` })
    .add({ situation = `[[entity]] is not anonymous`, behavior = `[[Hover.identifier]] is [[Entity.identifier]]` })
    .add({
      situation = `[[entity]] is anonymous`,
      behavior = `[[Hover.identifier]] is the text of the declaring node's first line`,
    })
    .add({
      behavior = `[[Hover.definition]] is [[Entity.definition]] with each [[TemplateReference]] replaced by the referenced identifier and each [[TemplateExecution]] by its value`,
    })
    .add({ behavior = `[[Hover.type]] is [[typeTextOf]] [[Entity.type]]` })
    .add({
      situation = `[[entity]] is a type parameter`,
      behavior = `[[Hover.owner]] is the identifier of the declaration whose [[TypeParameters]] lists it`,
    })
    .add({ situation = `[[entity]] is a member`, behavior = `[[Hover.owner]] is [[Kinds.Member.owner]] of it` })
    .add({ situation = `[[entity]] is neither a type parameter nor a member`, behavior = `[[Hover.owner]] is undefined` })
    .add({
      behavior = `[[Hover.documentation]] is the joined text of the [[documented]] nodes of the declaration, each line without its opener and closer and without one leading space`,
    })
    .add({
      behavior = `[[Hover.traits]] is the identifier of each of [[Entity.traits]] in application order, so a native data or fn shows [[builtin]] among them`,
    })
    .add({ behavior = `[[Hover.criteria]] is [[Binder.criteriaOf]] the entity` })
    .add({
      situation = `[[entity]] is a member of a kind data or of a base data, reached after the [[ContextAccessor]] or a [[ValueAccessor]]`,
      behavior = `It hovers as any member: kind [[SymbolKind.member]], its range in the library file that declares it, and its own definition and type`,
    })
    .add({
      situation = `[[entity]] is a type parameter`,
      behavior = `[[Hover.kind]] is [[SymbolKind.typeParameter]], [[Hover.owner]] is the declaration that lists it, and [[Hover.definition]], [[Hover.traits]], and [[Hover.criteria]] are empty`,
    })
    .add({
      situation = [
        `[[entity]] is a type parameter`,
        `It has a constraint, the type after its [[ExtendsKeyword]]`,
      ],
      behavior = `[[Hover.type]] is [[typeTextOf]] that constraint`,
    })
    .add({
      situation = [
        `[[entity]] is a type parameter`,
        `It has no [[ExtendsKeyword]] constraint`,
      ],
      behavior = `[[Hover.type]] is undefined`,
    });
}

fn hoverAt(workspace: Workspace, file: string, position: Position): `Everything shown for the symbol at a position` => Hover | undefined {
  @acceptanceCriteria
    .add({ behavior = `Returns [[hoverOf]] the entity of [[symbolAt]]` })
    .add({ situation = `[[symbolAt]] is undefined`, behavior = `Returns undefined` });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: /// Doc\nd A: \`An A\` {} const y = A;`),
        `def/a.lfy`,
        Position@like(`on the A after the equals sign`),
      ],
      expect = Hover@like(`kind data, identifier A, definition An A, documentation Doc, no criteria`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d Item {} d Box<T extends Item> { $item: \`d\` = T; }`),
        `def/a.lfy`,
        Position@like(`on the T after the equals sign`),
      ],
      expect = Hover@like(`kind typeParameter, identifier T, type Item, owner Box, no definition, no criteria`),
    },
  );
}

// Recommendation Queries

fn completionsAt(workspace: Workspace, file: string, position: Position): `What could be typed at a position` => Completion[] {
  @acceptanceCriteria
    .add({
      behavior = `The context is decided by the nearest token before [[position]] that is not [[trivia]], and by the innermost node of [[nodesAt]]`,
    })
    .add({
      behavior = `Every completion appears once, filtered to labels that begin with the identifier characters already typed before [[position]], case sensitive`,
    })
    .add({
      behavior = `Completions from a nearer scope come before those from an enclosing scope, then in file order, then those of kind [[CompletionKind.keyword]]`,
    })
    .add({
      situation = `The nearest token before [[position]] that is not [[trivia]] is a [[ContextAccessor]]`,
      behavior = `One completion of kind [[CompletionKind.context]] per member of the kind data of the entity the left side resolves to, as [[Binder.bind]] resolves the [[ContextAccessor]]: those of [[Prelude.Entity]] for every entity, then those of the data for its kind; each labelled by the member's name, with the member's definition as [[Completion.detail]]`,
    })
    .add({
      situation = `The nearest token before [[position]] that is not [[trivia]] is a [[ScopeAccessor]]`,
      behavior = `The members of the current entity of the scope that holds the position`,
    })
    .add({
      situation = `The nearest token before [[position]] that is not [[trivia]] is a [[ParentScopeAccessor]]`,
      behavior = `The members of the current entity of the parent of the scope that holds the position`,
    })
    .add({
      situation = `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves`,
      behavior = `What [[Binder.bind]] would resolve the [[ValueAccessor]] in, as the left side is`,
    })
    .add({
      situation = [
        `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves`,
        `The left side resolves to a module`,
      ],
      behavior = `The module's symbols`,
    })
    .add({
      situation = [
        `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves`,
        `The left side resolves to an entity that is not a module, an enum, or an object, and whose value is not a string, a number, or a list`,
      ],
      behavior = `The entity's own members, then the members of its kind data whose value is a function`,
    })
    .add({
      situation = [
        `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves`,
        `The left side resolves to an enum`,
      ],
      behavior = `The enum's keys`,
    })
    .add({
      situation = [
        `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves`,
        `The left side resolves to an object`,
      ],
      behavior = `The object's keys, then the members of [[Objects.Object]]`,
    })
    .add({
      situation = [
        `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves`,
        `The left side resolves to an entity whose value is a string`,
      ],
      behavior = `The entity's own members, then every member of [[Strings.String]]`,
    })
    .add({
      situation = [
        `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves`,
        `The left side resolves to an entity whose value is a number`,
      ],
      behavior = `The entity's own members, then every member of [[Numbers.Number]]`,
    })
    .add({
      situation = [
        `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves`,
        `The left side resolves to an entity whose value is a list`,
      ],
      behavior = `The entity's own members, then every member of [[Lists.List]]`,
    })
    .add({
      situation = `The nearest token before [[position]] that is not [[trivia]] is a [[ValueAccessor]] or [[OptionalValueAccessor]] and the left side of the [[Member]] resolves to nothing`,
      behavior = `No completions`,
    })
    .add({
      situation = `The nearest token before [[position]] that is not [[trivia]] is an [[IsKeyword]], the [[ExtendsKeyword]] of an [[ExtendsClause]], or a [[Comma]] inside [[TraitUses]]`,
      behavior = `Every symbol of kind [[SymbolKind._trait]] visible from the position, plus the module symbols`,
    })
    .add({
      situation = [
        `The position is inside the string of a [[Use]]`,
        `The path begins with a dot`,
      ],
      behavior = `Of kind [[CompletionKind.path]]: the directories and the .lfy files without their extension under the directory the path names so far, relative to the file's directory`,
    })
    .add({
      situation = [
        `The position is inside the string of a [[Use]]`,
        `The path does not begin with a dot`,
      ],
      behavior = `Of kind [[CompletionKind.path]]: the identifier of each [[Package]], then the directories and the .lfy files without their extension under the directory the path names so far, relative to that package's root`,
    })
    .add({
      situation = `The position is inside a [[TemplateReference]] or [[Documentation]]`,
      behavior = `Every name visible from the position, then every [[rule]] entity's identifier, because a reference found nowhere resolves to a rule`,
    })
    .add({
      situation = `The nearest token before [[position]] that is not [[trivia]] is the [[Colon]] of a [[DefinitionClause]] or [[Definition]], the [[LessThan]] or a [[Comma]] of [[TypeArguments]] or of [[Generic]], or the [[ExtendsKeyword]] or [[PlainSetter]] of a [[TypeParameter]]`,
      behavior = `A type is offered: every symbol of kind [[SymbolKind.data]], [[SymbolKind._type]], [[SymbolKind._enum]], [[SymbolKind._trait]], or [[SymbolKind.typeParameter]] visible from the position, then the primitive type keywords`,
    })
    .add({
      situation = [
        `A type parameter is visible from the position`,
        `The nearest token before [[position]] that is not [[trivia]] is the [[Colon]] of a [[DefinitionClause]] or [[Definition]], the [[LessThan]] or a [[Comma]] of [[TypeArguments]] or of [[Generic]], or the [[ExtendsKeyword]] or [[PlainSetter]] of a [[TypeParameter]]`,
      ],
      behavior = `The type parameter is among the completions, of kind [[SymbolKind.typeParameter]]`,
    })
    .add({
      situation = `A [[Statement]] can begin at the position`,
      behavior = `Every name visible from the position, then the keyword that begins each [[statement]] rule`,
    })
    .add({
      situation = [
        `An [[Expression]] can begin at the position`,
        `No [[Statement]] can begin at the position`,
        `The position is not inside the string of a [[Use]], a [[TemplateReference]], or [[Documentation]]`,
        `The nearest token before [[position]] that is not [[trivia]] is not a [[ContextAccessor]], a [[ScopeAccessor]], a [[ParentScopeAccessor]], a [[ValueAccessor]], an [[OptionalValueAccessor]], an [[IsKeyword]], the [[ExtendsKeyword]] of an [[ExtendsClause]] or of a [[TypeParameter]], a [[Comma]] inside [[TraitUses]], [[TypeArguments]], or [[Generic]], the [[Colon]] of a [[DefinitionClause]] or [[Definition]], the [[LessThan]] of [[TypeArguments]] or of [[Generic]], or the [[PlainSetter]] of a [[TypeParameter]]`,
      ],
      behavior = `Every name visible from the position, then the value keywords true, false, null, and undefined, then the primitive type keywords`,
    });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A { $x = string; } const y = A@`),
        `def/a.lfy`,
        Position@like(`just after the at sign`),
      ],
      expect = Completion[]@like(
        `One per member of [[Prelude.Entity]], identifier, definition, and like among them, each of kind [[CompletionKind.context]] with the member's definition as detail; no A or y`,
      ),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: const s = "x"; const y = s.`),
        `def/a.lfy`,
        Position@like(`just after the dot`),
      ],
      expect = Completion[]@like(
        `One per member of [[Strings.String]], length and trim among them, each of kind [[SymbolKind.member]]; no s or y`,
      ),
    },
    {
      input = [Workspace@like(`One file a.lfy reading: trait t {} d A is `), `def/a.lfy`, Position@like(`at the end`)],
      expect = Completion[]@like(`t alone, of kind trait`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d Item {} d Box<T> { $pair: \`d\` = Box<`),
        `def/a.lfy`,
        Position@like(`just after the less-than sign`),
      ],
      expect = Completion[]@like(
        `T of kind typeParameter, Item and Box of kind data, then the primitive type keywords; no pair`,
      ),
    },
  );
}

fn diagnosticsOf(workspace: Workspace, file?: string): `Every problem of the program, placed` => Diagnostic[] {
  @acceptanceCriteria
    .add({
      situation = `A [[LoadProblem]] has a path`,
      behavior = `An error of stage loader at an empty range at line 1, column 0 of that path`,
    })
    .add({
      situation = `A [[LoadProblem]] has no path`,
      behavior = `An error of stage loader at an empty range at line 1, column 0 of elfie.json under [[Workspace.root]], whether or not that file exists`,
    })
    .add({
      situation = [
        `A [[Token]] has no [[Token.rule]]`,
        `[[Token.raw]] of the token is not empty`,
      ],
      behavior = `An error of stage lexer at the token, whose message is invalid text`,
    })
    .add({
      situation = [
        `A [[Token]] has no [[Token.rule]]`,
        `[[Token.raw]] of the token is empty`,
      ],
      behavior = `An error of stage lexer at the token, whose message names the mode left open`,
    })
    .add({
      situation = `An [[ErrorNode]] without [[ErrorNode.keyword]] is in a tree`,
      behavior = `An error of stage parser at the node, whose message lists [[ErrorNode.expected]] and the text found`,
    })
    .add({
      situation = `An [[ErrorNode]] with [[ErrorNode.keyword]] is in a tree`,
      behavior = `An error of stage parser at [[ErrorNode.keyword]], whose message is the token's text followed by: is a keyword and cannot be a name`,
    })
    .add({
      situation = [
        `A [[Problem]] is in [[Workspace.problems]]`,
        `[[Problem.node]] is a [[Use]]`,
      ],
      behavior = `An error at [[Problem.node]] with [[Problem.message]], of stage loader, since resolving uses and their cycles is the only problem loading adds`,
    })
    .add({
      situation = [
        `A [[Problem]] is in [[Workspace.problems]]`,
        `[[Problem.node]] is not a [[Use]]`,
      ],
      behavior = `An error at [[Problem.node]] with [[Problem.message]], of stage binder`,
    })
    .add({
      situation = [
        `A [[Use]] without [[AsKeyword]] imports symbols of which none is used in the file, or one with [[AsKeyword]] whose module symbol is never used`,
        `The file holding the [[Use]] declares a symbol of its own`,
      ],
      behavior = `A warning of stage binder at the [[Use]]`,
    })
    .add({
      situation = `A file declares no symbol of its own, as the main file of the package elfie does`,
      behavior = `It only re-exports what it uses, so no warning of stage binder is given at any [[Use]] it holds`,
    })
    .add({ situation = `[[file]] is set`, behavior = `Only diagnostics whose range is in that file are returned` })
    .add({ behavior = `Diagnostics are in [[Workspace.files]] order, then by [[Range.start]], with elfie.json first` });

  @test(
    {
      input = [Workspace@like(`One file a.lfy reading: const y = z;`)],
      expect = Diagnostic[]@like(`One error of stage binder at z`),
    },
    {
      input = [Workspace@like(`One file a.lfy reading: const = 1;`), `def/a.lfy`],
      expect = Diagnostic[]@like(`One error of stage parser at the equals sign expecting [[Identifier]]`),
    },
  );
}

// Search Queries

fn outlineOf(workspace: Workspace, file: string): `The declarations of one file, nested as written` => Outline[] {
  @acceptanceCriteria
    .add({
      behavior = `One [[Outline]] per symbol declared in the file scope, in order, except module symbols and the symbols a [[Use]] imports`,
    })
    .add({
      behavior = `[[Outline.children]] holds the members of a data, trait, type, or enum declaration, then every declaration nested in its body, in order; parameters and loop variables are left out`,
    })
    .add({
      behavior = `[[Outline.range]] covers the declaring node and its [[documented]] nodes; [[Outline.selectionRange]] covers the identifier`,
    })
    .add({ situation = `[[file]] is not in [[Workspace.files]]`, behavior = `Returns an empty list` });
}

fn findSymbols(workspace: Workspace, query: string): `Declarations across the program whose name contains a text` => Outline[] {
  @acceptanceCriteria
    .add({
      situation = `[[query]] is not empty`,
      behavior = `Every [[Outline]] of every file, flattened, whose name contains [[query]] ignoring case`,
    })
    .add({
      situation = [
        `[[query]] is not empty`,
        `An [[Outline]] is a child of another [[Outline]]`,
      ],
      behavior = `Its name is its parent's name, a dot, and its own`,
    })
    .add({ situation = `[[query]] is empty`, behavior = `Every top level declaration of every file` })
    .add({
      behavior = `Files without a [[File.package]] come first, then package files, each in [[Workspace.files]] order`,
    });
}

fn find(workspace: Workspace, name: string): `Entities by the name an agent would spell` => Entity[] {
  @acceptanceCriteria
    .add({ behavior = `[[name]] is an identifier, or an owner's identifier, a dot, and a member's name` })
    .add({
      behavior = `Every entity whose symbol is named [[name]] in any file scope, or whose owner is, in the order [[findSymbols]] uses; the reader tells matches apart by file`,
    })
    .add({ situation = `[[name]] begins with a file path and a colon`, behavior = `Only that file's scope is searched` })
    .add({ situation = `No entity's symbol or owner is named [[name]]`, behavior = `Returns an empty list` });
}

// Action Queries

fn renameAt(workspace: Workspace, file: string, position: Position, name: string): `The edits that rename the symbol at a position everywhere, or why it cannot be renamed` => Edit[] | string {
  @acceptanceCriteria
    .add({ situation = `[[symbolAt]] is undefined`, behavior = `Returns a reason saying nothing is declared here` })
    .add({
      situation = `[[name]] is not an [[Identifier]], or is a [[Keyword]]`,
      behavior = `Returns a reason naming the rule`,
    })
    .add({
      situation = `A symbol named [[name]] is already visible from the declaring scope, or from the scope of any [[Usage]] of the symbol`,
      behavior = `Returns a reason naming that symbol's file and line, because the rename would capture or be captured`,
    })
    .add({
      situation = [
        `[[symbolAt]] is not undefined`,
        `[[name]] is an [[Identifier]] and not a [[Keyword]]`,
        `No symbol named [[name]] is visible from the declaring scope or from the scope of any [[Usage]] of the symbol`,
      ],
      behavior = `One [[Edit]] replaces the identifier of the declaration, and one replaces the name token of every [[Usage]] in [[Binder.usagesOf]] the symbol, references in templates and [[Documentation]] included`,
    })
    .add({
      situation = `The symbol is a module symbol`,
      behavior = `Only the name after [[AsKeyword]] and its usages change; the file is not renamed`,
    })
    .add({ behavior = `Edits are in [[Workspace.files]] order, then by [[Range.start]], and never overlap` });

  @test(
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y: \`See \[[A\]]\` = A;`),
        `def/a.lfy`,
        Position@like(`on the declared A`),
        `B`,
      ],
      expect = Edit[]@like(`Three edits: the declaration, the reference in the template, and the value`),
    },
    {
      input = [
        Workspace@like(`One file a.lfy reading: d A {} const y = A;`),
        `def/a.lfy`,
        Position@like(`on the declared A`),
        `const`,
      ],
      expect = string@like(`A reason saying const is a keyword`),
    },
  );
}
