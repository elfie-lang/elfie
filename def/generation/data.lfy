use "../interpret/data";
use "../model/data";
use "../model/type";
use "../workspace/data";
use "elfie/system/path";
use "elfie/system/time" as Time;
use "elfie/target" as Targets;

enum Reason: `Why a unit needs generating` {
  fresh = `no output has been generated for it`,
  changed = `its source differs from what its output was generated from`,
  requirements = `its criteria or tests differ from those its output was generated against, while its lowered code does not, so what its code must do may differ`,
  dependency = `the interface of a unit it depends on differs from the one its output was generated against`,
  violated = `a global criterion or test its output answers for was reviewed as violated`,
  requested = `the caller asked for it regardless`,
  touched = `another unit edited its outputs during this compile`,
}

d Marker: `One place where generated code says where it came from` {
  $outputLine: `The line of the output file that carries the marker, counting from 1` = number;
  $file: `The source path the marker names, relative to [[Workspace.root]]` = string;
  $entity: `The name the marker spells, when it names an entity: the identifier, or the owner's identifier, a dot, and a member's name; undefined when it names a line` = string | undefined;
  $line: `The source line: as spelled, or derived from [[Marker.entity]] as the first line of that entity's declaration` = number;
  $column: `The source column, counting from 0; undefined when the marker names a whole line or an entity` = number | undefined;
  $requirement: `The id of the [[LoweredCriterion]] or [[LoweredTest]] the region answers for, spelled after the entity and a #; a global id begins with global; undefined when it answers for none` = string | undefined;
  $end: `The last output line of the region the marker begins: the line before the next marker in the same output, or the last line of the output` = number;
  @acceptanceCriteria
    .add({
      behavior = `A marker's region is the output lines from [[Marker.outputLine]] through [[Marker.end]], inclusive`,
    })
    .add({ behavior = `The regions of one output never overlap` })
    .add({ behavior = `The regions of one output together cover every line from its first marker to its last line` })
    .add({
      behavior = `A marker is written in the output as a line comment of the target's language reading @lfy, a space, the source path relative to [[Workspace.root]], a colon, and then either a line (optionally a colon and a column) or the name of an entity of that file`,
    })
    .add({
      situation = `A marker is for a test, or for code written to satisfy one criterion`,
      behavior = `The marker names the entity the code belongs to, then a # and the id of that criterion or test, local or global`,
    })
    .add({
      behavior = `A criterion or test appears in an output only as its id in a marker, and never as its text`,
    })
    .add({
      situation = `What follows @lfy and the space is a path ending in .lfy, a colon, and a number or an identifier path`,
      behavior = `The text is read as a marker`,
    })
    .add({
      situation = `What follows @lfy is not a space and a path ending in .lfy, a colon, and a number or an identifier path`,
      behavior = `The text after @lfy is prose and is not read as a marker`,
    })
    // Decision: the compiler is asked to write names, never lines, so that its markers survive edits
    // that move lines.
    .add({
      behavior = `Nothing in a source map comes from the compiler but the names and lines its markers spell; every other value is derived from the model`,
    });
}

d SourceMap: `What one output file was generated from, recorded mechanically at acceptance in the map file of its unit, and re-read from the files when another unit writes them, carrying over what acceptance recorded` {
  $target: `The identifier of the target it was generated for` = string;
  $output: `The output file's path, relative to [[Workspace.root]]` = string;
  $source: `The source file's path, relative to [[Workspace.root]]` = string;
  // Decision: the hash is of the lowered code, so an edit that leaves it the same, such as a
  // comment, changes nothing.
  $hash: `SHA-256 of [[Unit.text]] of the unit when the output was accepted, as lowercase hex` = string;
  $requirements: `SHA-256 of the ids of the unit's local criteria and tests, sorted and joined by line breaks, when the output was accepted` = string;
  // Decision: the ids themselves are kept beside their hash, so a later request can tell which
  // criteria are new even when the source the output was generated from cannot be recovered.
  $answered: `The ids of the unit's local criteria and tests when the output was accepted, sorted; empty in a map file written before they were recorded` = string[];
  $signature: `SHA-256 of the unit's interface text when the output was accepted, as lowercase hex` = string;
  // Decision: the unit's own regions of the output are hashed too, so a step that would keep an
  // output as it is can tell whether the unit's code in it is still the code that was accepted and
  // reviewed. Only its own regions are hashed: another unit writing elsewhere in a shared file, such
  // as lib.rs, changes nothing the unit answers for, while an edit inside one of its regions does.
  $text: `SHA-256, as lowercase hex, of the unit's own region text of the output as it was accepted; empty in a map file written before it was recorded, which no hash equals` = string;
  $dependencies: `For each dependency's source path, the [[SourceMap.signature]] the output was generated against` = Object<
    string,
  >;
  $generated: `When the output was accepted: [[Time.Instant.rfc3339]] of [[Time.now]] at acceptance, carried over when the map is re-read from the files` = string;
  $markers: `Every [[Marker]] in the output, in output order, with [[Marker.line]] and [[Marker.end]] derived` = Marker[];

  // Interface text
  @acceptanceCriteria
    .add({
      behavior = `The interface text [[SourceMap.signature]] hashes is one line per entity of [[Unit.entities]], in the order of [[Unit.entities]], each line ended by a line break, and nothing else`,
    })
    .add({
      situation = `An entity of [[Unit.entities]] is a data, type, trait, or enum`,
      behavior = `Its line is followed by one line per member or enum member it declares, in declaration order, each beginning with two spaces`,
    })
    .add({
      behavior = `A line begins with a hyphen, a space, the identifier between backticks, a space, and the kind between parentheses`,
    })
    .add({
      situation = `The entity of a line has no identifier`,
      behavior = `The word anonymous stands for its identifier`,
    })
    .add({
      behavior = `A kind is spelled data: DataDeclaration, type: TypeDeclaration, trait: TraitDeclaration, enum: EnumDeclaration, agent function: AgentFunctionDeclaration for a fn, function: FunctionDeclaration for a function, variable: VariableDeclaration, alias: AliasDeclaration, external: ExternalDeclaration, member, or enum member`,
    })
    .add({
      behavior = `After the kind, a line holds, in this order and each only when its entity has one: the definition part, the type part, the parameters part, and the output part`,
    })
    .add({ behavior = `The definition part is a colon, a space, and the definition` })
    .add({
      behavior = `The type part is a space, an em dash (—), a space, the word type, a space, and the type between backticks`,
    })
    .add({
      behavior = `The parameters part is a space, an em dash, a space, the word parameters, a space, and the parameters in order between parentheses, joined by a comma and a space`,
    })
    .add({
      behavior = `A parameter in the parameters part is spelled as its name, then, when it has a type, a colon, a space, and its type`,
    })
    .add({
      behavior = `The output part is a space, an em dash, a space, the word output, a space, and the output between backticks`,
    })
    .add({
      behavior = `Wherever the interface text spells a type, it is [[typeTextOf]] that type`,
    })
    .add({
      behavior = `Wherever the interface text spells a type, an entity of the elfie package is spelled by its identifier alone, such as List or [[Path]], never by a path or a module name`,
    })
    .add({
      situation = `A change to the unit's file leaves every line of its interface text the same, such as a new criterion or a moved line`,
      behavior = `[[SourceMap.signature]] is the same as before the change`,
    });

  // Own regions
  @acceptanceCriteria
    .add({
      behavior = `A marker is a unit's own when it names the unit's file, or names an entity moved into the unit and the file declaring that entity`,
    })
    .add({
      behavior = `The unit's own region text of an output is the text of the regions of its own markers in that output, in output order, each region's lines with the marker comment a line carries, from [[Target.markerComment]] before @lfy to the end of the line, and any white space before it, removed, every line that is then empty left out, and each line followed by a line break, as [[ReviewRequest.hashes]] strips a region`,
    });

  // Source at the last accepted generation
  // Decision: lowered text leaves out criteria and tests, so a revision that only reworded a
  // criterion lowers to the same hash as the one the outputs were accepted from. Matching the
  // requirement ids as well keeps the reworded revision from being taken for the accepted one.
  @acceptanceCriteria
    .add({
      behavior = `A revision of a unit's file is one its outputs were accepted from exactly when its lowered text hashes to [[SourceMap.hash]] of the unit's outputs and its local criterion and test ids, taken as [[SourceMap.requirements]] takes them, hash to [[SourceMap.requirements]] of the unit's outputs`,
    })
    .add({
      situation = `[[SourceMap.answered]] of the unit's outputs is not empty`,
      behavior = `Comparing a revision's local criterion and test ids, sorted, with [[SourceMap.answered]] gives the same answer as comparing their hash with [[SourceMap.requirements]]`,
    })
    .add({
      behavior = `The source of a unit at its last accepted generation is its file as loaded when that is one its outputs were accepted from, and otherwise the most recent revision of its file that its outputs were accepted from`,
    })
    .add({
      situation = `Neither a unit's file as loaded nor any revision of it is one its outputs were accepted from`,
      behavior = `The source of the unit at its last accepted generation is not recoverable`,
    })
    // Decision: an old revision is lowered against the workspace as it is now, so a unit whose
    // criteria come from a trait or a with block in another file may have no revision whose ids match.
    // Its code can still be compared with the revision whose lowered text matches, while its criteria
    // are known only by the ids recorded in [[SourceMap.answered]].
    .add({
      behavior = `A unit's hash-matched source is the most recent revision of its file whose lowered text hashes to [[SourceMap.hash]] of the unit's outputs, whatever its criteria and tests`,
    });
}

d Unit: `The work the compiler does as one piece: one source file for one target, with any entities moved into it from other files` {
  $target: `What it is built for` = Target;
  $file: `The source file` = File;
  $entities: `The entities of the file built for the target that have a lowered node and were not moved out, in file order, then the entities moved into it, in the order of [[Plan.moves]]; never an entity of the elfie package, a trait, or an ace function` = Entity[];
  $lowered: `The file as lowering gave it` = LoweredFile;
  $text: `The lowered code the unit compiles: [[LoweredFile.text]] of its file without the code of the entities moved out of it, then the lowered code of each entity moved into it; exactly [[LoweredFile.text]] when nothing moved in or out` = string;
  $stem: `The name the unit goes by; the target's guidance spells the output file from it` = string;
  $dependencies: `The units of the same target its unit needs built first, each once` = Unit[];
  $outputs: `The outputs the last accepted generation produced, from the unit's map file; empty when none` = SourceMap[];
  $reason: `Why it is planned; undefined when it is up to date` = Reason | undefined;
  $waitsFor: `The [[Unit.stem]] of each planned unit it starts after, in [[Plan.units]] order: each of [[Unit.dependencies]] that is planned and either has no [[Unit.outputs]] or has an interface whose hash differs from what the unit's outputs record for it` = string[];
  @acceptanceCriteria
    .add({
      behavior = `The local criteria and tests of a unit are those of each of [[Unit.entities]] and of its file's own entity`,
    })
    .add({
      behavior = `[[Unit.stem]] is the [[File.name]] of its file`,
    })
    // Dependencies
    .add({
      situation = `A path in [[Source.uses]] of the unit's file names a file that has a unit for the same target`,
      behavior = `[[Unit.dependencies]] holds the unit of that file for the same target`,
    })
    .add({
      situation = `A path in [[Source.uses]] of the unit's file names a file that has no unit for the same target`,
      behavior = `[[Unit.dependencies]] holds, in its place, the units the used file's own uses contribute, transitively`,
    })
    .add({
      behavior = `An entity reaches another when the other is named by its type, by the type of one of its members, a member a trait added included, by the type of one of its parameters, or by its output, type arguments included`,
    })
    .add({ behavior = `Reaching is transitive` })
    .add({ behavior = `Only types are followed: a reference in a definition, a criterion, or a test reaches nothing` })
    .add({
      situation = `An entity of the unit reaches an entity held by another unit of the same target`,
      behavior = `[[Unit.dependencies]] holds that unit, whether or not the unit's file uses that unit's file`,
    });
}

// Decision: a cycle among files is resolved by moving entities down into the lowest file of the
// cycle, the one the others already use, so the uses keep saying which file is lower and no output
// ever imports a file that imports it back, whatever the target's language allows.
d Move: `Entities of one file compiled in another file's unit, because the files would otherwise reach each other` {
  $entities: `The entities moved, in the file order of the file that declares them` = Entity[];
  $origin: `The unit of the file that declares them` = Unit;
  $into: `The unit that compiles them: the unit of the lowest file of the cycle` = Unit;
  $cause: `The member, parameter, or output of an entity of [[Move.into]] whose type reaches the first of [[Move.entities]], spelled as the owner's identifier, a dot, and the member's or parameter's name, or the owner's identifier alone for an output` = string;
}

enum ForeignEditKind: `What a foreign edit did to the region it is in` {
  stub = `it only removed lines of the region and added the target's stub line, naming the unit that made it, in their place`,
  fix = `anything else, within the fix cap of [[Reach]]`,
}

// Decision: a foreign edit names its units by [[Unit.stem]], not by [[Unit]], because it is kept on
// disk in a change set and read back by a later compile, and a stem names one unit within its
// target.
d ForeignEdit: `One edit an accepted run for one unit made inside one region of another unit's output` {
  $by: `The [[Unit.stem]] of the unit whose run made it` = string;
  $owner: `The [[Unit.stem]] of the unit whose region it is in; always one of [[Reach.units]] of [[ForeignEdit.by]]` = string;
  $path: `The output file it is in, relative to [[Workspace.root]]` = string;
  $kind: `Whether it is a stub or a fix` = ForeignEditKind;
  $region: `The marker that begins the region, as the owner's outputs held it before the edit; the edit leaves it as it was` = Marker;
  $before: `The lines of the region before the edit, in order, each without its line break` = string[];
  $after: `The lines of the region after the edit, in order, each without its line break` = string[];
  $note: `Why it was made: for a stub, the reason its stub line gives; for a fix, the note the run gave through elfie_touch for [[ForeignEdit.owner]]` = string;
  @acceptanceCriteria
    .add({
      situation = `An accepted run for one unit edited a region of another unit`,
      behavior = `Exactly one [[ForeignEdit]] with that unit as [[ForeignEdit.by]] is recorded for that region and that run`,
    })
    .add({
      situation = `[[ForeignEdit.kind]] is stub`,
      behavior = `Every line of [[ForeignEdit.after]] is a line of [[ForeignEdit.before]] or a stub line naming [[ForeignEdit.by]]`,
    })
    // Decision: a rewritten line counts once, not as one line removed and one added, so the cap
    // measures how much code changed rather than how a diff spells it.
    .add({
      behavior = `The lines a foreign edit changes are the larger of two counts: the lines a line diff of [[ForeignEdit.before]] and [[ForeignEdit.after]] removes, and the lines it adds`,
    });
}

// Decision: the fix cap is two numbers kept here, once, so they can be tuned from measurements
// without touching what reads them; [[Reach]] carries them so a request and the agent server state
// the same cap.
ace const fixLines: `The most lines a fix may change in one region` = 10;
ace const fixUnitLines: `The most lines the fixes of one run may change across the regions of one other unit` = 40;

d Reach: `Which other units' outputs a run for one unit may edit, and how much` {
  $units: `Empty when every unit of the same target that depends on the unit directly and has outputs records the hash of the unit's interface as it is now; otherwise every unit of the same target that has outputs and depends on the unit, directly or through other units, in [[Plan.units]] order; their outputs and regions are those of their [[Unit.outputs]]` = Unit[];
  $fixLines: `The most lines a fix may change in one region` = number;
  $fixUnitLines: `The most lines the fixes of one run may change across the regions of one unit of [[Reach.units]]` = number;
  @acceptanceCriteria
    .add({ behavior = `[[Reach.fixLines]] is {{fixLines}}` })
    .add({ behavior = `[[Reach.fixUnitLines]] is {{fixUnitLines}}` })
    .add({
      situation = `Every unit of the same target that depends on the unit directly and has outputs has outputs whose [[SourceMap.dependencies]] record, for the unit's source path, the SHA-256 of the unit's interface text as it is now, as [[SourceMap.signature]] takes it`,
      behavior = `[[Reach.units]] is empty`,
    })
    .add({
      behavior = `A reach is read from [[Plan.units]], their outputs, and the definitions, and never depends on which units are planned`,
    });
}

d Interface: `What a dependent unit may rely on from another unit's output` {
  $unit: `The unit` = Unit;
  $outputs: `The paths of its outputs` = string[];
  $entities: `Its entities: each one's identifier, kind, definition, type, parameters and output as applicable; a type may name an entity of the elfie package by its identifier` = Entity[];
}

// Decision: a removed criterion or test is kept as its id, place, and text, taken while the file as
// it was is lowered, because its origin belongs to that lowering and nothing later can read it.
d RemovedRequirement: `A local criterion or test a unit's existing outputs were generated against that the unit no longer has` {
  $id: `The id it had` = string;
  $place: `Where it was in the unit's file as it was when its outputs were accepted: the file relative to [[Workspace.root]], a colon, and the line its origin began on; empty when not known` = string;
  $text: `What it said: [[LoweredCriterion.text]] for a criterion, its input and its expectation as written for a test; empty when not known` = string;
}

// Decision: a criterion reworded in place keeps its place but not its id, because an id hashes the
// text. Pairing it with the id it replaces lets markers move to the new id mechanically, while what
// the new text asks is still read against the code.
d Rewording: `A local criterion or test whose id changed since a unit's outputs were accepted because its text changed while it kept its position among its entity's criteria or tests` {
  $id: `The id it has now` = string;
  $replaces: `The id it had when the unit's outputs were accepted` = string;
  $text: `What it said then, as [[RemovedRequirement.text]] spells what a removed one said` = string;
}

d Previous: `The source of a unit at its last accepted generation, or its hash-matched source, recovered once and lowered once` {
  $text: `The unit's file as it was, as written and never lowered` = string;
  $program: `The program lowered with the unit's file read as [[Previous.text]] and every other file as it is` = Program;
  $hashMatched: `Whether it is only the unit's hash-matched source, as [[SourceMap]] defines one, because neither the unit's file as loaded nor any revision of it is its source at its last accepted generation` = boolean;
}

d Relocation: `The code of one entity moved from the outputs of the unit of the file that declared it to the unit of the file that declares it now, by rewriting the markers that name it` {
  $target: `The [[Target.identifier]] of the target whose outputs hold the markers` = string;
  $entity: `The name the markers spell: the identifier, or the owner's identifier, a dot, and a member's name` = string;
  $origin: `The file the markers named, relative to [[Workspace.root]]; it no longer declares the entity` = string;
  $into: `The file the markers name now, relative to [[Workspace.root]]: the one project file that declares the entity` = string;
  $markers: `How many markers were rewritten` = number;
}

d UnitReviews: `The review records one unit's review record file is to hold` {
  $target: `The [[Target.identifier]] of the unit's target` = string;
  $stem: `The [[Unit.stem]] of the unit` = string;
  $records: `Its records, sorted by [[ReviewRecord.id]]` = ReviewRecord[];
}

d Relocated: `What relocating the code of entities that moved to another file gives, for the caller to write` {
  $relocations: `One per entity, file it left, and target, in [[Workspace.targets]] order, then in [[Workspace.files]] order of [[Relocation.into]], then in the order its first marker appears in the outputs, taken in path order` = Relocation[];
  $outputs: `Each output file holding a rewritten marker, with its text once its markers are rewritten, in path order` = Output[];
  $sourceMaps: `Every source map read, with the maps of each unit a relocation moved code out of or into replaced by its maps as they read once [[Relocated.outputs]] are written` = SourceMap[];
  $reviews: `The review records of each unit a relocation moved review records out of or into, as they are to be recorded, in [[Plan.units]] order` = UnitReviews[];
}

d Request: `Everything the compiler is handed to produce the outputs of one unit` {
  $unit: `The unit` = Unit;
  $instructions: `The prompt: what to produce, where, the rules for producing it, and how to report the outcome` = string;
  $source: `[[Unit.text]] of the unit` = string;
  $requirements: `The local criteria and tests of the unit, each with its id` = (LoweredCriterion | LoweredTest)[];
  $globals: `Every global criterion and test of [[Plan.program]], each once with its id` = (LoweredCriterion | LoweredTest)[];
  $previous: `The lowered text the unit's existing outputs were generated from; undefined where unknown` = string | undefined;
  $answered: `The ids of the local criteria and tests the unit's existing outputs were generated against; undefined where unknown` = string[] | undefined;
  $removed: `The local criteria and tests the unit's existing outputs were generated against that the unit no longer has and that no criterion or test now rewords; undefined where the source they were generated from is unknown` = RemovedRequirement[] | undefined;
  $reworded: `The local criteria and tests of the unit that reword one its existing outputs were generated against; undefined where the source they were generated from is unknown` = Rewording[] | undefined;
  $rewordedOnly: `Whether the unit's existing outputs differ from what it asks for now only in the ids of reworded criteria and tests` = boolean;
  $existing: `The current text of each existing output of the unit, by path` = Object<string>;
  // Decision: the foreign edits are listed in the request, named by the unit that made them, so the
  // code an earlier run wrote into this unit's outputs is never taken for code this unit's own
  // last accepted run wrote.
  $foreignEdits: `Every edit another unit's run made inside the unit's regions since the unit was last accepted, in the order they were made; each has the unit as [[ForeignEdit.owner]]` = ForeignEdit[];
  $reach: `The later units whose outputs the run may edit, and the fix cap` = Reach;
  $relocated: `Every relocation of this compile whose [[Relocation.into]] or [[Relocation.origin]] is the unit's file, for the unit's target, in the order they were made` = Relocation[];
  $interfaces: `One [[Interface]] per dependency of the unit, in dependency order, each once` = Interface[];
  $guidance: `The criteria of [[Target.declaration]], in the guidance order [[Targets.Target]] gives, with template values rendered from the layers' arguments` = Criterion[];
  $nativeDependencies: `What the generated code may require from the target's ecosystem: [[Target.nativeDependencies]]` = NativeDependency[];
  $knowledge: `What the compiler is given to read: [[Target.knowledge]], then the knowledge of each entity of the unit, then of each entity of [[Request.interfaces]], each item once` = Knowledge[];
  $commands: `The commands the compiler runs instead of knowing the tools: [[Target.commands]]` = Command[];
  @acceptanceCriteria
    .add({
      behavior = `[[Request.requirements]] is every [[LoweredNode.criteria]] and [[LoweredNode.tests]] of [[Unit.entities]] of the unit, then [[LoweredFile.criteria]] and [[LoweredFile.tests]] of its file`,
    })
    .add({ behavior = `[[Request.globals]] is [[Program.criteria]] then [[Program.tests]] of [[Plan.program]]` })
    .add({
      behavior = `A criterion an add call in any file adds to [[Target.declaration]] is among the declaration's own criteria in [[Request.guidance]]`,
    })
    .add({
      situation = `A trait is reached again, with equal arguments, among the layers and the traits they extend`,
      behavior = `It contributes to [[Request.guidance]] once, at its first place`,
    })
    .add({
      behavior = `What a request holds never depends on which other units are planned with the unit`,
    });
}

d ReviewRequest: `Everything a verifier is handed to check outputs against what was asked: the local criteria and tests of one unit that need review, or every global one once` {
  $unit: `The unit; undefined for the review of global criteria and tests` = Unit | undefined;
  $instructions: `The prompt: every criterion and test under review with its id and place, where the regions answering for each are, and how to report` = string;
  $asked: `The id of every criterion and test [[ReviewRequest.instructions]] lists, in the order listed` = string[];
  $hashes: `For every local criterion and test of the unit, by id, the hash of the regions of the entity it belongs to, as the review computed it; empty for the review of global criteria and tests` = Object<
    string,
  >;
  $carried: `The record of every local criterion and test of the unit that is not listed, kept from its last review; empty for the review of global criteria and tests` = ReviewRecord[];
  @acceptanceCriteria
    .add({
      behavior = `A criterion's or test's place is the file of its origin relative to [[Workspace.root]], a colon, and the line its origin begins on`,
    })
    // Decision: verdicts are submitted through the agent server as they are judged, and the
    // JSON line is kept as the way a verifier with no agent server, or one run by hand, reports.
    .add({
      behavior = [
        `[[ReviewRequest.instructions]] holds the verifier protocol, which says:`,
        `That the reader examines and never edits, and never proposes code`,
        `That the code of a region is read through elfie_output, by the id of a criterion or test or by the name of an entity, or by reading the lines of the output file the region names`,
        `That verdicts are submitted as they are judged, many to a turn: one call of elfie_reportMany with one JSON line per verdict, or several calls of elfie_report in the same turn, and never one verdict per turn`,
        `That the id given to elfie_report or in a line of elfie_reportMany is copied from the instructions, or left out when file and line, the two halves of the place the instructions give, are given instead`,
        `That status is satisfied, violated, or unverifiable, evidence is the output path and line range it read or empty, and note is one line saying why and, for a violated one, what the code does instead`,
        `That a criterion no region can be checked against is unverifiable, not violated`,
        `That the tools of the agent server are called before files are searched or read by hand: elfie_source for where a line of generated code came from, elfie_search for the lines of the outputs that match a pattern, such as the body of a helper no marker names, elfie_entity for a definition with its criteria and tests, and elfie_references for where a name is used`,
        `That where elfie_report is not offered, each verdict is written in the final message instead, as one JSON object on one line with exactly the keys id, file, line, status, evidence, and note, holding what elfie_report would be given`,
        `That the final message ends with one line reading ELFIE: REVIEWED`,
      ],
    });
}

d ReviewRecord: `The last verdict on one local criterion or test of a unit, with the hash of the code it was judged against` {
  $id: `The id of the criterion or test` = string;
  $status: `What its last review found` = ReviewStatus;
  $hash: `The criterion's or test's hash in [[ReviewRequest.hashes]] of the review request it was reviewed under` = string;
  @acceptanceCriteria
    .add({
      behavior = `A unit's review record file is elfie-compile/reviews under [[Workspace.root]], then [[Target.identifier]], then [[Unit.stem]] with the extension .json, such as elfie-compile/reviews/rust/cli/main.json for def/cli/main.lfy`,
    })
    .add({
      behavior = `A record made from a [[Review]] of a run has the review's [[Review.id]] and [[Review.status]], and the hash [[ReviewRequest.hashes]] of the run's review request gives that id`,
    });
}

d Output: `One file the compiler produced` {
  $path: `Relative to [[Workspace.root]]` = string;
  $text: `Its content` = string;
}

enum OutcomeKind: `How one run of the compiler ended` {
  accepted = `the unit was accepted`,
  rejected = `an output failed acceptance`,
  blocked = `the compiler reported it could not proceed`,
  clarification = `the compiler asked a question only a person can answer`,
  failed = `the compiler command could not run, or exited without producing anything`,
}

enum SubmittedOutcome: `How the compiler says its run ended when it submits the outcome through the agent server` {
  done = `every output is written`,
  blocked = `it could not proceed`,
  clarify = `only a person can decide`,
}

// Decision: the compiler states its outcome through elfie_submit, checked when the call is made, so
// the CLI reads a structured outcome and never a line of text; the ELFIE: line of the final message
// is kept for a compiler with no agent server, or one run by hand.
d Submission: `The outcome a compiler submitted through the agent server` {
  $outcome: `How it says the run ended` = SubmittedOutcome;
  $message: `The reason for blocked or the question for clarify; for done, a note that is no part of the outcome, and may be empty` = string;
}

d Outcome: `What one run of the compiler came to, read mechanically from its submission or its report, and the verdict` {
  $kind: `How it ended` = OutcomeKind;
  $message: `The compiler's reason or question, or the first problem; empty when accepted` = string;
  $verdict: `The [[Verdict]] on the unit; undefined when the compiler never got that far` = Verdict | undefined;
}

d Verdict: `Whether outputs are accepted for one unit` {
  $accepted: `Whether every check passed` = boolean;
  $problems: `What failed and why, one per failure; empty when accepted` = string[];
  $sourceMaps: `One per accepted output; empty when rejected` = SourceMap[];
  $outputs: `Each accepted output with its markers normalized to the name form, for the caller to write back; empty when rejected` = Output[];
  $foreignEdits: `Every edit the outputs make inside a region of another unit, one per region, in the order of their paths and then of their lines; empty when rejected` = ForeignEdit[];
}

enum ChangeKind: `What differs for one entity between a unit's file as last accepted and as it is now` {
  added = `the entity is declared now and was not before`,
  removed = `the entity was declared before and is not now`,
  definition = `its definition differs`,
  declaredType = `its type differs, as the interface text of [[SourceMap.signature]] spells it`,
  signature = `its parameters or its output differ`,
  criteria = `its criteria differ in count or in the text of any`,
  tests = `its tests differ`,
  body = `anything else in the text of its declaration differs`,
}

d Change: `One difference for one entity between a unit's file as last accepted and as it is now` {
  $entity: `The identifier, or the owner's identifier, a dot, and a member's name` = string;
  $kind: `What differs` = ChangeKind;
  $detail: `What changed, in one line, quoting the old and the new when they are short` = string;
}

enum ReviewStatus: `What a verifier found for one criterion or test` {
  satisfied = `the output does what it says`,
  violated = `the output does something else`,
  unverifiable = `no output can be checked against it`,
}

// Decision: a review names its criterion or test by id and quotes nothing; its file, line, and entity
// are derived from the id's origin, so a verifier never has to spell a place right.
d Review: `A verifier's finding for one criterion or test` {
  $id: `The id of the [[LoweredCriterion]] or [[LoweredTest]] it answers for` = string;
  $file: `The definition file the criterion or test is written in, relative to [[Workspace.root]]` = string;
  $line: `The line the criterion or test begins on` = number;
  $entity: `The identifier, or the owner's identifier, a dot, and a member's name, of the entity it belongs to` = string;
  $status: `What was found` = ReviewStatus;
  $evidence: `The output path and line range it was checked against, such as crates/elfie-core/src/x.rs:120-134; empty when none` = string;
  $note: `Why, in one line; for a violated one, what the code does instead` = string;
  @acceptanceCriteria
    .add({
      situation = `The id names a criterion or test that is not global`,
      behavior = `[[Review.file]], [[Review.line]], and [[Review.entity]] are derived from the origin of the criterion or test the id names, never read from the verifier`,
    })
    .add({
      situation = `The id names a global criterion or test`,
      behavior = `[[Review.file]] and [[Review.line]] are derived from the origin of the criterion or test the id names, never read from the verifier, and [[Review.entity]] is global`,
    });
}

d ReviewReport: `Everything a verifier found for one unit, or for the global review, read mechanically from its report` {
  $reviews: `Each review submitted through the agent server, in the order recorded, then each read from the report, in report order; one per id` = Review[];
  $problems: `Each review line that was not read as a [[Review]], then the line reading the report did not end when there was no end line` = string[];
  $unplaced: `Each review line that was not read as a [[Review]] though its status is violated, as written; each is in [[ReviewReport.problems]] too` = string[];
  $missing: `Each id the review was asked about that no review in [[ReviewReport.reviews]] names, in the order it was asked` = string[];
}

d Plan: `Every unit of a workspace, which need generating, and the order they are compiled in` {
  $workspace: `The workspace planned` = Workspace;
  $program: `The workspace lowered, which units, requests, and reviews read` = Program;
  $units: `Every unit of every target, each after its dependencies; the planned units are compiled in this order, each starting once each unit of its [[Unit.waitsFor]] has merged into its change set, been skipped, or stopped` = Unit[];
  $moves: `Every move that resolved a cycle among files, in [[Plan.units]] order of [[Move.origin]], then in file order of the first of [[Move.entities]]` = Move[];
  $problems: `Every cycle among files that no move could resolve, and every entity that reaches one not built for its target, one [[Problem]] each` = Problem[];
}
