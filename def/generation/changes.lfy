use "../interpret/data";
use "../lexer/data";
use "../model/data";
use "../workspace/data";
use "./data";
use "./main";

// Decision: a change is found by comparing entities, never by diffing lines, so a reformatted or
// reordered file whose entities read the same gives none.
/// previous: the unit's source at its last accepted generation, or its hash-matched source, as recovered for the unit; undefined when neither is known
fn changes(workspace: Workspace, unit: Unit, previous: Previous | undefined): `What differs for each entity of a unit between its file as last accepted and as it is now` => Change[] {
  @acceptanceCriteria
    .add({
      behavior = [
        `The file as it was is the unit's file as [[Program.workspace]] of [[Previous.program]] of [[previous]] declares it, and the entities it declared are read from that workspace's model`,
        `Nothing is lowered or bound`,
      ],
    })
    .add({
      behavior = `The entities the file declared then are compared with those [[Unit.file]] declares now, both those built for [[Unit.target]], whether or not they moved to another unit`,
    })
    .add({
      behavior = `Entities are compared by name: the identifier, or the owner's identifier, a dot, and a member's name`,
    })
    .add({ behavior = `A member is compared as an entity of its own, under its owner` })
    .add({
      situation = `[[previous]] is undefined`,
      behavior = `One [[Change]] of kind [[ChangeKind.added]] per entity [[Unit.file]] declares that is built for [[Unit.target]], in file order, and nothing else`,
    })
    .add({
      situation = `A name is declared now and was not before`,
      behavior = `One [[Change]] of kind [[ChangeKind.added]]`,
    })
    .add({
      situation = `A name was declared before and is not now`,
      behavior = `One [[Change]] of kind [[ChangeKind.removed]]`,
    })
    .add({
      situation = `A name is declared on both sides`,
      behavior = `One [[Change]] per kind that differs, in the order [[ChangeKind]] declares them`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `[[Entity.definition]] differs`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.definition]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The type of the entity, spelled as [[interfaceOf]] spells it, differs`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.declaredType]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The entity is a fn, and its parameters, their types, or its output, spelled as [[interfaceOf]] spells them, differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.signature]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local criteria differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.criteria]], whose detail names the ids added and removed`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local criteria differ`,
        `Counting from the first, the criterion at some position among its local criteria then has an id that is none of its criteria's now, and the criterion at the same position now has an id that was none of its criteria's then`,
      ],
      behavior = `The detail of the [[ChangeKind.criteria]] change calls those two reworded, as a pair`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local tests differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.tests]], whose detail names the ids added and removed`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local tests differ`,
        `Counting from the first, the test at some position among its local tests then has an id that is none of its tests' now, and the test at the same position now has an id that was none of its tests' then`,
      ],
      behavior = `The detail of the [[ChangeKind.tests]] change calls those two reworded, as a pair`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The joined [[Token.raw]] of the tokens the declaring node covers differs once its definition, type, parameters, output, criteria, tests, whitespace, and comments are left out`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.body]]`,
    })
    .add({
      behavior = `The changes are in file order: the changes of entities declared now follow the order of [[Unit.entities]]`,
    })
    .add({
      situation = `An entity was removed, and some entity that preceded it in the previous file is still declared`,
      behavior = `Its change is placed after the changes of the last entity that preceded it in the previous file and is still declared`,
    })
    .add({
      situation = `An entity was removed, and no entity that preceded it in the previous file is still declared`,
      behavior = `Its change is placed first`,
    })
    .add({
      situation = `The old and the new of what differs are each under 80 characters`,
      behavior = `[[Change.detail]] is one line saying what differs, quoting the old and the new`,
    })
    .add({
      situation = `The old or the new of what differs is 80 characters or more`,
      behavior = `[[Change.detail]] is one line saying what differs, naming the old and the new rather than quoting them, such as the count of criteria before and after or the name of the parameter that differs`,
    });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A and a fn f`),
        Unit@like(`The unit of a.lfy`),
        undefined,
      ],
      expect = [Change@like(`A added`), Change@like(`f added`)],
    },
    {
      input = [
        Workspace@like(
          `def holds a.lfy declaring a data A defined as a thing and a fn f taking x: string and y: number`,
        ),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: A defined as a value and f taking only x: string`),
      ],
      expect = [
        Change@like(`A, definition, detail quoting a value and a thing`),
        Change@like(`f, signature, detail naming the added parameter y`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with three criteria and a data B`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: a data A, then f with two of those criteria, and B with one more member, old`),
      ],
      expect = [
        Change@like(`A removed`),
        Change@like(`f, criteria, detail reading 2 criteria before and 3 now`),
        Change@like(`B.old, removed`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A and a fn f`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(
          `a.lfy as it was: the same declarations with f before A, indented differently, and with a comment`,
        ),
      ],
      expect = [],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with criteria c1 then c4`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: f with criteria c1 then c2, c2 worded differently from c4`),
      ],
      expect = [Change@like(`f, criteria, detail naming c2 removed and c4 added and calling them reworded`)],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with criteria c0, then c1, then c5`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: f with criteria c1 then c2, c2 worded differently from c5`),
      ],
      expect = [Change@like(`f, criteria, detail naming c2 removed and c0 and c5 added, and calling no pair reworded`)],
    },
  );
}

/// previous: the unit's source at its last accepted generation, as recovered for the unit
fn reworded(workspace: Workspace, unit: Unit, previous: Previous): `The local criteria and tests of a unit whose id changed since its outputs were accepted only because their text did, each paired with the id it replaces` => Rewording[] {
  @acceptanceCriteria
    .add({
      behavior = `Returns one [[Rewording]] for each pair of a removed and an added id that a change of [[changes]] of [[workspace]], [[unit]], and [[previous]] calls reworded, in the order of those changes`,
    })
    .add({ behavior = `[[Rewording.id]] is the added id, and [[Rewording.replaces]] the removed one` })
    .add({
      behavior = `[[Rewording.text]] is what the removed one said, taken from the unit's file in [[Previous.program]] of [[previous]], as a [[RemovedRequirement]] takes its text`,
    })
    .add({
      situation = `The added id of a pair is not the id of a local criterion or test of [[unit]]`,
      behavior = `The pair gives no [[Rewording]]`,
    })
    .add({ behavior = [`Nothing is written`, `Nothing is lowered or bound`] });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with criteria c1 then c4, and a data B with tests t1 then t2`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: f with criteria c1 then c2, and B with tests t3 then t2`),
      ],
      expect = [
        Rewording@like(`c4, replacing c2, with the text of c2`),
        Rewording@like(`t1, replacing t3, with the input and expectation of t3`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with criteria c3 then c1`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: f with criteria c1 then c2`),
      ],
      expect = [],
    },
  );
}
