use "../grammar/rules/statement";
use "../interpret/data";
use "../interpret/main" as Interpreter;
use "../lexer/data";
use "../model/data";
use "../workspace/data";
use "../workspace/main" as Loader;
use "./data";
use "elfie/system/file" as Files;
use "elfie/system/json" as Json;
use "elfie/system/path";
use "elfie/system/time" as Time;
use "elfie/target/framework";
use "elfie/target/language";
use "elfie/target/layout";

// Decision: a unit is one source file for one target. Outputs and source maps are per file, a
// declaration's scope is its file, and a smaller unit would make the compiler merge into a file it
// does not own, which is itself an act of generation. A larger unit would not fit a request, but
// several units can share one: that is a batch. The one exception is a cycle among files, which no
// order of units can build: its entities move whole into the unit of the lowest file of the cycle.

fn interfaceOf(workspace: Workspace, unit: Unit): `What dependents of a unit may rely on, as one text whose hash tells whether it changed` => string {
  @acceptanceCriteria.add({
    behavior = `Returns the interface text of [[unit]] that [[SourceMap.signature]] hashes, exactly as [[SourceMap]] spells it`,
  });
}

/// sourceMaps: the source maps recorded for the workspace, as [[sourceMapsOf]] gives them
/// requested: units the caller asks for whatever their state, each named by its [[Unit.stem]] or its [[File.path]]
/// violated: the stems of units whose outputs answer for a global criterion or test the last global review found violated
fn plan(workspace: Workspace, sourceMaps: SourceMap[], requested: string[] = [], violated: string[] = []): `Every unit of a workspace, which need generating, and how they are batched` => Plan {
  // Selection
  @acceptanceCriteria
    .add({ behavior = `[[Plan.program]] is [[Interpreter.lower]] of [[workspace]]` })
    .add({ behavior = `[[Unit.lowered]] is the [[LoweredFile]] of [[Plan.program]] for the unit's file` })
    .add({
      behavior = `An entity is built for each [[Target]] whose [[Target.declaration]] is among the targets [[Entity.targets]] builds it for, and for no other`,
    })
    .add({
      behavior = `Only an entity declared in the file scope of a file is built: a member, a parameter, or an enum member goes with the entity that holds it`,
    })
    .add({
      situation = `A file has no [[File.package]] and at least one entity with a lowered node built for a target`,
      behavior = `The file gives one [[Unit]] for that target`,
    })
    .add({ situation = `A file has a [[File.package]]`, behavior = `It gives no [[Unit]]` })
    .add({
      situation = [
        `An entity of a unit reaches an entity of a project file that has a lowered node`,
        `That entity is not built for the unit's target`,
      ],
      behavior = `A [[Problem]] is added to [[Plan.problems]] at the member, parameter, or output whose type reaches it, naming both entities and the target`,
    });

  // Dependencies
  // Decision: a cycle among uses is reported once, by the [[Problem]] the workspace already holds.
  @acceptanceCriteria
    .add({
      situation = `There is a cycle among uses`,
      behavior = [`The cycle adds nothing to [[Plan.problems]]`, `The cycle moves no entity`],
    })
    .add({
      behavior = `[[Plan.units]] holds every unit of every target, each after its dependencies outside any cycle, otherwise in [[Workspace.targets]] then [[Workspace.files]] order`,
    });

  // Cycles
  @acceptanceCriteria
    .add({
      behavior = `A cycle is two or more units of one target each of which depends on every other, directly or through other units`,
    })
    .add({
      behavior = `The lowest file of a cycle is the file of one of its units that the file of every other unit of the cycle uses, directly or through other files, and that itself uses none of them`,
    })
    .add({
      situation = `A cycle has a lowest file`,
      behavior = `Every entity of another unit of the cycle that an entity of the lowest file's unit reaches moves into the lowest file's unit`,
    })
    .add({
      situation = `A cycle has a lowest file`,
      behavior = `Each unit an entity leaves gives one [[Move]] to [[Plan.moves]]`,
    })
    .add({
      situation = `An entity moved into a unit`,
      behavior = `It is among [[Unit.entities]] of the unit it moved into and not among those of the unit it left`,
    })
    .add({
      situation = `An entity moved into a unit`,
      behavior = `The unit it left depends on the unit it moved into`,
    })
    .add({ behavior = `After planning, no cycle that has a lowest file is left` })
    .add({
      situation = [
        `A cycle has no lowest file`,
        `The files of the cycle's units form no cycle among uses`,
      ],
      behavior = [
        `A [[Problem]] is added to [[Plan.problems]] at the first declaration, in [[Workspace.files]] order and then source order, of a member, parameter, or output whose type reaches an entity of another file of the cycle, naming every file of the cycle`,
        `Nothing moves for that cycle`,
      ],
    })
    .add({
      behavior = `Every move is decided by the definitions and the target's units alone, never by the target's guidance`,
    });

  // Staleness
  @acceptanceCriteria
    .add({
      behavior = `[[Unit.outputs]] is every [[SourceMap]] in [[sourceMaps]] whose target and source are the unit's`,
    })
    .add({
      situation = `[[File.path]] or [[Unit.stem]] is in [[requested]]`,
      behavior = `[[Unit.reason]] is requested`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is in [[violated]]`,
      ],
      behavior = `[[Unit.reason]] is violated`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is empty`,
      ],
      behavior = `[[Unit.reason]] is fresh`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] differs from [[SourceMap.hash]] of any output`,
      ],
      behavior = `[[Unit.reason]] is changed`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids differs from [[SourceMap.requirements]] of any output`,
      ],
      behavior = `[[Unit.reason]] is requirements`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids equals [[SourceMap.requirements]] of every output`,
        `The hash of [[interfaceOf]] some dependency differs from what [[SourceMap.dependencies]] of the unit's outputs record for it, or they record nothing for it`,
      ],
      behavior = `[[Unit.reason]] is dependency`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids equals [[SourceMap.requirements]] of every output`,
        `For every dependency, [[SourceMap.dependencies]] of the unit's outputs record a hash for it and it equals the hash of [[interfaceOf]] that dependency`,
      ],
      behavior = `[[Unit.reason]] is undefined`,
    })
    .add({
      situation = `An edit changes only the body of one fn, and no unit was stale before it`,
      behavior = `Only the unit holding that fn is planned`,
    });

  // Batching
  // Decision: batches follow the plan order and the directory a unit sits in, because units of one
  // directory share a crate module and most of their interfaces, so the shared context is sent once.
  // Decision: a dependency unit is compiled against what the batch holding its dependencies
  // produces, so it joins that batch across directories, within the same size limits.
  @acceptanceCriteria
    .add({
      behavior = `[[Plan.batches]] partitions the planned units in [[Plan.units]] order: each planned unit joins the batch opened last or opens a new one`,
    })
    .add({ situation = `There is no open batch`, behavior = `The planned unit opens a new batch` })
    .add({
      situation = `The open batch holds {{batchUnits}} units`,
      behavior = `The planned unit opens a new batch`,
    })
    .add({
      situation = `The sources of the open batch and the planned unit together are {{batchCharacters}} characters or more`,
      behavior = `The planned unit opens a new batch`,
    })
    // Decision: a batch is for one target, because its request makes the compiler the compiler for
    // one target.
    .add({
      situation = `The planned unit's [[Unit.target]] is not that of the units of the open batch`,
      behavior = `The planned unit opens a new batch`,
    })
    .add({
      situation = [
        `The open batch holds fewer than {{batchUnits}} units`,
        `The sources of the open batch and the planned unit together are under {{batchCharacters}} characters`,
        `The planned unit's [[Unit.target]] is that of the units of the open batch`,
        `The planned unit and the open batch share the first segment of [[Unit.stem]]`,
      ],
      behavior = `The planned unit joins the open batch`,
    })
    .add({
      situation = [
        `The open batch holds fewer than {{batchUnits}} units`,
        `The sources of the open batch and the planned unit together are under {{batchCharacters}} characters`,
        `The planned unit's [[Unit.target]] is that of the units of the open batch`,
        `The planned unit's reason is dependency`,
        `The unit has at least one planned dependency, and every one of them is in the open batch`,
      ],
      behavior = `The planned unit joins the open batch, even when they do not share the first segment of [[Unit.stem]]`,
    })
    .add({
      situation = [
        `The open batch holds fewer than {{batchUnits}} units`,
        `The sources of the open batch and the planned unit together are under {{batchCharacters}} characters`,
        `The planned unit and the open batch do not share the first segment of [[Unit.stem]]`,
        `The unit's reason is not dependency, or it has no planned dependency, or one of its planned dependencies is not in the open batch`,
      ],
      behavior = `The planned unit opens a new batch`,
    });

  @test(
    {
      input = [
        Workspace@like(`One target rust that global's targets hold; def holds a.lfy using ./b and b.lfy`),
        [],
        [],
      ],
      expect = Plan@like(`Two units, b before a, a depending on b, both with reason fresh, in one batch named b+1`),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold; def holds b.lfy declaring d B, and a.lfy using ./b and declaring d A with a member of type B and d C with a member of type string; c.lfy applies to B a trait adding a member of type C`,
        ),
        [],
        [],
      ],
      expect = Plan@like(
        `One move of C from a into b, caused by the member the trait added to B; b's unit holds B then C; a's unit holds A and depends on b's; both with reason fresh`,
      ),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold; def holds a.lfy declaring d A with a member of type B, and b.lfy declaring d B with a member of type A, neither using the other`,
        ),
        [],
        [],
      ],
      expect = Plan@like(`No moves, and one problem at the member of A naming a.lfy and b.lfy`),
    },
    {
      input = [
        Workspace@like(`The same project`),
        [
          SourceMap@like(
            `For a and for b, hashes matching the files, interface hashes matching, generated at the same time`,
          ),
        ],
        [],
      ],
      expect = Plan@like(`Two units, neither with a reason, and no batches`),
    },
    {
      input = [
        Workspace@like(`The same project with a comment added inside b.lfy`),
        [SourceMap@like(`For a and for b, hashes of the old files, interface hashes matching the current interfaces`)],
        [],
      ],
      expect = Plan@like(`b with reason changed and a without a reason`),
    },
    {
      input = [
        Workspace@like(`The same project with a member added to a data of b.lfy`),
        [SourceMap@like(`For a and for b, hashes and interface hashes of the old files`)],
        [],
      ],
      expect = Plan@like(`b with reason changed and a with reason dependency, in one batch`),
    },
    {
      input = [Workspace@like(`A project whose only target no entity, file, or global holds among its targets`), [], []],
      expect = Plan@like(`No units`),
    },
    {
      input = [
        Workspace@like(`One target rust that global's targets hold; def holds a.lfy using ./b and b.lfy`),
        [SourceMap@like(`For a and for b, hashes matching the files, interface hashes matching`)],
        [`a`],
        [],
      ],
      expect = Plan@like(`a with reason requested and b without a reason, in one batch named a`),
    },
    {
      input = [
        Workspace@like(`The same project`),
        [SourceMap@like(`For a and for b, hashes matching the files, interface hashes matching`)],
        [],
        [`b`],
      ],
      expect = Plan@like(`b with reason violated and a without a reason`),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold; def/x holds seven small files a.lfy through g.lfy, none using another`,
        ),
        [],
      ],
      expect = Plan@like(
        `Seven units with reason fresh, in two batches: a through f named x/a+5, then g alone named x/g`,
      ),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold; def/x holds a.lfy and b.lfy, neither using the other, each lowering to 40,000 characters`,
        ),
        [],
      ],
      expect = Plan@like(`Two units with reason fresh, in two batches named x/a and x/b`),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold; def/p/a.lfy declares d A, and def/q/b.lfy uses ../p/a and declares d B with a member of type A; A has a member added since the outputs were accepted`,
        ),
        [SourceMap@like(`For p/a and for q/b, hashes and interface hashes of the old files`)],
      ],
      expect = Plan@like(`p/a with reason changed and q/b with reason dependency, in one batch named p/a+1`),
    },
  );
}

/// previous: the text of each unit's definition file when its outputs were last accepted, as written and never lowered, by [[File.path]]
/// hosted: whether the compiler reading the request runs in a compiler session of the compile-hosted agent server, which offers elfie_task, elfie_dependency, elfie_mark, and elfie_submit
// Decision: the request is handed the source as written and lowers it itself, as [[changes]] does,
// because lowered text holds no criteria, and the criteria are what a compiler most needs compared.
// Decision: the caller says whether the request is for a hosted compiler session, because only the
// caller knows; a hosted compiler pulls an interface when it needs one, so its request names the
// interfaces instead of quoting them, while a request read anywhere else quotes them whole.
fn request(plan: Plan, batch: Batch, existing: Output[], previous: Object<string> = {}, hosted: boolean = false): `Everything the compiler is handed to produce the outputs of one batch` => Request {
  @acceptanceCriteria
    .add({ behavior = `[[Request.batch]] is [[batch]]` })
    .add({
      behavior = `The file as it was, for each path of [[previous]], is that path in [[Interpreter.lower]] of [[Loader.change]] of [[Program.workspace]] of [[Plan.program]] with that path and its text in [[previous]]`,
    })
    .add({
      behavior = `[[Request.previous]] maps each path of [[previous]] that is the file of a unit of [[batch]] to [[LoweredFile.text]] of the file as it was`,
    })
    .add({
      situation = `Some [[SourceMap.answered]] of the [[Unit.outputs]] of a unit of [[batch]] is not empty`,
      behavior = `[[Request.answered]] maps the unit's [[File.path]] to the ids of that [[SourceMap.answered]]`,
    })
    .add({
      situation = [
        `Every [[SourceMap.answered]] of the [[Unit.outputs]] of a unit of [[batch]] is empty`,
        `[[previous]] has an entry for the unit's file`,
      ],
      behavior = `[[Request.answered]] maps the unit's [[File.path]] to the ids of the local criteria and tests of the file as it was`,
    })
    .add({
      situation = `[[previous]] has an entry for the file of a unit of [[batch]]`,
      behavior = `[[Request.removed]] maps the unit's [[File.path]] to each local criterion and test of the file as it was whose id is none of the unit's now, in the order the file as it was gives them`,
    })
    .add({
      behavior = `[[Request.existing]] maps the path of each of [[existing]] whose path is among the [[Unit.outputs]] of a unit of the batch to its text`,
    });

  // Knowledge
  @acceptanceCriteria
    .add({
      situation = [`A knowledge item has the kind reference or example`, `Its quote is true`],
      behavior = `[[Request.instructions]] quotes the [[Files.read]] text of the source path [[Loader.load]] gives it`,
    })
    .add({
      situation = [`A knowledge item has the kind reference or example`, `Its quote is false or left out`],
      behavior = `[[Request.instructions]] gives the source path [[Loader.load]] gives it and says to read it before writing anything it covers`,
    })
    .add({
      situation = `A knowledge item has the kind definition`,
      behavior = `[[Request.instructions]] gives the files its source, a use path, resolves to and says to read them as Elfie`,
    })
    .add({
      situation = `A knowledge item has the kind tool`,
      behavior = `[[Request.instructions]] names the tool of the agent server its source names and says to call it before relying on what it answers`,
    });

  // Instructions
  // Decision: the instructions quote every criterion and test already resolved, so a compiler with no
  // access to the model can still work; the agent server is offered for what the request leaves out.
  // Decision: the tools of the agent server are offered first because they answer from the program
  // and its source maps at once.
  @acceptanceCriteria
    .add({
      behavior = `[[Request.instructions]] gives its parts in this order: the role, the outputs, the guidance, the native dependencies, the knowledge, the interfaces, the commands, one section per unit of the batch in batch order, the global section, the rules, the tools, and the report`,
    })
    .add({
      behavior = [
        `The role says that the reader is the compiler for the target`,
        `The role says that its whole job is the outputs for the units of this batch, listed by stem`,
        `The role says that it writes nothing outside them`,
      ],
    })
    .add({
      behavior = `The outputs part says that the outputs go under [[Target.outputDirectory]], spelled from each [[Unit.stem]] as the guidance says`,
    })
    .add({
      situation = `A unit of [[batch]] has outputs in [[Unit.outputs]]`,
      behavior = `The outputs part says that the outputs of that unit go at the paths in its [[Unit.outputs]]`,
    })
    .add({
      situation = `[[Request.existing]] is not empty`,
      behavior = [
        `The outputs part says that only what the difference between [[Request.previous]] and [[Request.sources]], and the criteria and tests marked new or removed, require changes`,
        `The outputs part says that names and structure are kept`,
        `The outputs part says that markers of unchanged items are kept`,
      ],
    })
    .add({
      situation = [`[[Request.existing]] is not empty`, `[[Request.previous]] has no entry for a unit of [[batch]]`],
      behavior = `The outputs part says that the existing outputs of that unit are reconciled with its source`,
    })
    .add({
      situation = [`[[Request.existing]] is not empty`, `[[Request.answered]] has no entry for a unit of [[batch]]`],
      behavior = `The outputs part says that which criteria and tests of that unit are new is not known, so the existing code is read against each of them before its marker is written`,
    })
    .add({
      behavior = `The guidance, native dependencies, and knowledge parts give [[Request.guidance]], [[Request.nativeDependencies]], and [[Request.knowledge]]`,
    })
    .add({
      situation = `[[hosted]] is false`,
      behavior = `The interfaces part gives, for each of [[Request.interfaces]], the dependency's output paths and the identifier, kind, definition, and type of each of its entities`,
    })
    .add({
      situation = `[[hosted]] is true`,
      behavior = `The interfaces part gives, for each of [[Request.interfaces]], one line reading the [[File.path]] of [[Interface.unit]], its output paths, and the identifiers of its entities, and no definition, kind, or type`,
    })
    .add({
      situation = `[[hosted]] is true`,
      behavior = `The interfaces part says that the interface of one of those entities, with its kind, definition, type, parameters, and output, is read with elfie_dependency`,
    })
    .add({
      behavior = `[[Request.interfaces]] holds every entity of each dependency whether or not [[hosted]] is true`,
    })
    .add({
      behavior = `The interfaces part says that an interface is used by the names its outputs spell and never edited`,
    })
    .add({
      behavior = `The commands part gives [[Request.commands]], one line per operation, and says that the build, test, and lint commands are run before the report and their results stated in it`,
    })
    // Decision: the commands part states both ways whether or not [[hosted]] is true, because a
    // command tool is offered only for an operation the target has a line for, and the tools the
    // reader is offered decide; a reader with the tools never needs a shell.
    .add({
      behavior = [
        `The commands part says that when the agent server offers elfie_build, elfie_test, elfie_lint, or elfie_format, the command of that operation is run through that tool`,
        `The commands part says that a line is run by hand only for an operation whose tool is not offered`,
      ],
    })
    .add({
      behavior = `The commands part says that elfie_test's filter is given to the test command as TESTS, and the scope of elfie_build, elfie_test, and elfie_lint to the command as SCOPE, which narrow the run only when the command's line reads them`,
    })
    .add({
      behavior = `A unit's section holds, for each of its entities, the entity's lowered code and then, apart from the code, its local criteria and tests, each on its own line with its id`,
    })
    .add({
      behavior = `A criterion's line in a unit's section reads its id, a space, an em dash, a space, and [[LoweredCriterion.text]]`,
    })
    .add({
      situation = `[[Request.answered]] has an entry for a unit of [[batch]]`,
      behavior = `In that unit's section, the line of each criterion and test whose id is not in that entry is marked new`,
    })
    .add({
      situation = `[[Request.removed]] has a non-empty entry for a unit of [[batch]]`,
      behavior = `That unit's section ends with each criterion and test of that entry on its own line, with its id and its text as a criterion's line or a test's line reads, under a heading saying they were removed since its outputs were accepted`,
    })
    .add({
      situation = `A criterion or test of a unit of [[batch]] is marked new`,
      behavior = `That unit's section says that a new one may restate a removed one in other words, and that its code is read against what the new one says, not against the removed one`,
    })
    .add({
      situation = `Entities moved into a unit of [[batch]]`,
      behavior = `That unit's section says which of its entities moved in, from which file, and because of which [[Move.cause]]`,
    })
    .add({
      situation = `Entities moved into a unit of [[batch]]`,
      behavior = `That unit's section says that they are written into that unit's outputs with markers naming the file that declares them`,
    })
    .add({
      situation = `Entities moved into a unit of [[batch]]`,
      behavior = `That unit's section says that a [[Use]] of the file they moved from is satisfied by the moved entities wherever the unit's code needs only them, never by importing that file`,
    })
    .add({
      situation = `Entities moved out of a unit of [[batch]]`,
      behavior = `That unit's section says which entities moved out and into which unit`,
    })
    .add({
      situation = `Entities moved out of a unit of [[batch]]`,
      behavior = `That unit's section says that they are imported from the outputs of the unit they moved into and never written again`,
    })
    .add({
      situation = `Entities moved out of a unit of [[batch]]`,
      behavior = `That unit's section says that the unit's outputs make each of them available under the name and path it would have had`,
    })
    // Decision: a requirements unit is never told its code is unchanged. Its lowered code is the
    // same, but a fn's criteria are what its code must do, so a changed criterion can ask for
    // behavior no code has yet.
    .add({
      situation = `A unit of [[batch]] has the reason requirements`,
      behavior = `That unit's section says that its lowered code is unchanged but its criteria or tests differ, and that the code must do what each criterion and test now says, which may mean writing new behavior`,
    })
    .add({
      behavior = [
        `The global section gives each of [[Request.globals]] once, with its id, marked global, a criterion as [[LoweredCriterion.text]]`,
        `The global section says that they hold across the whole program`,
        `The global section says that a unit answers for one only where it is relevant to that unit's code and ignores it otherwise`,
        `The global section says that the global review checks each once`,
      ],
    })
    .add({
      behavior = `The rules say that criteria and tests are never restated in an output as comments or documentation, and that an output names one only by its id in a [[Marker]]`,
    })
    .add({
      behavior = `The rules say that every emitted item and every test carries a [[Marker]] naming the entity it comes from, spelled as [[Marker]] says in a line comment beginning with [[Target.markerComment]], and never a line number`,
    })
    .add({
      behavior = `The rules say that each [[LoweredTest]] becomes one test, and each [[LoweredCriterion]] that can be checked mechanically becomes one test, each carrying a [[Marker]] with its id, placed where the guidance says`,
    })
    .add({
      behavior = `The rules say that a [[Marker]] carrying a criterion's id is written only on code that does what the criterion says in every situation it names, and that a marker never stands in for code`,
    })
    .add({
      behavior = `The tools part says that the tools of the agent server are called before files are searched or read by hand: elfie_entity for a definition with its criteria and tests, elfie_find for where a name is declared, elfie_references for where it is used, elfie_outline for the declarations of a file, elfie_output for the generated code of an entity, of a requirement id, or of an output file, and with text false for the regions of an output file without their code, elfie_search for the lines of the outputs that match a pattern, elfie_source for where a line of generated code came from, elfie_changes for what changed in a unit since its outputs were accepted, and elfie_check for whether acceptance would pass`,
    })
    .add({
      situation = `[[hosted]] is true`,
      behavior = [
        `The tools part says that elfie_task gives the batch's obligations again: each unit's outputs and reason, and every criterion and test with its id, place, and text, marked new or kept, with the removed ones`,
        `The tools part says that elfie_mark writes a marker line, and rewrites the id every marker of the batch's outputs names, so that an id is never typed by hand`,
      ],
    })
    .add({
      situation = `[[hosted]] is true`,
      behavior = `The report part says that the outcome is submitted through elfie_submit as done, blocked, or clarify, with the reason or the question as its message, before the final message, which still ends with the line the outcome reads`,
    })
    .add({
      behavior = [
        `The report part says to end the report with one line reading ELFIE: DONE when every output is written`,
        `The report part says to end it with ELFIE: BLOCKED: followed by the reason when an ambiguous criterion, two criteria in conflict, a name that resolves nowhere, or anything else stops it, then to write no output for the unit and to quote the criterion`,
        `The report part says to end it with ELFIE: CLARIFY: followed by one question when only a person can decide, then to write nothing`,
      ],
    });

  @test(
    {
      input = [Plan@like(`One batch of two units, b before a`), Batch@like(`b+1`), [], {}],
      expect = Request@like(
        `Instructions naming the target, listing b and a, quoting each one's entities with their criteria, no interfaces, no existing outputs, and the three report lines`,
      ),
    },
    {
      input = [
        Plan@like(
          `One batch of one unit, for a target whose language layer is a trait rust extending [[targetLanguage]], with two criteria of its own and a template value in one of them, whose layout layer is a trait flat extending [[targetLayout]] and [[targetFramework]] with one criterion, and whose frameworks hold flat too; the target's declaration has one criterion added to it by an add call at the top of its file`,
        ),
        Batch@like(`the batch`),
        [],
        {},
      ],
      expect = Request@like(
        `Guidance holding the declaration's own criterion, then flat's criterion once, then rust's two with the template value evaluated`,
      ),
    },
    {
      input = [
        Plan@like(
          `One batch of one unit a, reason requirements, whose fn f has criteria c1 and c3 now, and whose one output's source map answered the ids of c1 and c2`,
        ),
        Batch@like(`a`),
        [Output@like(`The existing output of a`)],
        Object@like(`def/a.lfy mapped to a.lfy as it was: f with criteria c1 and c2`),
      ],
      expect = Request@like(
        `A section for a that says its criteria differ and the code must do what each now says; c1's line unmarked, c3's line marked new, and c2 listed with its text as removed`,
      ),
    },
    {
      input = [
        Plan@like(
          `One batch of one unit a, whose fn f takes a B declared by data B in def/b.lfy, a unit of an earlier batch with the output src/b.rs`,
        ),
        Batch@like(`a`),
        [],
        {},
        true,
      ],
      expect = Request@like(
        `Interfaces holding b with B; instructions whose interfaces part is one line reading def/b.lfy, src/b.rs, and B, with no definition of B, and a line saying to read an interface with elfie_dependency; a tools part naming elfie_task and elfie_mark; a report part naming elfie_submit and the three report lines`,
      ),
    },
  );
}

/// report: everything the compiler wrote to standard output
/// submitted: the last outcome the compiler submitted through elfie_submit during the run; undefined when it submitted none
// Decision: a submitted outcome was checked when it arrived, so it wins over the report's ELFIE:
// line; the report is read only when nothing was submitted.
fn outcomeOf(report: string, verdicts: Verdict[], submitted?: Submission): `How one run of the compiler ended, read from its submitted outcome or its report, and the verdicts of its units` => Outcome {
  @acceptanceCriteria
    .add({
      situation = `[[submitted]] is given`,
      behavior = `No line of [[report]] changes the outcome`,
    })
    .add({
      situation = [
        `[[submitted]] is undefined`,
        `The last line of [[report]] that begins with ELFIE: reads ELFIE: BLOCKED:`,
      ],
      behavior = `The kind is blocked and the message is the rest of that line and every line after it`,
    })
    .add({
      situation = [
        `[[submitted]] is undefined`,
        `The last line of [[report]] that begins with ELFIE: reads ELFIE: CLARIFY:`,
      ],
      behavior = `The kind is clarification and the message is the rest of that line and every line after it`,
    })
    .add({
      situation = `[[Submission.outcome]] of [[submitted]] is blocked`,
      behavior = `The kind is blocked and the message is [[Submission.message]] of [[submitted]]`,
    })
    .add({
      situation = `[[Submission.outcome]] of [[submitted]] is clarify`,
      behavior = `The kind is clarification and the message is [[Submission.message]] of [[submitted]]`,
    })
    .add({
      situation = [`[[submitted]] is undefined`, `[[verdicts]] is empty and no line of [[report]] begins with ELFIE:`],
      behavior = `The kind is failed and the message says the compiler reported nothing`,
    })
    .add({
      situation = [
        `Some verdict of [[verdicts]] is rejected`,
        `[[Submission.outcome]] of [[submitted]] is done, or [[submitted]] is undefined and the last line of [[report]] that begins with ELFIE:, if there is one, reads neither ELFIE: BLOCKED: nor ELFIE: CLARIFY:`,
      ],
      behavior = `The kind is rejected and the message is the first problem of the first rejected verdict`,
    })
    .add({
      situation = [
        `No verdict of [[verdicts]] is rejected`,
        `[[Submission.outcome]] of [[submitted]] is done, or [[submitted]] is undefined, [[verdicts]] is not empty or some line of [[report]] begins with ELFIE:, and the last line of [[report]] that begins with ELFIE:, if there is one, reads neither ELFIE: BLOCKED: nor ELFIE: CLARIFY:`,
      ],
      behavior = `The kind is accepted and the message is empty`,
    })
    .add({ behavior = `[[Outcome.verdicts]] is [[verdicts]]` });

  @test(
    {
      input = [`I wrote it.\nELFIE: DONE`, [Verdict@like(`accepted`)]],
      expect = Outcome@like(`accepted, empty message`),
    },
    {
      input = [`ELFIE: CLARIFY: should Range.end be inclusive?`, []],
      expect = Outcome@like(`clarification with the question`),
    },
    {
      input = [`ELFIE: BLOCKED: \[[tokenAt\]] contradicts \[[nodesAt\]] on empty files`, []],
      expect = Outcome@like(`blocked with the reason`),
    },
    { input = [``, []], expect = Outcome@like(`failed`) },
    {
      input = [
        `I wrote it.\nELFIE: DONE`,
        [Verdict@like(`accepted`)],
        Submission@like(`blocked, with the message: two criteria of f conflict`),
      ],
      expect = Outcome@like(`blocked with the message two criteria of f conflict`),
    },
    {
      input = [``, [Verdict@like(`rejected, with the problem: no marker for B`)], Submission@like(`done`)],
      expect = Outcome@like(`rejected with the message no marker for B`),
    },
  );
}

/// recorded: the source maps recorded for the other units of the unit's target
fn accept(request: Request, unit: Unit, outputs: Output[], recorded: SourceMap[] = []): `Whether outputs satisfy a request for one unit structurally, the source maps they earn, and the outputs with their markers normalized` => Verdict {
  // Decision: an output may hold markers for other files of the program, because one output often
  // mirrors several. A marker naming a file outside the program is a fixture or prose, not a claim
  // about the program. A line marker inside an entity is rewritten to the entity's name, since a name
  // survives edits and a line does not.
  @acceptanceCriteria.add({ behavior = `[[Verdict.accepted]] is true exactly when [[Verdict.problems]] is empty` });

  // Markers
  @acceptanceCriteria
    .add({ situation = `[[outputs]] is empty`, behavior = `[[Verdict.problems]] holds one saying so` })
    // Decision: a file shared by several units is an output of each, as Rust's lib.rs must be; what a
    // unit may not do is take away what another unit recorded in it.
    .add({
      situation = [
        `An output's path is [[SourceMap.output]] of a source map in [[recorded]] whose [[SourceMap.source]] is not the file of the unit`,
        `That source is the file of no unit of [[Request.batch]] of [[request]]`,
        `A marker of that source map, compared by [[Marker.file]], [[Marker.entity]], and [[Marker.requirement]], is not in the output`,
      ],
      behavior = `[[Verdict.problems]] holds one naming the path, the other unit's source, and the marker`,
    })
    .add({
      situation = [
        `An output's path is [[SourceMap.output]] of a source map in [[recorded]] whose [[SourceMap.source]] is not the file of the unit`,
        `That source is the file of a unit of [[Request.batch]] of [[request]], or every marker of that source map, compared by [[Marker.file]], [[Marker.entity]], and [[Marker.requirement]], is in the output`,
      ],
      behavior = `Sharing the output with that other unit adds no problem`,
    })
    .add({
      situation = `An output's path does not [[Path.startsWith]] [[Target.outputDirectory]] of the unit's target`,
      behavior = `[[Verdict.problems]] holds one naming the path`,
    })
    .add({
      situation = `An output's [[Path.extension]] is not among [[Target.extensions]] of the unit's target`,
      behavior = `[[Verdict.problems]] holds one naming the path and the extensions the target allows`,
    })
    .add({
      situation = `A marker names an entity`,
      behavior = `Its line is derived as the first line of the declaring node of the entity with that name in that file, and the marker is left as written`,
    })
    .add({
      situation = `A marker names a file of the program and an entity that file does not declare`,
      behavior = `[[Verdict.problems]] holds one naming the output line and the name`,
    })
    .add({
      situation = `A marker names a line of the unit's file, or of the file declaring an entity moved into the unit, that falls inside an entity's declaration`,
      behavior = `The marker is rewritten in [[Verdict.outputs]] to name that entity`,
    })
    .add({
      situation = `An output holds a [[Marker]] naming a line of the unit's [[File.path]], or of the file declaring an entity moved into the unit, beyond that file's last line`,
      behavior = `[[Verdict.problems]] holds one naming the output line`,
    })
    .add({
      situation = `A marker naming the unit's [[File.path]], or the file of an entity moved into the unit, names a requirement id that is neither a local criterion or test of the unit nor one of [[Request.globals]]`,
      behavior = `[[Verdict.problems]] holds one naming the output line and the id`,
    })
    .add({
      situation = `An output holds a [[Marker]] naming another file of the program and an entity that file declares`,
      behavior = `The marker adds no problem`,
    })
    .add({
      situation = `An output holds a [[Marker]] naming a file that is not in the program`,
      behavior = [`The marker adds no problem`, `The marker is not in [[SourceMap.markers]]`],
    })
    .add({
      situation = `An entity of the unit has no marker in any output naming it or a line its declaring node covers`,
      behavior = `[[Verdict.problems]] holds one naming the entity`,
    });

  // Source maps, mechanically
  @acceptanceCriteria
    .add({
      situation = `[[Verdict.accepted]] is true`,
      behavior = `[[Verdict.sourceMaps]] holds one [[SourceMap]] per output, in [[outputs]] order`,
    })
    .add({
      behavior = `[[SourceMap.target]] of each of [[Verdict.sourceMaps]] is [[Target.identifier]] of the unit's target`,
    })
    .add({ behavior = `[[SourceMap.output]] of each of [[Verdict.sourceMaps]] is the path of the output it is for` })
    .add({ behavior = `[[SourceMap.source]] of each of [[Verdict.sourceMaps]] is [[File.path]] of the unit's file` })
    .add({
      behavior = `[[SourceMap.hash]] of each of [[Verdict.sourceMaps]] is the SHA-256 of [[Unit.text]] of [[unit]]`,
    })
    .add({
      behavior = `[[SourceMap.requirements]] of each of [[Verdict.sourceMaps]] is taken over the local criterion and test ids of [[unit]]`,
    })
    .add({
      behavior = `[[SourceMap.answered]] of each of [[Verdict.sourceMaps]] is the local criterion and test ids of [[unit]], sorted`,
    })
    .add({
      behavior = `[[SourceMap.signature]] of each of [[Verdict.sourceMaps]] is the SHA-256 of [[interfaceOf]] [[unit]]`,
    })
    .add({
      behavior = `[[SourceMap.dependencies]] of each of [[Verdict.sourceMaps]] maps the source path of each of [[Unit.dependencies]] to the SHA-256 of [[interfaceOf]] it, as computed during this call`,
    })
    .add({
      behavior = `[[SourceMap.generated]] of each of [[Verdict.sourceMaps]] is [[Time.Instant.rfc3339]] of [[Time.now]] during this call`,
    })
    .add({
      behavior = `[[SourceMap.markers]] of each of [[Verdict.sourceMaps]] holds every marker of the output it is for that names a file of the program, in output order, with its derived line`,
    })
    .add({ behavior = `Nothing in a source map comes from the compiler's text except the names it spelled` })
    .add({ behavior = `No command of the target is run` });

  @test(
    {
      input = [
        Request@like(`For a batch holding a unit with entities A and B in a.lfy`),
        Unit@like(`that unit`),
        [Output@like(`One file under the output directory with a marker a.lfy:A and one a.lfy:B`)],
      ],
      expect = Verdict@like(
        `Accepted, one source map with two markers whose lines are those of A and B, the first ending on the line before the second and the second on the last line of the output, the output unchanged`,
      ),
    },
    {
      input = [
        Request@like(`For a batch holding a unit with entities A and B in a.lfy`),
        Unit@like(`that unit`),
        [Output@like(`One file with a marker naming the line of A only`)],
      ],
      expect = Verdict@like(`Rejected, one problem naming B`),
    },
    {
      input = [
        Request@like(`For a batch holding a unit with entity A on line 3 of a.lfy`),
        Unit@like(`that unit`),
        [Output@like(`One file with a marker a.lfy:3`)],
      ],
      expect = Verdict@like(`Accepted, and the output in [[Verdict.outputs]] reads a.lfy:A instead`),
    },
  );
}

// Compile data

// Decision: compile-time data lives in elfie-compile under [[Workspace.root]], never under an output
// directory, so outputs hold only generated code. elfie-compile is checked in: it is the record of
// what was generated from what. elfie-compile/maps holds the source maps, one file per unit, so
// accepting a unit writes one small file instead of rewriting every map of the target, and a commit
// shows exactly which units a compile touched. elfie-compile/cache is git-ignored and holds only what
// can be rebuilt from the definitions, the maps, and the outputs: deleting it changes no plan,
// request, verdict, or output, only how long they take.

/// target: the identifier of one target; every target when left out
fn sourceMapsOf(workspace: Workspace, target?: string): `Every source map recorded for a workspace whose output still exists` => SourceMap[] {
  @acceptanceCriteria
    .add({
      behavior = `A unit's map file is elfie-compile/maps under [[Workspace.root]], then [[Target.identifier]], then [[Unit.stem]] with the extension .json, such as elfie-compile/maps/rust/cli/main.json for def/cli/main.lfy`,
    })
    .add({ behavior = `A unit's map file holds the unit's source maps as one JSON list` })
    .add({
      behavior = `Returns the source maps of every map file under the folder of each target of [[Workspace.targets]], in target order, then in the order [[Files.list]] gives the files, then in the order each file lists them`,
    })
    .add({
      situation = `[[target]] is set`,
      behavior = `Returns only the source maps of the map files under the folder of that target`,
    })
    .add({
      situation = `[[target]] is set`,
      behavior = `A map file of another target, even one that cannot be read, does not change the result`,
    })
    .add({
      situation = `[[Files.exists]] does not find the [[SourceMap.output]] of a recorded map`,
      behavior = `The map is left out`,
    })
    .add({
      situation = `A map file cannot be read or is not a JSON list of source maps`,
      behavior = `It contributes nothing`,
    })
    .add({
      situation = `A recorded map has no answered key`,
      behavior = `It is read with [[SourceMap.answered]] empty`,
    })
    .add({
      situation = [
        `A target has no folder under elfie-compile/maps`,
        `Its [[Target.outputDirectory]] holds source-map.json, as earlier versions recorded every map of a target`,
      ],
      behavior = `That target's maps are read from source-map.json instead, the same way`,
    })
    .add({
      situation = [
        `A target has no folder under elfie-compile/maps`,
        `Its [[Target.outputDirectory]] holds no source-map.json`,
      ],
      behavior = `That target has no source maps`,
    })
    .add({ behavior = `Nothing is written` })
    .add({ behavior = `Nothing it returns depends on elfie-compile/cache` });

  @test(
    {
      input = [
        Workspace@like(
          `One target rust; elfie-compile/maps/rust holds a.json with one map for crates/a/src/a.rs and b.json with one map for crates/b/src/b.rs, both outputs present`,
        ),
      ],
      expect = [SourceMap@like(`crates/a/src/a.rs`), SourceMap@like(`crates/b/src/b.rs`)],
    },
    {
      input = [Workspace@like(`The same project with crates/b/src/b.rs deleted`)],
      expect = [SourceMap@like(`crates/a/src/a.rs`)],
    },
    {
      input = [
        Workspace@like(
          `One target rust with no elfie-compile folder and crates/source-map.json holding two maps whose outputs are present`,
        ),
      ],
      expect = [SourceMap@like(`The two maps of crates/source-map.json, in its order`)],
    },
    {
      input = [
        Workspace@like(
          `One target rust; elfie-compile/maps/rust holds a.json reading {"output": and b.json with one map for crates/b/src/b.rs, whose output is present`,
        ),
      ],
      expect = [SourceMap@like(`crates/b/src/b.rs`)],
    },
  );
}

fn record(workspace: Workspace, unit: Unit, sourceMaps: SourceMap[]): `Whether the source maps of one accepted unit are recorded in its map file` => boolean {
  @acceptanceCriteria
    .add({
      behavior = `The unit's map file, as [[sourceMapsOf]] names it, holds [[sourceMaps]] afterwards, replacing whatever it held`,
      sideEffects = [`The unit's map file is written`],
    })
    .add({ behavior = `No other file is written` })
    // Decision: the layout is fixed so a diff of a map file shows only what changed.
    .add({
      behavior = `The file is [[Json.stringify]] of [[sourceMaps]] with [[Json.Layout.readable]]`,
    })
    .add({ behavior = `The file lists [[sourceMaps]] in [[SourceMap.output]] order, each map's markers in output order` })
    .add({ behavior = `The keys of every object in the file are in alphabetical order` })
    .add({ behavior = `The same maps always give the same bytes` })
    .add({
      situation = `The unit's map file already holds maps that differ from [[sourceMaps]] only in [[SourceMap.generated]]`,
      behavior = [`The file is left as it is`, `The result is true`],
    })
    .add({
      situation = `No folder above the unit's map file exists yet`,
      behavior = `Every missing folder is created`,
    })
    .add({
      situation = `[[sourceMaps]] is empty`,
      behavior = `The map file is removed by [[Files.remove]]`,
    })
    .add({ situation = `The file cannot be written`, behavior = `Returns false` });

  @test(
    {
      input = [
        Workspace@like(`One target rust whose maps folder holds a.json and b.json`),
        Unit@like(`The unit of def/a.lfy`),
        [SourceMap@like(`For crates/a/src/a.rs with a new hash`)],
      ],
      expect = boolean@like(`true; elfie-compile/maps/rust/a.json holds the new map and b.json is untouched`),
    },
    {
      input = [
        Workspace@like(`The same project`),
        Unit@like(`The unit of def/a.lfy`),
        [SourceMap@like(`The map a.json holds, with a later generated time`)],
      ],
      expect = boolean@like(`true, and a.json is not written`),
    },
    {
      input = [
        Workspace@like(`One target rust with no elfie-compile folder`),
        Unit@like(`The unit of def/cli/main.lfy`),
        [SourceMap@like(`For crates/elfie-cli/src/main.rs`)],
      ],
      expect = boolean@like(`true, and elfie-compile/maps/rust/cli/main.json is created with every folder above it`),
    },
  );
}

// Decision: review records live beside the maps in elfie-compile and are checked in, because a
// verdict cannot be rebuilt from the definitions, the maps, and the outputs without a verifier.
fn reviewsOf(workspace: Workspace, unit: Unit): `The review records of one unit, as its review record file holds them` => ReviewRecord[] {
  @acceptanceCriteria
    .add({ behavior = `Returns the records of the unit's review record file, in the order it lists them` })
    .add({
      situation = `The unit's review record file is missing, cannot be read, or is not a JSON list of review records`,
      behavior = `Returns an empty list`,
    })
    .add({
      situation = `A record of the file has an id that is not of a local criterion or test of the unit`,
      behavior = `The record is left out`,
    })
    .add({ behavior = `Nothing is written` })
    .add({ behavior = `Nothing it returns depends on elfie-compile/cache` });

  @test(
    {
      input = [
        Workspace@like(`One target rust; elfie-compile/reviews/rust/a.json holds two records for criteria of A`),
        Unit@like(`The unit of def/a.lfy, whose A still has both criteria`),
      ],
      expect = [ReviewRecord@like(`The first record`), ReviewRecord@like(`The second record`)],
    },
    {
      input = [
        Workspace@like(`One target rust with no elfie-compile/reviews folder`),
        Unit@like(`The unit of def/a.lfy`),
      ],
      expect = [],
    },
  );
}

fn recordReviews(workspace: Workspace, unit: Unit, records: ReviewRecord[]): `Whether the review records of one unit are recorded in its review record file` => boolean {
  @acceptanceCriteria
    .add({
      situation = `[[records]] is not empty`,
      behavior = `The unit's review record file holds [[records]] afterwards, replacing whatever it held`,
      sideEffects = [`The unit's review record file is written`],
    })
    .add({ behavior = `No other file is written` })
    .add({
      situation = `[[records]] is not empty`,
      behavior = `The file is [[Json.stringify]] of [[records]] with [[Json.Layout.readable]]`,
    })
    .add({ behavior = `The file lists [[records]] in the order given` })
    .add({ behavior = `The keys of every object in the file are in alphabetical order` })
    .add({ behavior = `The same records always give the same bytes` })
    .add({
      situation = `No folder above the unit's review record file exists yet`,
      behavior = `Every missing folder is created`,
    })
    .add({ situation = `[[records]] is empty`, behavior = `The review record file is removed by [[Files.remove]]` })
    .add({ situation = `The file cannot be written`, behavior = `Returns false` });

  @test(
    {
      input = [
        Workspace@like(`One target rust with no elfie-compile folder`),
        Unit@like(`The unit of def/cli/main.lfy`),
        [ReviewRecord@like(`One satisfied record`)],
      ],
      expect = boolean@like(`true, and elfie-compile/reviews/rust/cli/main.json is created with every folder above it`),
    },
  );
}

// Mapped output access

/// name: an identifier, or an owner's identifier, a dot, and a member's name
/// target: the identifier of one target; every target when left out
fn regionsOf(workspace: Workspace, sourceMaps: SourceMap[], name: string, target?: string): `Every region of generated output that came from one entity` => Marker[] {
  // Decision: a member's region is part of its owner's code, so the owner's regions include it.
  @acceptanceCriteria
    .add({
      behavior = `Returns every [[Marker]] of every [[SourceMap]] in [[sourceMaps]] whose [[Marker.entity]] is [[name]], source map by source map in [[sourceMaps]] order and within one in [[SourceMap.markers]] order, which is output order`,
    })
    .add({
      situation = `The [[Marker.entity]] of a marker of a [[SourceMap]] in [[sourceMaps]] is [[name]], a dot, and a member's name`,
      behavior = `The marker is returned, source map by source map in [[sourceMaps]] order and within one in [[SourceMap.markers]] order`,
    })
    .add({
      situation = `A marker of a [[SourceMap]] in [[sourceMaps]] names a line rather than an entity, [[Marker.file]] declares the entity named [[name]] in [[workspace]], and [[Marker.line]] falls inside its declaring node`,
      behavior = `The marker is returned`,
    })
    .add({
      situation = `[[target]] is set`,
      behavior = `Returns only markers of source maps whose [[SourceMap.target]] is [[target]]`,
    });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A with a member x and a fn f`),
        [
          SourceMap@like(
            `For output src/a.rs with markers a.lfy:A on line 3, a.lfy:A.x on line 9, and a.lfy:f on line 20`,
          ),
          SourceMap@like(`For output src/tests.rs with a marker a.lfy:f on line 1 and a.lfy:A on line 12`),
        ],
        `A`,
      ],
      expect = [
        Marker@like(`src/a.rs line 3 for A, ending on 8`),
        Marker@like(`src/a.rs line 9 for A.x, ending on 19`),
        Marker@like(`src/tests.rs line 12 for A, ending on the last line`),
      ],
    },
    {
      input = [Workspace@like(`The same project`), [SourceMap@like(`The same two source maps`)], `A.x`],
      expect = [Marker@like(`src/a.rs line 9 for A.x only`)],
    },
    { input = [Workspace@like(`The same project`), [SourceMap@like(`The same two source maps`)], `B`], expect = [] },
  );
}

// Decision: a change is found by binding the previous text through the loader and comparing entities,
// never by diffing lines, so a reformatted or reordered file whose entities read the same gives none.
/// previous: the text of the unit's file when its outputs were last accepted, as written and never lowered; undefined when they never were
fn changes(workspace: Workspace, unit: Unit, previous: string | undefined): `What differs for each entity of a unit between its file as last accepted and as it is now` => Change[] {
  @acceptanceCriteria
    .add({
      behavior = `The file as it was is bound as [[Loader.change]] of [[workspace]] with [[File.path]] of [[Unit.file]] and [[previous]]`,
    })
    .add({
      behavior = `The entities the file declared then are compared with those [[Unit.file]] declares now, both those built for [[Unit.target]], whether or not they moved to another unit`,
    })
    .add({
      behavior = `Entities are compared by name: the identifier, or the owner's identifier, a dot, and a member's name`,
    })
    .add({ behavior = `A member is compared as an entity of its own, under its owner` })
    .add({
      situation = `[[previous]] is undefined`,
      behavior = `One [[Change]] of kind [[ChangeKind.added]] per entity [[Unit.file]] declares that is built for [[Unit.target]], in file order, and nothing else`,
    })
    .add({
      situation = `A name is declared now and was not before`,
      behavior = `One [[Change]] of kind [[ChangeKind.added]]`,
    })
    .add({
      situation = `A name was declared before and is not now`,
      behavior = `One [[Change]] of kind [[ChangeKind.removed]]`,
    })
    .add({
      situation = `A name is declared on both sides`,
      behavior = `One [[Change]] per kind that differs, in the order [[ChangeKind]] declares them`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `[[Entity.definition]] differs`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.definition]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The type of the entity, spelled as [[interfaceOf]] spells it, differs`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.declaredType]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The entity is a fn, and its parameters, their types, or its output, spelled as [[interfaceOf]] spells them, differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.signature]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local criteria differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.criteria]], whose detail names the ids added and removed`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local criteria differ`,
        `A removed and an added criterion id are at the same position`,
      ],
      behavior = `The detail of the [[ChangeKind.criteria]] change calls that pair reworded`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local tests differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.tests]], whose detail names the ids added and removed`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local tests differ`,
        `A removed and an added test id are at the same position`,
      ],
      behavior = `The detail of the [[ChangeKind.tests]] change calls that pair reworded`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The joined [[Token.raw]] of the tokens the declaring node covers differs once its definition, type, parameters, output, criteria, tests, whitespace, and comments are left out`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.body]]`,
    })
    .add({
      behavior = `The changes are in file order: the changes of entities declared now follow the order of [[Unit.entities]]`,
    })
    .add({
      situation = `An entity was removed, and some entity that preceded it in the previous file is still declared`,
      behavior = `Its change is placed after the changes of the last entity that preceded it in the previous file and is still declared`,
    })
    .add({
      situation = `An entity was removed, and no entity that preceded it in the previous file is still declared`,
      behavior = `Its change is placed first`,
    })
    .add({
      situation = `The old and the new of what differs are each under 80 characters`,
      behavior = `[[Change.detail]] is one line saying what differs, quoting the old and the new`,
    })
    .add({
      situation = `The old or the new of what differs is 80 characters or more`,
      behavior = `[[Change.detail]] is one line saying what differs, naming the old and the new rather than quoting them, such as the count of criteria before and after or the name of the parameter that differs`,
    });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A and a fn f`),
        Unit@like(`The unit of a.lfy`),
        undefined,
      ],
      expect = [Change@like(`A added`), Change@like(`f added`)],
    },
    {
      input = [
        Workspace@like(
          `def holds a.lfy declaring a data A defined as a thing and a fn f taking x: string and y: number`,
        ),
        Unit@like(`The unit of a.lfy`),
        string@like(`a.lfy as it was: A defined as a value and f taking only x: string`),
      ],
      expect = [
        Change@like(`A, definition, detail quoting a value and a thing`),
        Change@like(`f, signature, detail naming the added parameter y`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with three criteria and a data B`),
        Unit@like(`The unit of a.lfy`),
        string@like(`a.lfy as it was: a data A, then f with two of those criteria, and B with one more member, old`),
      ],
      expect = [
        Change@like(`A removed`),
        Change@like(`f, criteria, detail reading 2 criteria before and 3 now`),
        Change@like(`B.old, removed`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A and a fn f`),
        Unit@like(`The unit of a.lfy`),
        string@like(`a.lfy as it was: the same declarations with f before A, indented differently, and with a comment`),
      ],
      expect = [],
    },
  );
}

// Independent verification

// Decision: the verifier is told where the regions are and pulls their code through the agent
// server, so a request stays small however large the batch's outputs are, and its protocol allows
// no edits: a review says where and why, never how to fix.
// Decision: a batch compiled in a copy of the root is reviewed in that copy, so the regions a
// verifier is pointed at, and the hashes its verdicts are recorded with, are those of the outputs
// it is judging and never the root's older ones.
// Decision: a criterion or test is reviewed again only when nothing says its verdict still holds:
// it has no record, its last verdict was not satisfied, or the code of its entity changed since. A
// change to code outside the entity's regions, such as a helper no marker names, does not count.
/// directory: the directory the batch's outputs were written in, which its regions are read from; [[Workspace.root]] when left out
/// records: the review records of the batch's units; every criterion and test is reviewed when it is empty
fn review(plan: Plan, batch: Batch, sourceMaps: SourceMap[], directory?: string, records: ReviewRecord[] = []): `Everything a verifier is handed to check the outputs of one batch against every criterion and test whose verdict is not carried` => ReviewRequest {
  @acceptanceCriteria
    .add({ behavior = `[[ReviewRequest.batch]] is [[batch]]` })
    .add({
      behavior = `Every output a region is read from is [[Files.read]] at [[SourceMap.output]] under [[directory]], or under [[Workspace.root]] when [[directory]] is left out`,
    })
    .add({ behavior = `[[ReviewRequest.instructions]] lists only local criteria and tests` })
    .add({
      behavior = `The regions of an entity are each [[Marker]] of [[regionsOf]] for its name in [[sourceMaps]] limited to the batch's target whose [[Marker.file]] is the file that declares the entity, in [[SourceMap.output]] order, then in [[Marker.outputLine]] order`,
    })
    .add({
      behavior = `[[ReviewRequest.hashes]] gives each local criterion and test of the units of [[batch]] the SHA-256, as lowercase hex, of the text of the regions of the entity it belongs to: each region's lines of its output, one region after another, each line followed by a line break`,
    })
    .add({
      situation = `The output of a region cannot be read`,
      behavior = `The region adds no text to a hash`,
    })
    .add({
      situation = `A local criterion or test belongs to an entity with no region, or to the file's own entity`,
      behavior = `Its hash is the SHA-256 of the empty text`,
    })
    .add({
      situation = `A local criterion or test of a unit of [[batch]] has no record in [[records]], or its record's [[ReviewRecord.status]] is violated or unverifiable, or its record's [[ReviewRecord.hash]] differs from its hash in [[ReviewRequest.hashes]], or the entity it belongs to has no region`,
      behavior = `It is listed in [[ReviewRequest.instructions]]`,
    })
    .add({
      situation = `A local criterion or test of a unit of [[batch]] belongs to an entity with a region, and has a record in [[records]] whose [[ReviewRecord.status]] is satisfied and whose [[ReviewRecord.hash]] is its hash in [[ReviewRequest.hashes]]`,
      behavior = [`It is not listed`, `Its record is in [[ReviewRequest.carried]]`],
    })
    .add({
      behavior = `A local criterion or test whose entity has no region, or that belongs to the file's own entity, is never carried`,
    })
    .add({
      situation = `At least one criterion or test is listed`,
      behavior = [
        `[[ReviewRequest.instructions]] says, in this order:`,
        `A heading naming [[Batch.identifier]] and the target`,
        `For each unit of the batch in order, for each of [[Unit.entities]] with a listed criterion or test: its identifier, or its owner's identifier, a dot, and its name, then its definition, then each of its regions on one line as the output path, a colon, [[Marker.outputLine]], a dash, and [[Marker.end]], then each of its listed criteria as [[LoweredCriterion.text]] on one line prefixed by its id and place, then each of its listed tests as input and expectation on one line prefixed by its id and place`,
        `Then, for that unit, when a criterion or test of its file's own entity is listed: the file's path, then each of those listed criteria and tests the same way`,
        `The verifier protocol`,
      ],
    })
    .add({ behavior = `[[ReviewRequest.instructions]] holds no line of any output` })
    .add({
      situation = `An entity of a unit of [[batch]] has no listed criterion or test`,
      behavior = `[[ReviewRequest.instructions]] names neither it nor its regions`,
    })
    .add({
      situation = `Another file of the program declares an entity with the same name as an entity of a unit of [[batch]]`,
      behavior = `[[ReviewRequest.instructions]] gives none of that other entity's regions`,
    })
    .add({
      situation = `No criterion or test is listed`,
      behavior = `[[ReviewRequest.instructions]] is the heading and one line saying nothing in the batch needs review`,
    });

  @test(
    {
      input = [
        Plan@like(
          `One batch of one unit, a.lfy for target rust, whose entity A has two criteria on lines 4 and 7 and one test on line 10`,
        ),
        Batch@like(`a`),
        [SourceMap@like(`For rust and src/a.rs from a.lfy, with one marker a.lfy:A on line 1 ending on line 30`)],
      ],
      expect = ReviewRequest@like(
        `Instructions headed a and rust; A with its definition and the region src/a.rs:1-30 with none of its lines; two criterion lines prefixed by their ids and def/a.lfy:4 and def/a.lfy:7, one test line prefixed by its id and def/a.lfy:10; then the protocol naming elfie_output, elfie_report, the six keys of the fallback line, and the three statuses, and ending with ELFIE: REVIEWED; asked holds the three ids; nothing carried`,
      ),
    },
    {
      input = [Plan@like(`The same plan`), Batch@like(`a`), []],
      expect = ReviewRequest@like(`The same instructions with no region for A`),
    },
    {
      input = [
        Plan@like(`The same plan`),
        Batch@like(`a`),
        [SourceMap@like(`The same source map`)],
        undefined,
        [
          ReviewRecord@like(`The criterion on line 4, satisfied, with the hash of src/a.rs lines 1 to 30 as they are`),
          ReviewRecord@like(`The criterion on line 7, unverifiable, with the same hash`),
        ],
      ],
      expect = ReviewRequest@like(
        `A with the criterion on line 7 and the test on line 10 only; asked holds their two ids; carried holds the record of the criterion on line 4`,
      ),
    },
    {
      input = [
        Plan@like(`The same plan`),
        Batch@like(`a`),
        [SourceMap@like(`The same source map`)],
        undefined,
        [
          ReviewRecord@like(
            `The criterion on line 4, satisfied, with a hash of src/a.rs as it was before line 12 changed`,
          ),
        ],
      ],
      expect = ReviewRequest@like(
        `A with both criteria and the test listed; asked holds the three ids; nothing carried`,
      ),
    },
    {
      input = [
        Plan@like(`The same plan`),
        Batch@like(`a`),
        [SourceMap@like(`The same source map`)],
        undefined,
        [
          ReviewRecord@like(`The criterion on line 4, satisfied, with the hash of src/a.rs lines 1 to 30 as they are`),
          ReviewRecord@like(`The criterion on line 7, satisfied, with the same hash`),
          ReviewRecord@like(`The test on line 10, satisfied, with the same hash`),
        ],
      ],
      expect = ReviewRequest@like(
        `Instructions of the heading and a line saying nothing needs review; asked empty; carried holds the three records`,
      ),
    },
  );
}

fn globalReview(plan: Plan, sourceMaps: SourceMap[]): `Everything a verifier is handed to check every global criterion and test once, across every output of the program` => ReviewRequest {
  @acceptanceCriteria
    .add({ behavior = `[[ReviewRequest.batch]] is undefined` })
    .add({
      behavior = `[[ReviewRequest.asked]] holds the ids of [[Program.criteria]] then [[Program.tests]] of [[Plan.program]], in that order`,
    })
    .add({ behavior = `[[ReviewRequest.hashes]] and [[ReviewRequest.carried]] are empty` })
    .add({
      behavior = [
        `[[ReviewRequest.instructions]] says, in this order:`,
        `A heading naming the global review and the targets`,
        `For each of [[Program.criteria]] then [[Program.tests]] of [[Plan.program]]: its id and place, then its text, [[LoweredCriterion.text]] for a criterion, then each [[Marker]] in [[sourceMaps]] whose [[Marker.requirement]] is its id, on one line as the output path, a colon, [[Marker.outputLine]], a dash, and [[Marker.end]]`,
        `The verifier protocol`,
      ],
    })
    .add({ behavior = `[[ReviewRequest.instructions]] holds no line of any output` })
    .add({
      situation = `No marker in any output names a global criterion's or test's id`,
      behavior = `It is listed in [[ReviewRequest.instructions]] with a line saying no unit answered for it`,
    });

  @test(
    {
      input = [
        Plan@like(
          `A program with one global criterion g, whose id two outputs, src/a.rs and src/b.rs, name in a marker`,
        ),
        [SourceMap@like(`For src/a.rs and src/b.rs, each with one marker naming global and the id of g`)],
      ],
      expect = ReviewRequest@like(
        `No batch; g once with its id, then the locations of two regions, one per output, with none of their lines, then the protocol; asked holds the id of g`,
      ),
    },
    {
      input = [Plan@like(`A program with one global criterion g that no marker names`), []],
      expect = ReviewRequest@like(`No batch; g once with a line saying no unit answered for it`),
    },
  );
}

/// report: everything the verifier wrote to standard output
/// program: the lowered program, whose criteria and tests the ids name
/// asked: the ids of the criteria and tests the review request gave the verifier; empty when not known
/// recorded: the reviews the verifier submitted through the agent server during the run, in the order recorded; empty when none
// Decision: a review line names its criterion by place as well as by id, because a 64-digit id is
// easy to copy wrong and a place is not; a line that names nothing yet says violated is kept apart,
// so a found failure is never lost for want of a name.
// Decision: a verdict submitted through the agent server was checked when it arrived, so it wins
// over a line of the report for the same criterion; the report is read only for what was not
// submitted.
fn reviewOf(report: string, program: Program, asked: string[] = [], recorded: Review[] = []): `What a verifier found, read mechanically from the verdicts it submitted and from its report` => ReviewReport {
  // Decision: the report is read leniently and only what tries to be a review can be wrong, because
  // a verifier that adds a sentence or a fence around its lines has still reviewed everything, and
  // running a second verifier for that costs as much as the first.
  @acceptanceCriteria
    .add({
      behavior = `Whitespace around a line of [[report]] is ignored wherever the line is compared or parsed`,
    })
    .add({
      situation = `A line of [[report]] reads ELFIE: REVIEWED, and no later line does`,
      behavior = `Every line after it is ignored`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It does not begin with {`,
      ],
      behavior = `It is ignored, whatever it says`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is one of [[ReviewStatus]]`,
        `Its id is the id of a criterion or test of [[program]]`,
      ],
      behavior = `It is read as one [[Review]] for that criterion or test`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is one of [[ReviewStatus]]`,
        `Its id is the id of no criterion or test of [[program]]`,
        `Exactly one id of a criterion or test of [[program]] begins with its id, or is the beginning of it, and the two share at least the receiver, the contributor, and 16 hex digits`,
      ],
      behavior = `It is read as one [[Review]] for that criterion or test`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is one of [[ReviewStatus]]`,
        `It has no id, or its id is the id of no criterion or test of [[program]] and no single id of one begins with it or is the beginning of it, sharing at least the receiver, the contributor, and 16 hex digits`,
        `Its file and line are the file and line where exactly one criterion or test of [[program]] begins`,
      ],
      behavior = `It is read as one [[Review]] for that criterion or test`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] does not read it as an object`,
      ],
      behavior = `It is in [[ReviewReport.problems]] as written`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is none of [[ReviewStatus]]`,
      ],
      behavior = `It is in [[ReviewReport.problems]] as written`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is one of [[ReviewStatus]]`,
        `It has no id, or its id is the id of no criterion or test of [[program]] and no single id of one begins with it or is the beginning of it, sharing at least the receiver, the contributor, and 16 hex digits`,
        `It has no file and line, or they are not where exactly one criterion or test of [[program]] begins`,
      ],
      behavior = `It is in [[ReviewReport.problems]] as written`,
    })
    .add({
      situation = [
        `A line of [[report]] is in [[ReviewReport.problems]] as written`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is violated`,
      ],
      behavior = `It is in [[ReviewReport.unplaced]] as written, in report order`,
    })
    .add({
      behavior = `[[ReviewReport.reviews]] holds every review of [[recorded]], in the order of [[recorded]], then every [[Review]] read from [[report]] whose id no review of [[recorded]] has`,
    })
    .add({
      situation = `A line of [[report]] is read as a [[Review]] whose id a review of [[recorded]] has`,
      behavior = `The line is neither in [[ReviewReport.reviews]] nor in [[ReviewReport.problems]]`,
    })
    .add({
      behavior = `[[ReviewReport.missing]] holds each of [[asked]] that is the id of no review in [[ReviewReport.reviews]], in the order of [[asked]]`,
    })
    .add({
      behavior = `The reviews read from [[report]] that are kept, and the lines of [[ReviewReport.problems]], are each in report order among themselves`,
    })
    .add({ behavior = `A [[Review]] takes its evidence and note as the line gives them, or empty when missing` })
    .add({ behavior = `Keys of a review line other than id, file, line, status, evidence, and note are ignored` })
    .add({
      situation = `Two lines of [[report]] that are each read as a [[Review]] name the same criterion or test`,
      behavior = `Only the last is kept in [[ReviewReport.reviews]], at its own place`,
    })
    .add({
      situation = `No line of [[report]] reads ELFIE: REVIEWED`,
      behavior = `[[ReviewReport.problems]] ends with a line reading: the report did not end`,
    });

  @test(
    {
      input = [
        `# reading src/a.rs\n{"id":"A:A:1f2e","status":"satisfied","evidence":"src/a.rs:1-30","note":"the field is there"}\n{"id":"A:A:9c0d","status":"violated","evidence":"src/a.rs:12-18","note":"returns undefined instead of an empty list"}\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
      ],
      expect = ReviewReport@like(
        `Two reviews, satisfied then violated, placed at def/a.lfy:4 and def/a.lfy:7 for A, and no problems`,
      ),
    },
    {
      input = [
        `{"id":"A:A:1f2e","status":"maybe","evidence":"","note":"unsure"}\nI think it is fine.\n{"id":"A:A:9c0d","status":"unverifiable","evidence":"","note":"no region"}\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
      ],
      expect = ReviewReport@like(`One review, unverifiable at line 7, and one problem: the line whose status is maybe`),
    },
    {
      input = [
        `All tests pass. Report follows.\n\`\`\`\n{"file":"def/a.lfy","line":4,"entity":"A","status":"Satisfied","evidence":"src/a.rs:1-9","note":"ok"}\n\`\`\`\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
      ],
      expect = ReviewReport@like(`One review, satisfied, placed at def/a.lfy:4 for A, and no problems`),
    },
    {
      input = [
        `{"id":"A:A:1f2e","status":"satisfied","evidence":"","note":"first"}\n{"id":"A:A:1f2e","status":"violated","evidence":"src/a.rs:3-3","note":"second"}`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
      ],
      expect = ReviewReport@like(
        `One review, violated with note second, and one problem reading: the report did not end`,
      ),
    },
    {
      input = [
        `{"id":"A:A:9c0e","file":"def/a.lfy","line":7,"status":"violated","evidence":"src/a.rs:12-18","note":"returns undefined"}\n{"id":"A:A:77aa","status":"violated","evidence":"src/a.rs:3-3","note":"no such id"}\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
        [`A:A:1f2e`, `A:A:9c0d`],
      ],
      expect = ReviewReport@like(
        `One review, violated at def/a.lfy:7 for the criterion A:A:9c0d; the A:A:77aa line in both problems and unplaced; A:A:1f2e missing`,
      ),
    },
    {
      input = [
        `{"id":"A:A:1f2e","status":"satisfied","evidence":"","note":"from the report"}\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
        [`A:A:1f2e`, `A:A:9c0d`],
        [Review@like(`A:A:1f2e, violated, at def/a.lfy:4 for A, with note submitted`)],
      ],
      expect = ReviewReport@like(
        `One review, the submitted violated one for A:A:1f2e; no problems; A:A:9c0d missing`,
      ),
    },
    {
      input = [
        `ELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
        [`A:A:1f2e`, `A:A:9c0d`],
        [
          Review@like(`A:A:9c0d, satisfied, at def/a.lfy:7 for A`),
          Review@like(`A:A:1f2e, unverifiable, at def/a.lfy:4 for A`),
        ],
      ],
      expect = ReviewReport@like(
        `The two submitted reviews in that order, A:A:9c0d then A:A:1f2e; no problems; nothing missing`,
      ),
    },
  );
}
