use "../grammar/rules/statement";
use "../interpret/data";
use "../interpret/main" as Interpreter;
use "../lexer/data";
use "../model/data";
use "../workspace/data";
use "./data";
use "elfie/system/file" as Files;
use "elfie/system/json" as Json;
use "elfie/system/path";
use "elfie/system/time" as Time;
use "elfie/target/framework";
use "elfie/target/language";
use "elfie/target/layout";

// Decision: a unit is one source file for one target. Outputs and source maps are per file, a
// declaration's scope is its file, and a smaller unit would make the compiler merge into a file it
// does not own, which is itself an act of generation. A larger unit would not fit a request. The one
// exception is a cycle among files, which no order of units can build: its entities move whole into
// the unit of the lowest file of the cycle.
// Decision: every request, review request, and acceptance is about one unit. A request puts first
// what is the same for every unit of a target, so the context several units once shared in one
// request is reused from a prompt cache instead.

fn interfaceOf(workspace: Workspace, unit: Unit): `What dependents of a unit may rely on, as one text whose hash tells whether it changed` => string {
  @acceptanceCriteria.add({
    behavior = `Returns the interface text of [[unit]] that [[SourceMap.signature]] hashes, exactly as [[SourceMap]] spells it`,
  });
}

/// sourceMaps: the source maps recorded for the workspace, as [[sourceMapsOf]] gives them
/// requested: units the caller asks for whatever their state, each named by its [[Unit.stem]] or its [[File.path]]
/// violated: the stems of units whose outputs answer for a global criterion or test the last global review found violated
/// foreignEdits: the foreign edits the change set kept for each target records, each made since its owner was last accepted in that change set; empty when no change set is kept
// Decision: plan is handed the recorded foreign edits, because only the change set kept by the
// compile loop knows them, and a unit whose outputs another unit edited is not stale by any hash.
fn plan(
  workspace: Workspace,
  sourceMaps: SourceMap[],
  requested: string[] = [],
  violated: string[] = [],
  foreignEdits: ForeignEdit[] = [],
): `Every unit of a workspace, which need generating, and the order they are compiled in` => Plan {
  // Selection
  @acceptanceCriteria
    .add({ behavior = `[[Plan.program]] is [[Interpreter.lower]] of [[workspace]]` })
    .add({ behavior = `[[Unit.lowered]] is the [[LoweredFile]] of [[Plan.program]] for the unit's file` })
    .add({
      behavior = `An entity is built for each [[Target]] whose [[Target.declaration]] is among the targets [[Entity.targets]] builds it for, and for no other`,
    })
    .add({
      behavior = `Only an entity declared in the file scope of a file is built: a member, a parameter, or an enum member goes with the entity that holds it`,
    })
    .add({
      situation = `A file has no [[File.package]] and at least one entity with a lowered node built for a target`,
      behavior = `The file gives one [[Unit]] for that target`,
    })
    .add({ situation = `A file has a [[File.package]]`, behavior = `It gives no [[Unit]]` })
    .add({
      situation = [
        `An entity of a unit reaches an entity of a project file that has a lowered node`,
        `That entity is not built for the unit's target`,
      ],
      behavior = `A [[Problem]] is added to [[Plan.problems]] at the member, parameter, or output whose type reaches it, naming both entities and the target`,
    });

  // Dependencies
  // Decision: a cycle among uses is reported once, by the [[Problem]] the workspace already holds.
  @acceptanceCriteria
    .add({
      situation = `There is a cycle among uses`,
      behavior = [`The cycle adds nothing to [[Plan.problems]]`, `The cycle moves no entity`],
    })
    .add({
      behavior = `[[Plan.units]] holds every unit of every target, each after its dependencies outside any cycle, otherwise in [[Workspace.targets]] then [[Workspace.files]] order`,
    })
    // Decision: a touched unit is later in plan order than the unit that touched it because a run may
    // edit only the units of its reach, which are later, and the order never depends on what is
    // planned, so it is the same order the edit was made under.
    .add({
      behavior = `The order of [[Plan.units]] is the same whatever [[sourceMaps]], [[requested]], [[violated]], and [[foreignEdits]] hold`,
    });

  // Cycles
  @acceptanceCriteria
    .add({
      behavior = `A cycle is two or more units of one target each of which depends on every other, directly or through other units`,
    })
    .add({
      behavior = `The lowest file of a cycle is the file of one of its units that the file of every other unit of the cycle uses, directly or through other files, and that itself uses none of them`,
    })
    .add({
      situation = `A cycle has a lowest file`,
      behavior = `Every entity of another unit of the cycle that an entity of the lowest file's unit reaches moves into the lowest file's unit`,
    })
    .add({
      situation = `A cycle has a lowest file`,
      behavior = `Each unit an entity leaves gives one [[Move]] to [[Plan.moves]]`,
    })
    .add({
      situation = `An entity moved into a unit`,
      behavior = `It is among [[Unit.entities]] of the unit it moved into and not among those of the unit it left`,
    })
    .add({
      situation = `An entity moved into a unit`,
      behavior = `The unit it left depends on the unit it moved into`,
    })
    .add({ behavior = `After planning, no cycle that has a lowest file is left` })
    .add({
      situation = [
        `A cycle has no lowest file`,
        `The files of the cycle's units form no cycle among uses`,
      ],
      behavior = [
        `A [[Problem]] is added to [[Plan.problems]] at the first declaration, in [[Workspace.files]] order and then source order, of a member, parameter, or output whose type reaches an entity of another file of the cycle, naming every file of the cycle`,
        `Nothing moves for that cycle`,
      ],
    })
    .add({
      behavior = `Every move is decided by the definitions and the target's units alone, never by the target's guidance`,
    });

  // Staleness
  @acceptanceCriteria
    .add({
      behavior = `[[Unit.outputs]] is every [[SourceMap]] in [[sourceMaps]] whose target and source are the unit's`,
    })
    .add({
      situation = `[[File.path]] or [[Unit.stem]] is in [[requested]]`,
      behavior = `[[Unit.reason]] is requested`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is in [[violated]]`,
      ],
      behavior = `[[Unit.reason]] is violated`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is empty`,
      ],
      behavior = `[[Unit.reason]] is fresh`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] differs from [[SourceMap.hash]] of any output`,
      ],
      behavior = `[[Unit.reason]] is changed`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids differs from [[SourceMap.requirements]] of any output`,
      ],
      behavior = `[[Unit.reason]] is requirements`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids equals [[SourceMap.requirements]] of every output`,
        `The hash of [[interfaceOf]] some dependency differs from what [[SourceMap.dependencies]] of the unit's outputs record for it, or they record nothing for it`,
      ],
      behavior = `[[Unit.reason]] is dependency`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids equals [[SourceMap.requirements]] of every output`,
        `For every dependency, [[SourceMap.dependencies]] of the unit's outputs record a hash for it and it equals the hash of [[interfaceOf]] that dependency`,
        `The unit is the owner of no foreign edit of [[foreignEdits]]`,
      ],
      behavior = `[[Unit.reason]] is undefined`,
    })
    .add({
      behavior = `A unit is the owner of a foreign edit of [[foreignEdits]] when [[ForeignEdit.owner]] is its [[Unit.stem]] and [[ForeignEdit.path]] [[Path.startsWith]] [[Target.outputDirectory]] of its target`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[Unit.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids equals [[SourceMap.requirements]] of every output`,
        `For every dependency, [[SourceMap.dependencies]] of the unit's outputs record a hash for it and it equals the hash of [[interfaceOf]] that dependency`,
        `The unit is the owner of a foreign edit of [[foreignEdits]]`,
      ],
      behavior = `[[Unit.reason]] is touched`,
    })
    .add({
      situation = `An edit changes only the body of one fn, and no unit was stale before it`,
      behavior = `Only the unit holding that fn is planned`,
    });

  // Waiting
  @acceptanceCriteria
    .add({
      behavior = `[[Unit.waitsFor]] of a unit holds the [[Unit.stem]] of each of its [[Unit.dependencies]] that has a [[Unit.reason]] and either has empty [[Unit.outputs]], or has an [[interfaceOf]] whose SHA-256 differs from what [[SourceMap.dependencies]] of the unit's outputs record for its source path, or for which they record nothing, in [[Plan.units]] order, each once`,
    })
    .add({ behavior = `[[Unit.waitsFor]] holds no unit that is not among [[Unit.dependencies]]` })
    .add({
      behavior = `[[Unit.waitsFor]] is decided from [[workspace]], [[sourceMaps]], [[requested]], [[violated]], and [[foreignEdits]] alone, before anything runs`,
    });

  @test(
    {
      input = [
        Workspace@like(`One target rust that global's targets hold; def holds a.lfy using ./b and b.lfy`),
        [],
        [],
      ],
      expect = Plan@like(`Two units, b before a, a depending on b and waiting for it, both with reason fresh`),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold; def holds b.lfy declaring d B, and a.lfy using ./b and declaring d A with a member of type B and d C with a member of type string; c.lfy applies to B a trait adding a member of type C`,
        ),
        [],
        [],
      ],
      expect = Plan@like(
        `One move of C from a into b, caused by the member the trait added to B; b's unit holds B then C; a's unit holds A and depends on b's; both with reason fresh`,
      ),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold; def holds a.lfy declaring d A with a member of type B, and b.lfy declaring d B with a member of type A, neither using the other`,
        ),
        [],
        [],
      ],
      expect = Plan@like(`No moves, and one problem at the member of A naming a.lfy and b.lfy`),
    },
    {
      input = [
        Workspace@like(`The same project`),
        [
          SourceMap@like(
            `For a and for b, hashes matching the files, interface hashes matching, generated at the same time`,
          ),
        ],
        [],
      ],
      expect = Plan@like(`Two units, neither with a reason`),
    },
    {
      input = [
        Workspace@like(`The same project with a comment added inside b.lfy`),
        [SourceMap@like(`For a and for b, hashes of the old files, interface hashes matching the current interfaces`)],
        [],
      ],
      expect = Plan@like(`b with reason changed and a without a reason`),
    },
    {
      input = [
        Workspace@like(`The same project with a member added to a data of b.lfy`),
        [SourceMap@like(`For a and for b, hashes and interface hashes of the old files`)],
        [],
      ],
      expect = Plan@like(`b with reason changed and a with reason dependency`),
    },
    {
      input = [Workspace@like(`A project whose only target no entity, file, or global holds among its targets`), [], []],
      expect = Plan@like(`No units`),
    },
    {
      input = [
        Workspace@like(`One target rust that global's targets hold; def holds a.lfy using ./b and b.lfy`),
        [SourceMap@like(`For a and for b, hashes matching the files, interface hashes matching`)],
        [`a`],
        [],
      ],
      expect = Plan@like(`a with reason requested and b without a reason`),
    },
    {
      input = [
        Workspace@like(`The same project`),
        [SourceMap@like(`For a and for b, hashes matching the files, interface hashes matching`)],
        [],
        [`b`],
      ],
      expect = Plan@like(`b with reason violated and a without a reason`),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold, with output directory src; def holds a.lfy using ./b and b.lfy`,
        ),
        [SourceMap@like(`For a and for b, hashes matching the files, interface hashes matching`)],
        [],
        [],
        [ForeignEdit@like(`A fix by b in a region of src/a.rs, with owner a`)],
      ],
      expect = Plan@like(`b before a; a with reason touched and b without a reason`),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold, with output directory src; def holds a.lfy using ./b and b.lfy, with a comment added inside a.lfy`,
        ),
        [SourceMap@like(`For a and for b, a's hash that of the old file, interface hashes matching`)],
        [],
        [],
        [ForeignEdit@like(`A stub by b in a region of src/a.rs, with owner a`)],
      ],
      expect = Plan@like(`a with reason changed, not touched, and b without a reason`),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold, with output directory src; def holds a.lfy and b.lfy`,
        ),
        [SourceMap@like(`For a and for b, hashes matching the files, interface hashes matching`)],
        [],
        [],
        [ForeignEdit@like(`A fix by a in a region of out/b.ts, with owner b, recorded for another target`)],
      ],
      expect = Plan@like(`Neither unit with a reason`),
    },
    {
      input = [
        Workspace@like(
          `One target rust that global's targets hold; def holds a.lfy using ./b and ./c, b.lfy, and c.lfy, with a member added to a data of b.lfy since their maps were recorded`,
        ),
        [SourceMap@like(`For a, b, and c, hashes and interface hashes of the files as they were before that edit`)],
        [`c`],
      ],
      expect = Plan@like(
        `b with reason changed, c with reason requested, and a with reason dependency, after both; a waits for b only, since c's interface hash is the one a's outputs record; b and c wait for nothing`,
      ),
    },
  );
}

/// previous: the unit's source at its last accepted generation, or its hash-matched source, recovered once for the compile; undefined when not known
/// hosted: whether the compiler reading the request runs in a compiler session of the compile-hosted agent server, which offers elfie_task, elfie_dependency, elfie_mark, elfie_reach, elfie_touch, and elfie_submit
/// foreignEdits: the foreign edits the change set records since the unit was last accepted in it, in the order they were made; edits of other units among them are left out
/// relocations: the relocations of this compile, in the order they were made; those of other units among them are left out
// Decision: the caller says whether the request is for a hosted compiler session, because only the
// caller knows; a hosted compiler pulls an interface when it needs one, so its request names the
// interfaces instead of quoting them, while a request read anywhere else quotes them whole. A
// compiler command that never uses the session it is hosted in still gets the interfaces by name
// only, and reads each definition another way.
// Decision: the request is handed the foreign edits rather than reading them, because only the
// compile loop keeps the change set they are recorded in.
fn request(
  plan: Plan,
  unit: Unit,
  existing: Output[],
  previous?: Previous,
  hosted: boolean = false,
  foreignEdits: ForeignEdit[] = [],
): `Everything the compiler is handed to produce the outputs of one unit` => Request {
  @acceptanceCriteria
    .add({ behavior = `[[Request.unit]] is [[unit]]` })
    .add({
      behavior = [
        `The file as it was is the [[LoweredFile]] of the unit's file in [[Previous.program]] of [[previous]]`,
        `Nothing is lowered or bound`,
      ],
    })
    .add({
      situation = `[[previous]] is given`,
      behavior = `[[Request.previous]] is [[LoweredFile.text]] of the file as it was`,
    })
    .add({
      situation = `Some [[SourceMap.answered]] of the [[Unit.outputs]] of [[unit]] is not empty`,
      behavior = `[[Request.answered]] is the ids of that [[SourceMap.answered]]`,
    })
    .add({
      situation = [`Every [[SourceMap.answered]] of the [[Unit.outputs]] of [[unit]] is empty`, `[[previous]] is given`],
      behavior = `[[Request.answered]] is the ids of the local criteria and tests of the file as it was`,
    })
    .add({
      situation = [`[[previous]] is given`, `[[Previous.hashMatched]] of [[previous]] is false`],
      behavior = `[[Request.removed]] is one [[RemovedRequirement]] for each local criterion and test of the file as it was whose id is none of the unit's now, is the [[Rewording.replaces]] of none of [[Request.reworded]], and is the id of no local criterion or test of an entity relocated out of the unit by one of [[Request.relocated]], in the order the file as it was gives them`,
    })
    .add({
      situation = [`[[previous]] is given`, `[[Previous.hashMatched]] of [[previous]] is false`],
      behavior = `[[Request.reworded]] is [[reworded]] of [[Program.workspace]] of [[Plan.program]], [[unit]], and [[previous]]`,
    })
    .add({
      situation = [`[[previous]] is given`, `[[Previous.hashMatched]] of [[previous]] is true`],
      behavior = [
        `[[Request.reworded]] is an empty list`,
        `[[Request.removed]] is one [[RemovedRequirement]] for each id of [[Request.answered]] that is none of the unit's local criterion and test ids now and is the id of no local criterion or test of an entity relocated out of the unit by one of [[Request.relocated]], in id order, each with [[RemovedRequirement.place]] and [[RemovedRequirement.text]] empty`,
      ],
    })
    .add({
      situation = [
        `[[unit]] has the reason requirements`,
        `[[previous]] is given`,
        `[[Previous.hashMatched]] of [[previous]] is false`,
        `[[Request.removed]] is an empty list`,
        `[[Request.reworded]] is a list that is not empty`,
        `The id of every local criterion and test of the unit is in [[Request.answered]], or is the [[Rewording.id]] of one of [[Request.reworded]]`,
        `For each of [[Unit.dependencies]], every [[SourceMap.dependencies]] of the unit's [[Unit.outputs]] records the SHA-256 of [[interfaceOf]] that dependency`,
      ],
      behavior = `[[Request.rewordedOnly]] is true`,
    })
    .add({ behavior = `[[Request.rewordedOnly]] is false wherever any of those does not hold` })
    .add({
      behavior = `A [[RemovedRequirement]] has the id of its criterion or test, its place in the file as it was, and its text, all taken from the file as it was in [[Previous.program]] of [[previous]]`,
    })
    .add({
      behavior = `[[Request.existing]] maps the path of each of [[existing]] whose path is among the [[Unit.outputs]] of [[unit]] to its text`,
    })
    .add({
      behavior = `[[Request.foreignEdits]] is each of [[foreignEdits]] whose [[ForeignEdit.owner]] is [[Unit.stem]] of [[unit]] and whose [[ForeignEdit.path]] [[Path.startsWith]] [[Target.outputDirectory]] of the unit's target, in the order of [[foreignEdits]]`,
    })
    .add({
      behavior = `[[Request.reach]] is read from [[Plan.units]] of [[plan]] and their [[Unit.outputs]], and never from their [[Unit.reason]]`,
    });

  // Knowledge
  @acceptanceCriteria
    .add({
      behavior = `A knowledge item's source path is [[Knowledge.source]] joined, as [[Path.join]] joins, to the [[Package.root]] of the [[File.package]] of the file its contributor is declared in, or to [[Workspace.root]] when that file has no [[File.package]]`,
    })
    .add({
      situation = [`A knowledge item has the kind reference or example`, `Its quote is true`],
      behavior = `[[Request.instructions]] quotes the [[Files.read]] text of its source path`,
    })
    .add({
      situation = [`A knowledge item has the kind reference or example`, `Its quote is false or left out`],
      behavior = `[[Request.instructions]] gives its source path and says to read it before writing anything it covers`,
    })
    .add({
      situation = `A knowledge item has the kind definition`,
      behavior = `[[Request.instructions]] gives the files its source, a use path, resolves to and says to read them as Elfie`,
    })
    .add({
      situation = `A knowledge item has the kind tool`,
      behavior = `[[Request.instructions]] names the tool of the agent server its source names and says to call it before relying on what it answers`,
    });

  // Instructions
  // Decision: the instructions quote every criterion and test already resolved, so a compiler with no
  // access to the model can still work; the agent server is offered for what the request leaves out.
  // Decision: the tools of the agent server are offered first because they answer from the program
  // and its source maps at once.
  // Decision: the parts that read the same for every unit of a target come first, so a prompt cache
  // keeps them from one unit's request to the next; the unit's own parts follow them.
  @acceptanceCriteria
    .add({
      behavior = `[[Request.instructions]] gives its parts in this order: the role, the guidance, the native dependencies, the target's knowledge, the commands, the global section, the rules, the stubs, the tools, and the report; then the interfaces, the unit's knowledge, the unit's section, the foreign edits, the existing outputs, and the reach`,
    })
    .add({
      behavior = `Every part before the interfaces reads the same in the request for every unit of the target made from [[plan]] with the same [[hosted]]`,
    })
    .add({
      behavior = [
        `The role says that the reader is the compiler for the target`,
        `The role says that its whole job is the outputs of the one unit the unit's section names`,
        `The role says that it writes nothing outside them, except the edits to later units the reach part allows`,
      ],
    })
    .add({
      behavior = `The role says that the outputs go under [[Target.outputDirectory]], spelled from the unit's stem as the guidance says`,
    })
    .add({
      behavior = `The guidance and native dependencies parts give [[Request.guidance]] and [[Request.nativeDependencies]]`,
    })
    .add({
      behavior = `The target's knowledge part gives the items of [[Request.knowledge]] that come from [[Target.knowledge]]`,
    })
    .add({
      behavior = `The unit's knowledge part gives every other item of [[Request.knowledge]], in its order`,
    })
    .add({
      situation = `[[hosted]] is false`,
      behavior = `The interfaces part gives, for each of [[Request.interfaces]], the dependency's output paths and the identifier, kind, definition, and type of each of its entities`,
    })
    .add({
      situation = `[[hosted]] is true`,
      behavior = `The interfaces part gives, for each of [[Request.interfaces]], one line reading the [[File.path]] of [[Interface.unit]], its output paths, and the identifiers of its entities, and no definition, kind, or type`,
    })
    .add({
      situation = `[[hosted]] is true`,
      behavior = `The interfaces part says that the interface of one of those entities, with its kind, definition, type, parameters, and output, is read with elfie_dependency`,
    })
    .add({
      behavior = `[[Request.interfaces]] holds every entity of each dependency whether or not [[hosted]] is true`,
    })
    .add({
      behavior = `The interfaces part says that an interface is used by the names its outputs spell and never edited`,
    })
    .add({
      behavior = `The commands part gives [[Request.commands]], one line per operation, and says that the build, test, and lint commands are run before the report and their results stated in it`,
    })
    // Decision: the commands part states both ways whether or not [[hosted]] is true, because a
    // command tool is offered only for an operation the target has a line for, and the tools the
    // reader is offered decide; a reader with the tools never needs a shell.
    .add({
      behavior = [
        `The commands part says that when the agent server offers elfie_build, elfie_test, elfie_lint, or elfie_format, the command of that operation is run through that tool`,
        `The commands part says that a line is run by hand only for an operation whose tool is not offered`,
      ],
    })
    .add({
      behavior = `The commands part says that elfie_test's filter is given to the test command as TESTS, and the scope of elfie_build, elfie_test, and elfie_lint to the command as SCOPE, which narrow the run only when the command's line reads them`,
    })
    .add({
      behavior = [
        `The commands part says that the unit is judged after its run with the test command run with stubs allowed, given as ALLOW_STUBS and through elfie_test's allowStubs, so that a test failing only by reaching a stub in a later unit's code does not fail the unit`,
        `The commands part says that a lint warning fails the unit only in the unit's own code`,
      ],
    })
    .add({
      behavior = [
        `The global section gives each of [[Request.globals]] once, with its id, marked global, a criterion as [[LoweredCriterion.text]]`,
        `The global section says that they hold across the whole program`,
        `The global section says that a unit answers for one only where it is relevant to that unit's code and ignores it otherwise`,
        `The global section says that the global review checks each once`,
      ],
    })
    .add({
      behavior = `The rules say that criteria and tests are never restated in an output as comments or documentation, and that an output names one only by its id in a [[Marker]]`,
    })
    .add({
      behavior = `The rules say that every emitted item and every test carries a [[Marker]] naming the entity it comes from, spelled as [[Marker]] says in a line comment beginning with [[Target.markerComment]], and never a line number`,
    })
    .add({
      behavior = `The rules say that each [[LoweredTest]] becomes one test, and each [[LoweredCriterion]] that can be checked mechanically becomes one test, each carrying a [[Marker]] with its id, placed where the guidance says`,
    })
    .add({
      behavior = `The rules say that a [[Marker]] carrying a criterion's id is written only on code that does what the criterion says in every situation it names, and that a marker never stands in for code`,
    });

  // Stubs and fixes
  // Decision: how to stub and the fix cap are the same for every unit of a target, so they are said
  // once in the shared parts; which units the run may edit is the unit's own, so it is said in the
  // reach part.
  @acceptanceCriteria
    .add({
      behavior = `The stub line of the target is the value the setters of [[Target.declaration]] of the unit's target give [[targetLanguage.stubLine]], read as [[Target.markerComment]] is the value they give markerComment; the target has no stub line when none gives it one`,
    })
    .add({
      behavior = `The stubs part says that a later unit's code is edited only where the unit's own change would otherwise stop the target's build or a test from passing, and only inside the regions of a unit the reach part lists`,
    })
    .add({
      situation = `The target has a stub line`,
      behavior = [
        `The stubs part says that a stub replaces the body of an item inside a later unit's region with the stub line and keeps the item's signature`,
        `The stubs part gives the stub line as the target sets it, and says that \{{unit}} in it is written as the stem of the unit the unit's section names and \{{reason}} as one line saying why the body was replaced`,
      ],
    })
    .add({
      situation = `The target has no stub line`,
      behavior = `The stubs part says that the target has no stub line, so a later unit's code is edited only by a fix`,
    })
    .add({
      behavior = `The stubs part says that a fix is any other edit inside a later unit's region, and that it changes at most [[Reach.fixLines]] of [[Request.reach]] lines in one region and at most [[Reach.fixUnitLines]] of [[Request.reach]] lines across the regions of one unit, counting lines as a [[ForeignEdit]] counts them`,
    })
    .add({ behavior = `The stubs part says that an edit bigger than a fix may be is written as a stub` })
    .add({
      behavior = `The stubs part says that the markers of a later unit's region are never changed, added, or removed`,
    })
    .add({
      behavior = `The stubs part says that every unit a fix is made in needs a note given through elfie_touch with that unit's stem and why it was edited, or the run is rejected`,
    })
    .add({
      behavior = `The stubs part says that a stub line left in the regions of the unit the unit's section names rejects the run`,
    });

  // The unit
  @acceptanceCriteria
    .add({
      behavior = `The unit's section begins with a heading naming [[Unit.stem]] and the [[File.path]] of [[unit]], and its [[Unit.reason]] when it has one`,
    })
    .add({
      situation = `[[Unit.outputs]] of [[unit]] is empty`,
      behavior = `The unit's section says that nothing has been generated for it yet`,
    })
    .add({
      situation = `[[Unit.outputs]] of [[unit]] is not empty`,
      behavior = `The unit's section says that its outputs go at the paths in its [[Unit.outputs]], except that a module the target's guidance says to split gains submodule files and has its code moved into them`,
    })
    .add({
      behavior = `The unit's section holds, for each of its entities, the entity's lowered code and then, apart from the code, its local criteria and tests, each on its own line with its id`,
    })
    .add({
      behavior = `A criterion's line in the unit's section reads its id, a space, an em dash, a space, and [[LoweredCriterion.text]]`,
    })
    .add({
      situation = `[[Request.answered]] is defined`,
      behavior = `In the unit's section, the line of each criterion and test whose id is not in [[Request.answered]], and is the [[Rewording.id]] of none of [[Request.reworded]], is marked new`,
    })
    .add({
      situation = `[[Request.reworded]] is defined`,
      behavior = `In the unit's section, the line of each criterion and test whose id is the [[Rewording.id]] of one of [[Request.reworded]] is marked reworded, and is followed by a line reading replaces, a space, its [[Rewording.replaces]], a space, an em dash, a space, and its [[Rewording.text]]`,
    })
    // Decision: compile moves a reworded criterion's markers to its new id before the request is
    // made, so the compiler is not asked to; the code is still read against the new text, because a
    // rewording may change what is asked.
    .add({
      situation = `A criterion or test of [[unit]] is marked reworded`,
      behavior = [
        `The unit's section says that a marker naming the id a reworded one replaces is rewritten to name its new id, and that compile has done so before the compiler runs`,
        `The unit's section says that the code of a reworded one is read against what it says now, and changed wherever it asks for what the code does not do`,
      ],
    })
    .add({
      situation = `[[Request.removed]] is not empty`,
      behavior = `The unit's section ends with each [[RemovedRequirement]] of [[Request.removed]] on its own line, reading its [[RemovedRequirement.id]], a space, an em dash, a space, and its [[RemovedRequirement.text]], under a heading saying they were removed since its outputs were accepted`,
    })
    .add({
      situation = `A [[RemovedRequirement]] of [[Request.removed]] has an empty [[RemovedRequirement.text]]`,
      behavior = `Its line reads its [[RemovedRequirement.id]], a space, an em dash, a space, and words saying its text is not known`,
    })
    .add({
      situation = `A criterion or test of [[unit]] is marked new`,
      behavior = `The unit's section says that a new one may restate a removed one in other words, and that its code is read against what the new one says, not against the removed one`,
    })
    .add({
      situation = `Entities moved into [[unit]]`,
      behavior = `The unit's section says which of its entities moved in, from which file, and because of which [[Move.cause]]`,
    })
    .add({
      situation = `Entities moved into [[unit]]`,
      behavior = `The unit's section says that they are written into the unit's outputs with markers naming the file that declares them`,
    })
    .add({
      situation = `Entities moved into [[unit]]`,
      behavior = `The unit's section says that a [[Use]] of the file they moved from is satisfied by the moved entities wherever the unit's code needs only them, never by importing that file`,
    })
    .add({
      situation = `Entities moved out of [[unit]]`,
      behavior = `The unit's section says which entities moved out and into which unit`,
    })
    .add({
      situation = `Entities moved out of [[unit]]`,
      behavior = `The unit's section says that they are imported from the outputs of the unit they moved into and never written again`,
    })
    .add({
      situation = `Entities moved out of [[unit]]`,
      behavior = `The unit's section says that the unit's outputs make each of them available under the name and path it would have had`,
    })
    // Decision: a requirements unit is never told its code is unchanged. Its lowered code is the
    // same, but a fn's criteria are what its code must do, so a changed criterion can ask for
    // behavior no code has yet.
    .add({
      situation = `[[unit]] has the reason requirements`,
      behavior = `The unit's section says that its lowered code is unchanged but its criteria or tests differ, and that the code must do what each criterion and test now says, which may mean writing new behavior`,
    });

  // Foreign edits
  // Decision: a foreign edit is shown with the lines it replaced and the unit whose run made it, so
  // the compiler never takes that code for code its own unit's last accepted run wrote.
  @acceptanceCriteria
    .add({ situation = `[[Request.foreignEdits]] is empty`, behavior = `The foreign edits part is left out` })
    .add({
      situation = `[[Request.foreignEdits]] is not empty`,
      behavior = `The foreign edits part gives each of [[Request.foreignEdits]] in order: its [[ForeignEdit.by]], [[ForeignEdit.kind]], [[ForeignEdit.path]], the marker of [[ForeignEdit.region]] as the output spells it, and [[ForeignEdit.note]], then the lines of [[ForeignEdit.before]], then those of [[ForeignEdit.after]]`,
    })
    .add({
      situation = `[[Request.foreignEdits]] is not empty`,
      behavior = `The foreign edits part says that those edits were written by the runs of the units they name, and that their code is kept only where it does what the unit's criteria and tests ask`,
    })
    .add({
      situation = `A foreign edit of [[Request.foreignEdits]] is a stub`,
      behavior = `The foreign edits part says that each stub line in the unit's regions is replaced by code that does what the unit's criteria and tests ask`,
    });

  // Existing outputs
  @acceptanceCriteria
    .add({ situation = `[[Request.existing]] is empty`, behavior = `The existing outputs part is left out` })
    .add({
      situation = `[[Request.existing]] is not empty`,
      behavior = `The existing outputs part lists each path of [[Request.existing]]`,
    })
    .add({
      situation = `[[Request.existing]] is not empty`,
      behavior = [
        `The existing outputs part says that only what the difference between [[Request.previous]] and [[Request.source]], the criteria and tests marked new, reworded, or removed, the foreign edits, and a split the target's guidance requires, require changes`,
        `The existing outputs part says that names and structure are kept, except that a module the target's guidance says to split gains submodule files and has its code moved into them; that split is the one change of structure allowed, and it keeps every name other units use`,
        `The existing outputs part says that markers of unchanged items are kept`,
      ],
    })
    .add({
      situation = [`[[Request.existing]] is not empty`, `[[Request.previous]] is defined`],
      behavior = `The existing outputs part quotes [[Request.previous]] as the source the outputs were generated from`,
    })
    .add({
      situation = [`[[Request.existing]] is not empty`, `[[Request.previous]] is undefined`],
      behavior = `The existing outputs part says that the existing outputs are reconciled with the unit's source`,
    })
    .add({
      situation = [`[[Request.existing]] is not empty`, `[[Request.answered]] is undefined`],
      behavior = `The existing outputs part says that which criteria and tests are new is not known, so the existing code is read against each of them before its marker is written`,
    });

  // Reach
  @acceptanceCriteria
    .add({
      situation = `[[Reach.units]] of [[Request.reach]] is empty`,
      behavior = `The reach part says that the run edits the outputs of no other unit`,
    })
    .add({
      situation = `[[Reach.units]] of [[Request.reach]] is not empty`,
      behavior = `The reach part lists each of [[Reach.units]], in order, by its [[Unit.stem]] with the paths of its [[Unit.outputs]]`,
    })
    .add({
      situation = `[[Reach.units]] of [[Request.reach]] is not empty`,
      behavior = `The reach part says that the code of those units may be edited only as the stubs part says, and that no other unit's code is edited`,
    });

  // Tools and report
  @acceptanceCriteria
    .add({
      behavior = `The tools part says that the tools of the agent server are called before files are searched or read by hand: elfie_entity for a definition with its criteria and tests, elfie_find for where a name is declared, elfie_references for where it is used, elfie_outline for the declarations of a file, elfie_output for the generated code of an entity, of a requirement id, or of an output file, and with text false for the regions of an output file without their code, elfie_search for the lines of the outputs that match a pattern, elfie_source for where a line of generated code came from, elfie_changes for what changed in a unit since its outputs were accepted, and elfie_check for whether acceptance would pass`,
    })
    .add({
      situation = `[[hosted]] is true`,
      behavior = [
        `The tools part says that elfie_task gives the unit's obligations again: its outputs and reason, and every criterion and test with its id, place, and text, marked new, kept, or unknown, with the removed ones`,
        `The tools part says that elfie_mark writes a marker line, and rewrites the id every marker of the unit's outputs names, so that an id is never typed by hand`,
        `The tools part says that elfie_reach gives the units the run may edit, their regions, and what is left of the fix cap`,
      ],
    })
    .add({
      situation = `[[hosted]] is true`,
      behavior = `The report part says that the outcome is submitted through elfie_submit as done, blocked, or clarify, with the reason or the question as its message, before the final message, which still ends with the line the outcome reads`,
    })
    .add({
      behavior = [
        `The report part says to end the report with one line reading ELFIE: DONE when every output is written`,
        `The report part says to end it with ELFIE: BLOCKED: followed by the reason when an ambiguous criterion, two criteria in conflict, a name that resolves nowhere, or anything else stops it, then to write no output for the unit and to quote the criterion`,
        `The report part says to end it with ELFIE: CLARIFY: followed by one question when only a person can decide, then to write nothing`,
      ],
    });

  @test(
    {
      input = [Plan@like(`Two units of one target, b before a, a using b`), Unit@like(`a`), []],
      expect = Request@like(
        `Instructions naming the target and a, quoting a's entities with their criteria, the interface of b, no existing outputs, no foreign edits, a reach part saying no other unit's outputs are edited, and the three report lines`,
      ),
    },
    {
      input = [
        Plan@like(
          `One unit, for a target whose language layer is a trait rust extending [[targetLanguage]], with two criteria of its own and a template value in one of them, whose layout layer is a trait flat extending [[targetLayout]] and [[targetFramework]] with one criterion, and whose frameworks hold flat too; the target's declaration has one criterion added to it by an add call at the top of its file`,
        ),
        Unit@like(`the unit`),
        [],
      ],
      expect = Request@like(
        `Guidance holding the declaration's own criterion, then flat's criterion once, then rust's two with the template value evaluated`,
      ),
    },
    {
      input = [
        Plan@like(
          `One unit a, reason requirements, whose fn f has criteria c3 then c1 now, and whose one output's source map answered the ids of c1 and c2`,
        ),
        Unit@like(`a`),
        [Output@like(`The existing output of a`)],
        Previous@like(`a.lfy as it was: f with criteria c1 then c2, not hash-matched`),
      ],
      expect = Request@like(
        `A section for a that says its criteria differ and the code must do what each now says; c1's line unmarked, c3's line marked new, and c2 listed with its text as removed; nothing reworded, and rewordedOnly false`,
      ),
    },
    {
      input = [
        Plan@like(
          `One unit a, reason requirements, whose fn f has criteria c1 then c4 now, and whose one output's source map answered the ids of c1 and c2`,
        ),
        Unit@like(`a`),
        [Output@like(`The existing output of a`)],
        Previous@like(`a.lfy as it was: f with criteria c1 then c2, c2 worded differently from c4, not hash-matched`),
      ],
      expect = Request@like(
        `A section for a with c1's line unmarked, and c4's line marked reworded and followed by a line reading replaces, the id of c2, and the text of c2; nothing removed; reworded holds c4 replacing c2; rewordedOnly true`,
      ),
    },
    {
      input = [
        Plan@like(
          `One unit a, whose fn f takes a B declared by data B in def/b.lfy, an earlier unit with the output src/b.rs`,
        ),
        Unit@like(`a`),
        [],
        undefined,
        true,
      ],
      expect = Request@like(
        `Interfaces holding b with B; instructions whose interfaces part is one line reading def/b.lfy, src/b.rs, and B, with no definition of B, and a line saying to read an interface with elfie_dependency; a tools part naming elfie_task, elfie_mark, and elfie_reach; a stubs part naming elfie_touch; a report part naming elfie_submit and the three report lines`,
      ),
    },
    {
      input = [
        Plan@like(
          `Three units of target rust with output directory src, c, then b, then a, each with outputs, src/c.rs, src/b.rs, and src/a.rs, a using b and c, and a's outputs recording for b an interface hash other than the one b has now; rust's language layer sets stubLine to todo!("elfie stub: \{{unit}}: \{{reason}}")`,
        ),
        Unit@like(`b`),
        [Output@like(`src/b.rs`)],
      ],
      expect = Request@like(
        `A reach whose units are a alone, fixLines 10 and fixUnitLines 40; a reach part listing a with src/a.rs; a stubs part giving todo!("elfie stub: \{{unit}}: \{{reason}}") as written and the caps of 10 and 40 lines`,
      ),
    },
    {
      input = [
        Plan@like(
          `Two units of target rust with output directory src, b before a, a using b, each with outputs, src/b.rs and src/a.rs`,
        ),
        Unit@like(`a`),
        [Output@like(`src/a.rs`)],
        undefined,
        false,
        [
          ForeignEdit@like(
            `A stub by b in the region of a.lfy:f in src/a.rs, with owner a and the note f's field changed type`,
          ),
          ForeignEdit@like(`A fix by b in a region of src/c.rs, with owner c`),
        ],
      ],
      expect = Request@like(
        `foreignEdits holding the stub alone; a foreign edits part naming b, stub, src/a.rs, the marker of a.lfy:f, and the note, with the lines before and after, and saying each stub line is replaced by code that does what a's criteria and tests ask; an empty reach`,
      ),
    },
  );
}

/// report: everything the compiler wrote to standard output
/// verdict: the [[Verdict]] of [[accept]] on the unit's outputs after the run; undefined when the compiler never got that far
/// submitted: the last outcome the compiler submitted through elfie_submit during the run; undefined when it submitted none
// Decision: a submitted outcome was checked when it arrived, so it wins over the report's ELFIE:
// line; the report is read only when nothing was submitted.
fn outcomeOf(report: string, verdict: Verdict | undefined, submitted?: Submission): `How one run of the compiler ended, read from its submitted outcome or its report, and the verdict on its unit` => Outcome {
  @acceptanceCriteria
    .add({
      situation = `[[submitted]] is given`,
      behavior = `No line of [[report]] changes the outcome`,
    })
    .add({
      situation = [
        `[[submitted]] is undefined`,
        `The last line of [[report]] that begins with ELFIE: reads ELFIE: BLOCKED:`,
      ],
      behavior = `The kind is blocked and the message is the rest of that line and every line after it`,
    })
    .add({
      situation = [
        `[[submitted]] is undefined`,
        `The last line of [[report]] that begins with ELFIE: reads ELFIE: CLARIFY:`,
      ],
      behavior = `The kind is clarification and the message is the rest of that line and every line after it`,
    })
    .add({
      situation = `[[Submission.outcome]] of [[submitted]] is blocked`,
      behavior = `The kind is blocked and the message is [[Submission.message]] of [[submitted]]`,
    })
    .add({
      situation = `[[Submission.outcome]] of [[submitted]] is clarify`,
      behavior = `The kind is clarification and the message is [[Submission.message]] of [[submitted]]`,
    })
    .add({
      situation = [
        `[[submitted]] is undefined`,
        `[[verdict]] is undefined and no line of [[report]] begins with ELFIE:`,
      ],
      behavior = `The kind is failed and the message says the compiler reported nothing`,
    })
    .add({
      situation = [
        `[[submitted]] is undefined`,
        `[[verdict]] is rejected`,
        `The last line of [[report]] that begins with ELFIE:, if there is one, reads neither ELFIE: BLOCKED: nor ELFIE: CLARIFY:`,
      ],
      behavior = `The kind is rejected and the message is the first problem of [[verdict]]`,
    })
    .add({
      situation = [
        `[[submitted]] is undefined`,
        `[[verdict]] is undefined or accepted`,
        `[[verdict]] is defined or some line of [[report]] begins with ELFIE:`,
        `The last line of [[report]] that begins with ELFIE:, if there is one, reads neither ELFIE: BLOCKED: nor ELFIE: CLARIFY:`,
      ],
      behavior = `The kind is accepted and the message is empty`,
    })
    .add({
      situation = [`[[Submission.outcome]] of [[submitted]] is done`, `[[verdict]] is rejected`],
      behavior = `The kind is rejected and the message is the first problem of [[verdict]]`,
    })
    .add({
      situation = [`[[Submission.outcome]] of [[submitted]] is done`, `[[verdict]] is accepted`],
      behavior = `The kind is accepted and the message is empty`,
    })
    .add({
      situation = [`[[Submission.outcome]] of [[submitted]] is done`, `[[verdict]] is undefined`],
      behavior = `The kind is failed and the message says the compiler submitted done but the unit was not judged`,
    })
    .add({
      situation = `[[Submission.outcome]] of [[submitted]] is done`,
      behavior = `[[Submission.message]] of [[submitted]] is no part of [[Outcome.message]]`,
    })
    .add({ behavior = `[[Outcome.verdict]] is [[verdict]]` });

  @test(
    {
      input = [`I wrote it.\nELFIE: DONE`, Verdict@like(`accepted`)],
      expect = Outcome@like(`accepted, empty message`),
    },
    {
      input = [`ELFIE: CLARIFY: should Range.end be inclusive?`, undefined],
      expect = Outcome@like(`clarification with the question`),
    },
    {
      input = [`ELFIE: BLOCKED: \[[tokenAt\]] contradicts \[[nodesAt\]] on empty files`, undefined],
      expect = Outcome@like(`blocked with the reason`),
    },
    { input = [``, undefined], expect = Outcome@like(`failed`) },
    {
      input = [
        `I wrote it.\nELFIE: DONE`,
        Verdict@like(`accepted`),
        Submission@like(`blocked, with the message: two criteria of f conflict`),
      ],
      expect = Outcome@like(`blocked with the message two criteria of f conflict`),
    },
    {
      input = [``, Verdict@like(`rejected, with the problem: no marker for B`), Submission@like(`done`)],
      expect = Outcome@like(`rejected with the message no marker for B`),
    },
    {
      input = [`ELFIE: DONE`, undefined, Submission@like(`done`)],
      expect = Outcome@like(`failed, with a message saying the unit was not judged`),
    },
  );
}

// Decision: the touched-fix path, which settles a unit whose only reason is touched and whose
// foreign edits are all fixes without a compiler, needs nothing of its own here. Its outputs are
// accepted as they are, given as they are as before, so no line changed and the fixes become the
// unit's own code, which [[SourceMap.text]] then hashes; [[review]] with the unit's records then
// lists the criteria and tests of the entities the fixes touched. A stub always goes to the
// compiler, since a stub line in the unit's own regions is always rejected.
/// recorded: the source maps recorded for the other units of the unit's target
/// elsewhere: every other file of the unit's target's output directory, as it is where the outputs are read
/// before: every file of the unit's target's output directory as it was before the run, read where the outputs are read; undefined when not known, and then no foreign edit is judged
/// touches: the note the run gave through elfie_touch for each unit it edited, by [[Unit.stem]]
fn accept(
  request: Request,
  unit: Unit,
  outputs: Output[],
  recorded: SourceMap[] = [],
  elsewhere: Output[] = [],
  before?: Output[],
  touches: Object<string> = {},
): `Whether outputs satisfy a request for one unit structurally, the source maps they earn, the outputs with their markers normalized, and the edits they make to later units` => Verdict {
  // Decision: an output may hold markers for other files of the program, because one output often
  // mirrors several. A marker naming a file outside the program is a fixture or prose, not a claim
  // about the program. A line marker inside an entity is rewritten to the entity's name, since a name
  // survives edits and a line does not.
  @acceptanceCriteria.add({ behavior = `[[Verdict.accepted]] is true exactly when [[Verdict.problems]] is empty` });

  // Markers
  @acceptanceCriteria
    .add({ situation = `[[outputs]] is empty`, behavior = `[[Verdict.problems]] holds one saying so` })
    // Decision: a file shared by several units is an output of each, as Rust's lib.rs must be; what a
    // unit may not do is take away what another unit recorded in it. Moving it is not taking it
    // away: splitting a module carries the markers another unit recorded in the unit's code into new
    // files, so a recorded marker is looked for in every output of the unit and in every other file
    // of the output directory, never only in the file it was recorded for. Markers are counted, not
    // just found, so dropping one of two regions with the same name is still taking one away. A
    // marker that is the unit's own, as [[SourceMap]] defines one, is the unit's to write or drop: a
    // co-owner's map holds it only because a map records every marker of its output.
    // Decision: in a shared output, whether a co-owner's region grew by lines the unit put under it is
    // judged by these counts alone and never line by line, because a module line such as lib.rs's
    // sits under whatever marker comes before it. [[SourceMap.text]] hashes the co-owner's own
    // regions and is carried over when its maps are re-derived, so a grown region no longer matches
    // it, and the co-owner's outputs are never kept as they are on that hash.
    .add({
      situation = [
        `An output's path is [[SourceMap.output]] of a source map in [[recorded]] whose [[SourceMap.source]] is not the file of the unit`,
        `For the [[Marker.file]], [[Marker.entity]], and [[Marker.requirement]] of a marker of that source map that is not the unit's own, fewer markers with those three across [[outputs]] and [[elsewhere]] together than across every map of [[recorded]] with that source`,
      ],
      behavior = `[[Verdict.problems]] holds one naming the path, the other unit's source, the marker, and both counts`,
    })
    .add({
      situation = [
        `An output's path is [[SourceMap.output]] of a source map in [[recorded]] whose [[SourceMap.source]] is not the file of the unit`,
        `For the [[Marker.file]], [[Marker.entity]], and [[Marker.requirement]] of every marker of that source map that is not the unit's own, as many markers with those three or more across [[outputs]] and [[elsewhere]] together as across every map of [[recorded]] with that source`,
      ],
      behavior = `Sharing the output with that other unit adds no problem`,
    })
    .add({
      behavior = `A file of [[elsewhere]] is in no [[Verdict.outputs]], has no source map, and its markers add no problem`,
    })
    .add({
      situation = `An output's path does not [[Path.startsWith]] [[Target.outputDirectory]] of the unit's target`,
      behavior = `[[Verdict.problems]] holds one naming the path`,
    })
    .add({
      situation = `An output's [[Path.extension]] is not among [[Target.extensions]] of the unit's target`,
      behavior = `[[Verdict.problems]] holds one naming the path and the extensions the target allows`,
    })
    .add({
      situation = `A marker names an entity`,
      behavior = `Its line is derived as the first line of the declaring node of the entity with that name in that file, and the marker is left as written`,
    })
    .add({
      situation = `A marker names a file of the program and an entity that file does not declare`,
      behavior = `[[Verdict.problems]] holds one naming the output line and the name`,
    })
    .add({
      situation = `A marker names a line of the unit's file, or of the file declaring an entity moved into the unit, that falls inside an entity's declaration`,
      behavior = `The marker is rewritten in [[Verdict.outputs]] to name that entity`,
    })
    .add({
      situation = `An output holds a [[Marker]] naming a line of the unit's [[File.path]], or of the file declaring an entity moved into the unit, beyond that file's last line`,
      behavior = `[[Verdict.problems]] holds one naming the output line`,
    })
    .add({
      situation = `A marker naming the unit's [[File.path]], or the file of an entity moved into the unit, names a requirement id that is neither a local criterion or test of the unit nor one of [[Request.globals]]`,
      behavior = `[[Verdict.problems]] holds one naming the output line and the id`,
    })
    .add({
      situation = `An output holds a [[Marker]] naming another file of the program and an entity that file declares`,
      behavior = `The marker adds no problem`,
    })
    .add({
      situation = `An output holds a [[Marker]] naming a file that is not in the program`,
      behavior = [`The marker adds no problem`, `The marker is not in [[SourceMap.markers]]`],
    })
    .add({
      situation = `An entity of the unit has no marker in any output naming it or a line its declaring node covers`,
      behavior = `[[Verdict.problems]] holds one naming the entity`,
    });

  // Stubs left
  // Decision: a unit holding a stub is never accepted, so every stub sits in the code of a unit not
  // yet accepted, later in plan order, and a bottom-up compile ends.
  @acceptanceCriteria
    .add({
      behavior = `A stub line naming a unit is a line that, with the white space before and after it removed, reads the stub line of the unit's target, the value the setters of [[Target.declaration]] give [[targetLanguage.stubLine]], read as [[Target.markerComment]] is the value they give markerComment, with \{{unit}} as that unit's [[Unit.stem]] and \{{reason}} as any text, which is the reason it gives`,
    })
    .add({
      situation = `No setter of [[Target.declaration]] of the unit's target gives [[targetLanguage.stubLine]] a value`,
      behavior = `No line is a stub line`,
    })
    .add({
      situation = `A line of a region of a marker of the unit's own, in an output of [[outputs]], is a stub line naming any unit`,
      behavior = `[[Verdict.problems]] holds one naming the output line and saying a stub is left in the unit's code`,
    });

  // Foreign edits
  // Decision: what the run changed is read by comparing the files with what they held before it,
  // because an edit to another unit's code shows in no marker. A changed line is judged by the
  // region it falls in, so the rules follow ownership rather than files.
  // Decision: a changed line of a shared output outside the unit's own regions is judged as before
  // there were foreign edits, by the marker counts alone, because a module line such as lib.rs's or
  // mod.rs's sits under whatever marker comes before it.
  @acceptanceCriteria
    .add({
      situation = `[[before]] is undefined`,
      behavior = [`No changed line is judged`, `[[Verdict.foreignEdits]] is empty`],
    })
    .add({
      situation = `[[before]] is given`,
      behavior = `The changed lines of a path are those a line diff removes from its text in [[before]] or adds in its text in [[outputs]], or in [[elsewhere]] when no output has the path, a path missing on either side being read as the empty text`,
    })
    .add({
      behavior = `A removed line falls in the region that held it in [[before]], and an added line in the region that holds it now, a region being that of a [[Marker]] naming a file of the program`,
    })
    .add({
      behavior = `A region is another unit's when its marker is that unit's own, as [[SourceMap]] defines one, and that unit is the owner of the region`,
    })
    .add({
      behavior = `An output of [[outputs]] is shared when its path is [[SourceMap.output]] of a map of [[recorded]] whose [[SourceMap.source]] is not the file of the unit`,
    })
    .add({
      situation = `A changed line falls in a region of a marker of the unit's own, or in an output of [[outputs]] that is not shared`,
      behavior = `It is the unit's own code, and adds no problem and no foreign edit`,
    })
    .add({
      situation = `A changed line of a shared output falls in no region of a marker of the unit's own`,
      behavior = `It adds no problem and no foreign edit beyond the marker counts of a shared output`,
    })
    .add({
      situation = [
        `A changed line is of a path that is no output of [[outputs]]`,
        `It falls in no region, or in a region whose marker is no unit's own`,
      ],
      behavior = `[[Verdict.problems]] holds one naming the path and the line, and saying the line is in no unit's code`,
    })
    .add({
      situation = [
        `A changed line is of a path that is no output of [[outputs]]`,
        `It falls in another unit's region`,
        `The owner is not among [[Reach.units]] of [[Request.reach]] of [[request]]`,
      ],
      behavior = `[[Verdict.problems]] holds one naming the path, the line, and the owner, and saying only the code of a unit in its reach, one that depends on it, is edited`,
    })
    .add({
      situation = [
        `A changed line is of a path that is no output of [[outputs]]`,
        `It falls in another unit's region`,
        `The changed lines of that region change the line of the marker that begins it, or add or remove a line read as a [[Marker]]`,
      ],
      behavior = `[[Verdict.problems]] holds one naming the path and the marker, and saying the markers of another unit's region stay as they were`,
    })
    .add({
      situation = [
        `The changed lines of a path that is no output of [[outputs]] fall in another unit's region`,
        `The owner is among [[Reach.units]] of [[Request.reach]] of [[request]]`,
        `They leave the markers of the region as they were`,
      ],
      behavior = `They are one [[ForeignEdit]] in [[Verdict.foreignEdits]], whose [[ForeignEdit.by]] is [[Unit.stem]] of [[unit]], whose [[ForeignEdit.owner]] is the owner's [[Unit.stem]], whose [[ForeignEdit.region]] is the marker that begins the region as [[before]] held it, and whose [[ForeignEdit.before]] and [[ForeignEdit.after]] are the lines of the region before and after`,
    })
    .add({
      situation = [
        `A foreign edit adds at least one line`,
        `Every line it adds is a stub line naming [[unit]]`,
      ],
      behavior = [
        `[[ForeignEdit.kind]] is stub`,
        `[[ForeignEdit.note]] is the reason the first of its stub lines gives`,
      ],
    })
    .add({
      situation = `A foreign edit adds no line, or adds a line that is not a stub line naming [[unit]]`,
      behavior = [`[[ForeignEdit.kind]] is fix`, `[[ForeignEdit.note]] is the note [[touches]] gives its owner`],
    })
    .add({
      situation = `A fix changes more than [[Reach.fixLines]] of [[Request.reach]] of [[request]] lines`,
      behavior = `[[Verdict.problems]] holds one naming the path, the marker of its region, the lines it changes, and the cap, and saying a bigger edit is a stub`,
    })
    .add({
      situation = `The fixes of [[Verdict.foreignEdits]] with one owner together change more than [[Reach.fixUnitLines]] of [[Request.reach]] of [[request]] lines`,
      behavior = `[[Verdict.problems]] holds one naming the owner, the lines they change, and the cap, and saying a bigger edit is a stub`,
    })
    .add({
      situation = `A fix's owner has no entry in [[touches]], or an empty one`,
      behavior = `[[Verdict.problems]] holds one naming the owner, and saying a fix needs a note given through elfie_touch`,
    })
    .add({ behavior = `A stub needs no note in [[touches]] and has no cap` });

  // Source maps, mechanically
  @acceptanceCriteria
    .add({
      situation = `[[Verdict.accepted]] is true`,
      behavior = `[[Verdict.sourceMaps]] holds one [[SourceMap]] per output, in [[outputs]] order`,
    })
    .add({
      behavior = `[[SourceMap.target]] of each of [[Verdict.sourceMaps]] is [[Target.identifier]] of the unit's target`,
    })
    .add({ behavior = `[[SourceMap.output]] of each of [[Verdict.sourceMaps]] is the path of the output it is for` })
    .add({ behavior = `[[SourceMap.source]] of each of [[Verdict.sourceMaps]] is [[File.path]] of the unit's file` })
    .add({
      behavior = `[[SourceMap.hash]] of each of [[Verdict.sourceMaps]] is the SHA-256 of [[Unit.text]] of [[unit]]`,
    })
    .add({
      behavior = `[[SourceMap.requirements]] of each of [[Verdict.sourceMaps]] is taken over the local criterion and test ids of [[unit]]`,
    })
    .add({
      behavior = `[[SourceMap.answered]] of each of [[Verdict.sourceMaps]] is the local criterion and test ids of [[unit]], sorted`,
    })
    .add({
      behavior = `[[SourceMap.signature]] of each of [[Verdict.sourceMaps]] is the SHA-256 of [[interfaceOf]] [[unit]]`,
    })
    .add({
      behavior = `[[SourceMap.text]] of each of [[Verdict.sourceMaps]] is the SHA-256, as lowercase hex, of the unit's own region text, as [[SourceMap]] defines it, of the output it is for as [[Verdict.outputs]] holds it`,
    })
    .add({
      behavior = `[[SourceMap.dependencies]] of each of [[Verdict.sourceMaps]] maps the source path of each of [[Unit.dependencies]] to the SHA-256 of [[interfaceOf]] it, as computed during this call`,
    })
    .add({
      behavior = `[[SourceMap.generated]] of each of [[Verdict.sourceMaps]] is [[Time.Instant.rfc3339]] of [[Time.now]] during this call`,
    })
    .add({
      behavior = `[[SourceMap.markers]] of each of [[Verdict.sourceMaps]] holds every marker of the output it is for that names a file of the program, in output order, with its derived line`,
    })
    .add({ behavior = `Nothing in a source map comes from the compiler's text except the names it spelled` })
    .add({ behavior = `No command of the target is run` });

  @test(
    {
      input = [
        Request@like(`For the unit of a.lfy, with entities A and B`),
        Unit@like(`that unit`),
        [Output@like(`One file under the output directory with a marker a.lfy:A and one a.lfy:B`)],
      ],
      expect = Verdict@like(
        `Accepted, one source map with two markers whose lines are those of A and B, the first ending on the line before the second and the second on the last line of the output, the output unchanged`,
      ),
    },
    {
      input = [
        Request@like(`For the unit of a.lfy, with entities A and B`),
        Unit@like(`that unit`),
        [Output@like(`One file with a marker naming the line of A only`)],
      ],
      expect = Verdict@like(`Rejected, one problem naming B`),
    },
    {
      input = [
        Request@like(`For the unit of a.lfy, with entity A on line 3`),
        Unit@like(`that unit`),
        [Output@like(`One file with a marker a.lfy:3`)],
      ],
      expect = Verdict@like(`Accepted, and the output in [[Verdict.outputs]] reads a.lfy:A instead`),
    },
    {
      input = [
        Request@like(`For the unit of b.lfy, which declares B`),
        Unit@like(`that unit`),
        [
          Output@like(`src/mod.rs with a marker b.lfy:B`),
          Output@like(`src/mod/part.rs, a new file, with a marker b.lfy:B and a marker a.lfy:A`),
        ],
        [SourceMap@like(`The recorded map of a.lfy for src/mod.rs, whose markers are a.lfy:A and b.lfy:B`)],
      ],
      expect = Verdict@like(`Accepted, with one source map for each of the two outputs`),
    },
    {
      input = [
        Request@like(`For the unit of b.lfy, which declares B`),
        Unit@like(`that unit`),
        [Output@like(`src/mod.rs with a marker b.lfy:B`)],
        [SourceMap@like(`The recorded map of a.lfy for src/mod.rs, whose markers are a.lfy:A and b.lfy:B`)],
        [Output@like(`src/a.rs, which holds no marker of b.lfy, with a marker a.lfy:A`)],
      ],
      expect = Verdict@like(`Accepted, with one source map, for src/mod.rs`),
    },
    {
      input = [
        Request@like(`For the unit of b.lfy, which declares B`),
        Unit@like(`that unit`),
        [Output@like(`src/mod.rs with a marker b.lfy:B`)],
        [SourceMap@like(`The recorded map of a.lfy for src/mod.rs, whose markers are a.lfy:A and b.lfy:B`)],
        [Output@like(`src/a.rs with no marker`)],
      ],
      expect = Verdict@like(`Rejected, one problem naming src/mod.rs, a.lfy, the marker a.lfy:A, 0, and 1`),
    },
    {
      input = [
        Request@like(`For the unit of b.lfy, which declares B`),
        Unit@like(`that unit`),
        [Output@like(`src/lib.rs with a marker b.lfy:B and no marker naming a.lfy`)],
        [
          SourceMap@like(`The recorded map of a.lfy for src/lib.rs, whose markers are a.lfy:A and b.lfy:B`),
          SourceMap@like(`The recorded map of a.lfy for src/a.rs, whose marker is a.lfy:A`),
        ],
        [Output@like(`src/a.rs with a marker a.lfy:A`)],
      ],
      expect = Verdict@like(`Rejected, one problem naming src/lib.rs, a.lfy, the marker a.lfy:A, 1, and 2`),
    },
    {
      input = [
        Request@like(
          `For the unit b of b.lfy, of target rust whose stub line is todo!("elfie stub: \{{unit}}: \{{reason}}"), with the unit a, whose output is src/a.rs, in its reach`,
        ),
        Unit@like(`that unit`),
        [Output@like(`src/b.rs with a marker b.lfy:B`)],
        [SourceMap@like(`The recorded map of a.lfy for src/a.rs, whose marker is a.lfy:f`)],
        [
          Output@like(
            `src/a.rs, whose body of f under the marker a.lfy:f is replaced by the line todo!("elfie stub: b: B.x is now a number")`,
          ),
        ],
        [Output@like(`src/b.rs as it was`), Output@like(`src/a.rs as it was, f's body twenty lines long`)],
      ],
      expect = Verdict@like(
        `Accepted, with one foreign edit: by b, owner a, in src/a.rs, kind stub, note B.x is now a number, region a.lfy:f, its lines before and after`,
      ),
    },
    {
      input = [
        Request@like(`For the unit b of b.lfy, with the unit a, whose output is src/a.rs, in its reach`),
        Unit@like(`that unit`),
        [Output@like(`src/b.rs with a marker b.lfy:B`)],
        [SourceMap@like(`The recorded map of a.lfy for src/a.rs, whose marker is a.lfy:f`)],
        [Output@like(`src/a.rs, with three lines of f's body under the marker a.lfy:f rewritten`)],
        [Output@like(`src/b.rs as it was`), Output@like(`src/a.rs as it was`)],
        Object@like(`a mapped to: B.x is now a number, so f converts it`),
      ],
      expect = Verdict@like(
        `Accepted, with one foreign edit: by b, owner a, kind fix, note B.x is now a number, so f converts it`,
      ),
    },
    {
      input = [
        Request@like(`For the unit b of b.lfy, with the unit a, whose output is src/a.rs, in its reach`),
        Unit@like(`that unit`),
        [Output@like(`src/b.rs with a marker b.lfy:B`)],
        [SourceMap@like(`The recorded map of a.lfy for src/a.rs, whose marker is a.lfy:f`)],
        [Output@like(`src/a.rs, with three lines of f's body under the marker a.lfy:f rewritten`)],
        [Output@like(`src/b.rs as it was`), Output@like(`src/a.rs as it was`)],
      ],
      expect = Verdict@like(`Rejected, one problem naming a and saying a fix needs a note given through elfie_touch`),
    },
    {
      input = [
        Request@like(`For the unit b of b.lfy, with the unit a, whose output is src/a.rs, in its reach`),
        Unit@like(`that unit`),
        [Output@like(`src/b.rs with a marker b.lfy:B`)],
        [SourceMap@like(`The recorded map of a.lfy for src/a.rs, whose marker is a.lfy:f`)],
        [Output@like(`src/a.rs, with twelve lines of f's body under the marker a.lfy:f rewritten`)],
        [Output@like(`src/b.rs as it was`), Output@like(`src/a.rs as it was`)],
        Object@like(`a mapped to a note`),
      ],
      expect = Verdict@like(`Rejected, one problem naming src/a.rs, the marker a.lfy:f, 12 lines, and the cap of 10`),
    },
    {
      input = [
        Request@like(
          `For the unit b of b.lfy, whose reach is empty because c, whose output is src/c.rs, does not depend on it`,
        ),
        Unit@like(`that unit`),
        [Output@like(`src/b.rs with a marker b.lfy:B`)],
        [SourceMap@like(`The recorded map of c.lfy for src/c.rs, whose marker is c.lfy:g`)],
        [Output@like(`src/c.rs, with one line of g's body under the marker c.lfy:g rewritten`)],
        [Output@like(`src/b.rs as it was`), Output@like(`src/c.rs as it was`)],
        Object@like(`c mapped to a note`),
      ],
      expect = Verdict@like(`Rejected, one problem naming src/c.rs, the line, and c, and no foreign edit`),
    },
    {
      input = [
        Request@like(`For the unit b of b.lfy`),
        Unit@like(`that unit`),
        [Output@like(`src/b.rs with a marker b.lfy:B`)],
        [],
        [Output@like(`src/notes.rs, which holds no marker, with one line added`)],
        [Output@like(`src/b.rs as it was`), Output@like(`src/notes.rs as it was`)],
      ],
      expect = Verdict@like(`Rejected, one problem naming src/notes.rs and the line, saying it is in no unit's code`),
    },
    {
      input = [
        Request@like(
          `For the unit a of a.lfy, of target rust whose stub line is todo!("elfie stub: \{{unit}}: \{{reason}}")`,
        ),
        Unit@like(`that unit`),
        [
          Output@like(
            `src/a.rs, whose marker a.lfy:f begins a region holding todo!("elfie stub: b: B.x is now a number")`,
          ),
        ],
      ],
      expect = Verdict@like(`Rejected, one problem naming the line of the stub in src/a.rs`),
    },
    {
      input = [
        Request@like(
          `For the unit a of a.lfy, reason touched, whose one foreign edit is a fix by b in the region of a.lfy:f`,
        ),
        Unit@like(`that unit`),
        [Output@like(`src/a.rs as the fix left it, with the markers a.lfy:A and a.lfy:f`)],
        [],
        [],
        [Output@like(`src/a.rs as the fix left it`)],
      ],
      expect = Verdict@like(
        `Accepted, no foreign edit, and one source map for src/a.rs whose text is the hash of a's own regions with the fix in them`,
      ),
    },
  );
}

// Compile data

// Decision: compile-time data lives in elfie-compile under [[Workspace.root]], never under an output
// directory, so outputs hold only generated code. elfie-compile is checked in: it is the record of
// what was generated from what. elfie-compile/maps holds the source maps, one file per unit, so
// accepting a unit writes one small file instead of rewriting every map of the target, and a commit
// shows exactly which units a compile touched. elfie-compile/cache is git-ignored and holds only what
// can be rebuilt or lost at the cost of time: deleting it changes no plan or verdict of the root.
// What it can change is where a compile resumes, since a kept change set, its copy, and the foreign
// edits recorded in it are lost with it.

/// target: the identifier of one target; every target when left out
fn sourceMapsOf(workspace: Workspace, target?: string): `Every source map recorded for a workspace whose output still exists` => SourceMap[] {
  @acceptanceCriteria
    .add({
      behavior = `A unit's map file is elfie-compile/maps under [[Workspace.root]], then [[Target.identifier]], then [[Unit.stem]] with the extension .json, such as elfie-compile/maps/rust/cli/main.json for def/cli/main.lfy`,
    })
    .add({ behavior = `A unit's map file holds the unit's source maps as one JSON list` })
    .add({
      behavior = `Returns the source maps of every map file under the folder of each target of [[Workspace.targets]], in target order, then in the order [[Files.list]] gives the files, then in the order each file lists them`,
    })
    .add({
      situation = `[[target]] is set`,
      behavior = `Returns only the source maps of the map files under the folder of that target`,
    })
    .add({
      situation = `[[target]] is set`,
      behavior = `A map file of another target, even one that cannot be read, does not change the result`,
    })
    .add({
      situation = `[[Files.exists]] does not find the [[SourceMap.output]] of a recorded map`,
      behavior = `The map is left out`,
    })
    .add({
      situation = `A map file cannot be read or is not a JSON list of source maps`,
      behavior = `It contributes nothing`,
    })
    .add({
      situation = `A recorded map has no answered key`,
      behavior = `It is read with [[SourceMap.answered]] empty`,
    })
    .add({
      situation = `A recorded map has no text key`,
      behavior = `It is read with [[SourceMap.text]] empty`,
    })
    .add({
      situation = [
        `A target has no folder under elfie-compile/maps`,
        `Its [[Target.outputDirectory]] holds source-map.json, as earlier versions recorded every map of a target`,
      ],
      behavior = `That target's maps are read from source-map.json instead, the same way`,
    })
    .add({
      situation = [
        `A target has no folder under elfie-compile/maps`,
        `Its [[Target.outputDirectory]] holds no source-map.json`,
      ],
      behavior = `That target has no source maps`,
    })
    .add({ behavior = `Nothing is written` })
    .add({ behavior = `Nothing it returns depends on elfie-compile/cache` });

  @test(
    {
      input = [
        Workspace@like(
          `One target rust; elfie-compile/maps/rust holds a.json with one map for crates/a/src/a.rs and b.json with one map for crates/b/src/b.rs, both outputs present`,
        ),
      ],
      expect = [SourceMap@like(`crates/a/src/a.rs`), SourceMap@like(`crates/b/src/b.rs`)],
    },
    {
      input = [Workspace@like(`The same project with crates/b/src/b.rs deleted`)],
      expect = [SourceMap@like(`crates/a/src/a.rs`)],
    },
    {
      input = [
        Workspace@like(
          `One target rust with no elfie-compile folder and crates/source-map.json holding two maps whose outputs are present`,
        ),
      ],
      expect = [SourceMap@like(`The two maps of crates/source-map.json, in its order`)],
    },
    {
      input = [
        Workspace@like(
          `One target rust; elfie-compile/maps/rust holds a.json reading {"output": and b.json with one map for crates/b/src/b.rs, whose output is present`,
        ),
      ],
      expect = [SourceMap@like(`crates/b/src/b.rs`)],
    },
  );
}

fn record(workspace: Workspace, unit: Unit, sourceMaps: SourceMap[]): `Whether the source maps of one accepted unit are recorded in its map file` => boolean {
  @acceptanceCriteria
    .add({
      behavior = `The unit's map file, as [[sourceMapsOf]] names it, holds [[sourceMaps]] afterwards, replacing whatever it held`,
      sideEffects = [`The unit's map file is written`],
    })
    .add({ behavior = `No other file is written` })
    // Decision: the layout is fixed so a diff of a map file shows only what changed.
    .add({
      behavior = `The file is [[Json.stringify]] of [[sourceMaps]] with [[Json.Layout.readable]]`,
    })
    .add({ behavior = `The file lists [[sourceMaps]] in [[SourceMap.output]] order, each map's markers in output order` })
    .add({ behavior = `The keys of every object in the file are in alphabetical order` })
    .add({ behavior = `The same maps always give the same bytes` })
    .add({
      situation = `The unit's map file already holds maps that differ from [[sourceMaps]] only in [[SourceMap.generated]]`,
      behavior = [`The file is left as it is`, `The result is true`],
    })
    .add({
      situation = `No folder above the unit's map file exists yet`,
      behavior = `Every missing folder is created`,
    })
    .add({
      situation = `[[sourceMaps]] is empty`,
      behavior = `The map file is removed by [[Files.remove]]`,
    })
    .add({ situation = `The file cannot be written`, behavior = `Returns false` });

  @test(
    {
      input = [
        Workspace@like(`One target rust whose maps folder holds a.json and b.json`),
        Unit@like(`The unit of def/a.lfy`),
        [SourceMap@like(`For crates/a/src/a.rs with a new hash`)],
      ],
      expect = boolean@like(`true; elfie-compile/maps/rust/a.json holds the new map and b.json is untouched`),
    },
    {
      input = [
        Workspace@like(`The same project`),
        Unit@like(`The unit of def/a.lfy`),
        [SourceMap@like(`The map a.json holds, with a later generated time`)],
      ],
      expect = boolean@like(`true, and a.json is not written`),
    },
    {
      input = [
        Workspace@like(`One target rust with no elfie-compile folder`),
        Unit@like(`The unit of def/cli/main.lfy`),
        [SourceMap@like(`For crates/elfie-cli/src/main.rs`)],
      ],
      expect = boolean@like(`true, and elfie-compile/maps/rust/cli/main.json is created with every folder above it`),
    },
  );
}

// Decision: when one unit writes a file another unit also has markers in, such as lib.rs, or moves
// another unit's markers into new files by splitting a module, the other unit's recorded maps no
// longer say where its regions are. Its maps are re-read from the files as they are, while
// everything its last accepted generation recorded is carried over output by output, so what it
// was generated from, and what decides whether it is planned, stays as it was.
// Decision: [[SourceMap.text]] is carried over and never read again from the files: it is the hash
// of the code the unit's own acceptance and review saw, so another unit's unreviewed edit inside
// one of its regions, or lines put under one of its markers, leaves its outputs no longer matching
// it. An output it had no map for has no text that was accepted, so its text is empty.
/// unit: a unit of the target whose output files another unit has written since its maps were recorded
/// sourceMaps: the maps the unit's map file holds, whether or not their outputs still exist
fn rederive(workspace: Workspace, unit: Unit, sourceMaps: SourceMap[]): `The source maps of a unit as the files of its target's output directory hold its markers now, carrying over what its last accepted generation recorded` => SourceMap[] {
  @acceptanceCriteria
    .add({
      behavior = `Returns one [[SourceMap]] for each file of [[Files.list]] of [[Target.outputDirectory]] of the unit's target under [[Workspace.root]], recursively, whose [[Files.read]] text holds a [[Marker]] that is the unit's own, as [[SourceMap]] defines one, in path order`,
    })
    .add({
      behavior = `[[SourceMap.target]], [[SourceMap.output]], and [[SourceMap.source]] of each returned map are [[Target.identifier]] of the unit's target, the file's path relative to [[Workspace.root]], and [[File.path]] of the unit's file`,
    })
    .add({
      behavior = `[[SourceMap.markers]] of each returned map holds every marker of its file that names a file of the program, in output order, read as [[accept]] reads a [[Marker]], left as written, and with its line and end derived as [[accept]] derives them`,
    })
    .add({
      situation = `A map of [[sourceMaps]] has the same [[SourceMap.output]] as a returned map`,
      behavior = `[[SourceMap.hash]], [[SourceMap.requirements]], [[SourceMap.answered]], [[SourceMap.signature]], [[SourceMap.text]], [[SourceMap.dependencies]], and [[SourceMap.generated]] of the returned map are that map's`,
    })
    .add({
      situation = [
        `No map of [[sourceMaps]] has the same [[SourceMap.output]] as a returned map`,
        `Every map of [[sourceMaps]] has the same [[SourceMap.hash]], [[SourceMap.requirements]], [[SourceMap.answered]], [[SourceMap.signature]], [[SourceMap.dependencies]], and [[SourceMap.generated]]`,
      ],
      behavior = [
        `Those six of the returned map are the ones every map of [[sourceMaps]] has`,
        `[[SourceMap.text]] of the returned map is empty`,
      ],
    })
    .add({
      situation = [
        `No map of [[sourceMaps]] has the same [[SourceMap.output]] as a returned map`,
        `Two maps of [[sourceMaps]] differ in [[SourceMap.hash]], [[SourceMap.requirements]], [[SourceMap.answered]], [[SourceMap.signature]], [[SourceMap.dependencies]], or [[SourceMap.generated]]`,
      ],
      behavior = `Returns [[sourceMaps]] as given`,
    })
    .add({
      situation = `[[sourceMaps]] is empty, or no file of the output directory holds a marker that is the unit's own`,
      behavior = `Returns [[sourceMaps]] as given`,
    })
    .add({ behavior = `Nothing is written` })
    .add({ behavior = `No compiler, verifier, or command of the target is run` });

  @test(
    {
      input = [
        Workspace@like(
          `One target rust; src/mod.rs holds markers a.lfy:A and b.lfy:B; src/mod/part.rs, added since a.lfy's maps were recorded, holds b.lfy:B and a.lfy:A.f`,
        ),
        Unit@like(`The unit of a.lfy, which declares A with a member f`),
        [
          SourceMap@like(
            `One map for src/mod.rs with the markers a.lfy:A, a.lfy:A.f, and b.lfy:B, recorded at hash h with text t`,
          ),
        ],
      ],
      expect = [
        SourceMap@like(`For src/mod.rs, markers a.lfy:A and b.lfy:B, hash h, text t`),
        SourceMap@like(`For src/mod/part.rs, markers b.lfy:B and a.lfy:A.f, hash h, text empty`),
      ],
    },
    {
      input = [
        Workspace@like(`One target rust; src/lib.rs holds a.lfy:A and a line another unit added since, under b.lfy:B`),
        Unit@like(`The unit of a.lfy`),
        [SourceMap@like(`One map for src/lib.rs with text t and the markers lib.rs held when it was accepted`)],
      ],
      expect = [SourceMap@like(`The same map, with text t and its markers as lib.rs holds them now`)],
    },
    {
      input = [
        Workspace@like(`One target rust; src/new.rs holds a.lfy:A`),
        Unit@like(`The unit of a.lfy`),
        [
          SourceMap@like(`A map for src/a.rs at hash h1`),
          SourceMap@like(`A map for src/b.rs at hash h2, written before a.rs's`),
        ],
      ],
      expect = [SourceMap@like(`The map for src/a.rs, unchanged`), SourceMap@like(`The map for src/b.rs, unchanged`)],
    },
  );
}

// Decision: review records live beside the maps in elfie-compile and are checked in, because a
// verdict cannot be rebuilt from the definitions, the maps, and the outputs without a verifier.
fn reviewsOf(workspace: Workspace, unit: Unit): `The review records of one unit, as its review record file holds them` => ReviewRecord[] {
  @acceptanceCriteria
    .add({ behavior = `Returns the records of the unit's review record file, in the order it lists them` })
    .add({
      situation = `The unit's review record file is missing, cannot be read, or is not a JSON list of review records`,
      behavior = `Returns an empty list`,
    })
    .add({
      situation = `A record of the file has an id that is not of a local criterion or test of the unit`,
      behavior = `The record is left out`,
    })
    .add({ behavior = `Nothing is written` })
    .add({ behavior = `Nothing it returns depends on elfie-compile/cache` });

  @test(
    {
      input = [
        Workspace@like(`One target rust; elfie-compile/reviews/rust/a.json holds two records for criteria of A`),
        Unit@like(`The unit of def/a.lfy, whose A still has both criteria`),
      ],
      expect = [ReviewRecord@like(`The first record`), ReviewRecord@like(`The second record`)],
    },
    {
      input = [
        Workspace@like(`One target rust with no elfie-compile/reviews folder`),
        Unit@like(`The unit of def/a.lfy`),
      ],
      expect = [],
    },
  );
}

fn recordReviews(workspace: Workspace, unit: Unit, records: ReviewRecord[]): `Whether the review records of one unit are recorded in its review record file` => boolean {
  @acceptanceCriteria
    .add({
      situation = `[[records]] is not empty`,
      behavior = `The unit's review record file holds [[records]] afterwards, replacing whatever it held`,
      sideEffects = [`The unit's review record file is written`],
    })
    .add({ behavior = `No other file is written` })
    .add({
      situation = `[[records]] is not empty`,
      behavior = `The file is [[Json.stringify]] of [[records]] with [[Json.Layout.readable]]`,
    })
    .add({ behavior = `The file lists [[records]] in the order given` })
    .add({ behavior = `The keys of every object in the file are in alphabetical order` })
    .add({ behavior = `The same records always give the same bytes` })
    .add({
      situation = `No folder above the unit's review record file exists yet`,
      behavior = `Every missing folder is created`,
    })
    .add({ situation = `[[records]] is empty`, behavior = `The review record file is removed by [[Files.remove]]` })
    .add({ situation = `The file cannot be written`, behavior = `Returns false` });

  @test(
    {
      input = [
        Workspace@like(`One target rust with no elfie-compile folder`),
        Unit@like(`The unit of def/cli/main.lfy`),
        [ReviewRecord@like(`One satisfied record`)],
      ],
      expect = boolean@like(`true, and elfie-compile/reviews/rust/cli/main.json is created with every folder above it`),
    },
  );
}

// Mapped output access

/// name: an identifier, or an owner's identifier, a dot, and a member's name
/// target: the identifier of one target; every target when left out
fn regionsOf(workspace: Workspace, sourceMaps: SourceMap[], name: string, target?: string): `Every region of generated output that came from one entity` => Marker[] {
  // Decision: a member's region is part of its owner's code, so the owner's regions include it.
  @acceptanceCriteria
    .add({
      behavior = `Returns every [[Marker]] of every [[SourceMap]] in [[sourceMaps]] whose [[Marker.entity]] is [[name]], source map by source map in [[sourceMaps]] order and within one in [[SourceMap.markers]] order, which is output order`,
    })
    .add({
      situation = `The [[Marker.entity]] of a marker of a [[SourceMap]] in [[sourceMaps]] is [[name]], a dot, and a member's name`,
      behavior = `The marker is returned, source map by source map in [[sourceMaps]] order and within one in [[SourceMap.markers]] order`,
    })
    .add({
      situation = `A marker of a [[SourceMap]] in [[sourceMaps]] names a line rather than an entity, [[Marker.file]] declares the entity named [[name]] in [[workspace]], and [[Marker.line]] falls inside its declaring node`,
      behavior = `The marker is returned`,
    })
    .add({
      situation = `[[target]] is set`,
      behavior = `Returns only markers of source maps whose [[SourceMap.target]] is [[target]]`,
    });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A with a member x and a fn f`),
        [
          SourceMap@like(
            `For output src/a.rs with markers a.lfy:A on line 3, a.lfy:A.x on line 9, and a.lfy:f on line 20`,
          ),
          SourceMap@like(`For output src/tests.rs with a marker a.lfy:f on line 1 and a.lfy:A on line 12`),
        ],
        `A`,
      ],
      expect = [
        Marker@like(`src/a.rs line 3 for A, ending on 8`),
        Marker@like(`src/a.rs line 9 for A.x, ending on 19`),
        Marker@like(`src/tests.rs line 12 for A, ending on the last line`),
      ],
    },
    {
      input = [Workspace@like(`The same project`), [SourceMap@like(`The same two source maps`)], `A.x`],
      expect = [Marker@like(`src/a.rs line 9 for A.x only`)],
    },
    { input = [Workspace@like(`The same project`), [SourceMap@like(`The same two source maps`)], `B`], expect = [] },
  );
}

// Decision: a change is found by comparing entities, never by diffing lines, so a reformatted or
// reordered file whose entities read the same gives none.
/// previous: the unit's source at its last accepted generation, or its hash-matched source, as recovered for the unit; undefined when neither is known
fn changes(workspace: Workspace, unit: Unit, previous: Previous | undefined): `What differs for each entity of a unit between its file as last accepted and as it is now` => Change[] {
  @acceptanceCriteria
    .add({
      behavior = [
        `The file as it was is the unit's file as [[Program.workspace]] of [[Previous.program]] of [[previous]] declares it, and the entities it declared are read from that workspace's model`,
        `Nothing is lowered or bound`,
      ],
    })
    .add({
      behavior = `The entities the file declared then are compared with those [[Unit.file]] declares now, both those built for [[Unit.target]], whether or not they moved to another unit`,
    })
    .add({
      behavior = `Entities are compared by name: the identifier, or the owner's identifier, a dot, and a member's name`,
    })
    .add({ behavior = `A member is compared as an entity of its own, under its owner` })
    .add({
      situation = `[[previous]] is undefined`,
      behavior = `One [[Change]] of kind [[ChangeKind.added]] per entity [[Unit.file]] declares that is built for [[Unit.target]], in file order, and nothing else`,
    })
    .add({
      situation = `A name is declared now and was not before`,
      behavior = `One [[Change]] of kind [[ChangeKind.added]]`,
    })
    .add({
      situation = `A name was declared before and is not now`,
      behavior = `One [[Change]] of kind [[ChangeKind.removed]]`,
    })
    .add({
      situation = `A name is declared on both sides`,
      behavior = `One [[Change]] per kind that differs, in the order [[ChangeKind]] declares them`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `[[Entity.definition]] differs`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.definition]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The type of the entity, spelled as [[interfaceOf]] spells it, differs`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.declaredType]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The entity is a fn, and its parameters, their types, or its output, spelled as [[interfaceOf]] spells them, differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.signature]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local criteria differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.criteria]], whose detail names the ids added and removed`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local criteria differ`,
        `Counting from the first, the criterion at some position among its local criteria then has an id that is none of its criteria's now, and the criterion at the same position now has an id that was none of its criteria's then`,
      ],
      behavior = `The detail of the [[ChangeKind.criteria]] change calls those two reworded, as a pair`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local tests differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.tests]], whose detail names the ids added and removed`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local tests differ`,
        `Counting from the first, the test at some position among its local tests then has an id that is none of its tests' now, and the test at the same position now has an id that was none of its tests' then`,
      ],
      behavior = `The detail of the [[ChangeKind.tests]] change calls those two reworded, as a pair`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The joined [[Token.raw]] of the tokens the declaring node covers differs once its definition, type, parameters, output, criteria, tests, whitespace, and comments are left out`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.body]]`,
    })
    .add({
      behavior = `The changes are in file order: the changes of entities declared now follow the order of [[Unit.entities]]`,
    })
    .add({
      situation = `An entity was removed, and some entity that preceded it in the previous file is still declared`,
      behavior = `Its change is placed after the changes of the last entity that preceded it in the previous file and is still declared`,
    })
    .add({
      situation = `An entity was removed, and no entity that preceded it in the previous file is still declared`,
      behavior = `Its change is placed first`,
    })
    .add({
      situation = `The old and the new of what differs are each under 80 characters`,
      behavior = `[[Change.detail]] is one line saying what differs, quoting the old and the new`,
    })
    .add({
      situation = `The old or the new of what differs is 80 characters or more`,
      behavior = `[[Change.detail]] is one line saying what differs, naming the old and the new rather than quoting them, such as the count of criteria before and after or the name of the parameter that differs`,
    });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A and a fn f`),
        Unit@like(`The unit of a.lfy`),
        undefined,
      ],
      expect = [Change@like(`A added`), Change@like(`f added`)],
    },
    {
      input = [
        Workspace@like(
          `def holds a.lfy declaring a data A defined as a thing and a fn f taking x: string and y: number`,
        ),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: A defined as a value and f taking only x: string`),
      ],
      expect = [
        Change@like(`A, definition, detail quoting a value and a thing`),
        Change@like(`f, signature, detail naming the added parameter y`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with three criteria and a data B`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: a data A, then f with two of those criteria, and B with one more member, old`),
      ],
      expect = [
        Change@like(`A removed`),
        Change@like(`f, criteria, detail reading 2 criteria before and 3 now`),
        Change@like(`B.old, removed`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A and a fn f`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(
          `a.lfy as it was: the same declarations with f before A, indented differently, and with a comment`,
        ),
      ],
      expect = [],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with criteria c1 then c4`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: f with criteria c1 then c2, c2 worded differently from c4`),
      ],
      expect = [Change@like(`f, criteria, detail naming c2 removed and c4 added and calling them reworded`)],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with criteria c0, then c1, then c5`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: f with criteria c1 then c2, c2 worded differently from c5`),
      ],
      expect = [Change@like(`f, criteria, detail naming c2 removed and c0 and c5 added, and calling no pair reworded`)],
    },
  );
}

/// previous: the unit's source at its last accepted generation, as recovered for the unit
fn reworded(workspace: Workspace, unit: Unit, previous: Previous): `The local criteria and tests of a unit whose id changed since its outputs were accepted only because their text did, each paired with the id it replaces` => Rewording[] {
  @acceptanceCriteria
    .add({
      behavior = `Returns one [[Rewording]] for each pair of a removed and an added id that a change of [[changes]] of [[workspace]], [[unit]], and [[previous]] calls reworded, in the order of those changes`,
    })
    .add({ behavior = `[[Rewording.id]] is the added id, and [[Rewording.replaces]] the removed one` })
    .add({
      behavior = `[[Rewording.text]] is what the removed one said, taken from the unit's file in [[Previous.program]] of [[previous]], as a [[RemovedRequirement]] takes its text`,
    })
    .add({
      situation = `The added id of a pair is not the id of a local criterion or test of [[unit]]`,
      behavior = `The pair gives no [[Rewording]]`,
    })
    .add({ behavior = [`Nothing is written`, `Nothing is lowered or bound`] });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with criteria c1 then c4, and a data B with tests t1 then t2`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: f with criteria c1 then c2, and B with tests t3 then t2`),
      ],
      expect = [
        Rewording@like(`c4, replacing c2, with the text of c2`),
        Rewording@like(`t1, replacing t3, with the input and expectation of t3`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with criteria c3 then c1`),
        Unit@like(`The unit of a.lfy`),
        Previous@like(`a.lfy as it was: f with criteria c1 then c2`),
      ],
      expect = [],
    },
  );
}

// Decision: one rule rewrites a marker's id, whether a compile moves the markers of reworded
// criteria before the compiler runs or a compiler asks elfie_mark to, so the two never differ.
// Only the markers that name the unit's own file are rewritten, because a marker naming another
// file is another unit's.
/// outputs: output files as they are now; any of them may hold markers of the unit
/// ids: for each id a marker names now, the id it is to name afterwards
fn rename(unit: Unit, outputs: Output[], ids: Object<string>): `The output files in which a marker of one unit names an id being replaced, with each such marker rewritten to name the new id` => Output[] {
  @acceptanceCriteria
    .add({ behavior = `A marker in an output is read as [[accept]] reads a [[Marker]]` })
    .add({
      behavior = `The markers rewritten are those whose [[Marker.requirement]] is a key of [[ids]] and whose [[Marker.file]] is the [[File.path]] of the file of [[unit]], or of a file declaring an entity moved into [[unit]]`,
    })
    .add({
      behavior = `A rewritten marker's line has its [[Marker.requirement]] replaced by the id [[ids]] gives for it, and every other character of the line, and every other line of its output, is kept`,
    })
    .add({
      behavior = `Returns, in the order of [[outputs]], each of [[outputs]] that holds a rewritten marker, with [[Output.text]] as it reads once its markers are rewritten`,
    })
    .add({ behavior = `An output that holds no rewritten marker is not returned` })
    .add({ behavior = `Nothing is written` });

  @test(
    {
      input = [
        Unit@like(`The unit of def/a.lfy, whose fn f has the criterion with id f:f:9c0d`),
        [
          Output@like(`src/a.rs, holding on lines 3 and 8 the markers // @lfy def/a.lfy:f#f:f:1f2e`),
          Output@like(`src/b.rs, holding the marker // @lfy def/b.lfy:g#f:f:1f2e`),
        ],
        Object@like(`f:f:1f2e mapped to f:f:9c0d`),
      ],
      expect = [
        Output@like(`src/a.rs, with lines 3 and 8 reading // @lfy def/a.lfy:f#f:f:9c0d and every other line as it was`),
      ],
    },
  );
}

// Independent verification

// Decision: the verifier is told where the regions are and pulls their code through the agent
// server, so a request stays small however large the unit's outputs are, and its protocol allows
// no edits: a review says where and why, never how to fix.
// Decision: a criterion or test is reviewed again only when nothing says its verdict still holds:
// it has no record, its last verdict was not satisfied, or the code of its entity changed since. A
// change to code outside the entity's regions, such as a helper no marker names, does not count.
// Decision: a marker comment is no part of a region's hash, while the code on its line is, so moving a reworded criterion's markers to
// its new id, or adding a marker, does not send the other criteria of the entity to review again.
// A reworded criterion is reviewed all the same: its new text may ask for something else, so no
// verdict on the id it replaces stands for it.
// Decision: a foreign edit changes the text of the owner's region, so the owner's earlier verdicts on
// that entity no longer count, and a touched unit reviewed with its records is reviewed on the
// entities the foreign edits touched and nothing whose verdict still holds; the touched-fix path
// needs no review of its own.
/// directory: the directory the unit's outputs were written in, which its regions are read from; [[Workspace.root]] when left out
/// records: the review records of the unit; every criterion and test is reviewed when it is empty
fn review(plan: Plan, unit: Unit, sourceMaps: SourceMap[], directory?: string, records: ReviewRecord[] = []): `Everything a verifier is handed to check the outputs of one unit against every criterion and test whose verdict is not carried` => ReviewRequest {
  @acceptanceCriteria
    .add({ behavior = `[[ReviewRequest.unit]] is [[unit]]` })
    .add({
      behavior = `Every output a region is read from is [[Files.read]] at [[SourceMap.output]] under [[directory]], or under [[Workspace.root]] when [[directory]] is left out`,
    })
    .add({ behavior = `[[ReviewRequest.instructions]] lists only local criteria and tests` })
    .add({
      behavior = `The regions of an entity are each [[Marker]] of [[regionsOf]] for its name in [[sourceMaps]] limited to the unit's target whose [[Marker.file]] is the file that declares the entity, in [[SourceMap.output]] order, then in [[Marker.outputLine]] order`,
    })
    .add({
      behavior = `[[ReviewRequest.hashes]] gives each local criterion and test of [[unit]] the SHA-256, as lowercase hex, of the text of the regions of the entity it belongs to: each region's lines of its output, each with the marker comment it carries, from [[Target.markerComment]] before @lfy to the end of the line, and any white space before it, removed, and every line that is then empty left out, one region after another, each line followed by a line break`,
    })
    .add({
      situation = `The output of a region cannot be read`,
      behavior = `The region adds no text to a hash`,
    })
    .add({
      situation = `A local criterion or test belongs to an entity with no region, or to the file's own entity`,
      behavior = `Its hash is the SHA-256 of the empty text`,
    })
    .add({
      situation = `A local criterion or test of [[unit]] has no record in [[records]], or its record's [[ReviewRecord.status]] is violated or unverifiable, or its record's [[ReviewRecord.hash]] differs from its hash in [[ReviewRequest.hashes]], or the entity it belongs to has no region`,
      behavior = `It is listed in [[ReviewRequest.instructions]]`,
    })
    .add({
      situation = `A local criterion or test of [[unit]] belongs to an entity with a region, and has a record in [[records]] whose [[ReviewRecord.status]] is satisfied and whose [[ReviewRecord.hash]] is its hash in [[ReviewRequest.hashes]]`,
      behavior = [`It is not listed`, `Its record is in [[ReviewRequest.carried]]`],
    })
    .add({
      behavior = `A local criterion or test whose entity has no region, or that belongs to the file's own entity, is never carried`,
    })
    .add({
      behavior = `A record in [[records]] is carried only for the criterion or test whose id it holds, and never for one that rewords it, even when the regions of its entity are unchanged`,
    })
    .add({
      situation = `At least one criterion or test is listed`,
      behavior = [
        `[[ReviewRequest.instructions]] says, in this order:`,
        `A heading naming [[Unit.stem]] of [[unit]] and the target`,
        `For each of [[Unit.entities]] with a listed criterion or test: its identifier, or its owner's identifier, a dot, and its name, then its definition, then each of its regions on one line as the output path, a colon, [[Marker.outputLine]], a dash, and [[Marker.end]], a region that begins on the line after the one before it in the same output being joined to it as one range, then each of its listed criteria as [[LoweredCriterion.text]] on one line prefixed by its id and place, then each of its listed tests as input and expectation on one line prefixed by its id and place`,
        `Then, when a criterion or test of the file's own entity is listed: the file's path, then each of those listed criteria and tests the same way`,
        `The verifier protocol`,
      ],
    })
    .add({ behavior = `[[ReviewRequest.instructions]] holds no line of any output` })
    .add({
      situation = `An entity of [[unit]] has no listed criterion or test`,
      behavior = `[[ReviewRequest.instructions]] names neither it nor its regions`,
    })
    .add({
      situation = `Another file of the program declares an entity with the same name as an entity of [[unit]]`,
      behavior = `[[ReviewRequest.instructions]] gives none of that other entity's regions`,
    })
    .add({
      situation = `No criterion or test is listed`,
      behavior = `[[ReviewRequest.instructions]] is the heading and one line saying nothing in the unit needs review`,
    });

  @test(
    {
      input = [
        Plan@like(
          `One unit, a.lfy for target rust, whose entity A has two criteria on lines 4 and 7 and one test on line 10`,
        ),
        Unit@like(`a`),
        [SourceMap@like(`For rust and src/a.rs from a.lfy, with one marker a.lfy:A on line 1 ending on line 30`)],
      ],
      expect = ReviewRequest@like(
        `Instructions headed a and rust; A with its definition and the region src/a.rs:1-30 with none of its lines; two criterion lines prefixed by their ids and def/a.lfy:4 and def/a.lfy:7, one test line prefixed by its id and def/a.lfy:10; then the protocol naming elfie_output, elfie_report, the six keys of the fallback line, and the three statuses, and ending with ELFIE: REVIEWED; asked holds the three ids; nothing carried`,
      ),
    },
    {
      input = [Plan@like(`The same plan`), Unit@like(`a`), []],
      expect = ReviewRequest@like(`The same instructions with no region for A`),
    },
    {
      input = [
        Plan@like(`The same plan`),
        Unit@like(`a`),
        [SourceMap@like(`The same source map`)],
        undefined,
        [
          ReviewRecord@like(`The criterion on line 4, satisfied, with the hash of src/a.rs lines 1 to 30 as they are`),
          ReviewRecord@like(`The criterion on line 7, unverifiable, with the same hash`),
        ],
      ],
      expect = ReviewRequest@like(
        `A with the criterion on line 7 and the test on line 10 only; asked holds their two ids; carried holds the record of the criterion on line 4`,
      ),
    },
    {
      input = [
        Plan@like(`The same plan`),
        Unit@like(`a`),
        [SourceMap@like(`The same source map`)],
        undefined,
        [
          ReviewRecord@like(
            `The criterion on line 4, satisfied, with a hash of src/a.rs as it was before line 12 changed`,
          ),
        ],
      ],
      expect = ReviewRequest@like(
        `A with both criteria and the test listed; asked holds the three ids; nothing carried`,
      ),
    },
    {
      input = [
        Plan@like(`The same plan`),
        Unit@like(`a`),
        [SourceMap@like(`The same source map`)],
        undefined,
        [
          ReviewRecord@like(`The criterion on line 4, satisfied, with the hash of src/a.rs lines 1 to 30 as they are`),
          ReviewRecord@like(`The criterion on line 7, satisfied, with the same hash`),
          ReviewRecord@like(`The test on line 10, satisfied, with the same hash`),
        ],
      ],
      expect = ReviewRequest@like(
        `Instructions of the heading and a line saying nothing needs review; asked empty; carried holds the three records`,
      ),
    },
    {
      input = [
        Plan@like(
          `One unit a.lfy for target rust, reason touched, whose entities A and C each have one criterion; src/a.rs holds a.lfy:A on lines 1 to 20, where another unit's fix changed two lines, and a.lfy:C on lines 21 to 40`,
        ),
        Unit@like(`a`),
        [SourceMap@like(`For rust and src/a.rs from a.lfy, with the markers a.lfy:A on line 1 and a.lfy:C on line 21`)],
        string@like(`The copy of the root the change set is worked in`),
        [
          ReviewRecord@like(`The criterion of A, satisfied, with the hash of A's region before the fix`),
          ReviewRecord@like(`The criterion of C, satisfied, with the hash of C's region as it is`),
        ],
      ],
      expect = ReviewRequest@like(
        `A with its criterion listed; asked holds its id; carried holds the record of C's criterion`,
      ),
    },
  );
}

fn globalReview(plan: Plan, sourceMaps: SourceMap[]): `Everything a verifier is handed to check every global criterion and test once, across every output of the program` => ReviewRequest {
  @acceptanceCriteria
    .add({ behavior = `[[ReviewRequest.unit]] is undefined` })
    .add({
      behavior = `[[ReviewRequest.asked]] holds the ids of [[Program.criteria]] then [[Program.tests]] of [[Plan.program]], in that order`,
    })
    .add({ behavior = `[[ReviewRequest.hashes]] and [[ReviewRequest.carried]] are empty` })
    .add({
      behavior = [
        `[[ReviewRequest.instructions]] says, in this order:`,
        `A heading naming the global review and the targets`,
        `For each of [[Program.criteria]] then [[Program.tests]] of [[Plan.program]]: its id and place, then its text, [[LoweredCriterion.text]] for a criterion, then each [[Marker]] in [[sourceMaps]] whose [[Marker.requirement]] is its id, on one line as the output path, a colon, [[Marker.outputLine]], a dash, and [[Marker.end]]`,
        `The verifier protocol`,
      ],
    })
    .add({ behavior = `[[ReviewRequest.instructions]] holds no line of any output` })
    .add({
      situation = `No marker in any output names a global criterion's or test's id`,
      behavior = `It is listed in [[ReviewRequest.instructions]] with a line saying no unit answered for it`,
    });

  @test(
    {
      input = [
        Plan@like(
          `A program with one global criterion g, whose id two outputs, src/a.rs and src/b.rs, name in a marker`,
        ),
        [SourceMap@like(`For src/a.rs and src/b.rs, each with one marker naming global and the id of g`)],
      ],
      expect = ReviewRequest@like(
        `No unit; g once with its id, then the locations of two regions, one per output, with none of their lines, then the protocol; asked holds the id of g`,
      ),
    },
    {
      input = [Plan@like(`A program with one global criterion g that no marker names`), []],
      expect = ReviewRequest@like(`No unit; g once with a line saying no unit answered for it`),
    },
  );
}

/// report: everything the verifier wrote to standard output
/// program: the lowered program, whose criteria and tests the ids name
/// asked: the ids of the criteria and tests the review request gave the verifier; empty when not known
/// recorded: the reviews the verifier submitted through the agent server during the run, in the order recorded; empty when none
// Decision: a review line names its criterion by place as well as by id, because a 64-digit id is
// easy to copy wrong and a place is not; a line that names nothing yet says violated is kept apart,
// so a found failure is never lost for want of a name.
// Decision: a verdict submitted through the agent server was checked when it arrived, so it wins
// over a line of the report for the same criterion; the report is read only for what was not
// submitted.
fn reviewOf(report: string, program: Program, asked: string[] = [], recorded: Review[] = []): `What a verifier found, read mechanically from the verdicts it submitted and from its report` => ReviewReport {
  // Decision: the report is read leniently and only what tries to be a review can be wrong, because
  // a verifier that adds a sentence or a fence around its lines has still reviewed everything, and
  // running a second verifier for that costs as much as the first.
  @acceptanceCriteria
    .add({
      behavior = `Whitespace around a line of [[report]] is ignored wherever the line is compared or parsed`,
    })
    .add({
      situation = `A line of [[report]] reads ELFIE: REVIEWED, and no later line does`,
      behavior = `Every line after it is ignored`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It does not begin with {`,
      ],
      behavior = `It is ignored, whatever it says`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is one of [[ReviewStatus]]`,
        `Its id is the id of a criterion or test of [[program]]`,
      ],
      behavior = `It is read as one [[Review]] for that criterion or test`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is one of [[ReviewStatus]]`,
        `Its id is the id of no criterion or test of [[program]]`,
        `Exactly one id of a criterion or test of [[program]] begins with its id, or is the beginning of it, and the two share at least the receiver, the contributor, and 16 hex digits`,
      ],
      behavior = `It is read as one [[Review]] for that criterion or test`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is one of [[ReviewStatus]]`,
        `It has no id, or its id is the id of no criterion or test of [[program]] and no single id of one begins with it or is the beginning of it, sharing at least the receiver, the contributor, and 16 hex digits`,
        `Its file and line are the file and line where exactly one criterion or test of [[program]] begins`,
      ],
      behavior = `It is read as one [[Review]] for that criterion or test`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] does not read it as an object`,
      ],
      behavior = `It is in [[ReviewReport.problems]] as written`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is none of [[ReviewStatus]]`,
      ],
      behavior = `It is in [[ReviewReport.problems]] as written`,
    })
    .add({
      situation = [
        `A line of [[report]] is followed by a line reading ELFIE: REVIEWED, or no line of [[report]] reads ELFIE: REVIEWED`,
        `It begins with {`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is one of [[ReviewStatus]]`,
        `It has no id, or its id is the id of no criterion or test of [[program]] and no single id of one begins with it or is the beginning of it, sharing at least the receiver, the contributor, and 16 hex digits`,
        `It has no file and line, or they are not where exactly one criterion or test of [[program]] begins`,
      ],
      behavior = `It is in [[ReviewReport.problems]] as written`,
    })
    .add({
      situation = [
        `A line of [[report]] is in [[ReviewReport.problems]] as written`,
        `[[Json.parse]] reads it as an object whose status, compared without regard to case, is violated`,
      ],
      behavior = `It is in [[ReviewReport.unplaced]] as written, in report order`,
    })
    .add({
      behavior = `[[ReviewReport.reviews]] holds every review of [[recorded]], in the order of [[recorded]], then every [[Review]] read from [[report]] whose id no review of [[recorded]] has`,
    })
    .add({
      situation = `A line of [[report]] is read as a [[Review]] whose id a review of [[recorded]] has`,
      behavior = `The line is neither in [[ReviewReport.reviews]] nor in [[ReviewReport.problems]]`,
    })
    .add({
      behavior = `[[ReviewReport.missing]] holds each of [[asked]] that is the id of no review in [[ReviewReport.reviews]], in the order of [[asked]]`,
    })
    .add({
      behavior = `The reviews read from [[report]] that are kept, and the lines of [[ReviewReport.problems]], are each in report order among themselves`,
    })
    .add({ behavior = `A [[Review]] takes its evidence and note as the line gives them, or empty when missing` })
    .add({ behavior = `Keys of a review line other than id, file, line, status, evidence, and note are ignored` })
    .add({
      situation = `Two lines of [[report]] that are each read as a [[Review]] name the same criterion or test`,
      behavior = `Only the last is kept in [[ReviewReport.reviews]], at its own place`,
    })
    .add({
      situation = `No line of [[report]] reads ELFIE: REVIEWED`,
      behavior = `[[ReviewReport.problems]] ends with a line reading: the report did not end`,
    });

  @test(
    {
      input = [
        `# reading src/a.rs\n{"id":"A:A:1f2e","status":"satisfied","evidence":"src/a.rs:1-30","note":"the field is there"}\n{"id":"A:A:9c0d","status":"violated","evidence":"src/a.rs:12-18","note":"returns undefined instead of an empty list"}\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
      ],
      expect = ReviewReport@like(
        `Two reviews, satisfied then violated, placed at def/a.lfy:4 and def/a.lfy:7 for A, and no problems`,
      ),
    },
    {
      input = [
        `{"id":"A:A:1f2e","status":"maybe","evidence":"","note":"unsure"}\nI think it is fine.\n{"id":"A:A:9c0d","status":"unverifiable","evidence":"","note":"no region"}\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
      ],
      expect = ReviewReport@like(`One review, unverifiable at line 7, and one problem: the line whose status is maybe`),
    },
    {
      input = [
        `All tests pass. Report follows.\n\`\`\`\n{"file":"def/a.lfy","line":4,"entity":"A","status":"Satisfied","evidence":"src/a.rs:1-9","note":"ok"}\n\`\`\`\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
      ],
      expect = ReviewReport@like(`One review, satisfied, placed at def/a.lfy:4 for A, and no problems`),
    },
    {
      input = [
        `{"id":"A:A:1f2e","status":"satisfied","evidence":"","note":"first"}\n{"id":"A:A:1f2e","status":"violated","evidence":"src/a.rs:3-3","note":"second"}`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
      ],
      expect = ReviewReport@like(
        `One review, violated with note second, and one problem reading: the report did not end`,
      ),
    },
    {
      input = [
        `{"id":"A:A:9c0e","file":"def/a.lfy","line":7,"status":"violated","evidence":"src/a.rs:12-18","note":"returns undefined"}\n{"id":"A:A:77aa","status":"violated","evidence":"src/a.rs:3-3","note":"no such id"}\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
        [`A:A:1f2e`, `A:A:9c0d`],
      ],
      expect = ReviewReport@like(
        `One review, violated at def/a.lfy:7 for the criterion A:A:9c0d; the A:A:77aa line in both problems and unplaced; A:A:1f2e missing`,
      ),
    },
    {
      input = [
        `{"id":"A:A:1f2e","status":"satisfied","evidence":"","note":"from the report"}\nELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
        [`A:A:1f2e`, `A:A:9c0d`],
        [Review@like(`A:A:1f2e, violated, at def/a.lfy:4 for A, with note submitted`)],
      ],
      expect = ReviewReport@like(
        `One review, the submitted violated one for A:A:1f2e; no problems; A:A:9c0d missing`,
      ),
    },
    {
      input = [
        `ELFIE: REVIEWED`,
        Program@like(
          `A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`,
        ),
        [`A:A:1f2e`, `A:A:9c0d`],
        [
          Review@like(`A:A:9c0d, satisfied, at def/a.lfy:7 for A`),
          Review@like(`A:A:1f2e, unverifiable, at def/a.lfy:4 for A`),
        ],
      ],
      expect = ReviewReport@like(
        `The two submitted reviews in that order, A:A:9c0d then A:A:1f2e; no problems; nothing missing`,
      ),
    },
  );
}
