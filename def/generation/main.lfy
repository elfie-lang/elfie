use "../grammar/rules/statement";
use "../interpret/data";
use "../interpret/main" as Interpreter;
use "../lexer/data";
use "../model/data";
use "../model/main" as Binder;
use "../workspace/data";
use "../workspace/main" as Loader;
use "./data";
use "elfie/prelude/builtin";
use "elfie/system/file" as Files;
use "elfie/system/json" as Json;
use "elfie/system/path";
use "elfie/system/time" as Time;
use "elfie/target/language";
use "elfie/target/layout";
use "elfie/target/target";

// Decision: a unit is one source file for one target. Outputs and source maps are per file, a
// declaration's scope is its file, and a smaller unit would make the compiler merge into a file it
// does not own, which is itself an act of generation. A larger unit would not fit a request, but
// several units can share one: that is a batch.

fn interfaceOf(workspace: Workspace, unit: Unit): `What dependents of a unit may rely on, as one text whose hash tells whether it changed` => string {
  @acceptanceCriteria
    .add({
      behavior = `One line per entity of [[Unit.entities]] in file order: its identifier, its kind, its definition, and its type, each as [[Binder.criteriaOf]] would spell them`,
    })
    .add({
      situation = `An entity of [[Unit.entities]] is a fn`,
      behavior = `Its line also gives its parameters with their types and its output, after its type, each as [[Binder.criteriaOf]] would spell them`,
    })
    .add({
      situation = `An entity of [[Unit.entities]] is a data, type, trait, or enum`,
      behavior = `After the line giving its identifier, kind, definition, and type, one line per member or enum member it declares, in order: the member's name, definition, and type, since a dependent relies on those as much as on the declaration itself`,
    })
    .add({
      behavior = `Wherever the text spells a type, it spells an entity of the elfie package by its identifier alone, such as List or [[Path]], never by a path or a module name`,
    })
    .add({
      situation = `A change to the unit's file leaves every line the same, such as a new criterion or a moved line`,
      behavior = `The text is the same as before the change, so dependents are not regenerated for it`,
    });
}

/// violated: the stems of units whose outputs answer for a global criterion or test the last global review found violated
fn plan(workspace: Workspace, sourceMaps: SourceMap[], requested: string[] = [], violated: string[] = []): `Every unit of a workspace, which need generating, and how they are batched` => Plan {
  // Selection
  @acceptanceCriteria
    .add({
      behavior = `[[Plan.program]] is [[Interpreter.lower]] of [[workspace]], and [[Unit.lowered]] is its [[LoweredFile]] for the unit's file`,
    })
    .add({
      situation = `An entity has no lowered node, such as a trait or an ace function`,
      behavior = `It is never among [[Unit.entities]], so no output has to carry a marker for it`,
    })
    .add({
      situation = `An entity is among [[Binder.entitiesOf]] the [[Target.marker]] of a [[Target]]`,
      behavior = `The entity is built for that [[Target]]`,
    })
    .add({
      situation = `The anonymous entity of a file is among [[Binder.entitiesOf]] the [[Target.marker]] of a [[Target]]`,
      behavior = `Every entity declared in the file scope of that file is built for that [[Target]]`,
    })
    .add({
      situation = `global is among [[Binder.entitiesOf]] the [[Target.marker]] of a [[Target]]`,
      behavior = `Every entity declared in the file scope of any file is built for that [[Target]]`,
    })
    .add({
      situation = `Neither an entity, nor the anonymous entity of its file, nor global is among [[Binder.entitiesOf]] the [[Target.marker]] of a [[Target]]`,
      behavior = `The entity is not built for that [[Target]]`,
    })
    .add({
      situation = `A file has no [[File.package]] and at least one entity with a lowered node built for a target, that is among [[Binder.entitiesOf]] the [[Target.marker]] itself or through the anonymous entity of its file or global`,
      behavior = `The file gives one [[Unit]] for that target holding those entities in file order`,
    })
    .add({
      situation = `A file has a [[File.package]]`,
      behavior = `It gives no unit; a package is compiled by its own project`,
    })
    .add({
      situation = `A file's [[File.package]] is the elfie package, the standard library`,
      behavior = `It gives no unit even when [[Target.marker]] is applied to global, and none of its entities is ever in [[Unit.entities]]; a unit's [[Interface]] and [[Request.interfaces]] may still name its entities as types`,
    })
    .add({
      behavior = `[[Unit.stem]] is [[Path.relative]] of [[File.path]] to [[Workspace.sourceDirectory]], without the .lfy extension`,
    });

  // Dependencies
  @acceptanceCriteria
    .add({
      situation = `A path in [[Source.uses]] of the unit's file names a file that has a unit for the same target`,
      behavior = `[[Unit.dependencies]] holds the unit of that file for the same target`,
    })
    .add({
      situation = `A path in [[Source.uses]] of the unit's file names a file that has no unit for the same target`,
      behavior = `[[Unit.dependencies]] holds, in its place, the units the used file's own uses contribute, transitively`,
    })
    .add({ behavior = `Each unit appears once among dependencies` })
    .add({
      situation = `There is a cycle among uses`,
      behavior = `The cycle adds nothing beyond the [[Problem]] the workspace already holds`,
    })
    .add({
      behavior = `[[Plan.units]] holds every unit of every target, each after its dependencies, otherwise in [[Workspace.targets]] then [[Workspace.files]] order`,
    });

  // Staleness
  @acceptanceCriteria
    .add({
      behavior = `[[Unit.outputs]] is every [[SourceMap]] in [[sourceMaps]] whose target and source are the unit's; the caller drops maps whose output no longer exists before calling`,
    })
    .add({
      situation = `[[File.path]] or [[Unit.stem]] is in [[requested]]`,
      behavior = `[[Unit.reason]] is requested`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is in [[violated]]`,
      ],
      behavior = `[[Unit.reason]] is violated`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is empty`,
      ],
      behavior = `[[Unit.reason]] is fresh`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[LoweredFile.text]] differs from [[SourceMap.hash]] of any output`,
      ],
      behavior = `[[Unit.reason]] is changed`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[LoweredFile.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids differs from [[SourceMap.requirements]] of any output`,
      ],
      behavior = `[[Unit.reason]] is requirements`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[LoweredFile.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids equals [[SourceMap.requirements]] of every output`,
        `The hash of [[interfaceOf]] some dependency differs from what [[SourceMap.dependencies]] of the unit's outputs record for it, or they record nothing for it`,
      ],
      behavior = `[[Unit.reason]] is dependency`,
    })
    .add({
      situation = [
        `Neither [[File.path]] nor [[Unit.stem]] is in [[requested]]`,
        `[[Unit.stem]] is not in [[violated]]`,
        `[[Unit.outputs]] is not empty`,
        `The SHA-256 of [[LoweredFile.text]] equals [[SourceMap.hash]] of every output`,
        `The SHA-256 of its local criterion and test ids equals [[SourceMap.requirements]] of every output`,
        `For every dependency, [[SourceMap.dependencies]] of the unit's outputs record a hash for it and it equals the hash of [[interfaceOf]] that dependency`,
      ],
      behavior = `[[Unit.reason]] is undefined`,
    })
    .add({
      situation = `Only [[Program.criteria]] or [[Program.tests]] differ from what the outputs were generated against`,
      behavior = `No unit is planned for the difference; the global review is run instead`,
    })
    .add({
      situation = [
        `Only [[Program.criteria]] or [[Program.tests]] differ from what the outputs were generated against`,
        `The global review finds a global criterion or test a unit's output answers for violated`,
      ],
      behavior = `That unit is planned again`,
    })
    .add({
      situation = [
        `Only [[Program.criteria]] or [[Program.tests]] differ from what the outputs were generated against`,
        `The global review finds no global criterion or test a unit's output answers for violated`,
      ],
      behavior = `No unit is planned again`,
    })
    .add({
      situation = `A dependency is planned only because of its own dependencies, and its interface is unchanged`,
      behavior = `It plans nothing beyond itself, so an edit inside one function body regenerates one unit`,
    });

  // Batching
  // Decision: batches follow the plan order and the directory a unit sits in, because units of one
  // directory share a crate module and most of their interfaces, so the shared context is sent once.
  @acceptanceCriteria
    .add({ behavior = `[[Plan.batches]] partitions the planned units in [[Plan.units]] order` })
    .add({
      situation = `A planned unit and the open batch share the first segment of [[Unit.stem]], the batch holds fewer than 6 units, and the sources of the batch and the unit together are under 60,000 characters`,
      behavior = `The unit joins the open batch`,
    })
    .add({
      situation = `There is no open batch, or a planned unit and the open batch do not share the first segment of [[Unit.stem]], or the batch holds 6 units or more, or the sources of the batch and the unit together are 60,000 characters or more`,
      behavior = `The unit opens a new batch`,
    })
    .add({
      situation = `A planned unit's reason is dependency and its only planned dependencies are in the open batch`,
      behavior = `The unit joins that batch even across directories, since it is compiled against what the batch produces`,
    })
    .add({ behavior = `Every batch comes after the batches holding the dependencies of its units` })
    .add({
      situation = `A batch holds one unit`,
      behavior = `[[Batch.identifier]] is the unit's stem`,
    })
    .add({
      situation = `A batch holds more than one unit`,
      behavior = `[[Batch.identifier]] is the first unit's stem, then a plus sign and the count of the others`,
    })
    .add({ situation = `Nothing is planned`, behavior = `[[Plan.batches]] is empty` });

  @test(
    {
      input = [
        Workspace@like(`One target rust whose marker global carries; def holds a.lfy using ./b and b.lfy`),
        [],
        [],
      ],
      expect = Plan@like(`Two units, b before a, a depending on b, both with reason fresh, in one batch named b+1`),
    },
    {
      input = [
        Workspace@like(`The same project`),
        [
          SourceMap@like(
            `For a and for b, hashes matching the files, interface hashes matching, generated at the same time`,
          ),
        ],
        [],
      ],
      expect = Plan@like(`Two units, neither with a reason, and no batches`),
    },
    {
      input = [
        Workspace@like(`The same project with a comment added inside b.lfy`),
        [SourceMap@like(`For a and for b, hashes of the old files, interface hashes matching the current interfaces`)],
        [],
      ],
      expect = Plan@like(`b with reason changed and a without a reason, because b's interface is the same`),
    },
    {
      input = [
        Workspace@like(`The same project with a member added to a data of b.lfy`),
        [SourceMap@like(`For a and for b, hashes and interface hashes of the old files`)],
        [],
      ],
      expect = Plan@like(`b with reason changed and a with reason dependency, in one batch`),
    },
    {
      input = [Workspace@like(`A project whose only target's marker nothing carries`), [], []],
      expect = Plan@like(`No units`),
    },
  );
}

fn request(plan: Plan, batch: Batch, existing: Output[], previous: object = {}): `Everything the compiler is handed to produce the outputs of one batch` => Request {
  @acceptanceCriteria
    .add({
      behavior = `[[Request.batch]] is [[batch]]; [[Request.sources]] maps each unit's [[File.path]] to [[LoweredFile.text]] of [[Unit.lowered]]; [[Request.requirements]] maps it to every [[LoweredNode.criteria]], [[LoweredNode.tests]], [[LoweredFile.criteria]], and [[LoweredFile.tests]] of the file; [[Request.globals]] is [[Program.criteria]] then [[Program.tests]] of [[Plan.program]]; [[Request.previous]] is [[previous]]`,
    })
    .add({
      behavior = `[[Request.existing]] maps the path of each of [[existing]] whose path is among the [[Unit.outputs]] of a unit of the batch to its text`,
    })
    .add({
      behavior = `[[Request.interfaces]] holds one [[Interface]] per dependency of any unit of the batch that is not itself in the batch, each once, in dependency order`,
    })
    .add({
      behavior = `[[Request.guidance]] is [[Binder.criteriaOf]] the [[Target.marker]], then of every trait it extends, transitively and nearest first, so a marker extending [[targetLanguage]] gives its own criteria, then those of [[targetLanguage]], then those of [[target]]`,
    })
    .add({
      situation = `A trait is reached twice among the traits the [[Target.marker]] extends`,
      behavior = `It contributes to [[Request.guidance]] once, at its first place`,
    })
    .add({
      behavior = `[[Request.guidance]] holds the criteria of every trait applied to the marker with arguments, such as [[cratePerPrefix]] and [[modulePerFile]], in extends order after the marker's own, with each of their template values evaluated from those arguments; every template value of the guidance is evaluated for the marker's application`,
    })
    .add({
      behavior = `[[Request.nativeDependencies]] is [[Workspace.nativeDependencies]] followed by [[Package.nativeDependencies]] of [[Target.package]]`,
    });

  // Decision: the instructions quote every criterion and test already resolved, so a compiler with no
  // access to the model can still work; the agent server is offered for what the request leaves out.
  @acceptanceCriteria
    .add({
      behavior = [
        `[[Request.instructions]] says, in this order:`,
        `That the reader is the compiler for the target, that its whole job is the outputs for the units of this batch, listed by stem, and that it writes nothing outside them`,
        `Where the outputs go: under [[Target.outputDirectory]], spelled from each [[Unit.stem]] as the guidance says`,
        `The guidance, then the native dependencies it may require, then each interface: the dependency's output paths and the identifier, kind, definition, and type of each of its entities, to be used by the names its outputs spell and never edited`,
        `Then, for each unit of the batch in order, a section holding, for each of its entities, the entity's lowered code and then, apart from the code, its local criteria and tests, each on its own line with its id`,
        `Then one section of the global criteria and tests, each once with its id and marked global, saying that they hold across the whole program, that a unit answers for one only where it is relevant to that unit's code and ignores it otherwise, and that the global review checks each once`,
        `That criteria and tests are never restated in an output as comments or documentation; an output names one only by its id in a [[Marker]]`,
        `That the data and fns of the standard library carrying [[builtin]] are bound to what the guidance names for them and never generated, and that a member of the library written out in full is translated where it is used`,
        `The rules for kinds: a [[DataDeclaration]] becomes a type; an [[AgentFunctionDeclaration]] becomes a function whose body satisfies every criterion and test; a [[FunctionDeclaration]] is translated statement by statement with nothing added; a [[TraitDeclaration]] emits nothing of its own, its members and criteria belong to each entity that carries it; a [[TypeDeclaration]] and [[EnumDeclaration]] become their nearest equivalents; an [[ExternalDeclaration]] is bound to what the guidance says; a folded value is written as the literal it holds and a [[Prompted]] value is chosen to fit its prompt; a [[Use]] is satisfied by the interfaces`,
        `That every emitted item and every test carries a [[Marker]] naming the entity it comes from, spelled as [[Marker]] says, and never a line number`,
        `That each [[LoweredTest]] becomes one test, and each [[LoweredCriterion]] that can be checked mechanically becomes one test, each carrying a [[Marker]] with its id, placed where the guidance says`,
        `That the tools of the agent server may be called for anything the request leaves out`,
        `How to end its report: with one line reading ELFIE: DONE when every output is written; ELFIE: BLOCKED: followed by the reason when an ambiguous criterion, two criteria in conflict, a name that resolves nowhere, or anything else stops it, in which case it writes no output for the unit and quotes the criterion; or ELFIE: CLARIFY: followed by one question when only a person can decide, in which case it writes nothing`,
      ],
    })
    .add({
      situation = `A unit of [[batch]] has outputs in [[Unit.outputs]]`,
      behavior = `[[Request.instructions]], where it says where the outputs go, says that the outputs of that unit go at the paths in its [[Unit.outputs]]`,
    })
    .add({
      situation = `A unit of [[batch]] has the reason requirements`,
      behavior = `[[Request.instructions]] says, right after the item saying that each [[LoweredTest]] becomes one test, that the code of that unit is unchanged and only the tests and code answering for the criteria and tests whose ids were added or removed need to change`,
    })
    .add({
      situation = `[[Request.existing]] is not empty`,
      behavior = `[[Request.instructions]] says, right before the item saying that the tools of the agent server may be called, that only what the difference between [[Request.previous]] and [[Request.sources]] requires changes, that names and structure are kept, and that markers of unchanged items are kept; where [[Request.previous]] has no entry, that the existing output is reconciled with the source`,
    });

  @test(
    {
      input = [Plan@like(`One batch of two units, b before a`), Batch@like(`b+1`), [], {}],
      expect = Request@like(
        `Instructions naming the target, listing b and a, quoting each one's entities with their criteria, no interfaces, no existing outputs, and the three report lines`,
      ),
    },
    {
      input = [
        Plan@like(
          `One batch of one unit, for a target whose marker is a trait rust extending [[targetLanguage]], with two criteria of its own and a template value in one of them`,
        ),
        Batch@like(`the batch`),
        [],
        {},
      ],
      expect = Request@like(
        `Guidance holding rust's two criteria first, with the template value evaluated for rust, then every criterion of [[targetLanguage]], then every criterion of [[target]], and nothing twice`,
      ),
    },
  );
}

fn outcomeOf(report: string, verdicts: Verdict[]): `How one run of the compiler ended, read from its report and the verdicts of its units` => Outcome {
  @acceptanceCriteria
    .add({
      situation = `The last line of [[report]] that begins with ELFIE: reads ELFIE: BLOCKED:`,
      behavior = `The kind is blocked and the message is the rest of that line and every line after it`,
    })
    .add({
      situation = `The last line of [[report]] that begins with ELFIE: reads ELFIE: CLARIFY:`,
      behavior = `The kind is clarification and the message is the rest of that line and every line after it`,
    })
    .add({
      situation = `[[verdicts]] is empty and no line of [[report]] begins with ELFIE:`,
      behavior = `The kind is failed and the message says the compiler reported nothing`,
    })
    .add({
      situation = `Some verdict of [[verdicts]] is rejected, and the last line of [[report]] that begins with ELFIE:, if there is one, reads neither ELFIE: BLOCKED: nor ELFIE: CLARIFY:`,
      behavior = `The kind is rejected and the message is the first problem of the first rejected verdict`,
    })
    .add({
      situation = `No verdict of [[verdicts]] is rejected, [[verdicts]] is not empty or some line of [[report]] begins with ELFIE:, and the last line of [[report]] that begins with ELFIE:, if there is one, reads neither ELFIE: BLOCKED: nor ELFIE: CLARIFY:`,
      behavior = `The kind is accepted and the message is empty`,
    })
    .add({ behavior = `[[Outcome.verdicts]] is [[verdicts]]` });

  @test(
    {
      input = [`I wrote it.\nELFIE: DONE`, [Verdict@like(`accepted`)]],
      expect = Outcome@like(`accepted, empty message`),
    },
    {
      input = [`ELFIE: CLARIFY: should Range.end be inclusive?`, []],
      expect = Outcome@like(`clarification with the question`),
    },
    {
      input = [`ELFIE: BLOCKED: \[[tokenAt\]] contradicts \[[nodesAt\]] on empty files`, []],
      expect = Outcome@like(`blocked with the reason`),
    },
    { input = [``, []], expect = Outcome@like(`failed`) },
  );
}

fn accept(request: Request, unit: Unit, outputs: Output[]): `Whether outputs satisfy a request for one unit structurally, the source maps they earn, and the outputs with their markers normalized` => Verdict {
  // Markers
  @acceptanceCriteria
    .add({ situation = `[[outputs]] is empty`, behavior = `Rejected with a problem saying so` })
    .add({
      situation = `An output's path does not [[Path.startsWith]] [[Target.outputDirectory]] of the unit's target`,
      behavior = `Rejected with a problem naming the path`,
    })
    .add({
      situation = `A marker names an entity`,
      behavior = `Its line is derived as the first line of the declaring node of the entity with that name in that file, and the marker is left as written`,
    })
    .add({
      situation = `A marker names a file of the program and an entity that file does not declare`,
      behavior = `Rejected with a problem naming the output line and the name`,
    })
    .add({
      situation = `A marker names a line of the unit's file that falls inside an entity's declaration`,
      behavior = `The marker is rewritten in [[Verdict.outputs]] to name that entity, since a name survives edits and a line does not`,
    })
    .add({
      situation = `An output holds a [[Marker]] naming a line of the unit's [[File.path]] beyond its last`,
      behavior = `Rejected with a problem naming the output line`,
    })
    .add({
      situation = `A marker names a requirement id that is neither a local criterion or test of the unit nor one of [[Request.globals]]`,
      behavior = `Rejected with a problem naming the output line and the id`,
    })
    .add({
      behavior = `An output may hold markers for other files of the program, because one output often mirrors several`,
    })
    .add({
      situation = `An output holds a [[Marker]] naming a file that is not in the program`,
      behavior = `The marker is ignored and not recorded; it is a fixture or prose, not a claim about the program`,
    })
    .add({
      situation = `An entity of the unit has no marker in any output naming it or a line its declaring node covers`,
      behavior = `Rejected with a problem naming the entity`,
    });

  // Source maps, mechanically
  @acceptanceCriteria
    .add({
      situation = `[[outputs]] is not empty, every output's path [[Path.startsWith]] [[Target.outputDirectory]] of the unit's target, every entity a marker names in a file of the program is declared by that file, no marker names a line of the unit's [[File.path]] beyond its last, every requirement id a marker names is a local criterion or test of the unit or one of [[Request.globals]], and every entity of the unit has a marker in some output naming it or a line its declaring node covers`,
      behavior = `Accepted, with one [[SourceMap]] per output holding the SHA-256 of [[LoweredFile.text]] of the unit, the SHA-256 of its local criterion and test ids as [[SourceMap.requirements]] says, the SHA-256 of [[interfaceOf]] the unit, the interface hash of each dependency as computed now, [[Time.Instant.rfc3339]] of [[Time.now]] as [[SourceMap.generated]], and every marker in output order with its derived line; nothing in a source map comes from the compiler's text except the names it spelled`,
    })
    .add({
      situation = `A marker is followed by another marker in the same output`,
      behavior = `[[Marker.end]] of the marker is derived as the line before [[Marker.outputLine]] of the next marker in the same output`,
    })
    .add({
      situation = `A marker is the last marker of its output`,
      behavior = `[[Marker.end]] of the marker is derived as the last line of the output`,
    })
    .add({
      behavior = `The regions from [[Marker.outputLine]] through [[Marker.end]] of the markers of an output partition it from its first marker on`,
    })
    .add({
      behavior = `Whether an output builds or its tests pass is not checked here; the guidance says how, and the caller runs it`,
    });

  @test(
    {
      input = [
        Request@like(`For a batch holding a unit with entities A and B in a.lfy`),
        Unit@like(`that unit`),
        [Output@like(`One file under the output directory with a marker a.lfy:A and one a.lfy:B`)],
      ],
      expect = Verdict@like(
        `Accepted, one source map with two markers whose lines are those of A and B, the first ending on the line before the second and the second on the last line of the output, the output unchanged`,
      ),
    },
    {
      input = [
        Request@like(`For a batch holding a unit with entities A and B in a.lfy`),
        Unit@like(`that unit`),
        [Output@like(`One file with a marker naming the line of A only`)],
      ],
      expect = Verdict@like(`Rejected, one problem naming B`),
    },
    {
      input = [
        Request@like(`For a batch holding a unit with entity A on line 3 of a.lfy`),
        Unit@like(`that unit`),
        [Output@like(`One file with a marker a.lfy:3`)],
      ],
      expect = Verdict@like(`Accepted, and the output in [[Verdict.outputs]] reads a.lfy:A instead`),
    },
  );
}

// Mapped output access

/// name: an identifier, or an owner's identifier, a dot, and a member's name
/// target: the identifier of one target; every target when left out
fn regionsOf(workspace: Workspace, sourceMaps: SourceMap[], name: string, target?: string): `Every region of generated output that came from one entity` => Marker[] {
  @acceptanceCriteria
    .add({
      behavior = `Returns every [[Marker]] of every [[SourceMap]] in [[sourceMaps]] whose [[Marker.entity]] is [[name]], source map by source map in [[sourceMaps]] order and within one in [[SourceMap.markers]] order, which is output order`,
    })
    .add({
      situation = `The [[Marker.entity]] of a marker of a [[SourceMap]] in [[sourceMaps]] is [[name]], a dot, and a member's name`,
      behavior = `The marker is returned too, source map by source map in [[sourceMaps]] order and within one in [[SourceMap.markers]] order, since a member's region is part of its owner's code`,
    })
    .add({
      situation = `A marker of a [[SourceMap]] in [[sourceMaps]] names a line rather than an entity, [[Marker.file]] declares the entity named [[name]] in [[workspace]], and [[Marker.line]] falls inside its declaring node`,
      behavior = `The marker is returned`,
    })
    .add({
      situation = `[[target]] is set`,
      behavior = `Only markers of source maps whose [[SourceMap.target]] is [[target]]`,
    })
    .add({
      situation = `No marker of [[sourceMaps]], within those whose [[SourceMap.target]] is [[target]] when it is set, names [[name]], a member of it, or a line inside the declaring node of the entity named [[name]]`,
      behavior = `Returns an empty list`,
    });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A with a member x and a fn f`),
        [
          SourceMap@like(
            `For output src/a.rs with markers a.lfy:A on line 3, a.lfy:A.x on line 9, and a.lfy:f on line 20`,
          ),
          SourceMap@like(`For output src/tests.rs with a marker a.lfy:f on line 1 and a.lfy:A on line 12`),
        ],
        `A`,
      ],
      expect = [
        Marker@like(`src/a.rs line 3 for A, ending on 8`),
        Marker@like(`src/a.rs line 9 for A.x, ending on 19`),
        Marker@like(`src/tests.rs line 12 for A, ending on the last line`),
      ],
    },
    {
      input = [Workspace@like(`The same project`), [SourceMap@like(`The same two source maps`)], `A.x`],
      expect = [Marker@like(`src/a.rs line 9 for A.x only`)],
    },
    { input = [Workspace@like(`The same project`), [SourceMap@like(`The same two source maps`)], `B`], expect = [] },
  );
}

// Decision: a change is found by binding the previous text through the loader and comparing entities,
// never by diffing lines, so a reformatted or reordered file whose entities read the same gives none.
/// previous: the text of the unit's file when its outputs were last accepted; undefined when they never were
fn changes(workspace: Workspace, unit: Unit, previous: string | undefined): `What differs for each entity of a unit between its file as last accepted and as it is now` => Change[] {
  @acceptanceCriteria
    .add({
      behavior = `The file as it was is bound as [[Loader.change]] of [[workspace]] with [[File.path]] of [[Unit.file]] and [[previous]], and its entities are compared with [[Unit.entities]] by name: the identifier, or the owner's identifier, a dot, and a member's name; a member is compared as an entity of its own, under its owner`,
    })
    .add({
      situation = `[[previous]] is undefined`,
      behavior = `One [[Change]] of kind [[ChangeKind.added]] per entity of the unit, in file order, and nothing else`,
    })
    .add({
      situation = `A name is declared now and was not before`,
      behavior = `One [[Change]] of kind [[ChangeKind.added]]`,
    })
    .add({
      situation = `A name was declared before and is not now`,
      behavior = `One [[Change]] of kind [[ChangeKind.removed]]`,
    })
    .add({
      situation = `A name is declared on both sides`,
      behavior = `One [[Change]] per kind that differs, in the order [[ChangeKind]] declares them`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `[[Entity.definition]] differs`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.definition]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The type of the entity, spelled as [[interfaceOf]] spells it, differs`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.declaredType]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The entity is a fn, and its parameters, their types, or its output, spelled as [[interfaceOf]] spells them, differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.signature]]`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local criteria differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.criteria]], whose detail names the ids added and removed`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local criteria differ`,
        `A removed and an added criterion id are at the same position`,
      ],
      behavior = `The detail of the [[ChangeKind.criteria]] change calls that pair reworded`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local tests differ`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.tests]], whose detail names the ids added and removed`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The ids of its local tests differ`,
        `A removed and an added test id are at the same position`,
      ],
      behavior = `The detail of the [[ChangeKind.tests]] change calls that pair reworded`,
    })
    .add({
      situation = [
        `A name is declared on both sides`,
        `The joined [[Token.raw]] of the tokens the declaring node covers differs once its definition, type, parameters, output, criteria, tests, whitespace, and comments are left out`,
      ],
      behavior = `One [[Change]] of kind [[ChangeKind.body]]`,
    })
    .add({
      behavior = `The changes are in file order: the changes of entities declared now follow the order of [[Unit.entities]]`,
    })
    .add({
      situation = `An entity was removed, and some entity that preceded it in the previous file is still declared`,
      behavior = `Its change is placed after the changes of the last entity that preceded it in the previous file and is still declared`,
    })
    .add({
      situation = `An entity was removed, and no entity that preceded it in the previous file is still declared`,
      behavior = `Its change is placed first`,
    })
    .add({
      situation = `The old and the new of what differs are each under 80 characters`,
      behavior = `[[Change.detail]] is one line saying what differs, quoting the old and the new`,
    })
    .add({
      situation = `The old or the new of what differs is 80 characters or more`,
      behavior = `[[Change.detail]] is one line saying what differs, naming the old and the new rather than quoting them, such as the count of criteria before and after or the name of the parameter that differs`,
    });

  @test(
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a data A and a fn f`),
        Unit@like(`The unit of a.lfy`),
        undefined,
      ],
      expect = [Change@like(`A added`), Change@like(`f added`)],
    },
    {
      input = [
        Workspace@like(
          `def holds a.lfy declaring a data A defined as a thing and a fn f taking x: string and y: number`,
        ),
        Unit@like(`The unit of a.lfy`),
        string@like(`a.lfy as it was: A defined as a value and f taking only x: string`),
      ],
      expect = [
        Change@like(`A, definition, detail quoting a value and a thing`),
        Change@like(`f, signature, detail naming the added parameter y`),
      ],
    },
    {
      input = [
        Workspace@like(`def holds a.lfy declaring a fn f with three criteria and a data B`),
        Unit@like(`The unit of a.lfy`),
        string@like(`a.lfy as it was: a data A, then f with two of those criteria, and B with one more member`),
      ],
      expect = [
        Change@like(`A removed`),
        Change@like(`f, criteria, detail reading 2 criteria before and 3 now`),
        Change@like(`B.old, removed`),
      ],
    },
  );
}

// Independent verification

// Decision: the verifier is handed the regions already excerpted, so it reads exactly what a criterion
// is about, and its protocol allows no edits: a review says where and why, never how to fix.
fn review(plan: Plan, batch: Batch, sourceMaps: SourceMap[]): `Everything a verifier is handed to check the outputs of one batch against every criterion and test` => ReviewRequest {
  @acceptanceCriteria
    .add({ behavior = `[[ReviewRequest.batch]] is [[batch]]` })
    .add({
      behavior = `Only local criteria and tests are reviewed here; a global one is reviewed once, by [[globalReview]]. A criterion's or test's place is the file of its origin relative to [[Workspace.root]], a colon, and the line its origin begins on`,
    })
    .add({
      behavior = [
        `[[ReviewRequest.instructions]] says, in this order:`,
        `A heading naming [[Batch.identifier]] and the target`,
        `For each unit of the batch in order, for each of [[Unit.entities]]: its identifier, or its owner's identifier, a dot, and its name, then its definition, then each of its local criteria on one line prefixed by its id and place, then each of its local tests as input and expectation on one line prefixed by its id and place`,
        `Then, for each of those entities, each [[Marker]] of [[regionsOf]] for its name in [[sourceMaps]] limited to the batch's target: the output path, a colon, [[Marker.outputLine]], a dash, [[Marker.end]], and then the region's text`,
        `The verifier protocol: that the reader examines and never edits, and never proposes code; that it writes one JSON object on one line per criterion and per test with exactly the keys id, status, evidence, and note, as [[Review]] says, where status is satisfied, violated, or unverifiable, evidence is the output path and line range it read or empty, and note is one line saying why and, for a violated one, what the code does instead; that a criterion no region can be checked against is unverifiable, not violated; that the tools of the agent server may be called for regions the request leaves out; and that the report ends with one line reading ELFIE: REVIEWED`,
      ],
    })
    .add({
      situation = [
        `A [[Marker]] of [[regionsOf]] for the name of an entity of a unit of [[batch]] in [[sourceMaps]], limited to the batch's target`,
        `Its output can be read`,
      ],
      behavior = `The region's text for that marker in [[ReviewRequest.instructions]] is the [[Files.read]] text of its lines of the output in a fenced block`,
    })
    .add({
      situation = [
        `A [[Marker]] of [[regionsOf]] for the name of an entity of a unit of [[batch]] in [[sourceMaps]], limited to the batch's target`,
        `Its output cannot be read`,
      ],
      behavior = `The region's text for that marker in [[ReviewRequest.instructions]] is a line saying the output cannot be read`,
    });

  @test(
    {
      input = [
        Plan@like(
          `One batch of one unit, a.lfy for target rust, whose entity A has two criteria on lines 4 and 7 and one test on line 10`,
        ),
        Batch@like(`a`),
        [SourceMap@like(`For rust and src/a.rs from a.lfy, with one marker a.lfy:A on line 1 ending on line 30`)],
      ],
      expect = ReviewRequest@like(
        `Instructions headed a and rust; A with its definition, two criterion lines prefixed def/a.lfy:4 and def/a.lfy:7, one test line prefixed def/a.lfy:10; one region src/a.rs:1-30 with the file's thirty lines in a fenced block; then the protocol naming the six keys and the three statuses and ending with ELFIE: REVIEWED`,
      ),
    },
    {
      input = [Plan@like(`The same plan`), Batch@like(`a`), []],
      expect = ReviewRequest@like(
        `The same instructions with no region for A, so the verifier can only find A's criteria unverifiable`,
      ),
    },
  );
}

fn globalReview(plan: Plan, sourceMaps: SourceMap[]): `Everything a verifier is handed to check every global criterion and test once, across every output of the program` => ReviewRequest {
  @acceptanceCriteria
    .add({ behavior = `[[ReviewRequest.batch]] is undefined` })
    .add({
      behavior = [
        `[[ReviewRequest.instructions]] says, in this order:`,
        `A heading naming the global review and the targets`,
        `For each of [[Program.criteria]] then [[Program.tests]] of [[Plan.program]]: its id and place, then its text, then each [[Marker]] in [[sourceMaps]] whose [[Marker.requirement]] is its id, as the output path, a colon, [[Marker.outputLine]], a dash, [[Marker.end]], and the [[Files.read]] text of those lines in a fenced block`,
        `The verifier protocol: that the reader examines and never edits, and never proposes code; that it writes one JSON object on one line per criterion and per test with exactly the keys id, status, evidence, and note, as [[Review]] says, where status is satisfied, violated, or unverifiable, evidence is the output path and line range it read or empty, and note is one line saying why and, for a violated one, what the code does instead; that a criterion no region can be checked against is unverifiable, not violated; that the tools of the agent server may be called for regions the request leaves out; and that the report ends with one line reading ELFIE: REVIEWED`,
      ],
    })
    .add({
      situation = `No marker in any output names a global criterion's or test's id`,
      behavior = `It is listed in [[ReviewRequest.instructions]] with a line saying no unit answered for it, so the verifier finds it unverifiable, never violated`,
    })
    .add({ behavior = `The caller runs it once after every batch of a compile` })
    .add({
      situation = `[[Program.criteria]] or [[Program.tests]] changed`,
      behavior = `The caller runs it`,
    })
    .add({
      situation = `A review from it is violated`,
      behavior = `The review gives the stems of the units whose markers answered for it, for the violated argument of [[plan]]`,
    });

  @test(
    {
      input = [
        Plan@like(`A program with one global criterion g, whose id two outputs, src/a.rs and src/b.rs, name in a marker`),
        [SourceMap@like(`For src/a.rs and src/b.rs, each with one marker naming global and the id of g`)],
      ],
      expect = ReviewRequest@like(`No batch; g once with its id, then two regions, one per output, then the protocol`),
    },
    {
      input = [Plan@like(`A program with one global criterion g that no marker names`), []],
      expect = ReviewRequest@like(`No batch; g once with a line saying no unit answered for it`),
    },
  );
}

/// report: everything the verifier wrote to standard output
/// program: the lowered program, whose criteria and tests the ids name
fn reviewOf(report: string, program: Program): `What a verifier found, read mechanically from its report` => ReviewReport {
  @acceptanceCriteria
    .add({
      behavior = `The end line is the last line of [[report]] reading ELFIE: REVIEWED, with any whitespace around it; lines after it are ignored`,
    })
    .add({
      situation = `Some line of [[report]] reads ELFIE: REVIEWED, with any whitespace around it`,
      behavior = `Each line of [[report]] before its last line reading ELFIE: REVIEWED, with any whitespace around it, that [[Json.parse]] reads as an object with exactly the keys id, status, evidence, and note, whose id names a criterion or test of [[program]] and whose status is one of [[ReviewStatus]], is one [[Review]] in [[ReviewReport.reviews]], in report order, with its file, line, and entity derived from that criterion's or test's origin`,
    })
    .add({
      situation = `No line of [[report]] reads ELFIE: REVIEWED, with any whitespace around it`,
      behavior = `Each line of [[report]] that [[Json.parse]] reads as an object with exactly the keys id, status, evidence, and note, whose id names a criterion or test of [[program]] and whose status is one of [[ReviewStatus]], is one [[Review]] in [[ReviewReport.reviews]], in report order, with its file, line, and entity derived from that criterion's or test's origin`,
    })
    .add({
      situation = `Two lines of [[report]] that are each read as a [[Review]] have the same id`,
      behavior = `Only the last is kept in [[ReviewReport.reviews]], at its own place`,
    })
    .add({
      situation = `Some line of [[report]] reads ELFIE: REVIEWED, with any whitespace around it`,
      behavior = `Every line of [[report]] before its last line reading ELFIE: REVIEWED, with any whitespace around it, that is not read as a [[Review]], is not blank, and does not begin with # is in [[ReviewReport.problems]] as written, in report order`,
    })
    .add({
      situation = `No line of [[report]] reads ELFIE: REVIEWED, with any whitespace around it`,
      behavior = `Every line of [[report]] that is not read as a [[Review]], is not blank, and does not begin with # is in [[ReviewReport.problems]] as written, in report order`,
    })
    .add({
      situation = `No line of [[report]] reads ELFIE: REVIEWED, with any whitespace around it`,
      behavior = `Reviews and problems are read from every line of [[report]], and [[ReviewReport.problems]] ends with a line reading: the report did not end`,
    });

  @test(
    {
      input = [
        `# reading src/a.rs\n{"id":"A:A:1f2e","status":"satisfied","evidence":"src/a.rs:1-30","note":"the field is there"}\n{"id":"A:A:9c0d","status":"violated","evidence":"src/a.rs:12-18","note":"returns undefined instead of an empty list"}\nELFIE: REVIEWED`,
        Program@like(`A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`),
      ],
      expect = ReviewReport@like(`Two reviews, satisfied then violated, placed at def/a.lfy:4 and def/a.lfy:7 for A, and no problems`),
    },
    {
      input = [
        `{"id":"A:A:1f2e","status":"maybe","evidence":"","note":"unsure"}\nI think it is fine.\n{"id":"A:A:9c0d","status":"unverifiable","evidence":"","note":"no region"}\nELFIE: REVIEWED`,
        Program@like(`A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`),
      ],
      expect = ReviewReport@like(
        `One review, unverifiable at line 7, and two problems: the line whose status is maybe, and the prose line`,
      ),
    },
    {
      input = [
        `{"id":"A:A:1f2e","status":"satisfied","evidence":"","note":"first"}\n{"id":"A:A:1f2e","status":"violated","evidence":"src/a.rs:3-3","note":"second"}`,
        Program@like(`A program whose def/a.lfy declares A with two local criteria, id A:A:1f2e on line 4 and id A:A:9c0d on line 7`),
      ],
      expect = ReviewReport@like(
        `One review, violated with note second, and one problem reading: the report did not end`,
      ),
    },
  );
}
