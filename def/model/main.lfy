use "../grammar/rules/expression";
use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../grammar/terminals/keyword";
use "../grammar/terminals/punctuation";
use "../grammar/traits";
use "../parser/data";
use "./data";
use "../interpret/main" as Interpreter;
use "elfie/prelude/entity" as Prelude;
use "elfie/prelude/fn" as Functions;
use "elfie/prelude/kinds" as Kinds;
use "elfie/prelude/trait" as Traits;
use "elfie/values/list" as Lists;
use "elfie/values/number" as Numbers;
use "elfie/values/object" as Objects;
use "elfie/values/string" as Strings;
use "elfie/values/template" as Templates;

ace const memberRead: `The situation every rule for reading a member begins with` = `A [[Member]] is bound, or a [[Current]] is bound with the scope's current entity as the left side`;

ace const kindData: `The prelude data each kind of entity is seen as, besides [[Prelude.Entity]]` = [
  { kind = `a trait`, data = Traits.Trait },
  { kind = `a fn or function`, data = Functions.Function },
  { kind = `a data`, data = Kinds.Data },
  { kind = `a type`, data = Kinds.Type },
  { kind = `an enum`, data = Kinds.Enum },
  { kind = `a member`, data = Kinds.Member },
  { kind = `a parameter or a type parameter`, data = Kinds.Parameter },
  { kind = `a variable`, data = Kinds.Variable },
  { kind = `a module`, data = Kinds.Module },
];

ace const baseData: `The prelude data each kind of value has as its base` = [
  { kind = `a string`, data = Strings.String },
  { kind = `a number`, data = Numbers.Number },
  { kind = `a boolean`, data = Numbers.Boolean },
  { kind = `an object`, data = Objects.Object },
  { kind = `any list`, data = Lists.List },
  { kind = `a template`, data = Templates.Template },
  { kind = `a function value`, data = Functions.Function },
];

fn bind(sources: Source[]): `Build the model of a program from the resolved files of all of it` => Model {
  // Passes
  @acceptanceCriteria
    .add({
      behavior = `Binding is three passes, each over every file before the next begins: declare (scopes, symbols, entities), expand (traits, members, criteria, and every other compile-time statement), and resolve (usages, properties, templates)`,
    })
    .add({ behavior = `[[sources]] are bound in the order given, which places every file after the files it uses` })
    .add({ behavior = `Binding never stops: every failure it meets is a [[Problem]]` })
    .add({ behavior = `An [[ErrorNode]] declares and uses nothing` })
    .add({ behavior = `A file's symbols, usages, and problems appear once in the model, however many files use it` })
    .add({
      behavior = `Every [[Problem]] added while binding, those [[Interpreter.expand]] and [[Interpreter.evaluate]] add among them, has [[Problem.stage]] [[Stage.binder]]`,
    });

  // Declare
  @acceptanceCriteria
    .add({ behavior = `Names in a scope are visible throughout that scope` })
    .add({
      situation = `A scope belongs to a [[SourceFile]]`,
      behavior = `Its [[Scope.current]] is an anonymous entity for the file`,
    })
    .add({
      situation = `An [[ExpressionStatement]] in a data or trait body begins with [[Current]] using [[ScopeAccessor]]`,
      behavior = `It declares a member whose description is the [[Definition]] on it and whose type is the right side of its [[Assignment]]`,
    })
    .add({
      situation = `A [[TypeParameter]] is bound in the [[TypeParameters]] of a declaration`,
      behavior = `Its name is visible throughout the declaration: its [[ExtendsClause]], its [[DefinitionClause]], its [[Parameters]], its output, and its body`,
    })
    .add({
      situation = `An [[ObjectKey]] is bound in the [[Object]] of an [[EnumDeclaration]]`,
      behavior = `It declares a symbol of kind [[SymbolKind.enumMember]]`,
    })
    .add({
      situation = `An [[ObjectKey]] is bound anywhere but in the [[Object]] of an [[EnumDeclaration]]`,
      behavior = `It declares nothing`,
    })
    .add({
      situation = [
        `A name is declared twice in the same scope`,
        `The two declarations are not one parameter and one member`,
      ],
      behavior = [`A [[Problem]] is added at the second`, `The first wins`],
    })
    // Decision: a member is reached through the scope layer and a parameter through the value
    // layer, so a trait may name a member after the parameter it holds, as binding does.
    .add({
      situation = `A parameter and a member of the same scope share a name`,
      behavior = `Both are declared, and no [[Problem]] is added`,
    })
    .add({
      situation = `A name is declared in a child scope that already exists in the parent scope`,
      behavior = `The name is visible in the child scope and the parent scope's name is shadowed there, but no [[Problem]] is added`,
    })
    .add({
      situation = `A scope belongs to a declaration`,
      behavior = `Its [[Scope.current]] is the declared entity`,
    })
    .add({
      situation = `A scope belongs to a [[With]]`,
      behavior = `Its [[Scope.current]] is the entity the [[With]] expression resolves to`,
    })
    .add({
      situation = `A scope belongs to a node that is not a declaration, a [[With]], or a [[SourceFile]]`,
      behavior = `Its [[Scope.current]] is [[Scope.current]] of its [[Scope.parent]]`,
    })
    .add({
      situation = `The expression of a [[With]] is a [[Member]] using [[ScopeAccessor]]`,
      behavior = `[[Scope.current]] of the scope the [[With]] owns is the entity of the member symbol it resolves to`,
    });

  // use
  @acceptanceCriteria
    .add({
      situation = `The entry of a [[Use]] in [[Source.uses]] is a path`,
      behavior = `The [[Use]] refers to the [[Source]] whose [[Source.path]] that entry names`,
    })
    .add({
      situation = `The entry of a [[Use]] in [[Source.uses]] is undefined`,
      behavior = `The [[Use]] imports nothing`,
    })
    .add({
      situation = `[[Use]] has no [[AsKeyword]]`,
      behavior = `The used file's own symbols, not its imports, are visible in the user's file scope after its own`,
    })
    .add({
      situation = `[[Use]] has [[AsKeyword]]`,
      behavior = `The module symbol's entity is the used file's entity`,
    })
    .add({
      situation = [`[[Use]] has [[AsKeyword]]`, `A [[For]] with in iterates over its module symbol`],
      behavior = `The [[For]] visits the entities of the used file's symbols`,
    })
    .add({
      situation = [`[[Use]] has [[AsKeyword]]`, `A [[For]] with of iterates over its module symbol`],
      behavior = `The [[For]] visits the names of the used file's symbols`,
    })
    .add({
      situation = [`[[Use]] has [[AsKeyword]]`, `A [[For]] with from iterates over its module symbol`],
      behavior = `The [[For]] visits both the entities and the names of the used file's symbols`,
    });

  // Expand
  @acceptanceCriteria.add({ behavior = `The expand pass is [[Interpreter.expand]]` });

  // Resolve
  @acceptanceCriteria
    .add({
      situation = `A [[Name]] or [[TraitUse]] is bound`,
      behavior = `It resolves to the first match walking from its scope outward`,
    })
    // Decision: a trait name skips the declaration's own scope so that a member the declaration
    // gains from an applied trait never shadows a trait, as the member rule of the trait rule would.
    .add({
      situation = `A trait is named in the [[IsClause]] or [[ExtendsClause]] of a declaration`,
      behavior = `The name is found walking outward from the scope that holds the declaration, never from the declaration's own scope`,
    })
    .add({
      situation = `A trait is named with arguments in the [[IsClause]] or [[ExtendsClause]] of a declaration`,
      behavior = `The arguments resolve in the declaration's own scope`,
    })
    .add({
      behavior = `The kind data of an entity is the prelude data for what it is, and always includes [[Prelude.Entity]]`,
    })
    .add({
      situation = [
        memberRead,
        `It uses [[ValueAccessor]] or [[OptionalValueAccessor]]`,
        `The value of the left side is a module`,
      ],
      behavior = `The [[MemberName]] resolves in the module's symbols`,
    })
    .add({
      situation = [
        memberRead,
        `It uses [[ValueAccessor]] or [[OptionalValueAccessor]]`,
        `The value of the left side is an entity that is not a module`,
      ],
      behavior = `The [[MemberName]] resolves in the entity's own members first, then in those members of its kind data whose value is a function, whether an inline function or a reference to a fn or function declaration, such as [[Traits.Trait.apply]]`,
    })
    .add({
      situation = [
        memberRead,
        `It uses [[ValueAccessor]] or [[OptionalValueAccessor]]`,
        `The value of the left side is an object`,
      ],
      behavior = `The [[MemberName]] resolves in the object's keys, then in the members of [[Objects.Object]]`,
    })
    .add({
      situation = [
        memberRead,
        `It uses [[ValueAccessor]] or [[OptionalValueAccessor]]`,
        `The value of the left side is not a module, an entity, or an object`,
      ],
      behavior = `The [[MemberName]] resolves in the members of the base data of that value`,
    })
    .add({
      situation = [memberRead, `It uses [[ScopeAccessor]] and spells a [[MemberName]]`],
      behavior = `The [[MemberName]] resolves to the member symbol itself`,
    })
    .add({
      situation = [memberRead, `It uses [[ScopeAccessor]] and spells no [[MemberName]]`],
      behavior = `It resolves to the entity's [[Entity.scope]]`,
    })
    .add({
      situation = [
        memberRead,
        `It uses [[ContextAccessor]]`,
        `The [[MemberName]] is a member of the entity's kind data`,
      ],
      behavior = `The [[MemberName]] resolves in the members of the entity's kind data and yields that member`,
    })
    // Decision: a member of another kind's data yields undefined, so a test's input can read
    // [[Functions.Function.parameters]] of anything.
    .add({
      situation = [
        memberRead,
        `It uses [[ContextAccessor]]`,
        `The [[MemberName]] is a member of a kind data other than the entity's`,
      ],
      behavior = `It yields undefined for that [[MemberName]], without a [[Problem]]`,
    })
    .add({
      situation = [
        `A [[Member]] using [[ContextAccessor]] is bound`,
        `Its left side is a [[Name]] bound to a const or let`,
      ],
      behavior = `It reads the context layer of the const's or let's entity, never of its value`,
    })
    .add({
      situation = [memberRead, `It uses [[ParentScopeAccessor]]`, `The left side's scope is contained in another scope`],
      behavior = `It yields the scope that contains the left side's scope`,
    })
    .add({
      situation = [
        memberRead,
        `It uses [[ParentScopeAccessor]]`,
        `The left side's scope is contained in no other scope`,
      ],
      behavior = `It yields undefined`,
    })
    .add({
      situation = `A [[Name]] resolves to a symbol of kind [[SymbolKind.typeParameter]]`,
      behavior = `What it yields as a type is the type parameter's entity`,
    })
    .add({
      situation = [
        `A [[Member]] is bound with [[ValueAccessor]] or [[OptionalValueAccessor]] on a left side whose type is a type parameter`,
        `The type parameter has an [[ExtendsKeyword]]`,
      ],
      behavior = `The [[MemberName]] resolves in the members of the parameter's [[Entity.type]]`,
    })
    // Decision: the binder infers nothing about an unconstrained type parameter.
    .add({
      situation = [
        `A [[Member]] is bound with [[ValueAccessor]] or [[OptionalValueAccessor]] on a left side whose type is a type parameter`,
        `The type parameter has no [[ExtendsKeyword]]`,
      ],
      behavior = `Nothing resolves and no [[Problem]] is added`,
    })
    .add({
      situation = `A [[Member]] named add is bound with [[ValueAccessor]] on [[Prelude.Entity.acceptanceCriteria]], [[Prelude.Entity.knowledge]], [[Prelude.Entity.commands]], or [[Prelude.Entity.targets]] reached with [[ContextAccessor]], directly or on the list an earlier add on the same list yields`,
      behavior = `It has no symbol and adds no [[Problem]]`,
    })
    .add({
      situation = `A [[Dereference]] is bound`,
      behavior = `It yields the entity its operand is bound to, not its value`,
    })
    .add({
      situation = `A [[Previous]] is bound`,
      behavior = `It yields the entity declared by the nearest earlier statement of the same block`,
    })
    .add({
      situation = `A [[TemplateReference]] or [[TemplateExecution]] is bound`,
      behavior = `It resolves in the scope the template is written in`,
    })
    .add({
      situation = [
        `A [[TemplateReference]] or [[TemplateExecution]] is bound`,
        `What it spells is found nowhere in the scope the template is written in`,
        `Exactly one [[rule]] entity in the program has the identifier it spells`,
      ],
      behavior = `It resolves to that [[rule]] entity, in whichever file it is`,
    })
    // Decision: the grammar knows a rule only by its identifier.
    .add({
      situation = `Two [[rule]] entities in the program have the same identifier`,
      behavior = `A [[Problem]] is added at the second, naming the file of the first`,
    })
    .add({
      situation = [
        `Two [[rule]] entities in the program have the same identifier`,
        `A [[TemplateReference]] or [[TemplateExecution]] spells that identifier and is found nowhere in the scope it is written in`,
      ],
      behavior = `It resolves to neither rule, and its [[Problem]] says the name is more than one rule rather than that it is not declared`,
    })
    // Decision: being lenient with a name found nowhere would hide a misspelled member behind a
    // silent undefined.
    .add({
      situation = [
        `Nothing is found for a name`,
        `The name is not the [[MemberName]] of a [[Member]] whose left side has no symbol either`,
        `The name is not the [[MemberName]] of a [[Member]] on a left side whose type is a type parameter with no [[ExtendsKeyword]]`,
        `The name is not a [[MemberName]] read with [[ContextAccessor]] that is a member of some kind data`,
      ],
      behavior = [
        `The [[Usage]] has no symbol`,
        `A [[Problem]] is added, whatever the left side is: a trait, a data, a module, a predicate, or a value, and even when no prelude is bound and the entity's kind data is empty`,
      ],
    });

  // Kind data
  for (const row in kindData) {
    where (`An entity is {{row.kind}}`) -> `Its kind data includes {{row.data}}`;
  }
  for (const row in baseData) {
    where (`A value is {{row.kind}}`) -> `Its base data is {{row.data}}`;
  }

  // Properties
  @acceptanceCriteria
    .add({
      situation = `A [[TypeParameter]] is bound`,
      behavior = [
        `[[Kinds.Parameter.defaultValue]] of its entity is what the [[TypeExpression]] after its [[PlainSetter]] resolves to`,
        `[[Kinds.Parameter.optional]] of its entity is whether it has a [[PlainSetter]]`,
        `[[Kinds.Parameter.spread]] of its entity is false`,
      ],
    })
    .add({
      situation = `A [[TypeParameter]] is bound`,
      behavior = `Its entity's [[Entity.definition]] is undefined and its [[Entity.traits]] and [[Entity.acceptanceCriteria]] are empty`,
    })
    .add({
      situation = `A [[Reference]] that resolves to a declaration is followed by [[TypeArguments]] in a type position, or by [[Generic]] in an expression position`,
      behavior = `It yields an entity that is the declaration seen with those arguments: [[Entity.identifier]], [[Entity.definition]], the members, the criteria, and [[Entity.typeParameters]] are the declaration's, and [[Entity.type]] is the declaration itself`,
    })
    .add({
      situation = `A [[Reference]] that resolves to a declaration is followed by neither [[TypeArguments]] nor [[Generic]]`,
      behavior = `It yields the declaration itself`,
    })
    .add({
      situation = `[[TypeArguments]] or [[Generic]] lists more arguments than the declaration has [[Entity.typeParameters]], or fewer than those without a [[Kinds.Parameter.defaultValue]]`,
      behavior = [`A [[Problem]] is added at the arguments`, `The entity is still bound with the arguments as written`],
    })
    .add({
      situation = `A [[TypeItem]] ends with [[ListOpen]] and [[ListClose]]`,
      behavior = `It yields [[Lists.List]] seen with one argument: what the item before the brackets resolves to`,
    })
    .add({
      situation = `An [[Index]] with nothing inside is bound in an expression position`,
      behavior = `It yields [[Lists.List]] seen with one argument: what the left side resolves to`,
    })
    .add({
      situation = `[[Index]] nodes with nothing inside follow one another`,
      behavior = `Each nests the [[Lists.List]] of the one before it as its argument`,
    })
    .add({
      situation = `A [[FunctionType]] is bound`,
      behavior = `It yields an anonymous entity whose kind data is [[Functions.Function]]: [[FnEntity.parameters]] is the symbols of the [[Parameter]] and [[SpreadParameter]] nodes of its [[Parameters]], declared in the scope the [[FunctionType]] owns, and [[FnEntity.output]] is what the [[TypeExpression]] after its [[DoubleArrowRight]] resolves to`,
    })
    .add({
      situation = `A [[Member]] is bound with [[ValueAccessor]] or [[OptionalValueAccessor]] on a left side whose type has [[Entity.typeArguments]]`,
      behavior = [
        `The member's type, as read there, is its declared type with each of the base's [[Entity.typeParameters]] replaced by the argument at the same position, through nested [[Entity.typeArguments]] and through the parameters and output of a function type`,
        `Nothing beyond this direct substitution is inferred`,
      ],
    })
    .add({
      situation = [
        `A [[Member]] is bound with [[ValueAccessor]] or [[OptionalValueAccessor]] on a left side whose type has [[Entity.typeArguments]]`,
        `One of the base's [[Entity.typeParameters]] has no argument at its position`,
      ],
      behavior = `That parameter stays itself in the member's type as read there`,
    })
    .add({
      situation = `A [[Where]] is bound`,
      behavior = `One [[Criterion]] is appended to [[Entity.acceptanceCriteria]] of [[Scope.current]] of its scope`,
    });

  @test(
    {
      input = [[Source@like(`a.lfy, parsed from: trait t { $x: \`d\` = string; } d A is t {} const y = A.x;`)]],
      expect = Model@like(`The [[Usage]] of x in A.x resolving to the member x that A gains from t; no problems`),
    },
    {
      input = [
        [
          Source@like(
            `main.lfy, parsed from: use "./tokens/keyword" as Keyword; for (const token in Keyword) { }, its one use naming tokens/keyword.lfy`,
          ),
          Source@like(`tokens/keyword.lfy, parsed`),
        ],
      ],
      expect = Model@like(
        `The [[Usage]] of Keyword resolving to a module symbol whose entity is the second file's entity, and the symbol token in the scope the [[For]] owns; no problems`,
      ),
    },
    {
      input = [
        [
          Source@like(
            `a.lfy, parsed from: d X { $m: \`d\` = string; with X$m { where (\`s\`) -> \`b\`; @test({ input = "a", expect = "a" }); } }`,
          ),
        ],
      ],
      expect = Model@like(
        `The entity of member m of X carrying one [[Criterion]] whose situation is s and behavior is b, and one [[Test]]; X carrying no criteria and no tests`,
      ),
    },
    {
      input = [
        [
          Source@like(`lib/main.lfy of the package elfie, with [[Origin.prelude]], using ./prelude/entity`),
          Source@like(`lib/prelude/entity.lfy, with [[Origin.library]], declaring d Entity with a member identifier`),
          Source@like(`a.lfy, with [[Origin.program]], parsed from: d A {} const n = A@identifier; const e = Entity;`),
        ],
      ],
      expect = Model@like(
        `The [[Usage]] of Entity in a.lfy resolving to the prelude's symbol through the parent of a.lfy's file scope; the [[Usage]] of identifier resolving to that member of Entity; no problems`,
      ),
    },
    {
      input = [[Source@like(`a.lfy, with [[Origin.program]], parsed from: trait t {} d A {} t.apply(A);`)]],
      expect = Model@like(
        `apply resolving to [[Traits.Trait.apply]] through t's kind data, and A carrying one [[Applied]] for t`,
      ),
    },
    {
      input = [
        [
          Source@like(
            `b.lfy, with [[Origin.program]], parsed from: trait rule(syntax: string) { $rule: \`the rule\` = string; }`,
          ),
          Source@like(
            `a.lfy, with [[Origin.program]], parsed from: use "./b"; d A is rule(\`x\`): \`a\` {} d B is rule(\`y\`): \`b\` {}`,
          ),
        ],
      ],
      expect = Model@like(
        `Both [[Usage]]s of rule in a.lfy resolving to the trait rule of b.lfy, not to the member rule that A and B gain; no problems`,
      ),
    },
    {
      input = [[Source@like(`a.lfy, with [[Origin.program]], parsed from: trait t {} d A {} t.apply(@);`)]],
      expect = Model@like(`The anonymous entity for a.lfy carrying one [[Applied]] for t, and A carrying none`),
    },
    {
      input = [[Source@like(`a.lfy, parsed from: d Item {} d Box<T extends Item = string> { $item: \`x\` = T; }`)]],
      expect = Model@like(
        `A symbol T of kind [[SymbolKind.typeParameter]] in the scope Box owns, whose entity has [[Entity.type]] Item and [[Kinds.Parameter.defaultValue]] string`,
      ),
    },
    {
      input = [
        [
          Source@like(
            `a.lfy, parsed from: d Box<T> { $item: \`x\` = T; $items: \`y\` = T[]; } const b = Box<string>; const i = b.item; const j = b.items;`,
          ),
        ],
      ],
      expect = Model@like(
        `i having type string and j having type [[Lists.List]] of string, while the member items of Box keeps type [[Lists.List]] of T`,
      ),
    },
  );
}

fn resolve(model: Model, node: Node): `The symbol a node uses or declares` => Symbol | undefined {
  @acceptanceCriteria
    .add({ situation = `[[node]] has a [[Usage]] in [[model]]`, behavior = `Returns its [[Usage.symbol]]` })
    .add({ situation = `[[node]] declares a symbol in [[model]]`, behavior = `Returns that symbol` })
    .add({
      situation = `[[node]] has no [[Usage]] in [[model]] and declares no symbol in [[model]]`,
      behavior = `Returns undefined`,
    });
}

fn usagesOf(model: Model, target: Symbol): `Every use of a symbol` => Usage[] {
  @acceptanceCriteria
    .add({
      behavior = `Returns every [[Usage]] whose symbol is [[target]] or an alias chain ending at it, in node order`,
    });
  @test({
    input = [
      Model@like(`Bound from: d A {} alias B = A; alias C = B; const x = C; const y = A; const z = 1;`),
      Symbol@like(`The symbol A`),
    ],
    expect = Usage[]@like(`Four usages, in node order: A in alias B, B in alias C, C in const x, and A in const y`),
  });
}

fn criteriaOf(model: Model, entity: Entity): `Every criterion attached to an entity, with templates resolved for it` => Criterion[] {
  @acceptanceCriteria
    .add({
      behavior = `Returns [[Entity.acceptanceCriteria]] with each template reference replaced by the referenced entity's identifier and each execution by its value, evaluated for [[entity]]`,
    })
    .add({
      situation = `An execution's value is a type`,
      behavior = `It is replaced by [[typeTextOf]] that type`,
    });
  @test({
    input = [
      Model@like(
        `Bound from: d A {} d B {} d X with a member xs of type (A | B)[] and one criterion whose behavior is the word Holds followed by an execution of the type of xs`,
      ),
      Entity@like(`X`),
    ],
    expect = Criterion[]@like(`One criterion whose behavior is Holds (A | B)[]`),
  });
}
