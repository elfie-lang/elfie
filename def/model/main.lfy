use "../grammar/rules/expression";
use "../grammar/rules/statement";
use "../grammar/terminals/punctuation";
use "../grammar/traits";
use "../parser/data";
use "./data";
use "./traits";
use "elfie/criteria/criterion" as Criteria;
use "elfie/prelude/entity" as Prelude;
use "elfie/prelude/fn" as Functions;
use "elfie/prelude/kinds" as Kinds;
use "elfie/prelude/trait" as Traits;
use "elfie/values/list" as Lists;
use "elfie/values/number" as Numbers;
use "elfie/values/object" as Objects;
use "elfie/values/string" as Strings;
use "elfie/values/template" as Templates;

fn bind(sources: Source[]): `Build the model of a program from the resolved files of all of it` => Model {
  // Passes
  @acceptanceCriteria
    .add({
      behavior = [
        `Binding runs three passes over every file: declare (scopes, symbols, entities), apply (traits, members, criteria), resolve (usages, properties, templates)`,
        `[[sources]] are bound in the order given, which places every file after the files it uses`,
        `Binding never stops; every failure below is a [[Problem]] and an [[ErrorNode]] declares and uses nothing`,
      ],
    })
    .add({ behavior = `Each [[Source]] is bound once, however many others use it` });

  // Declare
  @acceptanceCriteria
    .add({
      behavior = [
        `Each [[SourceFile]] is a file scope whose current entity is an anonymous entity for the file`,
        `Every [[scoped]] node creates a scope and every [[declaring]] node a symbol and an entity, as those traits say; a declaration's [[Block]] is the child of the declaration's own scope`,
        `Names in a scope are visible throughout that scope`,
      ],
    })
    .add({
      behavior = [
        `The prelude scope is the file scope of the [[Source]] whose [[Source.origin]] is [[Origin.prelude]]: its own symbols and the symbols its [[Use]]s import`,
        `The parent of the file scope of every [[Source]] whose [[Source.origin]] is [[Origin.program]] is the prelude scope; the file scope of a [[Source]] whose [[Source.origin]] is [[Origin.library]] or [[Origin.prelude]] has no parent`,
      ],
    })
    .add({
      situation = `No [[Source]] has [[Origin.prelude]] as its [[Source.origin]]`,
      behavior = `No file scope has a parent, and a name only the prelude would give is found nowhere`,
    })
    .add({
      situation = `A name declared in a file scope is also in the prelude scope`,
      behavior = `The file's symbol shadows the prelude's throughout that file, and no [[Problem]] is added`,
    })
    .add({
      situation = `An [[ExpressionStatement]] in a data or trait body begins with [[Current]] using [[ScopeAccessor]]`,
      behavior = `It declares a member whose description is the [[Definition]] on it and whose type is the right side of its [[Assignment]]`,
    })
    .add({
      situation = `A [[TypeParameter]] is bound in the [[TypeParameters]] of a declaration`,
      behavior = `Its symbol, of kind [[SymbolKind.typeParameter]], is in the scope that declaration owns, beside its parameters and members, so the name is visible throughout the declaration: its [[ExtendsClause]], its [[DefinitionClause]], its [[Parameters]], its output, and its body`,
    })
    .add({
      situation = `An [[ObjectKey]] is bound in the [[Object]] of an [[EnumDeclaration]]`,
      behavior = `It declares a symbol of kind [[SymbolKind.enumMember]]; an [[ObjectKey]] anywhere else declares nothing`,
    })
    .add({
      situation = `A name is declared twice in the same scope`,
      behavior = `A [[Problem]] is added at the second and the first wins`,
    })
    .add({
      situation = `A name is declared in a child scope that already exists in the parent scope`,
      behavior = `The name is visible in the child scope and the parent scope's name is shadowed there, but no [[Problem]] is added`,
    })
    .add({
      situation = `A scope belongs to a declaration, a [[With]], or any other node`,
      behavior = `Its current entity is, in the same order, the declared entity, the entity the [[With]] expression resolves to, or the parent scope's`,
    })
    .add({
      situation = `The expression of a [[With]] is a [[Member]] using [[ScopeAccessor]], so it resolves to a member symbol`,
      behavior = `The current entity of the scope the [[With]] owns is that member's entity, so criteria and tests inside the block attach to the member and not to the entity that declares it`,
    });

  // use
  @acceptanceCriteria
    .add({
      behavior = `A [[Use]] refers to the [[Source]] whose [[Source.path]] its entry in [[Source.uses]] names; an entry of undefined imports nothing`,
    })
    .add({
      situation = `[[Use]] has no [[AsKeyword]]`,
      behavior = `The used file's own symbols, not its imports, are visible in the user's file scope after its own`,
    })
    .add({
      situation = `[[Use]] has [[AsKeyword]]`,
      behavior = `The module symbol's entity is the used file's entity, so a [[Member]] on it resolves in that file's symbols and a [[For]] over it visits those symbols' entities (in) or names (of) or both (from)`,
    });

  // Apply
  @acceptanceCriteria
    .add({
      situation = `A [[Call]] is bound whose left is a [[Member]] that resolves to [[Traits.Trait.apply]] on an expression that resolves to a trait`,
      behavior = `The trait is applied as the criteria of [[Traits.Trait.apply]] say: to the entity the first argument resolves to, or to every item when it resolves to an [[alternationList]], with the other arguments as [[Applied.arguments]]`,
    })
    .add({
      situation = `An applied trait has an [[ExtendsClause]]`,
      behavior = `Each extended trait is applied too, up the whole chain, with its arguments evaluated from the extending trait's parameters`,
    })
    .add({
      situation = `A trait is applied to an entity`,
      behavior = [
        `Each member declared in the trait's body joins the entity's scope`,
        `The trait body's value setters are evaluated with the parameters bound to the arguments as the entity's values`,
        `Each criterion of the trait body is appended to [[Entity.acceptanceCriteria]] with [[Criterion.contributor]] set to the trait`,
      ],
    })
    .add({
      situation = `Two applied traits declare the same member`,
      behavior = `Most recently applied trait definition wins`,
    })
    .add({
      behavior = [
        `[[TraitEntity.entities]] is every entity the trait was applied to, in file order then application order, complete before the resolve pass reads it`,
        `[[TraitEntity.extenders]] is every trait that names it in an [[ExtendsClause]], in file order, and an extender is never one of its [[TraitEntity.entities]]`,
      ],
    });

  // Resolve
  @acceptanceCriteria
    .add({
      situation = `A [[Name]] or [[TraitUse]] is bound`,
      behavior = `It resolves to the first match walking from its scope outward`,
    })
    .add({
      behavior = [
        `The kind data of an entity is the prelude data for what it is: [[Prelude.Entity]] for every entity, and also [[Traits.Trait]] for a trait, [[Functions.Function]] for a fn or function, [[Kinds.Data]] for a data, [[Kinds.Type]] for a type, [[Kinds.Enum]] for an enum, [[Kinds.Member]] for a member, [[Kinds.Parameter]] for a parameter or a type parameter, [[Kinds.Variable]] for a variable, and [[Kinds.Module]] for a module`,
        `The base data of a value is [[Strings.String]] for a string, [[Numbers.Number]] for a number, [[Numbers.Boolean]] for a boolean, [[Objects.Object]] for an object, [[Lists.List]] for any list, [[Templates.Template]] for a template, and [[Functions.Function]] for a function value`,
      ],
    })
    .add({
      situation = [
        `A [[Member]] is bound, or a [[Current]] is bound with the scope's current entity as the left side`,
      ],
      behavior = [
        `With [[ValueAccessor]] or [[OptionalValueAccessor]], the [[MemberName]] resolves in the value of the left side: a module's symbols; an entity's own members first, then those members of its kind data whose value is a function, whether an inline function or a reference to a fn or function declaration, as [[Traits.Trait.apply]] is; an object's keys, then the members of [[Objects.Object]]; or, for a value of any other base data, that data's members`,
        `With [[ScopeAccessor]], the [[MemberName]] resolves to the member symbol itself, or to the entity's scope when there is no name`,
        `With [[ContextAccessor]], the [[MemberName]] resolves in the members of the entity's kind data and yields that member`,
        `With [[ContextAccessor]], a [[MemberName]] that is a member of a kind data other than the entity's yields undefined for it, without a [[Problem]], so [[Criteria.Test.input]] can read [[Functions.Function.parameters]] of anything`,
        `With [[ParentScopeAccessor]], it yields the scope that contains the left side's scope, or undefined when there is none`,
        `A keyword is a valid [[MemberName]] in this position only`,
      ],
    })
    .add({
      situation = `A [[Name]] resolves to a symbol of kind [[SymbolKind.typeParameter]]`,
      behavior = `The [[Usage]] is of layer value like any name, and what it yields as a type is the type parameter's entity`,
    })
    .add({
      situation = `A [[Member]] is bound with [[ValueAccessor]] or [[OptionalValueAccessor]] on a left side whose type is a type parameter`,
      behavior = `The [[MemberName]] resolves in the members of the parameter's [[Entity.type]] when it has an [[ExtendsKeyword]]; without one nothing resolves and no [[Problem]] is added, because the binder infers nothing about an unconstrained parameter`,
    })
    .add({
      situation = `A [[Member]] named add is bound with [[ValueAccessor]] on [[Prelude.Entity.acceptanceCriteria]] reached with [[ContextAccessor]]`,
      behavior = `It is the add call the criteria of [[Criteria.Criterion]] describe: it has no symbol and adds no [[Problem]]`,
    })
    .add({
      situation = `A [[Dereference]] is bound`,
      behavior = `It yields the entity its operand is bound to, not its value`,
    })
    .add({
      situation = `A [[Previous]] is bound`,
      behavior = `It yields the entity declared by the nearest earlier statement of the same block`,
    })
    .add({
      situation = `A [[TemplateReference]] or [[TemplateExecution]] is bound`,
      behavior = `It resolves in the scope the template is written in; a reference found nowhere resolves to the one [[rule]] entity with that identifier in any file`,
    })
    .add({
      situation = [
        `Nothing is found for a name`,
        `The name is not the [[MemberName]] of a [[Member]] whose left side has no symbol either`,
      ],
      behavior = `The [[Usage]] has no symbol, and a [[Problem]] is added, whatever the left side is: a trait, a data, a module, a predicate, or a value; being lenient here would hide a misspelled member behind a silent undefined`,
    });

  // Properties
  @acceptanceCriteria
    .add({
      behavior = [
        `[[Entity.identifier]] is the symbol's name`,
        `[[Entity.definition]] is the string or template in the declaration's [[DefinitionClause]] or [[Definition]]`,
        `[[FnEntity.parameters]] is the symbols of its [[Parameter]] and [[SpreadParameter]] nodes in order`,
        `[[FnEntity.output]] is what the type after the arrow resolves to`,
      ],
    })
    .add({
      situation = `The entity is a data, trait, type, or enum declaration`,
      behavior = `[[Entity.type]] is the entity itself`,
    })
    .add({
      situation = `The declaration has a [[TypeExpression]] after the colon, an [[Assignment]] right side on a member or external, or a value on a variable or parameter`,
      behavior = `[[Entity.type]] is, in the same order, what that expression resolves to, what the right side resolves to, or the type of the value`,
    })
    .add({
      situation = `A [[TypeParameter]] is bound`,
      behavior = `Its entity's [[Entity.type]] is what the [[TypeExpression]] after its [[ExtendsKeyword]] resolves to, or undefined without one; its kind data is [[Kinds.Parameter]], whose [[Kinds.Parameter.defaultValue]] is what the [[TypeExpression]] after its [[PlainSetter]] resolves to and whose [[Kinds.Parameter.optional]] is whether it has one; [[Kinds.Parameter.spread]] is false`,
    })
    .add({
      behavior = `[[Entity.typeParameters]] is the entity of each [[TypeParameter]] in the declaration's [[TypeParameters]], in order; empty for a declaration without them`,
    })
    .add({
      situation = `A [[Reference]] that resolves to a declaration is followed by [[TypeArguments]] in a type position, or by [[Generic]] in an expression position`,
      behavior = `It yields an entity that is the declaration seen with those arguments: [[Entity.identifier]], [[Entity.definition]], the members, the criteria, and [[Entity.typeParameters]] are the declaration's, [[Entity.type]] is the declaration itself, and [[Entity.typeArguments]] is what each argument resolves to, in order; a [[Reference]] without arguments yields the declaration, whose [[Entity.typeArguments]] is empty`,
    })
    .add({
      situation = `[[TypeArguments]] or [[Generic]] lists more arguments than the declaration has [[Entity.typeParameters]], or fewer than those without a [[Kinds.Parameter.defaultValue]]`,
      behavior = `A [[Problem]] is added at the arguments, and the entity is still bound with the arguments as written`,
    })
    .add({
      situation = `A [[TypeItem]] ends with [[ListOpen]] and [[ListClose]], or an [[Index]] with nothing inside is bound in an expression position`,
      behavior = `It yields [[Lists.List]] seen with one argument, what the item or the left side resolves to, so T[] is List of T; nested brackets nest the arguments`,
    })
    .add({
      behavior = `[[Entity.itemType]] is the first of [[Entity.typeArguments]] of [[Entity.type]] when that type is [[Lists.List]], and undefined otherwise, for a bare [[Lists.List]] and a list value included`,
    })
    .add({
      situation = `A [[FunctionType]] is bound`,
      behavior = `It yields an anonymous entity whose kind data is [[Functions.Function]]: [[FnEntity.parameters]] is the symbols of the [[Parameter]] and [[SpreadParameter]] nodes of its [[Parameters]], declared in the scope the [[FunctionType]] owns, and [[FnEntity.output]] is what the [[TypeExpression]] after its [[DoubleArrowRight]] resolves to`,
    })
    .add({
      situation = `A [[Member]] is bound with [[ValueAccessor]] or [[OptionalValueAccessor]] on a left side whose type has [[Entity.typeArguments]]`,
      behavior = `The member's type, as read there, is its declared type with each of the base's [[Entity.typeParameters]] replaced by the argument at the same position, through nested [[Entity.typeArguments]] and through the parameters and output of a function type; a parameter with no argument at its position stays itself; nothing beyond this direct substitution is inferred`,
    })
    .add({
      situation = `An add [[Call]] on the entity's context, or a [[Where]], is bound in its body or in a [[With]] whose current it is`,
      behavior = `One [[Criterion]] is appended to [[Entity.acceptanceCriteria]]`,
    })
    .add({
      situation = `A [[Call]] of [[Prelude.Entity.test]] on the entity's context is bound`,
      behavior = `Each of its arguments is appended to [[Prelude.Entity.tests]] as one [[Test]]`,
    })
    .add({
      behavior = `[[Prelude.Entity.like]] takes a prompt and yields a value of [[Entity.type]] that the prompt describes`,
    });

  @test(
    {
      input = [[Source@like(`a.lfy, parsed from: trait t { $x: \`d\` = string; } d A is t {} const y = A.x;`)]],
      expect = Model@like(
        `Symbols t, A, and y in the file scope; entity A with one [[Applied]] for t and a member x with definition d and type string; [[TraitEntity.entities]] of t holding A; a [[Usage]] for A.x resolving to that member; no problems`,
      ),
    },
    {
      input = [
        [
          Source@like(
            `main.lfy, parsed from: use "./tokens/keyword" as Keyword; for (const token in Keyword) { }, its one use naming tokens/keyword.lfy`,
          ),
          Source@like(`tokens/keyword.lfy, parsed`),
        ],
      ],
      expect = Model@like(
        `A module symbol Keyword bound to the second file's entity; a loop variable token in the [[For]] scope; a [[Usage]] of Keyword with layer value resolving to the module symbol; no problems`,
      ),
    },
    {
      input = [[Source@like(`a.lfy, parsed from: const y = z;`)]],
      expect = Model@like(`Symbol y; a [[Usage]] of z with no symbol; one [[Problem]] at z`),
    },
    {
      input = [[Source@like(`a.lfy, parsed from: trait a {} trait b extends a {} d C is b {}`)]],
      expect = Model@like(`[[TraitEntity.entities]] of a holding C alone and [[TraitEntity.extenders]] of a holding b`),
    },
    {
      input = [
        [
          Source@like(
            `a.lfy, parsed from: d X { $m: \`d\` = string; with X$m { where (\`s\`) -> \`b\`; @test({ input = "a", expect = "a" }); } }`,
          ),
        ],
      ],
      expect = Model@like(
        `The entity of member m of X carrying one [[Criterion]] whose situation is s and behavior is b, and one [[Test]]; X carrying no criteria and no tests; no problems`,
      ),
    },
    {
      input = [
        [
          Source@like(`lib/main.lfy of the package elfie, with [[Origin.prelude]], using ./prelude/entity`),
          Source@like(`lib/prelude/entity.lfy, with [[Origin.library]], declaring d Entity with a member identifier`),
          Source@like(`a.lfy, with [[Origin.program]], parsed from: d A {} const n = A@identifier; const e = Entity;`),
        ],
      ],
      expect = Model@like(
        `The [[Usage]] of Entity in a.lfy resolving to the prelude's symbol through the parent of a.lfy's file scope; the [[Usage]] of identifier resolving to that member of Entity; no problems`,
      ),
    },
    {
      input = [[Source@like(`a.lfy, with [[Origin.program]], parsed from: trait t {} d A {} t.apply(A);`)]],
      expect = Model@like(
        `apply resolving to [[Traits.Trait.apply]] through t's kind data; A carrying one [[Applied]] for t; no problems`,
      ),
    },
    {
      input = [[Source@like(`a.lfy, parsed from: d Item {} d Box<T extends Item = string> { $item: \`x\` = T; }`)]],
      expect = Model@like(
        `Symbols Item and Box in the file scope and a symbol T of kind [[SymbolKind.typeParameter]] in the scope Box owns; [[Entity.typeParameters]] of Box holding T's entity alone, whose [[Entity.type]] is Item and whose [[Kinds.Parameter.defaultValue]] is string; the member item with type T's entity; no problems`,
      ),
    },
    {
      input = [
        [
          Source@like(
            `a.lfy, parsed from: d Box<T> { $item: \`x\` = T; $items: \`y\` = T[]; } const b = Box<string>; const i = b.item; const j = b.items;`,
          ),
        ],
      ],
      expect = Model@like(
        `The type of b being Box seen with [[Entity.typeArguments]] holding string; the [[Usage]] of item on b resolving to Box's member and i having type string; j having type [[Lists.List]] whose [[Entity.typeArguments]] hold string, so its [[Entity.itemType]] is string; the member items of Box itself keeping type [[Lists.List]] of T; no problems`,
      ),
    },
    {
      input = [[Source@like(`a.lfy, parsed from: d Box<T> {} const b = Box<string, number>;`)]],
      expect = Model@like(
        `Symbol b whose type is Box seen with two [[Entity.typeArguments]]; one [[Problem]] at the [[Generic]] after Box, because Box lists one type parameter`,
      ),
    },
  );

  for (const rule in declaring@entities) {
    where (`A [[Node]] for [[&rule]] is bound`) -> `A symbol and an entity are created as [[declaring]] says`;
  }
  for (const rule in reading@entities) {
    where (`A [[Node]] for [[&rule]] is bound`) -> `A [[Usage]] with the layer from [[reading]] is created and resolved as above`;
  }
}

fn resolve(model: Model, node: Node): `The symbol a node uses or declares` => Symbol | undefined {
  @acceptanceCriteria
    .add({ situation = `[[node]] has a [[Usage]] in [[model]]`, behavior = `Returns its [[Usage.symbol]]` })
    .add({ situation = `[[node]] declares a symbol in [[model]]`, behavior = `Returns that symbol` })
    .add({ situation = `Neither`, behavior = `Returns undefined` });
}

fn entitiesOf(model: Model, traitEntity: TraitEntity): `Everything that has a trait` => Entity[] {
  @acceptanceCriteria
    .add({ behavior = `Returns [[TraitEntity.entities]] of [[traitEntity]]` })
    .add({ situation = `[[traitEntity]] is not a trait`, behavior = `Returns an empty list` });
}

fn usagesOf(model: Model, target: Symbol): `Every use of a symbol` => Usage[] {
  @acceptanceCriteria
    .add({
      behavior = `Returns every [[Usage]] whose symbol is [[target]] or an alias chain ending at it, in node order`,
    });
}

fn criteriaOf(model: Model, entity: Entity): `Every criterion attached to an entity, with templates resolved for it` => Criterion[] {
  @acceptanceCriteria
    .add({
      behavior = `Returns [[Entity.acceptanceCriteria]] with each template reference replaced by the referenced entity's identifier and each execution by its value, evaluated for [[entity]]`,
    });
}
