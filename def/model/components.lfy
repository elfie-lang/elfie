use "../grammar/rules/expression";
use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../grammar/terminals/identifier";
use "../grammar/terminals/punctuation";
use "./data";
use "./traits";

// Scopes
scoped.apply(SourceFile);
scoped.apply(Block);
scoped.apply(DataDeclaration);
scoped.apply(AgentFunctionDeclaration);
scoped.apply(FunctionDeclaration);
scoped.apply(InlineFunction);
scoped.apply(FunctionType);
scoped.apply(TraitDeclaration);
scoped.apply(TypeDeclaration);
scoped.apply(EnumDeclaration);
scoped.apply(For);
scoped.apply(With);

// Layers
accessor.apply(ValueAccessor, Layer.value);
accessor.apply(OptionalValueAccessor, Layer.value);
accessor.apply(ContextAccessor, Layer.context);
accessor.apply(ScopeAccessor, Layer.scope);
accessor.apply(ParentScopeAccessor, Layer.parent);
accessor.apply(Name, Layer.value);
accessor.apply(TraitUse, Layer.value);
accessor.apply(Dereference, Layer.dereference);
accessor.apply(Previous, Layer.previous);

// Traits/Extensions
traitClause.apply(IsClause);
extensionClause.apply(ExtendsClause);

// Declarations
namedBy.apply(DataDeclaration, Identifier, SymbolKind.data);
namedBy.apply(TraitDeclaration, Identifier, SymbolKind._trait);
namedBy.apply(FunctionDeclaration, Signature, SymbolKind._function);
namedBy.apply(AgentFunctionDeclaration, Signature, SymbolKind.agentFunction);
namedBy.apply(TypeDeclaration, Identifier, SymbolKind._type);
namedBy.apply(EnumDeclaration, Declared, SymbolKind._enum);
namedBy.apply(VariableDeclaration, Declared, SymbolKind.variable);
namedBy.apply(AliasDeclaration, Declared, SymbolKind._alias);
namedBy.apply(ExternalDeclaration, Declared, SymbolKind._external);
namedBy.apply(Use, Identifier, SymbolKind._module);
namedBy.apply(Parameter, Name, SymbolKind.parameter);
namedBy.apply(SpreadParameter, Name, SymbolKind.parameter);
namedBy.apply(TypeParameter, Identifier, SymbolKind.typeParameter);
namedBy.apply(TypeKey, Name, SymbolKind.member);
loopVariable.apply(For, Declared);
loopVariable.apply(ForFrom, Declared);
