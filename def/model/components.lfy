use "../grammar/rules/expression";
use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../grammar/terminals/identifier";
use "../grammar/terminals/punctuation";
use "./data";
use "./traits";

// Scopes
scoped.apply(SourceFile);
scoped.apply(Block);
scoped.apply(DataDeclaration);
scoped.apply(AgentFunctionDeclaration);
scoped.apply(FunctionDeclaration);
scoped.apply(InlineFunction);
scoped.apply(TraitDeclaration);
scoped.apply(TypeDeclaration);
scoped.apply(EnumDeclaration);
scoped.apply(For);
scoped.apply(With);

// Layers
reading.apply(ValueAccessor, Layer.value);
reading.apply(OptionalValueAccessor, Layer.value);
reading.apply(ContextAccessor, Layer.context);
reading.apply(ScopeAccessor, Layer.scope);
reading.apply(ParentScopeAccessor, Layer.parent);
reading.apply(Name, Layer.value);
reading.apply(TraitUse, Layer.value);
reading.apply(Dereference, Layer.dereference);
reading.apply(Previous, Layer.previous);

// Traits/Extensions
applyingTraits.apply(IsClause);
applyingExtensions.apply(ExtendsClause);

// Declarations
declaring.apply(DataDeclaration, Identifier, SymbolKind.data);
declaring.apply(TraitDeclaration, Identifier, SymbolKind._trait);
declaring.apply(FunctionDeclaration, Signature, SymbolKind._function);
declaring.apply(AgentFunctionDeclaration, Signature, SymbolKind.agentFunction);
declaring.apply(TypeDeclaration, Declared, SymbolKind._type);
declaring.apply(EnumDeclaration, Declared, SymbolKind._enum);
declaring.apply(VariableDeclaration, Declared, SymbolKind.variable);
declaring.apply(AliasDeclaration, Declared, SymbolKind._alias);
declaring.apply(ExternalDeclaration, Declared, SymbolKind._external);
declaring.apply(Use, Identifier, SymbolKind._module);
declaring.apply(For, Declared, SymbolKind.loopVariable);
declaring.apply(ForFrom, Declared, SymbolKind.loopVariable);
declaring.apply(Parameter, Name, SymbolKind.parameter);
declaring.apply(SpreadParameter, Name, SymbolKind.parameter);
declaring.apply(TypeKey, Name, SymbolKind.member);
