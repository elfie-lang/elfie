use "../grammar/rules/expression";
use "../grammar/rules/statement";
use "../grammar/terminals/keyword";
use "../lexer/data";
use "../parser/data";
use "elfie/criteria/command" as Commands;
use "elfie/criteria/criterion" as Criteria;
use "elfie/criteria/knowledge" as Knowledges;
use "elfie/prelude/entity" as Prelude;
use "elfie/prelude/fn" as Functions;
use "elfie/prelude/kinds" as Kinds;
use "elfie/prelude/trait" as Traits;
use "elfie/values/list" as Lists;

enum Layer: `The three layers of every entity, the parent scope, and the two ways of pointing at an entity itself` {
  value = `value`,
  context = `context`,
  scope = `scope`,
  parent = `parent scope`,
  dereference = `the entity a name is bound to`,
  previous = `the entity the previous statement declared`,
}

enum Origin: `Where a file comes from, which decides what its file scope's parent is` {
  program = `program`,
  library = `library`,
  prelude = `prelude`,
}

enum SymbolKind: `What kind of declaration a symbol came from` {
  data = `data`,
  _trait = `trait`,
  _type = `type`,
  _enum = `enum`,
  enumMember = `enumMember`,
  _function = `function`,
  agentFunction = `agentFunction`,
  variable = `variable`,
  loopVariable = `loopVariable`,
  parameter = `parameter`,
  typeParameter = `typeParameter`,
  member = `member`,
  _alias = `alias`,
  _external = `external`,
  _module = `module`,
}

// Core

d Symbol: `A name bound to an entity in one scope` {
  $name: `The name` = string;
  $entity: `What the name is bound to; for an alias, the target's entity` = Entity;
  $node: `The node that declared it` = Node;
  $scope: `The scope that holds it` = Scope;
  $kind: `What kind of declaration it came from` = SymbolKind;
}

d Scope: `A region in which names resolve` {
  $symbols: `The symbols declared directly in it, in order` = Symbol[];
  $parent: `The scope that contains it; undefined for the outermost` = Scope | undefined;
  $current: `The current entity: what the value, context, and scope accessors reach without a left expression` = Entity;
  @acceptanceCriteria
    .add({
      situation = `The scope is a file scope`,
      behavior = `[[Scope.symbols]] holds the symbols its use statements import, after the symbols declared directly in it`,
    })
    .add({
      situation = `A file scope belongs to the file whose [[Source.origin]] is [[Origin.prelude]]`,
      behavior = `It is the prelude scope`,
    })
    .add({
      situation = [
        `A file scope belongs to a file whose [[Source.origin]] is [[Origin.program]]`,
        `A [[Source]] bound with it has [[Origin.prelude]] as its [[Source.origin]]`,
      ],
      behavior = `[[Scope.parent]] is the prelude scope`,
    })
    .add({
      situation = [
        `A file scope belongs to a file whose [[Source.origin]] is [[Origin.program]]`,
        `No [[Source]] bound with it has [[Origin.prelude]] as its [[Source.origin]]`,
      ],
      behavior = `[[Scope.parent]] is undefined`,
    })
    .add({
      situation = `A file scope belongs to a file whose [[Source.origin]] is [[Origin.library]] or [[Origin.prelude]]`,
      behavior = `[[Scope.parent]] is undefined`,
    });
}

d Applied: `One trait on one entity` {
  $entity: `The trait` = Entity;
  $arguments: `Argument nodes, in order` = Node[];
  $source: `What applied it: the [[IsClause]], [[ExtendsClause]], or apply [[Call]] when the trait was applied directly; the [[Applied]] it was inherited through otherwise` = Node | Applied;
}

// Context

// Decision: the prelude declares what every entity is seen as (Entity, Trait, Function,
// Criterion, Test, Knowledge, Command); the model extends those and keeps only what the binder
// needs internally, overriding a member where its own record is richer than the prelude's or
// where the binder says how its value is found. The model's names shadow the prelude's in every
// file that uses this one, without a problem.

/// The prelude's [[Criteria.Criterion]] with the contributor held as the entity itself, where
/// the prelude types it as object.
d Criterion extends Criteria.Criterion: `One acceptance criterion as written, with the entity it came from` {
  $contributor: `The entity whose body holds it: the entity itself or one of its traits` = Entity;
}

/// The prelude's [[Knowledges.Knowledge]] with the contributor held as the entity itself, where
/// the prelude types it as object.
d Knowledge extends Knowledges.Knowledge: `Something the compiler is given to read, with the entity it came from` {
  $contributor: `The entity whose body holds it: the entity itself or one of its traits` = Entity;
}

/// The prelude's [[Commands.Command]] with the contributor held as the entity itself, where the
/// prelude types it as object.
d Command extends Commands.Command: `A shell command for one operation, with the entity it came from` {
  $contributor: `The entity whose body holds it: the entity itself or one of its traits` = Entity;
}

// Decision: Test stays a data, not an alias of the prelude's: types of the program reach it, and
// an alias would make them reach the prelude's Test, which is never built for a target.

/// The prelude's [[Criteria.Test]], declared here too for the files that take it from the model.
d Test extends Criteria.Test: `One test, as the prelude declares it` {}

/// The prelude's [[Prelude.Entity]] with what the binder keeps: its criterion, applied trait,
/// usage, knowledge, and command records are richer than the prelude's, and the binder says how
/// the values of its naming and typing members are found.
d Entity extends Prelude.Entity: `A declared thing seen through its context layer` {
  $type: `The declared or inferred type; the entity itself for a data, trait, type, or enum` = Entity | undefined;
  $typeParameters: `The type parameters the declaration lists, in order; empty when none` = Entity[];
  $typeArguments: `The arguments the type was written with when it is generic, in order; empty otherwise` = Entity[];
  $acceptanceCriteria: `Own criteria first, then each trait's in application order` = Criterion[];
  $traits: `Every trait applied to it, direct or inherited, in application order, each with its [[Applied.source]]` = Applied[];
  $references: `Every use of a [[Reference]] in its definition, documentation, or value` = Usage[];
  $knowledge: `Own items first, then each trait's in application order` = Knowledge[];
  $commands: `Own commands first, then each trait's in application order` = Command[];
  $node: `The node that declared it` = Node;
  $symbol: `The symbol that names it; undefined for an anonymous entity` = Symbol | undefined;
  $scope: `The scope it owns, holding its parameters, members, and body; undefined when it owns none` = Scope | undefined;

  with Entity$identifier {
    @acceptanceCriteria.add({ behavior = `[[Entity.identifier]] is [[Symbol.name]] of [[Entity.symbol]]` });
  }

  with Entity$definition {
    @acceptanceCriteria
      .add({
        behavior = `[[Entity.definition]] is the string or template in the declaration's [[DefinitionClause]] or [[Definition]]`,
      });
  }

  with Entity$type {
    @acceptanceCriteria
      .add({
        situation = `The declaration has a [[TypeExpression]] after the colon`,
        behavior = `[[Entity.type]] is what that expression resolves to`,
      })
      .add({
        situation = `The declaration is a member or external with an [[Assignment]] right side`,
        behavior = `[[Entity.type]] is what the right side resolves to`,
      })
      .add({
        situation = `The declaration is a variable or parameter with a value`,
        behavior = `[[Entity.type]] is the type of the value`,
      })
      .add({
        situation = [`The entity is declared by a [[TypeParameter]]`, `The [[TypeParameter]] has an [[ExtendsKeyword]]`],
        behavior = `[[Entity.type]] is what the [[TypeExpression]] after its [[ExtendsKeyword]] resolves to`,
      })
      .add({
        situation = [`The entity is declared by a [[TypeParameter]]`, `The [[TypeParameter]] has no [[ExtendsKeyword]]`],
        behavior = `[[Entity.type]] is undefined`,
      });
  }

  with Entity$typeParameters {
    @acceptanceCriteria
      .add({
        behavior = `[[Entity.typeParameters]] holds the entity of each [[TypeParameter]] in the declaration's [[TypeParameters]], in order`,
      });
  }

  with Entity$typeArguments {
    @acceptanceCriteria
      .add({
        situation = `The entity is a declaration seen with the [[TypeArguments]] or [[Generic]] that follow a [[Reference]] to it`,
        behavior = `[[Entity.typeArguments]] holds what each argument resolves to, in order`,
      });
  }
}

// Decision: the item type belongs to the list type, not to every entity, so a list-typed
// const reads it through its type. A bare [[Lists.List]], seen with no argument, is a data and
// has none.

/// The prelude's [[Kinds.Array]]: [[Lists.List]] seen with one type argument, as a list type or a
/// List with its argument yields it.
d ListEntity extends Kinds.Array: `A list type seen through its context layer` {
  with ListEntity$itemType {
    @acceptanceCriteria
      .add({ behavior = `[[ListEntity.itemType]] is the first of [[ListEntity.typeArguments]]` });
  }
}

/// The prelude's [[Functions.Function]], with the binder saying how its parameters are found.
d FnEntity extends Functions.Function: `A declared fn or function seen through its context layer` {
  with FnEntity$parameters {
    @acceptanceCriteria
      .add({
        behavior = `[[FnEntity.parameters]] holds the entities of its [[Parameter]] and [[SpreadParameter]] nodes, in order`,
      });
  }
}

/// The prelude's [[Traits.Trait]], named here too for the files that take it from the model.
alias TraitEntity: `A declared trait seen through its context layer, as the prelude declares it` = Traits.Trait;

// Tracking

d Usage: `One use of a name or of an entity` {
  $node: `The node that uses it` = Node;
  $name: `The name spelled after the accessor; undefined when the usage is of the layer itself` = string | undefined;
  $layer: `Which layer is read` = Layer;
  $symbol: `What it resolved to; undefined when unresolved` = Symbol | undefined;
}

enum Stage: `The stage that reported a diagnostic` {
  loader = `loader`,
  lexer = `lexer`,
  parser = `parser`,
  binder = `binder`,
  generation = `generation`,
}

d Problem: `Something that did not resolve; binding continues past it` {
  $node: `Where` = Node;
  $message: `What and why` = string;
  $stage: `Which stage added it` = Stage;
}

d Source: `One file to bind, with its [[Use]] statements already resolved` {
  $path: `The file's path, as [[Token.file]] holds it` = string;
  $tree: `The parse of the file` = Tree;
  $uses: `The path each [[Use]] in the tree refers to, in the order the uses appear; undefined where it refers to nothing` = (string | undefined)[];
  $origin: `[[Origin.prelude]] for the main file of the package elfie, [[Origin.library]] for its other files, [[Origin.program]] for every other file` = Origin;
}

d Model: `The program, queryable` {
  $problems: `Every [[Problem]], in node order` = Problem[];
  @acceptanceCriteria
    .add({ behavior = `Answers every query of this module for every file it was bound from` });
}
