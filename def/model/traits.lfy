use "../grammar/rules/expression";
use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../grammar/terminals/identifier";
use "../grammar/traits";
use "../lexer/data";
use "../parser/data";
use "./data";

// Components the model attaches to grammar rules from components.lfy.

trait scoped: `Owns a scope` {
  with Scope {
    where (`A [[Node]] for {{@identifier}} is bound`) -> `A [[Scope]] is created that holds every name declared by a descendant outside a nested [[scoped]] node`;
    where (`A [[Node]] for {{@identifier}} is bound`) and (`The node is a [[SourceFile]]`) -> `Its scope is the file scope of its file`;
    where (`A [[Node]] for {{@identifier}} is bound`) and (`The node is not a [[SourceFile]]`) -> `[[Scope.parent]] of its scope is the scope of the nearest [[scoped]] ancestor`;
  }
}

trait accessor(layer: Layer): `Reads one layer of what it names` {
  with Usage {
    where (`A [[Node]] for {{@identifier}} is bound, or a [[Member]] or [[Current]] whose accessor token satisfies {{@identifier}}`) -> `One [[Usage]] is created for that node`;
    where (`A [[Usage]] is created for a node that satisfies {{@identifier}} or whose accessor token does`) -> `[[Usage.layer]] is {{layer}}`;
    where (`A [[Usage]] is created for a node that satisfies {{@identifier}} or whose accessor token does`) and (`The node spells no name after its accessor`) -> `[[Usage.name]] is undefined`;
  }
}

trait traitList: `Names traits, with their arguments, in its [[TraitUses]]` {
  with Entity {
    where (`A [[Node]] for {{@identifier}} is bound`) -> `Each [[TraitUse]] becomes one [[Applied]] on the declared entity, with the trait resolved by name and the arguments from its [[Arguments]]`;
  }
}

trait traitClause extends traitList: `Applies the traits in its [[TraitUses]] to the entity being declared` {
  with Entity {
    where (`A [[TraitUse]] of a [[Node]] for {{@identifier}} resolves to a trait`) -> `The entity that node declares joins that trait's [[TraitEntity.entities]]`;
  }
}

trait extensionClause extends traitList: `Takes on what its [[TraitUses]] name, and passes it to everything that later receives this declaration` {
  with Entity {
    where (`A [[TraitUse]] of a [[Node]] for {{@identifier}} resolves to a trait`) -> `The entity that node declares joins that trait's [[TraitEntity.extenders]], after those declared earlier in file order`;
    where (`A [[TraitUse]] of a [[Node]] for {{@identifier}} resolves to a trait`) -> `The entity that node declares never joins that trait's [[TraitEntity.entities]]`;
    where (`An entity later receives the entity declared by a [[Node]] for {{@identifier}}`) -> `It receives each [[TraitUse]] of that node too, recorded as an [[Applied]] whose [[Applied.source]] is the receiving application`;
    where (`An entity later receives the entity declared by a [[Node]] for {{@identifier}}`) -> `It joins the [[TraitEntity.entities]] of each trait that node's [[TraitUses]] name`;
  }
}

trait namedBy(holder: is rule, kind: SymbolKind): `Introduces one name of kind {{kind}} into the scope that encloses it, spelled by the first [[&holder]] found in token order without entering a nested [[Parameters]], [[Block]], [[Object]], or [[Type]]` {
  with Symbol {
    where (`A [[Node]] for {{@identifier}} is bound`) and (`A [[&holder]] is found that way`) -> `A [[Symbol]] of kind {{kind}}, named by the [[Token.value]] of the first [[Identifier]] inside the [[&holder]] and declared by the node, is added to the scope that encloses the node, not to one the node owns`;
    where (`A [[Node]] for {{@identifier}} is bound`) and (`A [[&holder]] is found that way`) -> `The node declares one [[Entity]] whose [[Entity.symbol]] is that symbol`;
    where (`A [[Node]] for {{@identifier}} is bound`) and (`No [[&holder]] is found that way`) -> `The node is an anonymous entity`;
  }
}

trait loopVariable(holder: is rule): `Introduces the variable of a loop into the loop's own scope, spelled by its first [[&holder]]` {
  with Symbol {
    where (`A [[Node]] for {{@identifier}} is bound`) -> `A [[Symbol]] of kind [[SymbolKind.loopVariable]], named by the [[Token.value]] of the first [[Identifier]] inside its first [[&holder]] and declared by the node, is added to the scope owned by the [[For]] that is or contains the node`;
    where (`A [[Node]] for {{@identifier}} is bound`) -> `The node declares one [[Entity]] whose [[Entity.symbol]] is that symbol`;
    where (`A [[Node]] for {{@identifier}} is bound`) -> `The symbol is visible in the loop body and nowhere else`;
  }
}
