use "./data";

ace function inMode(modes: string[]) {
  return `The top of the [[ModeStack]] is {{modes.join(` or `)}}`;
}

trait candidateInModes(...modes: string[]): `A terminal is considered only while the condition holds` {
  $lexCondition: `When this terminal may match` = string;
  .lexCondition = inMode(modes);
}

trait modeOpener(mode: string, when?: string): `Creating this token pushes a mode` {
  const onToken = `A token is created for {{@definition}}`;
  with ModeStack {
    where (onToken) and (when ?? `Always`) -> `{{mode}} is pushed, recording {{@definition}} as its opener`;
  }
}

trait modeCloser(mode: string): `Creating this token pops a mode` {
  const onToken = `A token is created for {{@definition}}`;
  with ModeStack {
    where (onToken) and (`{{mode}} is at the top`) -> `{{mode}} is popped`;
  }
}

trait modeToggle(mode: string, when?: string): `The same boundary opens the mode and, seen again, closes it` {
  const onToken = `A token is created for {{@definition}}`;
  with ModeStack {
    where (onToken) and (`{{mode}} is at the top and was opened by {{@definition}}`) -> `{{mode}} is popped`;
    where (onToken) and !(`{{mode}} is at the top`) and (when ?? `Always`) -> `{{mode}} is pushed, recording {{@definition}} as its opener`;
  }
}

trait appliedUntilNewLine(mode: string): `The mode this token opens ends with the line` {
  with ModeStack {
    where (`{{mode}} opened by {{@definition}} is at the top`) and (`The next characters are a [[NewLine]] or the end of the source`) -> `{{mode}} is popped before the line break is lexed`;
  }
}
