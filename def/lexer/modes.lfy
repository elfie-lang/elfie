use "../grammar/terminals/comment";
use "../grammar/terminals/literal";
use "./traits";

// Conditions
const inCode: `Anywhere ordinary tokens are read, including inside template expressions and references` = inMode([
  Mode.code,
  Mode.execution,
  Mode.reference,
]);

// Text regions: the boundary opens and closes the region; inside it only the body and the boundary are lexed
delimiter.apply(SingleQuote, Mode.singleQuote);
lexedIn.apply(SingleQuote, Mode.code, Mode.execution, Mode.reference, Mode.singleQuote);
lineBounded.apply(SingleQuote, Mode.singleQuote);
lexedIn.apply(SingleQuoteBody, Mode.singleQuote);

delimiter.apply(DoubleQuote, Mode.doubleQuote);
lexedIn.apply(DoubleQuote, Mode.code, Mode.execution, Mode.reference, Mode.doubleQuote);
lineBounded.apply(DoubleQuote, Mode.doubleQuote);
lexedIn.apply(DoubleQuoteBody, Mode.doubleQuote);

delimiter.apply(Backtick, Mode.template);
lexedIn.apply(Backtick, Mode.code, Mode.execution, Mode.reference, Mode.template);
lexedIn.apply(TemplateBody, Mode.template);
opener.apply(ExecutionOpen, Mode.execution);
lexedIn.apply(ExecutionOpen, Mode.template);
closer.apply(ExecutionClose, Mode.execution);
lexedIn.apply(ExecutionClose, Mode.execution);
opener.apply(ReferenceOpen, Mode.reference);
lexedIn.apply(ReferenceOpen, Mode.template, Mode.blockDocumentation, Mode.lineDocumentation);
closer.apply(ReferenceClose, Mode.reference);
lexedIn.apply(ReferenceClose, Mode.reference);

// Comments nest; documentation does not
opener.apply(BlockCommentOpen, Mode.blockComment);
lexedIn.apply(BlockCommentOpen, Mode.code, Mode.blockComment, Mode.execution);
closer.apply(BlockCommentClose, Mode.blockComment);
lexedIn.apply(BlockCommentClose, Mode.blockComment);
lexedIn.apply(BlockCommentBody, Mode.blockComment);
opener.apply(LineCommentOpen, Mode.lineComment);
lexedIn.apply(LineCommentOpen, Mode.code);
lineBounded.apply(LineCommentOpen, Mode.lineComment);
lexedIn.apply(LineCommentBody, Mode.lineComment);

opener.apply(BlockDocumentationOpen, Mode.blockDocumentation);
lexedIn.apply(BlockDocumentationOpen, Mode.code, Mode.execution);
closer.apply(BlockDocumentationClose, Mode.blockDocumentation);
lexedIn.apply(BlockDocumentationClose, Mode.blockDocumentation);
lexedIn.apply(BlockDocumentationBody, Mode.blockDocumentation);
opener.apply(LineDocumentationOpen, Mode.lineDocumentation);
lexedIn.apply(LineDocumentationOpen, Mode.code);
lineBounded.apply(LineDocumentationOpen, Mode.lineDocumentation);
lexedIn.apply(LineDocumentationBody, Mode.lineDocumentation);
