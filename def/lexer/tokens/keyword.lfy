use "../data";
use "./comment";
use "./literal";

enum Keyword {
  KW_AGENT_DATA: `Agentically defined data structure` = `d`,
  KW_AGENT_FN: `Agentically defined function` = `fn`,
  KW_ALIAS: `Alias for identifier` = `alias`,
  KW_AND: `Combine conditions in contexts like the "where" syntax sugar keyword` = `and`,
  KW_AS: `Casting or aliasing` = `as`,
  KW_ASYNC: `Indicating an asynchronous block wrapped in a Promise` = `async`,
  KW_AWAIT: `Awaiting the completion of a Promise` = `await`,
  KW_BREAK: `Breaking out of loops` = `break`,
  KW_COMPILE_TIME_EXECUTION: `Marking a statement or block to be executed at compile time` = `ace`,
  KW_CONST: `Defining constant variables` = `const`,
  KW_CONTINUE: `Completing the block, but not breaking out of it` = `continue`,
  KW_DEFAULT: `The default action, value, or block` = `default`,
  KW_ELSE: `An else statement or block` = `else`,
  KW_ENUM: `Defining a variable with enumerated keys and values` = `enum`,
  KW_EXTERNAL: `Referencing something external to the code` = `external`,
  KW_FOR: `A loop over iterators when combined with from, of, and in keywords` = `for`,
  KW_FROM: `Referencing a type, variable, or data structures' keys and values` = `from`,
  KW_FUNCTION: `An explicitly defined function` = `function`,
  KW_IF: `An if conditional block or statement` = `if`,
  KW_IN: `Referencing a type, variable, or data structures' values` = `in`,
  KW_LET: `Defining a mutable variable` = `let`,
  KW_LOOP: `A basic loop that runs until it encounters a break` = `loop`,
  KW_MATCH: `A match expression or block that branches based on condition statements` = `match`,
  KW_MATCHALL: `A matchall expression or block that applies the results of all condition statements that are true` = `matchall`,
  KW_OF: `Referencing a type, variable, or data structures' keys` = `of`,
  KW_OR: `Branch conditions in contexts like the "where" syntax sugar keyword` = `or`,
  KW_RETURN: `Return expression that ends execution of a function and returns a value or set of values` = `return`,
  KW_TRAIT: `Group of shared definitions, properties, configuration, and other information that can be easily added to data, functions or other kinds of variables` = `trait`,
  KW_TYPE: `Defining a type map` = `type`,
  KW_USE: `Add the scoped contents of a file, folder, or library to the current scope` = `use`,
  KW_WHILE: `A while loop` = `while`,
  KW_WHERE: `Syntax sugar for @acceptanceCriteria.add` = `where`,

  KW_PRIMITIVE_BOOLEAN: `Primitive boolean type` = `boolean`,
  KW_PRIMITIVE_BOOLEAN_FALSE: `Primitive boolean value false` = `false`,
  KW_PRIMITIVE_BOOLEAN_TRUE: `Primitive boolean value true` = `true`,
  KW_PRIMITIVE_NULL: `Primitive null` = `null`,
  KW_PRIMITIVE_NUMBER: `Primitive number type` = `number`,
  KW_PRIMITIVE_OBJECT: `Primitive object type` = `object`,
  KW_PRIMITIVE_STRING: `Primitive string type` = `string`,
  KW_PRIMITIVE_UNDEFINED: `Primitive undefined` = `undefined`,

  KW_ABSTRACT: `Reserved for future use` = `abstract`,
  KW_CASE: `Reserved for future use` = `case`,
  KW_CLASS: `Reserved for future use` = `class`,
  KW_IMPL: `Reserved for future use` = `impl`,
  KW_INTERFACE: `Reserved for future use` = `interface`,
  KW_NEW: `Reserved for future use` = `new`,
  KW_PRIVATE: `Reserved for future use` = `private`,
  KW_PUBLIC: `Reserved for future use` = `public`,
  KW_SELF: `Reserved for future use` = `self`,
  KW_STATIC: `Reserved for future use` = `static`,
  KW_SUPER: `Reserved for future use` = `super`,
  KW_SWITCH: `Reserved for future use` = `switch`,
  KW_THEN: `Reserved for future use` = `then`,
  KW_TYPEOF: `Reserved for future use` = `typeof`,
  KW_WITH: `Reserved for future use` = `with`,
  KW_YIELD: `Reserved for future use` = `yield`,
}

