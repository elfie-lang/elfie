use "../data";
use "./comment";
use "./literal";

with Token {
  where
    (`Lexing encounters an Unicode XID_Start or _ character followed by any number of Unicode XID_Continue characters and the characters do not match a keyword`)
    and !(inComment)
    and !(inDocumentation)
    and !(inString)
    and !(inTemplate)
      -> `Those characters become an identifier [[Token]]`;
}
