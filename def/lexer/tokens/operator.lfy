enum Operator {
  OP_ACCESSOR_VALUE: `` = `.`,
  OP_ACCESSOR_CONTEXT: `` = `@`,
  OP_ACCESSOR_SCOPE: `` = `$`,

  OP_ARROW_SINGLE_LEFT: `Single arrow left` = `<-`,
  OP_ARROW_SINGLE_LEFT_SINGLE_CHAR: `Single arrow left single character` = `←`,
  OP_ARROW_SINGLE_RIGHT: `Single arrow right` = `->`,
  OP_ARROW_SINGLE_RIGHT_SINGLE_CHAR: `Single arrow right single character` = `→`,
  OP_ARROW_DOUBLE_RIGHT: `Double arrow right` = `=>`,
  OP_BITWISE_AND: `Bitwise AND` = `&`,
  OP_BITWISE_OR: `Bitwise OR` = `|`,
  OP_BITWISE_NOT: `Bitwise NOT` = `~`,
  OP_BITWISE_XOR is cantBeFollowedBy([`a non-numeric character`]): `Bitwise XOR (when followed by a number)` = `^`,
  OP_COALESCENCE_NULL: `Null coalescence` = `??`,
  OP_DEFINITION: `Definition` = `:`,
  OP_EQUALITY_LESS_THAN: `Less than` = `<`,
  OP_EQUALITY_LESS_THAN_OR_EQUAL: `Less than or equal to` = `<=`,
  OP_EQUALITY_GREATER_THAN: `Greater than` = `>`,
  OP_EQUALITY_GREATER_THAN_OR_EQUAL: `Greater than or equal to` = `>=`,
  OP_EQUALITY_STRICT: `Equality (Are these two values equal, no auto-casting)` = `==`,
  OP_EQUALITY_UNEQUAL: `Inequality` = `!=`,
  OP_EQUALITY_REFERENCE: `Reference equality (do these refer to the same point in memory)` = `&=`,
  OP_EQUALITY_WITH_CASTING: `About equal (equality + auto-casting)` = `~=`,
  OP_LOGICAL_NOT: `Logical Not` = `!`,
  OP_LOGICAL_ADD: `And` = `&&`,
  OP_LOGICAL_OR: `Or` = `||`,
  OP_QUESTION_MARK: `optional (chaining, type, etc.) or Inline conditional` = `?`,
  OP_REF_LAST: `Previous statement reference` = `^^`,
  OP_REF_DEFINE_LAST: `Apply a definition to the previous statement` = `^^:`,
  OP_SETTER: `Setter` = `=`,
  OP_SETTER_BOOLEAN_TOGGLE: `For boolean, set variable to NOT value` = `=!`,
  OP_SETTER_ADDITIVE: `Add or append and re-set variable` = `=+`,
  OP_SETTER_INCREMENT: `Add 1 to a numeric value and re-set variable` = `=++`,
  OP_SETTER_SUBTRACTIVE: `Subtract and re-set variable` = `=-`,
  OP_SETTER_DECREMENT: `Subtract 1 fom a numeric value and re-set variable` = `=--`,
  OP_SETTER_MULTIPLICATIVE: `Multiply and re-set variable` = `=*`,
  OP_SETTER_POWER: `To power of and re-set variable` = `=**`,
  OP_SETTER_BITWISE_AND: `Bitwise AND and re-set variable` = `=&`,
  OP_SETTER_BITWISSE_OR: `Bitwise OR and re-set variable` = `=|`,
  OP_SETTER_COALESCENCE_NULL: `Set if undefined` = `=??`,
  OP_SETTER_COALESCENCE_FALSEY: `Set if falsey` = `=||`,
  OP_SETTER_COALESCENCE_TRUTHY: `Set if truthy` = `=&&`,

  OP_ADD: `Addition, concatenation` = `+`,
  OP_SUBTRACT: `Subtraction` = `-`,
  OP_MULTIPLY: `Multiplication` = `*`,
  OP_POWER: `Power` = `**`,
  OP_MODULUS: `Modulus` = `%`,
  OP_DIVIDE: `Division` = `/`,
  OP_SPREAD: `Spread` = `...`,
}
