use "../data";
use "./literal";
use "./traits";

alias CommentMode = `mode::comment`;
alias DocumentationMode = `mode::documentation`;

const inComment = `{{CommentMode}} is the top mode on the [[LexerModeStack]]`;
const inInlineComment = `{{CommentMode}} is the top mode on the [[LexerModeStack]] and {{CommentMode}} was pushed onto the stack when an inline comment token was created`;
const inBlockComment = `{{CommentMode}} is the top mode on the [[LexerModeStack]] and {{CommentMode}} was pushed onto the stack when a block comment start token was created`;
const inDocumentation = `{{DocumentationMode}} is the top mode on the [[LexerModeStack]]`;
const inInlineDocumentation = `{{DocumentationMode}} is the top mode on the [[LexerModeStack]] and {{DocumentationMode}} was pushed onto the stack when an inline documentation token was created`;
const inBlockDocumentation = `{{DocumentationMode}} is the top mode on the [[LexerModeStack]] and {{DocumentationMode}} was pushed onto the stack when a block documentation start token was created`;

enum Comment {
  CM_BLOCK_OPEN is modeCreator(CommentMode)
    : `a block comment start [[Token]]` = `/*`,

  CM_BLOCK_CLOSE is modeDestroyer(CommentMode)
    : `a block comment end [[Token]]` = `*/`,

  CM_INLINE_START is modeCreator(CommentMode), clearModeAtNewLine(CommentMode)
    : `an inline comment [[Token]]` = `//`,

  CM_DOC_BLOCK_OPEN is modeCreator(DocumentationMode), cantBeFollowedBy(['/'])
    : `a block documentation start [[Token]]` = `/**`,

  CM_DOC_BLOCK_CLOSE is modeDestroyer(DocumentationMode)
    : `a block documentation end [[Token]]` = `**/`,

  CM_DOC_INLINE_START is modeCreator(DocumentationMode), clearModeAtNewLine(DocumentationMode)
    : `an inline documentation [[Token]]` = `///`,
}
