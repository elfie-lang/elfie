use "../data";

trait modeCreator(mode: string, condition?: string) {
  const onToken = `New token is created for {{@definition}}`;
  with LexerModeStack {
    where (onToken) and (`{{mode}} mode is allowed to be created`) and (condition ?? true)
      -> `Push {{mode}} to top of the mode stack`;
  }
}

trait modeDestroyer(mode: string, condition?: string) {
  const onToken = `New token is created for {{@definition}}`;
  with LexerModeStack {
    where (onToken) and (`Top of mode stack is {{mode}}`) and (condition ?? true)
      -> `Pop the {{mode}} from the top of the stack`;
  }
}

trait modeBoundary(mode: string, condition?: string) {
  const onToken = `New boundary token is created for {{@definition}}`;
  const inMode = `Top of [[LexerModeStack]] stack is {{mode}}`;
  const matchesOpen = `Top of [[LexerModeStack]] stack was created from the same boundary token with {{.}}`
  with LexerModeStack {
    where (onToken) and !(inMode) and (condition ?? true)
      -> `Push {{mode}} to top of the mode stack`;
    where (onToken) and (inMode) and (matchesOpen)
      -> `Pop the {{mode}} from the top of the stack`;
  }
}

trait clearModeAtNewLine(mode: string) {
  const onToken = `Next \n or \r\n or EOF is encountered after {{mode}} is created for {{@definition}}`;
  with LexerModeStack {
    where (onToken) and (`Top of mode stack is {{mode}}`)
      -> `Pop the {{mode}} from the top of the stack`;
  }
}

trait cantBeFollowedBy(forbidden: string[]) {
  for(const str in forbidden) {
    where (`Token {{.}} is a candidate token for lexer from [[@]]`) -> `Is not considered a match if followed by {{str}}`;
  }
}
