use "../grammar/main" as Grammar;
use "../grammar/terminals/keyword";
use "../grammar/terminals/literal";
use "../grammar/terminals/punctuation";
use "../grammar/terminals/space";
use "../grammar/traits";
use "./data";
use "./modes";
use "./traits";

ace function matches(rule: Rule) {
  return `The characters at the current position match {{rule.syntax}} from {{rule.identifier}} ([[&rule$&]])`;
}

ace function push(kind: string) {
  return `A [[Token]] for {{kind}} is created from the matched characters and appended to the result`;
}

fn lex(source: string, file?: string): `Turn source text into tokens` => Token[] {
  @acceptanceCriteria
    .add({ behavior = `[[source]] is read as UTF-8 from start to end` })
    .add({ situation = `[[file]] is set`, behavior = `[[Token.file]] is set to {{file}}` })
    .add({ situation = `[[file]] is not defined`, behavior = `[[Token.file]] is set to "anonymous"` })
    .add({ behavior = `End of line tokens can match any [[NewLine]] terminal and the values are treated equally` })
    .add({ behavior = `[[Token.line]] is set to the line number (1-indexed) in [[source]] that this starts at` })
    .add({ behavior = `[[Token.column]] is set to the 0-indexed column in the line that this token starts at` })
    .add({ behavior = `[[Token.raw]] is the original set of all characters that makes up the token` })
    .add({ behavior = `A new [[ModeStack]] is created for each call` })
    .add({
      behavior = `At each position every [[terminal]] whose [[candidateInModes]] condition holds (or [[inCode]] when it has none) is matched`,
    })
    .add({ behavior = `The longest match is the token` })
    .add({
      situation = [
        `Tokens are of equal length`,
        `No other criteria specifies which token wins`,
      ],
      behavior = `A compile-time lexer error naming both terminals`,
    })
    .add({
      situation = `Terminal has criteria for what [[Token.value]] should be`,
      behavior = `Terminal criteria is respected`,
    })
    .add({
      situation = `Terminal does not have criteria for what [[Token.value]] should be`,
      behavior = `[[Token.value]] should be equal to [[Token.raw]]`,
    })
    .add({
      situation = `No terminal matches at a position`,
      behavior = `One [[Token]] with no [[Token.rule]] is created from the characters up to the next position where some terminal matches, and lexing continues`,
    })
    .add({
      situation = `The source ends while the [[ModeStack]] holds more than a single code mode`,
      behavior = `For each remaining mode, an invalid [[Token]] with no [[Token.rule]] and empty [[Token.raw]] is appended whose [[Token.value]] names the mode that was not closed`,
    });

  @test(
    {
      input = [''],
      expect = [],
    },
    {
      input = ['const x = 1_0;'],
      expect = [
        Token@like(`Token for [[ConstKeyword]] with value "const"`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[Identifier]] with value "x"`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[PlainSetter]] with value "="`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[NumberLiteral]] with value "10"`),
        Token@like(`Token for [[Semicolon]] with value ";"`),
      ],
    },
    {
      input = ['`a {{b}} c`;'],
      expect = [
        Token@like(`Token for [[Backtick]] with value "\`"`),
        Token@like(`Token for [[TemplateBody]] with value "a "`),
        Token@like(`Token for [[ExecutionOpen]] with value "\{{"`),
        Token@like(`Token for [[Identifier]] with value "b"`),
        Token@like(`Token for [[ExecutionClose]] with value "\}}"`),
        Token@like(`Token for [[TemplateBody]] with value " c"`),
        Token@like(`Token for [[Backtick]] with value "\`"`),
        Token@like(`Token for [[Semicolon]] with value ";"`),
      ],
    },
    {
      input = [`'it\\'s'`],
      expect = [
        Token@like(`Token for [[SingleQuote]] with value "'"`),
        Token@like(`Token for [[SingleQuoteBody]] with value "it's"`),
        Token@like(`Token for [[SingleQuote]] with value "'"`),
      ],
    },
  );

  // The terminal document is the only grammar the lexer knows
  const terminals: `EBNF of every terminal` = Grammar.terminalDocument();
  @acceptanceCriteria
    .add({
      behavior = `Reads a bare name inside a rule as a reference to the terminal or character class with that identifier`,
    })
    .add({ behavior = `Matches against the following terminals only: \n\n {{terminals}}` });

  for (const rule in terminal@entities) {
    where (matches(rule.rule)) and (rule.lexCondition ?? inCode) -> push(&rule@definition);
  }

  for (const rule in keyword@entities) {
    where (`[[&rule]] and [[Identifier]] match the same characters`) -> `[[&rule]] is the token`;
  }

  for (const rule in escape@entities) {
    @acceptanceCriteria.add({
      behavior = `Matched only as part of another terminal`,
      sideEffects = [`Can never be a token`],
    });
  }

  where (`No candidate matched`) -> push(`invalid text`);
}
