use "../grammar/main" as Grammar;
use "../grammar/terminals/comment";
use "../grammar/terminals/identifier";
use "../grammar/terminals/keyword";
use "../grammar/terminals/literal";
use "../grammar/terminals/punctuation";
use "../grammar/terminals/space";
use "../grammar/traits";
use "./data";
use "./modes";
use "./traits";

fn lex(source: string, file: string = "anonymous"): `Turn source text into tokens` => Token[] {
  @acceptanceCriteria
    .add({ behavior = `The call ends in time linear in the length of [[source]]` })
    .add({ behavior = `Every [[Token.file]] is [[file]]` })
    .add({ behavior = `The whole [[source]] is one code region, which no token opens or closes` })
    .add({ behavior = `A region a token opens is nested in the innermost open region before that token` })
    .add({ behavior = `The innermost open region is the most recently opened region that is still open` })
    .add({
      situation = [
        `A token is of a terminal that closes some open region`,
        `That region is not the innermost open one`,
      ],
      behavior = `That region stays open`,
    })
    .add({
      situation = `A [[terminal]] is neither [[lexedIn]] nor an [[escape]]`,
      behavior = `A token of it begins only where [[inCode]] holds`,
    })
    .add({ behavior = `Of the terminals that may be lexed at a position, the longest match is the token` })
    .add({
      situation = `Two terminals that may be lexed at a position have longest matches of equal length there`,
      behavior = `Building the lexer fails with an error naming both terminals`,
    })
    .add({
      situation = `No terminal that may be lexed at a position matches there`,
      behavior = `One [[Token]] with null [[Token.rule]] is created from the characters up to the next position where some terminal that may be lexed there matches`,
    })
    .add({
      situation = `Regions other than the code region are still open at the end of [[source]]`,
      behavior = [
        `Each of them gives one [[Token]] with null [[Token.rule]], empty [[Token.raw]], and [[Token.value]] equal to its [[Mode]]`,
        `These tokens come after every other token, innermost last`,
      ],
    });

  @test(
    {
      input = [''],
      expect = [],
    },
    {
      input = ['const x = 1_0;'],
      expect = [
        Token@like(`Token for [[ConstKeyword]] with value "const"`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[Identifier]] with value "x"`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[PlainSetter]] with value "="`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[NumberLiteral]] with value "10"`),
        Token@like(`Token for [[Semicolon]] with value ";"`),
      ],
    },
    {
      input = ['`a {{b}} c`;'],
      expect = [
        Token@like(`Token for [[Backtick]] with value "\`"`),
        Token@like(`Token for [[TemplateBody]] with value "a "`),
        Token@like(`Token for [[ExecutionOpen]] with value "\{{"`),
        Token@like(`Token for [[Identifier]] with value "b"`),
        Token@like(`Token for [[ExecutionClose]] with value "\}}"`),
        Token@like(`Token for [[TemplateBody]] with value " c"`),
        Token@like(`Token for [[Backtick]] with value "\`"`),
        Token@like(`Token for [[Semicolon]] with value ";"`),
      ],
    },
    {
      input = [`'it\\'s'`],
      expect = [
        Token@like(`Token for [[SingleQuote]] with value "'"`),
        Token@like(`Token for [[SingleQuoteBody]] with value "it's"`),
        Token@like(`Token for [[SingleQuote]] with value "'"`),
      ],
    },
    {
      input = ["`{{`{{'c'}}`}}`"],
      expect = [
        Token@like(`Token for [[Backtick]] with value "\`"`),
        Token@like(`Token for [[ExecutionOpen]] with value "\{{"`),
        Token@like(`Token for [[Backtick]] with value "\`", opening a template nested in the expression`),
        Token@like(`Token for [[ExecutionOpen]] with value "\{{"`),
        Token@like(`Token for [[SingleQuote]] with value "'"`),
        Token@like(`Token for [[SingleQuoteBody]] with value "c"`),
        Token@like(`Token for [[SingleQuote]] with value "'"`),
        Token@like(`Token for [[ExecutionClose]] with value "\}}"`),
        Token@like(`Token for [[Backtick]] with value "\`", closing the inner template`),
        Token@like(`Token for [[ExecutionClose]] with value "\}}"`),
        Token@like(`Token for [[Backtick]] with value "\`", closing the outer template`),
      ],
    },
    {
      input = ["'abc\nx"],
      expect = [
        Token@like(`Token for [[SingleQuote]] with value "'"`),
        Token@like(`Token for [[SingleQuoteBody]] with value "abc"`),
        Token@like(`Token for [[NewLine]] with value "\\n"`),
        Token@like(`Token for [[Identifier]] with value "x"`),
      ],
    },
    {
      input = ['`a {{ b'],
      expect = [
        Token@like(`Token for [[Backtick]] with value "\`"`),
        Token@like(`Token for [[TemplateBody]] with value "a "`),
        Token@like(`Token for [[ExecutionOpen]] with value "\{{"`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[Identifier]] with value "b"`),
        Token@like(`Invalid token with empty raw text and value "template"`),
        Token@like(`Invalid token with empty raw text and value "template execution"`),
      ],
    },
    {
      input = ["`{{ '}}' }}`"],
      expect = [
        Token@like(`Token for [[Backtick]] with value "\`"`),
        Token@like(`Token for [[ExecutionOpen]] with value "\{{"`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[SingleQuote]] with value "'"`),
        Token@like(`Token for [[SingleQuoteBody]] with value "\}}"`),
        Token@like(`Token for [[SingleQuote]] with value "'"`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Token for [[ExecutionClose]] with value "\}}"`),
        Token@like(`Token for [[Backtick]] with value "\`"`),
      ],
    },
    {
      input = ['iffy'],
      expect = [Token@like(`Token for [[Identifier]] with value "iffy"`)],
    },
    {
      input = ['/**/'],
      expect = [
        Token@like(`Token for [[BlockCommentOpen]] with value "/*"`),
        Token@like(`Token for [[BlockCommentClose]] with value "*/"`),
      ],
    },
    {
      input = ['/***/'],
      expect = [
        Token@like(`Token for [[BlockCommentOpen]] with value "/*"`),
        Token@like(`Token for [[BlockCommentBody]] with value "*"`),
        Token@like(`Token for [[BlockCommentClose]] with value "*/"`),
      ],
    },
    {
      input = ['/* a /* b */ c */'],
      expect = [
        Token@like(`Token for [[BlockCommentOpen]] with value "/*"`),
        Token@like(`Token for [[BlockCommentBody]] with value " a "`),
        Token@like(`Token for [[BlockCommentOpen]] with value "/*", opening a nested block comment`),
        Token@like(`Token for [[BlockCommentBody]] with value " b "`),
        Token@like(`Token for [[BlockCommentClose]] with value "*/", closing the nested block comment`),
        Token@like(`Token for [[BlockCommentBody]] with value " c "`),
        Token@like(`Token for [[BlockCommentClose]] with value "*/", closing the outer block comment`),
      ],
    },
    {
      input = ["a\r\nb"],
      expect = [
        Token@like(`Token for [[Identifier]] with value "a"`),
        Token@like(`Token for [[NewLine]] with raw text "\\r\\n" and value "\\n"`),
        Token@like(`Token for [[Identifier]] with value "b"`),
      ],
    },
    {
      input = ["/*\n*/x"],
      expect = [
        Token@like(`Token for [[BlockCommentOpen]] on line 1, column 0`),
        Token@like(`Token for [[BlockCommentBody]] with value "\\n" on line 1, column 2`),
        Token@like(`Token for [[BlockCommentClose]] on line 2, column 0`),
        Token@like(`Token for [[Identifier]] with value "x" on line 2, column 2`),
      ],
    },
    {
      input = [`"\\uD800"`],
      expect = [
        Token@like(`Token for [[DoubleQuote]] with value '"'`),
        Token@like(`Token for [[DoubleQuoteBody]] with value "\\uD800", the escape kept as written`),
        Token@like(`Token for [[DoubleQuote]] with value '"'`),
      ],
    },
    {
      input = ['a<=b<c'],
      expect = [
        Token@like(`Token for [[Identifier]] with value "a"`),
        Token@like(`Token for [[LessThanOrEqual]] with value "<="`),
        Token@like(`Token for [[Identifier]] with value "b"`),
        Token@like(`Token for [[LessThan]] with value "<"`),
        Token@like(`Token for [[Identifier]] with value "c"`),
      ],
    },
    {
      input = ['x ##y'],
      expect = [
        Token@like(`Token for [[Identifier]] with value "x"`),
        Token@like(`Token for [[Space]] with value " "`),
        Token@like(`Invalid token with raw text "##"`),
        Token@like(`Token for [[Identifier]] with value "y"`),
      ],
    },
  );

  // The terminal document is the only grammar the lexer knows
  const terminals: `EBNF of every terminal` = Grammar.terminalDocument();
  @acceptanceCriteria
    .add({
      behavior = `Reads a bare name inside a rule as a reference to the terminal or character class with that identifier`,
    })
    .add({ behavior = `Matches against the following terminals only: \n\n {{terminals}}` });
}
