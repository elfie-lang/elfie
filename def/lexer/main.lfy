use "./data";
use "./tokens/comment";
use "./tokens/identifier";
use "./tokens/keyword";
use "./tokens/literal";
use "./tokens/operator";
use "./tokens/separator";
use "./tokens/whitespace";


fn lexString(str: string, file?: string): `Turn a given string into a set of lexigraphical tokens` => Token[] {
  @acceptanceCriteria
    .add({ behavior = `[[str]] is read as a UTF-8 string`, })
    .add({ behavior = `[[str]] is tokenized by processing the string start to finish`, })
    .add({ situation = `[[str]] is empty`, expect: [], })
    .add({ situation = `[[file]] is set`, behavior = `[[Token.file]] is set to {{file}}`, })
    .add({ situation = `[[file]] is not defined`, behavior = `[[Token.file]] is set to "anonymous"`, })
    .add({ behavior = `End of line tokens can be either \n or \r\n interchangably and the values are treated equally`, })
    .add({ behavior = `[[Token.line]] is set to the line number (1-indexed) in [[str]] that this starts at`, })
    .add({ behavior = `[[Token.position]] is set to the 0-indexed position in the line that this token starts at`, })
    .add({ behavior = `[[Token.raw]] is the original set of all characters that makes up the token`, })
    .add({ behavior = `New [[LexerModeStack]] is initialized for each run`, sideEffects: [`[[LexerModeStack]] responds when new tokens are created to manage modes based on tokens`], })
    .add({ situation = `Reached end of string and [[LexerModeStack]] for the run is not empty`, behavior = `Throws error indicating an unexpected end of file`, })
    .add({
      situation = `Characters would match multiple different tokens`,
      behavior = `Applies context and [[LexerModeStack]] mode to determine which follow characters are allowed for the given situation, then uses a maximal munch approach`,
    });

  // Literals
  for (const key, token from Literal) {
    where (`Characters match {{token}} from [[key]]`) and !(inComment) and !(inDocumentation) -> `A new [[Token]] is pushed to the results as {{key@definition}}`;
  }

  where (`Characters match {{TemplateBlock.TB_EXECUTION_OPEN}} from [[TemplateBlock.TB_EXECUTION_OPEN]]`) and (inTemplate) -> `A new [[Token]] is pushed to the results as {{TemplateBlock.TB_EXECUTION_OPEN@definition}}`;
  where (`Characters match {{TemplateBlock.TB_EXECUTION_CLOSE}} from [[TemplateBlock.TB_EXECUTION_CLOSE]]`) and (inTemplateExecution) -> `A new [[Token]] is pushed to the results as {{TemplateBlock.TB_EXECUTION_CLOSE@definition}}`;
  where (`Characters match {{TemplateBlock.TB_REFERENCE_OPEN}} from [[TemplateBlock.TB_REFERENCE_OPEN]]`) and (inTemplate) -> `A new [[Token]] is pushed to the results as {{TemplateBlock.TB_REFERENCE_OPEN@definition}}`;
  where (`Characters match {{TemplateBlock.TB_REFERENCE_CLOSE}} from [[TemplateBlock.TB_REFERENCE_CLOSE]]`) and (inTemplateReference) -> `A new [[Token]] is pushed to the results as {{TemplateBlock.TB_REFERENCE_CLOSE@definition}}`;

  where
    (`Lexing encounters a digit (0-9) followed by zero or more digits (0-9) or . or _ characters`)
    and !(inComment)
    and !(inDocumentation)
    and !(inString)
    and !(inTemplate)
      -> `Those characters become a number [[Token]] with _ characters stripped out of the [[Token.value]]`;

  for (const key, token from Sequence) {
    where (`Characters match {{token}} from [[key]]`) and ((inString) or (inTemplate)) -> `Sequence is replaced in the body content with {{key@definition}}`;
  }

  where ((inTemplate) or (inString)) and !(`Matched with a sequence or block that is valid in this mode`) -> `Characters are treated as plain text and grouped into a new text [[Token]] until the boundary or block`;
  where ((inTemplate) or (inString))
    and ((`Characters match {{Literal.LT_STRING_SINGLE_BOUNDARY}}`) or (`Characters match {{Literal.LT_STRING_DOUBLE_BOUNDARY}}`) or (`Characters match {{Literal.LT_STRING_TEMPLATE_BOUNDARY}}`))
    and (`Character does not match the boundary character that started this mode`)
      -> `Characters are treated as plain text, not tokens for parsing`;

  // Comments
  for(const key, token from Comment) {
    where (`Characters match {{token}}`)
      and !(inString)
      and !(inTemplate)
      and !(inInlineComment)
      and !(inInlineDocumentation)
      and !(key.includes('INLINE') ? inBlockComment : false)
      and !(key.includes('INLINE') ? inBlockDocumentation : false)
        -> `A new [[Token]] is pushed to the results as {{key@definition}}`;
  }

  where (inComment) and !(`Matched with a sequence or block that is valid inside {{CommentMode}}`) -> `characters are treated a plain text and placed in a shared new comment body [[Token]]`;
  where (inDocumentation) and !(`Matched with a sequence or block that is valid inside {{DocumentationMode}}`) -> `characters are treated as plain text and placed in a shared new documentation body [[Token]]`;

  // Keywords
  for(const key, token from Keyword) {
    where (`Characters match {{token}} from [[key]]`) and !(inString) and !(inTemplate) and !(inComment) and !(inDocumentation) -> `A new [[Token]] is pushed to the results as {{key@definition}}`;
  }

  // Operators
  for(const key, token from Operator) {
    where (`Characters match {{token}} from [[key]]`) and !(inString) and !(inTemplate) and !(inComment) and !(inDocumentation) -> `A new [[Token]] is pushed to the results as {{key@definition}}`;
  }

  // Separators
  for(const key, token from Separator) {
    where (`Characters match {{token}} from [[key]]`) and !(inString) and !(inTemplate) and !(inComment) and !(inDocumentation) -> `A new [[Token]] is pushed to the results as {{key@definition}}`;
  }

  // Whitespace
  for(const key, token from Space) {
    where (`Characters match {{token}} from [[key]]`) and !(inString) and !(inTemplate) and !(inComment) and !(inDocumentation) -> `A new space [[Token]] is pushed to the results`;
  }

  // Identifiers
  where
    (`Lexing encounters an Unicode XID_Start or _ character followed by any number of Unicode XID_Continue characters and the combination of all the characters do not match a keyword`)
    and !(inComment)
    and !(inDocumentation)
    and !(inString)
    and !(inTemplate)
      -> `Those characters become an identifier [[Token]]`;

  where (`Character does not match any rule`) -> `Raise an unexpected token error`
}