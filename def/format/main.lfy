use "../grammar/rules/expression";
use "../grammar/rules/statement";
use "../grammar/terminals/comment";
use "../grammar/terminals/punctuation";
use "../grammar/terminals/space";
use "../grammar/traits";
use "../lexer/data";
use "../parser/data";
use "../parser/traits";

// Decision: the formatter works on the lossless [[Tree]] rather than on tokens, so layout follows
// the rule a token belongs to. It is its own module because both the command line and the language
// server format, and neither should own the rules.

fn format(tree: Tree): `The source of a tree, laid out the standard way` => string {
  // Invariants
  @acceptanceCriteria
    .add({
      behavior = [
        `The tokens of the result, [[trivia]] aside, are [[Tree.tokens]] with the same [[Token.value]] in the same order`,
        `Formatting the result again gives the same result`,
        `The text of every [[body]] token, [[Comment]], and [[Documentation]] is kept exactly, even its line breaks`,
        `Every line ends with one line feed and the result ends with one`,
      ],
    })
    .add({
      situation = `[[Tree.errors]] is not empty`,
      behavior = `The result is the source unchanged, because moving tokens the parser could not place would hide the error`,
    });

  // Lines and indentation
  @acceptanceCriteria
    .add({
      behavior = `Each [[Statement]] begins on its own line, indented two spaces per enclosing [[Block]], [[Object]], [[Type]], or multi-line [[List]], [[Arguments]], or [[Parameters]]`,
    })
    .add({
      behavior = `A run of blank lines between statements becomes one blank line; blank lines inside a statement are removed`,
    })
    .add({
      behavior = `[[Documentation]] and a [[Comment]] on its own line stay on their own line before what follows them, indented like it; a [[Comment]] that shares a line with code stays at the end of that line after one space`,
    })
    .add({ behavior = `Trailing spaces are removed and every [[NewLine]] becomes a line feed` });

  // Spacing
  @acceptanceCriteria
    .add({
      behavior = `One space on both sides of every [[infix]] operator, [[SingleArrow]], and [[DoubleArrowRight]]; none between a [[prefix]] operator and its operand, nor between a [[postfix]] operator and the expression before it`,
    })
    .add({
      behavior = `One space after each [[Comma]] and [[Colon]] and none before; none after [[GroupOpen]], [[ListOpen]], [[ReferenceOpen]], or [[ExecutionOpen]] and none before their closes`,
    })
    .add({
      behavior = `One space between a keyword and what follows it, and between a closing [[GroupClose]] and a [[BlockOpen]]`,
    })
    .add({
      behavior = `The [[LessThan]] and [[GreaterThan]] of [[TypeParameters]], [[TypeArguments]], and [[Generic]] are brackets, not operators: no space after the [[LessThan]] and none before the [[GreaterThan]]; [[TypeParameters]] attach to the [[Identifier]] before them and [[TypeArguments]] and [[Generic]] to the expression before them without a space`,
    })
    .add({
      behavior = `A [[FunctionType]] is laid out as its [[Parameters]] are, then one space, the [[DoubleArrowRight]], one space, and the type`,
    })
    .add({
      behavior = `A [[Block]] opens on the line of its statement and its close stands alone on its own line; an empty [[Block]] is the two braces together`,
    });

  // Wrapping
  @acceptanceCriteria
    .add({
      situation = `A [[List]], [[Object]], [[Type]], [[Arguments]], [[Parameters]], [[Items]], or [[TraitUses]] held a [[NewLine]] between its brackets in the source, or the line would exceed 120 characters`,
      behavior = `It is multi-line: one item per line, each ending with a [[Comma]], the close on its own line`,
    })
    .add({
      situation = `A [[List]], [[Object]], [[Type]], [[Arguments]], [[Parameters]], [[Items]], or [[TraitUses]] held no [[NewLine]] between its brackets in the source, and the line would not exceed 120 characters`,
      behavior = `It stays on one line and a trailing [[Comma]] before the close is removed`,
    })
    .add({
      situation = `[[TypeParameters]], [[TypeArguments]], or the arguments of a [[Generic]] would make the line exceed 120 characters`,
      behavior = `They are multi-line like [[Arguments]]: one item per line, each ending with a [[Comma]], the [[GreaterThan]] on its own line; otherwise they stay on one line whatever the source held`,
    })
    .add({
      situation = `A chain of [[Call]] and [[Member]] on one left side, such as add on acceptanceCriteria, held a [[NewLine]] before an accessor in the source`,
      behavior = `Each [[Member]] of the chain begins a new line indented one level below the chain's first line`,
    });

  @test(
    {
      input = [Tree@like(`The parse of: const   x=1 ;`)],
      expect = `const x = 1;\n`,
    },
    {
      input = [Tree@like(`The parse of: fn f(a:string)=>number{@acceptanceCriteria.add({behavior=\`b\`,});}`)],
      expect = `fn f(a: string) => number {\n  @acceptanceCriteria.add({ behavior = \`b\` });\n}\n`,
    },
    {
      input = [Tree@like(`The parse of: const = 1;`)],
      expect = `const = 1;`,
    },
    {
      input = [Tree@like(`The parse of: fn map < T,U >(list:List< T >,transform:( item:T )=>U)=>List<U>;`)],
      expect = `fn map<T, U>(list: List<T>, transform: (item: T) => U) => List<U>;\n`,
    },
  );
}
