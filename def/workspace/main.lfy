use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../interpret/main" as Interpreter;
use "../lexer/main" as Lexer;
use "../model/data";
use "../model/main" as Binder;
use "../parser/main" as Parser;
use "./data";
use "elfie/system/file" as FileSystem;
use "elfie/system/path";
use "elfie/system/process" as Process;
use "elfie/prelude/trait" as Traits;
use "elfie/target" as Targets;
use "elfie/target/ecosystem";
use "elfie/target/framework";
use "elfie/target/interface";
use "elfie/target/language";
use "elfie/target/layout";
use "elfie/target/platform";
use "elfie/target/runtime";
use "elfie/target/target";

fn load(root: string): `Load a project from disk and bind it` => Workspace {
  // Passes
  @acceptanceCriteria
    .add({
      behavior = [
        `Loading reads the project layout, discovers every file, orders the files by what they use, then binds them once`,
        `[[Workspace.root]] is [[root]]`,
        `Loading never stops for a failure`,
        `Every failure while loading is a [[LoadProblem]] or a [[Problem]], and the rest of the project still loads`,
      ],
    })
    .add({
      behavior = `[[Workspace.files]] are the [[Source]]s the model was bound from, so each holds the path every [[Use]] in it resolved to`,
    });

  // Layout
  @acceptanceCriteria
    .add({
      situation = `elfie.json under [[root]] is a JSON object that gives a name`,
      behavior = `[[Workspace.name]] is the name elfie.json gives`,
    })
    .add({
      situation = `elfie.json under [[root]] is a JSON object that gives no name`,
      behavior = `[[Workspace.name]] is the name of the [[root]] directory`,
    })
    .add({
      situation = `elfie.json under [[root]] is a JSON object that gives a source directory`,
      behavior = `[[Workspace.sourceDirectory]] is the source directory elfie.json gives`,
    })
    .add({
      situation = `elfie.json under [[root]] is a JSON object that gives no source directory`,
      behavior = `[[Workspace.sourceDirectory]] is def`,
    })
    .add({
      situation = `elfie.json under [[root]], or an entry of it, has a key the loader does not read, such as targets, output, or native, which earlier versions read`,
      behavior = `The key is ignored and adds no problem, so a manifest written for another version or another tool still loads`,
    })
    .add({
      situation = `A key the loader reads has a value of the wrong kind, such as a dependency whose root is not a string`,
      behavior = `A [[LoadProblem]] for elfie.json names the key and what it should be, and the rest of the manifest is still read`,
    })
    .add({
      situation = `[[FileSystem.exists]] finds elfie.json under [[root]] but [[FileSystem.read]] of it is undefined, or its text is not a JSON object`,
      behavior = `A [[LoadProblem]] for it is added, [[Workspace.name]] is the name of the [[root]] directory, and [[Workspace.sourceDirectory]] is def`,
    })
    .add({
      situation = `No elfie.json exists under [[root]]`,
      behavior = `[[Workspace.name]] is the name of the [[root]] directory, [[Workspace.sourceDirectory]] is def, and no problem is added, since a manifest is optional`,
    })
    .add({
      situation = `[[FileSystem.exists]] is false for [[root]], or for [[Workspace.sourceDirectory]] under it`,
      behavior = `A [[LoadProblem]] with no path is added and [[Workspace.files]] is empty`,
    });

  // Discovery
  @acceptanceCriteria
    .add({
      behavior = [
        `Every file [[FileSystem.list]] gives recursively under [[Workspace.sourceDirectory]] whose [[Path.extension]] is lfy is in the program, with no [[File.package]]`,
        `Every file a [[Use]] in a file of the program refers to is in the program`,
        `A file is in [[Workspace.files]] once, however many files use it`,
      ],
    })
    .add({
      behavior = `[[File.path]] is the file's path relative to [[Workspace.root]]: [[Path.join]] of the directory listed and the path [[FileSystem.list]] gave under it; [[File.tree]] is what [[Parser.parse]] gives for [[Lexer.lex]] of [[FileSystem.read]] of the file with that path as the file, satisfying [[SourceFile]]`,
    })
    .add({
      situation = `[[FileSystem.read]] of a file is undefined`,
      behavior = `A [[LoadProblem]] for its path is added and it is left out of the program`,
    });

  // use
  @acceptanceCriteria
    .add({
      situation = `A [[Use]] names a path beginning with a dot`,
      behavior = `It is [[Path.join]] of [[Path.parent]] of the file that holds it and the path, then [[Path.normalize]]`,
    })
    .add({
      situation = `A [[Use]] names a path beginning with anything else`,
      behavior = `The first of its [[Path.segments]] names a [[Package]], and the path is [[Path.join]] of that [[Package.root]] and the remaining segments`,
    })
    .add({
      situation = `[[FileSystem.exists]] is true for the path a [[Use]] names, once joined to its file's directory or its package's root, plus .lfy`,
      behavior = `The [[Use]] resolves to the file at the path plus .lfy`,
    })
    .add({
      situation = `[[FileSystem.exists]] is false for the path a [[Use]] names, once joined to its file's directory or its package's root, plus .lfy, and true for [[Path.join]] of that path and main.lfy`,
      behavior = `The [[Use]] resolves to the file at [[Path.join]] of the path and main.lfy`,
    })
    .add({
      situation = `[[FileSystem.exists]] is true for both the joined path of a [[Use]] plus .lfy and [[Path.join]] of that path and main.lfy`,
      behavior = `The [[Use]] resolves to the path plus .lfy`,
    })
    .add({
      situation = `A [[Use]] resolves to no file`,
      behavior = `A [[Problem]] is added at the [[Use]] and its entry in [[Source.uses]] is undefined`,
    });

  // Order
  @acceptanceCriteria
    .add({ behavior = `[[Workspace.files]] places every file after the files it uses` })
    .add({
      situation = `The use statements form a cycle`,
      behavior = `A [[Problem]] is added at each [[Use]] in the cycle and those files keep the order they were discovered in`,
    });

  // Dependencies
  @acceptanceCriteria
    .add({ behavior = `Each dependency elfie.json names gives one [[Package]]` })
    .add({
      behavior = `Every file [[FileSystem.list]] gives recursively under a [[Package.root]] whose [[Path.extension]] is lfy is in the program and carries that package as its [[File.package]]`,
    })
    .add({
      situation = `[[FileSystem.exists]] is false for a [[Package.root]]`,
      behavior = `A [[LoadProblem]] for it is added and no file of it is in the program`,
    });

  // The package elfie
  @acceptanceCriteria
    .add({
      behavior = [
        `The [[Package]] named elfie is in the program whether or not elfie.json names it, and every file [[FileSystem.list]] gives recursively under its [[Package.root]] whose [[Path.extension]] is lfy is in the program and carries it as its [[File.package]]`,
      ],
    })
    .add({
      situation = `elfie.json has the dependency entry elfie`,
      behavior = `The [[Package.root]] of the [[Package]] named elfie is the directory that entry gives, whether or not that directory exists`,
    })
    .add({
      situation = `elfie.json has no dependency entry elfie and has the top level key lib`,
      behavior = `The [[Package.root]] of the [[Package]] named elfie is the directory lib gives, relative to [[root]], whether or not that directory exists`,
    })
    .add({
      situation = `elfie.json has neither the dependency entry elfie nor the top level key lib, and [[Process.environment]] gives a directory for ELFIE_LIB`,
      behavior = `The [[Package.root]] of the [[Package]] named elfie is the directory [[Process.environment]] gives for ELFIE_LIB, whether or not that directory exists`,
    })
    .add({
      situation = `elfie.json has neither the dependency entry elfie nor the top level key lib, and [[Process.environment]] gives no directory for ELFIE_LIB`,
      behavior = `The [[Package.root]] of the [[Package]] named elfie is the copy of the library the compiler was built with, which the target's guidance says how it travels`,
    })
    .add({
      behavior = [
        `[[Source.origin]] of the file main.lfy at the [[Package.root]] of the [[Package]] named elfie is [[Origin.prelude]], of every other file of that package [[Origin.library]], and of every file not in that package [[Origin.program]]`,
      ],
    });

  // Targets
  @acceptanceCriteria
    .add({
      behavior = [
        `After binding, every ace const of a project file whose value is a [[Targets.Target]] gives one [[Target]]: its declared type is [[Targets.Target]], or its value is a call of a function whose output is [[Targets.Target]]`,
        `[[Target.identifier]] is the const's name and [[Target.declaration]] is the const's entity`,
        `A const of a file of a package gives no target, whatever it holds`,
      ],
    })
    .add({
      behavior = `A target's slots are read from [[Interpreter.evaluate]] of the const's value: the keys output, language, runtime, platforms, ecosystem, frameworks, interfaces, layout, layers, and dependencies, where each layer is a trait, or an object holding a trait as subject and its arguments as arguments, as [[Traits.Layer]] is`,
    })
    .add({
      behavior = [
        `[[Target.layers]] is the trait of each layer of the slots layers, interfaces, frameworks, layout, runtime, platforms, ecosystem, and language, in that order and each slot in its own order`,
        `A trait in two slots with equal arguments is in [[Target.layers]] once, at its first place`,
      ],
    })
    .add({
      behavior = `[[Target.outputDirectory]] is the output the const's value gives, with any trailing slash removed`,
    })
    .add({
      behavior = [
        `[[Target.markerComment]] is the value the declaration's setters give markerComment, and [[Target.extensions]] is the value they give fileExtension followed by every item of every value they give outputExtensions, each once`,
        `[[Target.scriptRunner]] is the value they give scriptRunner, undefined when none does`,
      ],
    })
    .add({
      behavior = `[[Target.nativeDependencies]] holds one [[NativeDependency]] per item of the dependencies slot, in order: its name as [[NativeDependency.identifier]], its version as [[NativeDependency.version]], and as [[NativeDependency.ecosystem]] the value the declaration's setters give ecosystem`,
    })
    .add({
      behavior = [
        `[[Target.commands]] holds, for each [[Operation]] in the order it lists them, the first command with that operation among the declaration's commands that neither a layer nor a trait a layer extends contributed, whoever else contributed them, such as the file that adds one with an add call on the const's commands; and only when there is none, the first among those the layers and the traits they extend contributed, in guidance order`,
        `An operation whose first command has no line has no command in [[Target.commands]], and an operation no command names has none either`,
      ],
    })
    .add({
      behavior = `[[Target.knowledge]] is the declaration's knowledge that neither a layer nor a trait a layer extends contributed, in the order added, then the knowledge of the layers and the traits they extend, in guidance order`,
    })
    .add({
      behavior = `[[Workspace.targets]] holds the targets in the order their consts are declared: file by file in [[Workspace.files]] order, then source order`,
    });

  // Problems with targets
  @acceptanceCriteria
    .add({
      situation = `A slot of a target holds a layer whose trait extends neither the role of that slot nor a trait that extends it, directly or through other traits`,
      behavior = `A [[Problem]] at the const's declaration names the target, the slot, and the trait; the roles are [[targetLanguage]] for language, [[targetRuntime]] for runtime, [[targetPlatform]] for platforms, [[targetEcosystem]] for ecosystem, [[targetFramework]] for frameworks, [[targetInterface]] for interfaces, [[targetLayout]] for layout, and [[target]] for layers`,
    })
    .add({
      situation = `A target's value gives no output, no language, or no layout`,
      behavior = `A [[Problem]] at the const's declaration names the target and what is missing, and the target is left out of [[Workspace.targets]]`,
    })
    .add({
      situation = `An item of a value the declaration's setters give requires is not an item of any value they give provides`,
      behavior = `A [[Problem]] at the const's declaration says the target requires that capability and none of its layers provides it`,
    })
    .add({
      situation = `A target has dependencies and no ecosystem`,
      behavior = `A [[Problem]] at the const's declaration says its dependencies need an ecosystem`,
    })
    .add({
      situation = `Two targets have the same output directory, or the output directory of one is inside the other's`,
      behavior = `A [[Problem]] at the declaration of each names both targets and the directory`,
    })
    .add({
      situation = `A knowledge item of an entity of the program has the kind reference or example, and [[FileSystem.exists]] is false for its source joined to the [[Package.root]] of the package of the file its contributor is declared in, or to [[Workspace.root]] when that file is the project's own`,
      behavior = `A [[Problem]] at the declaration of the entity holding it says the source does not exist`,
    })
    .add({
      situation = `A knowledge item's source begins with http:// or https://`,
      behavior = `A [[Problem]] at the declaration of the entity holding it says knowledge is vendored, so a compile never depends on the network`,
    });

  // Binding
  @acceptanceCriteria
    .add({
      behavior = `[[Workspace.model]] is [[Binder.bind]] of [[Workspace.files]], called once, with each file's [[Source.origin]] set, [[Origin.prelude]] for main.lfy of the package elfie, [[Origin.library]] for its other files, and [[Origin.program]] for every other file, so that the prelude scope is the file scope of the main file of the package elfie`,
    });

  @test(
    {
      input = [string@like(`A root with an empty def directory and no elfie.json`)],
      expect = Workspace@like(
        `[[Workspace.name]] from the directory, source directory def, no files of the project, the files of the package elfie from the copy the compiler was built with, no targets, and no problems`,
      ),
    },
    {
      input = [
        string@like(`A root whose def holds main.lfy reading: use "./rules"; and a rules directory holding main.lfy`),
      ],
      expect = Workspace@like(
        `def/rules/main.lfy before def/main.lfy in [[Workspace.files]], both with no [[File.package]], and no problems`,
      ),
    },
    {
      input = [string@like(`A root whose def holds a.lfy using ./b and b.lfy using ./a`)],
      expect = Workspace@like(
        `Both files in the order they were discovered and one [[Problem]] at each [[Use]] of the cycle`,
      ),
    },
    {
      input = [string@like(`A root whose def holds one file reading: use "./missing";`)],
      expect = Workspace@like(
        `One file, one [[Problem]] at the [[Use]], and the [[Source.uses]] entry for it undefined`,
      ),
    },
    {
      input = [
        string@like(
          `A root whose elfie.json names no lib and no dependency elfie, loaded while [[Process.environment]] gives a directory holding the library for ELFIE_LIB`,
        ),
      ],
      expect = Workspace@like(
        `A [[Package]] elfie whose [[Package.root]] is that directory, every .lfy file under it in [[Workspace.files]] with that package, its main.lfy with [[Origin.prelude]] and the others with [[Origin.library]], and no problems`,
      ),
    },
    {
      input = [
        string@like(
          `A root whose elfie.json names a target t with package p and marker m, in the shape earlier versions read`,
        ),
      ],
      expect = Workspace@like(`No targets and no problems, because elfie.json's key targets is ignored`),
    },
    {
      input = [
        string@like(
          `A root whose def/targets.lfy reads: use "elfie/target"; use "./roles"; ace const t = targetOf({ output = "out/", language = lang, layout = flat }); where def/roles.lfy declares trait lang extends targetLanguage setting fileExtension to rs and markerComment to //, and trait flat extends targetLayout`,
        ),
      ],
      expect = Workspace@like(
        `One target t whose declaration is the const t, whose output directory is out, whose layers are flat then lang, whose extensions are rs, and whose marker comment is //; no problems`,
      ),
    },
    {
      input = [
        string@like(
          `The same root, with the const's value giving flat as its language and lang as its layout`,
        ),
      ],
      expect = Workspace@like(
        `Two [[Problem]]s at the declaration of t, one naming the slot language and flat, one naming the slot layout and lang`,
      ),
    },
    {
      input = [
        string@like(
          `The same root, with a third trait server extends targetFramework setting requires to a list holding node-api, given as the const's frameworks`,
        ),
      ],
      expect = Workspace@like(
        `One target t and one [[Problem]] at its declaration saying t requires node-api and none of its layers provides it`,
      ),
    },
    {
      input = [
        string@like(
          `The same root, with lang adding the commands build cargo build and format cargo fmt --check in its body, and def/targets.lfy adding to t's commands, after the const, a format command with no line`,
        ),
      ],
      expect = Workspace@like(
        `One target t whose commands are build cargo build alone, because the file's format command with no line comes before the layer's`,
      ),
    },
    {
      input = [
        string@like(
          `The same root, with a second const u holding a target whose output is out/u`,
        ),
      ],
      expect = Workspace@like(`Two targets, and a [[Problem]] at each declaration naming t, u, and the directory out/u`),
    },
  );
}

fn change(workspace: Workspace, path: string, text: string | undefined): `A workspace with one file read as something other than what is on disk` => Workspace {
  @acceptanceCriteria
    .add({ behavior = `[[path]] is relative to [[Workspace.root]] of [[workspace]]` })
    .add({ behavior = `[[workspace]] is left as it was and the result is a new [[Workspace]]` })
    .add({
      situation = `[[text]] is set`,
      behavior = `The file at [[path]] is read as [[text]] instead of what [[FileSystem.read]] gives`,
    })
    .add({
      situation = `[[text]] is undefined and [[FileSystem.exists]] is true for [[path]]`,
      behavior = `The file at [[path]] is read with [[FileSystem.read]] again`,
    })
    .add({
      situation = `[[text]] is undefined and [[FileSystem.exists]] is false for [[path]]`,
      behavior = `The file at [[path]] leaves the program`,
    })
    .add({
      behavior = `The result is what [[load]] of the same root gives when every file replaced this way holds what it was replaced with`,
    })
    .add({ behavior = `A replacement stands until the same [[path]] is given again` })
    .add({
      situation = `[[path]] is neither under [[Workspace.sourceDirectory]], nor under the [[Package.root]] of a package in the program, nor resolved to by a [[Use]] in the program, nor the source of a knowledge item of the program joined to the root it is read from`,
      behavior = `The result matches [[workspace]]`,
    });

  @test(
    {
      input = [
        Workspace@like(`A project whose def holds only main.lfy`),
        `def/extra.lfy`,
        string@like(`A file declaring one trait`),
      ],
      expect = Workspace@like(`Two files, the declared trait among the symbols of [[Workspace.model]], and no problems`),
    },
    {
      input = [Workspace@like(`A project whose def holds main.lfy and extra.lfy`), `def/extra.lfy`, undefined],
      expect = Workspace@like(`Two files again, matching a fresh [[load]] of the root`),
    },
  );
}
