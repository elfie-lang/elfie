use "../grammar/rules/statement";
use "../model/data";
use "elfie/criteria/command" as Commands;
use "elfie/target" as Targets;

d NativeDependency: `Something the generated code needs from the target's own ecosystem` {
  $identifier: `The name that ecosystem knows it by` = string;
  $ecosystem: `The ecosystem that the dependency is in` = string;
  $version: `The version the project asks for, spelled as that ecosystem spells it; undefined when it pins none` = string | undefined;
}

d Package: `Elfie source loaded from outside the project` {
  $identifier: `The name a [[Use]] refers to it by` = string;
  $root: `Its directory, relative to [[Workspace.root]]; absolute for the package elfie when it is found outside the project` = string;
}

d File extends Source: `One .lfy file in the program, ready to bind` {
  $package: `The package it came from; undefined for the project's own source` = Package | undefined;
}

// Decision: a target is declared in the program, as an ace const holding a [[Targets.Target]],
// rather than in elfie.json; this record is what the loader resolved it to. It keeps the name Target
// because the library's record is only seen where a file uses the package elfie's target module.
d Target: `One thing the project is compiled into, as the loader resolved it from the ace const that declares it` {
  $identifier: `The name of the const that declares it` = string;
  $declaration: `The ace const that declares it, with its layers applied as [[Targets.Target]] says` = Entity;
  $layers: `The trait of each of its layers, in the guidance order [[Targets.Target]] gives` = Entity[];
  $outputDirectory: `Where its generated code is written, relative to [[Workspace.root]]` = string;
  $extensions: `The extensions, without the dot, its outputs may have` = string[];
  $markerComment: `How a line comment begins in its language` = string;
  $scriptRunner: `What runs a script its ecosystem's manifest names; undefined when it has no ecosystem or the ecosystem sets none` = string | undefined;
  $nativeDependencies: `What its generated code needs, from its dependencies, each in the ecosystem its ecosystem layer names` = NativeDependency[];
  $commands: `The one command of each operation the target has a command for, in the order [[Commands.Operation]] lists them` = Command[];
  $knowledge: `What the compiler is given to read for the target: [[Entity.knowledge]] of [[Target.declaration]]` = Knowledge[];
}

d LoadProblem: `Something that went wrong before there was a node to point at` {
  $path: `What could not be read, relative to [[Workspace.root]]; undefined when the project itself is at fault` = string | undefined;
  $message: `What and why` = string;
}

d Workspace: `A project, loaded and bound` {
  $root: `The project's directory` = string;
  $name: `The project's name` = string;
  $sourceDirectory: `Where the project's own source lives, relative to [[Workspace.root]]` = string;
  $files: `Every file in the program, in the order they were bound` = File[];
  $model: `The program` = Model;
  $targets: `What the project is compiled into, in the order their consts are declared: file by file in [[Workspace.files]] order, then source order` = Target[];
  $problems: `Every [[LoadProblem]], then every [[Problem]] loading or binding added` = (LoadProblem | Problem)[];
}
