use "../generation/data";
use "../generation/main" as Generation;
use "../grammar/main" as Grammar;
use "../interpret/data";
use "../model/data";
use "../model/main" as Binder;
use "../query/main" as Query;
use "../workspace/data";
use "../workspace/main" as Loader;
use "./data";
use "./traits";
use "elfie/system/file" as Files;
use "elfie/system/path";
use "elfie/system/process" as Process;

// Decision: the agent server writes one thing only: the marker lines elfie_mark writes in the
// regions of a compiler session's own batch, in its target's output files under its run's
// directory, so an id is copied by the server and never retyped by an agent. Code is written by the agent itself, and source maps and review
// records by the CLI, which asks acceptance to check the outputs, so marker lines go through
// acceptance like any other line. A command tool runs the target's own command, which writes what
// that command always writes, such as build artifacts, and never an output.
// Decision: serve never offers a command tool, because a session over standard input and output has
// no [[Binding]], so no run's directory to run a command in and no batch whose target it is.
// Decision: tools only, with no resources and no prompts, because one surface is enough to keep
// exact.
external Protocol: `The Model Context Protocol, revision 2025-06-18, as the target ecosystem's library provides it` = undefined;

fn serve(root?: string): `Serve agents over standard input and output until the connection closes` => number {
  @acceptanceCriteria
    .add({ behavior = `Speaks the [[Protocol]] over standard input and output` })
    .add({ behavior = `Nothing but [[Protocol]] messages is ever written to standard output` })
    .add({ behavior = `Logging goes to standard error` })
    .add({ behavior = `The server never writes a file` })
    .add({
      situation = [`initialize arrives`, `[[root]] is given`],
      behavior = `[[Session.workspace]] is [[Loader.load]] of [[root]]`,
    })
    .add({
      situation = [`initialize arrives`, `[[root]] is not given`],
      behavior = `[[Session.workspace]] is [[Loader.load]] of the current directory`,
    })
    .add({
      behavior = `The tools offered to the session are every fn of this file that carries [[tool]], except [[report]] and [[reportMany]], every fn that carries [[commandTool]], and every fn that carries [[compilerTool]]`,
    })
    .add({ behavior = `[[Session.binding]] is undefined` })
    .add({ behavior = `No resource and no prompt is listed` })
    .add({
      behavior = `The instructions the initialize answer carries name only tools offered over standard input and output, and say that none of them writes a file`,
    })
    .add({ behavior = `Calls are handled one at a time, in the order received` })
    .add({
      behavior = `Every call answers for the program's files and elfie.json as they are on disk when the call arrives`,
    })
    .add({
      situation = [
        `A call arrives`,
        `A .lfy file under one of [[Workspace.sourceDirectories]] is not in the program, and no earlier call saw it`,
      ],
      behavior = `The file is read through [[Loader.change]] with undefined before the tool runs`,
    })
    .add({
      situation = [
        `A call arrives`,
        `A file of the program has a modification time or size other than [[Session.seen]] holds for it`,
      ],
      behavior = `The file is re-read through [[Loader.change]] with undefined before the tool runs`,
    })
    .add({
      situation = [`A call arrives`, `A file of the program has vanished since it was last read`],
      behavior = `The file is dropped through [[Loader.change]] with undefined before the tool runs`,
    })
    .add({
      situation = [`A call arrives`, `elfie.json has changed since the last call`],
      behavior = `The workspace is loaded again before the tool runs`,
    })
    .add({
      situation = `An edit to a file keeps both its size and its modification time`,
      behavior = `The edit is not seen by the next call`,
    })
    .add({ situation = `Standard input closes`, behavior = `Returns 0` });

  @test(
    {
      input = [string@like(`A root whose def holds a.lfy reading: const y = z;`)],
      expect = number@like(
        `0, after a tools/list answer naming elfie_problems, elfie_find, elfie_entity, elfie_references, elfie_outline, elfie_grammar, elfie_units, elfie_request, elfie_check, elfie_output, elfie_search, elfie_source, elfie_changes, elfie_review, and elfie_globalReview, a call of elfie_problems answering with one binder error at z, and standard input closed`,
      ),
    },
  );
}

// Decision: a compile hosts the agent server itself, so every agent it runs reads the plan the
// compile made, not one a server of its own re-made from files that may have changed since, and its
// verdicts and its compiler's outcome reach the CLI through the server rather than through text it
// prints. What elfie_report, elfie_reportMany, and elfie_submit record stays in memory until the CLI
// closes the session, and the only file the host writes itself is a marker line elfie_mark writes.
// Decision: the server listens only on 127.0.0.1 and refuses any request without the host's token,
// so no other program on the machine can call a tool, even one that finds the port.
// Decision: the ecosystem's protocol library already serves the protocol over streamable HTTP
// (rmcp's transport-streamable-http-server feature, mounted in an axum router), so the host adds
// only the token check, the session routes, and the bindings in front of it.
fn host(): `Serve agents over HTTP on this machine for the length of one compile or verify, one hosted session per run of the compiler or the verifier` => Host {
  @acceptanceCriteria
    .add({ behavior = `Speaks the [[Protocol]] over its streamable HTTP transport` })
    .add({ behavior = `Listens on 127.0.0.1 only, at a port the operating system picks` })
    .add({ behavior = `[[Host.url]] names the address and port it listens on` })
    .add({
      behavior = `[[Host.token]] is 64 lowercase hex digits from the operating system's secure random source, new for each call of [[host]]`,
    })
    .add({
      situation = `A request does not carry the header Authorization reading Bearer, a space, and [[Host.token]]`,
      behavior = [`It is answered with status 401`, `No tool runs for it`],
    })
    .add({
      situation = [`A request carries the token`, `Its path is not the path of an open session`],
      behavior = [`It is answered with status 404`, `No tool runs for it`],
    })
    .add({
      behavior = `[[Host.open]] returns [[Host.url]] followed by sessions, a slash, and a number no earlier session of the host had`,
    })
    .add({
      behavior = `Every request at a session's URL, under any MCP session id or none, acts on that hosted session, sharing its [[Session.binding]], [[Session.reviews]], and [[Session.submission]]`,
    })
    .add({ behavior = `[[Session.binding]] of a session is the [[Binding]] [[Host.open]] was given for it` })
    .add({
      behavior = `[[Session.workspace]] of a session is [[Program.workspace]] of [[Binding.program]], with [[Workspace.root]] read as [[Binding.directory]]`,
    })
    .add({
      behavior = `No call of a session re-reads a definition file or elfie.json, so an edit to them during a compile takes effect at the next compile`,
    })
    .add({
      behavior = `Every call of a session reads outputs and source maps from disk under [[Binding.directory]] as they are when the call arrives`,
    })
    .add({
      situation = [
        `A call of a session reads [[Generation.sourceMapsOf]] the workspace`,
        `[[Binding.sourceMaps]] is not empty`,
      ],
      behavior = `Every map read whose [[SourceMap.target]] and [[SourceMap.source]] are those of a map of [[Binding.sourceMaps]] is left out, and every map of [[Binding.sourceMaps]] is read in their place`,
    })
    // Decision: a compiler edits its batch's outputs while it reads them, so in its session the maps
    // of the batch's own units come from the markers its output files hold now, never from the last
    // acceptance, and every region a tool gives for them is where it is.
    .add({
      situation = [
        `A call of a session reads [[Generation.sourceMapsOf]] the workspace`,
        `[[Binding.role]] of the session is compiler`,
      ],
      behavior = `Every map read whose [[SourceMap.source]] is the [[File.path]] of a unit of [[Binding.batch]] is left out`,
    })
    // Decision: the maps read in their place are those [[Generation.rederive]] gives, so a region is
    // bounded the same way in a session as once the batch is recorded, and every member but the
    // markers, the recorded text included, is what the compile planned with.
    .add({
      situation = [
        `A call of a session reads [[Generation.sourceMapsOf]] the workspace`,
        `[[Binding.role]] of the session is compiler`,
        `A unit of [[Binding.batch]] has maps in its map file`,
      ],
      behavior = `In place of its recorded maps, the maps read for it are [[Generation.rederive]] of the workspace, the unit, and the maps its map file holds, with the output files as they are when the call arrives`,
    })
    .add({
      situation = [
        `A call of a session reads [[Generation.sourceMapsOf]] the workspace`,
        `[[Binding.role]] of the session is compiler`,
        `A unit of [[Binding.batch]] has no map in its map file`,
      ],
      behavior = `For each output file of its target, as [[output]] defines one, that holds a marker that is the unit's own, as [[SourceMap]] defines one, one map is read whose [[SourceMap.target]], [[SourceMap.output]], and [[SourceMap.source]] are those, whose [[SourceMap.markers]] are read from the file when the call arrives as [[Generation.rederive]] reads them, and whose other members are empty`,
    })
    .add({
      situation = `[[Binding.role]] of a session is compiler`,
      behavior = `The tools offered to the session are every fn of this file that carries [[tool]] and not [[commandTool]], except [[report]] and [[reportMany]], and every fn of this file that carries [[commandTool]] whose operation a target of the session has a command with a defined [[Command.line]] for, among its [[Target.commands]]`,
    })
    .add({
      situation = `[[Binding.role]] of a session is verifier`,
      behavior = `The tools offered to the session are every fn of this file that carries [[tool]] and neither [[commandTool]] nor [[compilerTool]], except [[check]], and every fn of this file that carries [[commandTool]] whose operation a target of the session has a command with a defined [[Command.line]] for, among its [[Target.commands]]`,
    })
    .add({
      behavior = `The targets of a session are the [[Unit.target]] of the units of [[Binding.batch]] when it is set, and every target of [[Workspace.targets]] when it is undefined`,
    })
    .add({
      behavior = `[[Host.offered]] of the URL of an open session returns the [[Tool.name]] of every tool the session is offered, in the order the server lists them`,
    })
    .add({
      situation = `[[Host.offered]] is given a URL that is not an open session's`,
      behavior = `Returns an empty list`,
    })
    .add({ behavior = `No resource and no prompt is listed` })
    .add({
      behavior = `The instructions a session's initialize answer carries name only tools offered to that session, say which of them change files, and say which role the session is bound to`,
    })
    .add({ behavior = `The calls of one session are handled one at a time, in the order received` })
    .add({
      situation = `Two calls of different sessions are not both calls of command tools for the same [[Binding.directory]]`,
      behavior = `Neither waits for the other to end`,
    })
    .add({ behavior = `[[Session.reviews]] of a new session is empty` })
    .add({ behavior = `[[Session.submission]] of a new session is undefined` })
    .add({
      behavior = [
        `[[Host.close]] of the URL of an open session returns a [[SessionRecord]] holding [[Session.reviews]] and [[Session.submission]] of it`,
        `The session is no longer open afterwards`,
      ],
    })
    .add({
      situation = `[[Host.close]] is given a URL that is not an open session's`,
      behavior = `Returns a [[SessionRecord]] with no review and no submission`,
    })
    .add({
      behavior = [`[[Host.stop]] closes every open session`, `The port is no longer listened on once it returns`],
    })
    .add({
      behavior = `The host never writes a file, other than the marker lines [[mark]] writes and what a target's command that a command tool runs writes`,
    })
    .add({ behavior = `The host writes nothing to standard output` })
    .add({ situation = `No port can be listened on`, behavior = `[[host]] fails, saying why` });
}

// Decision: the line below is the agent server's own contract for a diagnostic. The CLI states its
// own line for check; the two surfaces are kept apart on purpose and happen to agree.
/// file: a path relative to the root; every file when left out
fn problems(session: Session, file?: string) is tool: `The problems of the program, or of one file: what the compiler, an editor, or a check would report` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `One line per [[Query.diagnosticsOf]] reading the file, a colon, the line, a colon, the column, a colon, a space, the stage, a space, the severity, a colon, a space, and the message`,
    })
    .add({
      situation = `[[Query.diagnosticsOf]] gives no diagnostic for the program, or for [[file]] when it is given`,
      behavior = `The text says no problems`,
    });
}

/// name: an identifier, or an owner's identifier, a dot, and a member's name; a file path and a colon before it limits the search to that file
fn find(session: Session, name: string) is tool: `Where things with a name are declared` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `One line per entity of [[Query.find]] reading the kind, the identifier, the file, and the line`,
    })
    .add({
      situation = `An entity of [[Query.find]] for [[name]] has a definition`,
      behavior = `Its line ends with the definition, after the kind, the identifier, the file, and the line`,
    })
    .add({ situation = `[[Query.find]] finds no entity for [[name]]`, behavior = `The text says so` })
    .add({ situation = `[[Query.find]] finds no entity for [[name]]`, behavior = `The text suggests elfie_outline` });
}

/// name: as elfie_find takes it
fn entity(session: Session, name: string) is tool: `Everything known about the things with a name: definition, type, documentation, traits, members, criteria, tests, references, and source` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `For each entity of [[Query.find]], in order: the fields of [[Query.hoverOf]] with a heading each; the identifier of each trait in [[Entity.traits]]; each member's name, definition, and type; each of [[Entity.tests]] as input and expectation; the count of [[Binder.usagesOf]] its symbol with the file and line of each; then [[Query.sourceOf]] in a fenced block`,
    })
    .add({
      situation = `[[Query.find]] finds more than one entity for [[name]]`,
      behavior = `Each is separated by a rule and headed by its file`,
    });
}

/// name: as elfie_find takes it
fn references(session: Session, name: string) is tool: `Every place things with a name are used` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `For each entity of [[Query.find]], one line per [[Binder.usagesOf]] its symbol reading the file, the line, the column, and the text of that line`,
    });
}

/// file: a path relative to the root
fn outline(session: Session, file: string) is tool: `The declarations of one file, nested as written` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[Query.outlineOf]] as an indented list: two spaces per level, then the kind, the name, and the line`,
    })
    .add({
      situation = `[[file]] is not in the program`,
      behavior = `An error saying so and listing the files that are`,
    });
}

fn grammar(session: Session) is tool: `The grammar of Elfie: every terminal and every rule as EBNF, for an agent writing or reading Elfie` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[Grammar.terminalDocument]], a blank line, then [[Grammar.grammarDocument]]`,
    });
}

/// target: the identifier of one target; every target when left out
fn units(session: Session, target?: string) is tool: `The units the compiler would produce, in order, why each needs generating, and how they are batched` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `The plan shown is [[Generation.plan]] of the workspace with [[Generation.sourceMapsOf]] the workspace, and with the violated units of the last [[GlobalReview]] as its violated units`,
    })
    .add({
      behavior = `The text lists the problems, then the moves, then the units, then the batches`,
    })
    .add({
      behavior = `Each of [[Plan.problems]] is one line, as [[problems]] spells a diagnostic of stage generation and severity error at its node`,
    })
    .add({
      behavior = `Each of [[Plan.moves]] is one line reading the word move, the target, the stem of [[Move.origin]], the word into, the stem of [[Move.into]], the identifiers of [[Move.entities]] in brackets, the word for, and [[Move.cause]]`,
    })
    .add({
      behavior = `Each unit is one line reading the target, [[Unit.stem]], the reason or up to date, and the stems of its dependencies`,
    })
    .add({ behavior = `Each batch is one line reading its identifier and the stems it holds` })
    .add({
      situation = `[[target]] is set and is a known target`,
      behavior = `Only that target's problems, moves, units, and batches are listed`,
    })
    .add({
      situation = `[[target]] is set and is not a known target`,
      behavior = `An error naming the known targets`,
    });
}

// Decision: a batch's identifier begins with the stem of its first unit, so an identifier and a
// stem of the same text name the same batch in all but contrived cases; the precedence below
// settles those.
/// batch: the identifier of a batch, as elfie_units lists it, or the stem of one of its units
/// target: the identifier of the batch's target; the only target when left out
fn request(session: Session, batch: string, target?: string) is tool: `The full request for one batch: what to produce, where, every criterion to satisfy, and how to report` => ToolResult {
  @acceptanceCriteria
    .add({
      situation = `[[Session.binding]] is undefined, or its [[Binding.role]] is verifier`,
      behavior = `[[Request.instructions]] of [[Generation.request]] for the batch, with the existing outputs read from disk, no previous source, and hosted false`,
    })
    .add({
      situation = [
        `[[Session.binding]] is set and its [[Binding.role]] is compiler`,
        `The batch [[batch]] names is [[Binding.batch]]`,
      ],
      behavior = `[[Request.instructions]] of [[Binding.request]], the request the session's compiler run was given`,
    })
    .add({
      situation = `[[batch]] is the identifier of one batch and the stem of a unit of another batch`,
      behavior = `The batch whose identifier it is is meant`,
    })
    .add({
      situation = `No batch has [[batch]] as its identifier or holds a unit with it as its stem, or the target is ambiguous`,
      behavior = `An error saying which`,
    })
    .add({
      situation = [`[[Session.binding]] is set`, `The batch [[batch]] names is not [[Binding.batch]]`],
      behavior = `An error saying the session acts only on its own batch, naming it or the global review, and no request`,
    })
    .add({
      situation = `[[Plan.problems]] of the plan elfie_units shows is not empty`,
      behavior = `An error listing each of [[Plan.problems]], and no request`,
    });
}

// Decision: elfie_task repeats what the unit sections of the request push, read from the very
// request the compiler was given, so a compiler deep in a long run reads its obligations again
// without scrolling back, and never from definitions that may have changed since the compile
// planned.
/// unit: the stem of one unit of the batch, as elfie_units lists it; every unit of the batch when left out
fn task(session: Session, unit?: string) is tool, compilerTool: `What this compiler run must do: for each unit of its batch, the outputs and the reason, every criterion and test to answer for with its id, place, and text, each marked new, reworded, kept, or unknown, and those removed since the outputs were accepted` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `Answers from [[Binding.request]] and [[Binding.program]], and reads no definition file and no output`,
    })
    .add({
      behavior = `The units given are those of [[Request.batch]], in batch order, or only the one whose [[Unit.stem]] is [[unit]] when [[unit]] is given`,
    })
    .add({
      behavior = `A unit given begins with a line reading its [[Unit.stem]], the [[File.path]] of its [[Unit.file]], and its [[Unit.reason]]`,
    })
    .add({
      situation = `The [[Unit.outputs]] of a unit given is not empty`,
      behavior = `Its next line lists the [[SourceMap.output]] of each of its [[Unit.outputs]]`,
    })
    .add({
      situation = `The [[Unit.outputs]] of a unit given is empty`,
      behavior = `Its next line says it has no output yet, and that its outputs go under [[Target.outputDirectory]] at the paths the guidance spells from its stem`,
    })
    .add({
      behavior = `Then each criterion and test of [[Request.requirements]] for the unit's [[File.path]] is one line, in that order`,
    })
    .add({
      situation = `A criterion or test is the first given for the entity it is for`,
      behavior = `Its line comes after a line naming that entity: its identifier, or its owner's identifier, a dot, and its name, or the unit's [[File.path]] for the file's own entity`,
    })
    .add({
      situation = `An entity named by such a line was moved into the unit`,
      behavior = `The line ends with the file that declares it`,
    })
    .add({
      behavior = `The line of a criterion or test reads its mark, a space, its id, a space, its place, a space, an em dash, a space, and its text`,
    })
    .add({
      behavior = `A place is the file of the origin of the criterion or test relative to [[Workspace.root]], a colon, and the line its origin begins on, as a [[ReviewRequest]] spells it`,
    })
    .add({
      behavior = `The text of a criterion is its [[LoweredCriterion.text]], and the text of a test is its input and its expectation as written`,
    })
    .add({
      situation = [`[[Request.answered]] has an entry for the unit's [[File.path]]`, `The entry holds the id`],
      behavior = `The mark is kept`,
    })
    .add({
      situation = [
        `[[Request.answered]] has an entry for the unit's [[File.path]] that does not hold the id, or the unit's [[Unit.outputs]] is empty`,
        `The id is the [[Rewording.id]] of none of [[Request.reworded]] for the unit's [[File.path]]`,
      ],
      behavior = `The mark is new`,
    })
    .add({
      situation = `The id is the [[Rewording.id]] of one of [[Request.reworded]] for the unit's [[File.path]]`,
      behavior = [
        `The mark is reworded`,
        `The line is followed by one reading replaces, a space, its [[Rewording.replaces]], a space, an em dash, a space, and its [[Rewording.text]]`,
      ],
    })
    .add({
      situation = [
        `[[Request.answered]] has no entry for the unit's [[File.path]]`,
        `The unit's [[Unit.outputs]] is not empty`,
      ],
      behavior = `The mark is unknown`,
    })
    .add({
      situation = `Some entity of [[Unit.entities]] of the unit has no criterion or test`,
      behavior = `Then a line lists the identifiers of those entities, and says that each still needs a [[Marker]]`,
    })
    .add({
      situation = `Every entity of [[Unit.entities]] of the unit has a criterion or test`,
      behavior = `Then a line says that no entity lacks a criterion or test`,
    })
    .add({
      situation = `[[Request.removed]] has a non-empty entry for the unit's [[File.path]]`,
      behavior = `The unit ends with a line saying these were removed since its outputs were accepted, then one line for each [[RemovedRequirement]] of that entry, in its order, reading removed, a space, its [[RemovedRequirement.id]], a space, its [[RemovedRequirement.place]], a space, an em dash, a space, and its [[RemovedRequirement.text]]`,
    })
    .add({
      situation = [
        `[[Request.removed]] has a non-empty entry for the unit's [[File.path]]`,
        `A [[RemovedRequirement]] of that entry has an empty [[RemovedRequirement.text]]`,
      ],
      behavior = `Its line reads removed, a space, its [[RemovedRequirement.id]], a space, an em dash, a space, and words saying its text is not known, in place of the line above`,
    })
    .add({
      situation = [
        `[[Request.removed]] has no entry for the unit's [[File.path]]`,
        `The unit's [[Unit.outputs]] is not empty`,
      ],
      behavior = `The unit ends with a line saying which criteria and tests were removed is not known`,
    })
    .add({
      behavior = `The text ends with a line counting the criteria and tests given as new, reworded, kept, unknown, and removed`,
    })
    .add({
      situation = `[[unit]] is given and is the stem of no unit of [[Request.batch]]`,
      behavior = `An error naming the stems of the units of [[Request.batch]]`,
    });

  @test(
    {
      input = [
        Session@like(
          `Bound to a compiler run of batch a, whose one unit a for def/a.lfy has the reason requirements and the output src/a.rs; its fn f has the criterion c1 on line 4, the criterion c3 on line 9, and the criterion c4 on line 12; the output answered c1, c2, and c5; the request has c2, which was on line 6, as removed, and c4 as rewording c5`,
        ),
        undefined,
      ],
      expect = ToolResult@like(
        `Not an error: a line reading a, def/a.lfy, and requirements; a line listing src/a.rs; a line naming f; a line reading kept, the id of c1, def/a.lfy:4, and the text of c1; a line reading new, the id of c3, def/a.lfy:9, and the text of c3; a line reading reworded, the id of c4, def/a.lfy:12, and the text of c4, then a line reading replaces, the id of c5, and the text of c5; a line saying no entity lacks a criterion or test; a line saying these were removed, then a line reading removed, the id of c2, def/a.lfy:6, and the text of c2; a last line counting 1 new, 1 reworded, 1 kept, 0 unknown, and 1 removed`,
      ),
    },
    {
      input = [Session@like(`The same session`), `b`],
      expect = ToolResult@like(`An error naming a as the only unit of the batch`),
    },
  );
}

// Decision: a dependency's interface is pulled one entity at a time from the request the compiler
// was given, so a hosted request names its dependencies' entities instead of quoting them all.
/// name: the identifier of an entity of a dependency outside the batch, as the request's interfaces part names it, or an owner's identifier, a dot, and a member's name; a dependency's file path and a colon before it limits the search to that dependency
fn dependency(session: Session, name: string) is tool, compilerTool: `What one entity of a dependency of this compiler run's batch offers its dependents: the dependency's unit and outputs, and the entity's kind, definition, type, parameters, output, and members` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `Answers from [[Request.interfaces]] of [[Binding.request]], and reads no definition file and no output`,
    })
    .add({
      behavior = `After any leading file path and colon is set aside from [[name]], the identifier is what remains, or its part before the first dot when it holds one`,
    })
    .add({
      behavior = `The entities given are every entity of the [[Interface.entities]] of each of [[Request.interfaces]] whose identifier is that identifier`,
    })
    .add({
      situation = `[[name]] begins with a file path and a colon`,
      behavior = `Only entities of the [[Interface]] whose [[Interface.unit]] has that [[File.path]] are given`,
    })
    .add({
      behavior = `An entity given begins with a line reading the [[Unit.stem]] and the [[File.path]] of its [[Interface.unit]], then a line listing its [[Interface.outputs]]`,
    })
    .add({
      behavior = `Then come the lines of the entity in [[Generation.interfaceOf]] of [[Program.workspace]] of [[Binding.program]] and its [[Interface.unit]]: its own line, then the line of each member or enum member it declares`,
    })
    .add({
      situation = `What remains of [[name]] once any leading file path and colon is set aside holds a dot`,
      behavior = `Of the lines of its members, only that of the member whose name follows the dot is given`,
    })
    .add({ situation = `More than one entity is given`, behavior = `Each is separated by a rule` })
    .add({
      situation = `No entity is given`,
      behavior = [
        `An error saying that no dependency outside the batch declares [[name]]`,
        `The error says that an entity of the batch itself, or of any file, is read with elfie_entity`,
      ],
    });

  @test(
    {
      input = [
        Session@like(
          `Bound to a compiler run of batch a, whose unit a depends on unit b for def/b.lfy with the output src/b.rs, declaring data B: a thing, with one member n of type number`,
        ),
        `B`,
      ],
      expect = ToolResult@like(
        `Not an error: a line reading b and def/b.lfy, a line listing src/b.rs, the line of B reading its kind data and its definition, then the line of its member n with its type number`,
      ),
    },
    {
      input = [Session@like(`The same session`), `Missing`],
      expect = ToolResult@like(
        `An error saying no dependency outside the batch declares Missing, and naming elfie_entity`,
      ),
    },
  );
}

/// unit: the stem of a unit, as elfie_units lists it
/// target: the identifier of the unit's target; the only target when left out
fn check(session: Session, unit: string, target?: string) is tool: `Whether the outputs on disk satisfy the request for one unit, and what is wrong when they do not` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[Generation.accept]] of the unit against the request of its batch and the files under [[Target.outputDirectory]] that carry a [[Marker]] for the unit's file, read from disk, with the source maps recorded for the target's other units as recorded, and with every other file under [[Target.outputDirectory]], read from disk, as elsewhere`,
    })
    .add({
      situation = `[[Generation.accept]] of the unit accepts it`,
      behavior = `The text says so and lists the outputs`,
    })
    .add({
      situation = `[[Generation.accept]] of the unit rejects it`,
      behavior = `An error listing [[Verdict.problems]]`,
    })
    .add({
      situation = [`[[Session.binding]] is set`, `The unit [[unit]] names is not a unit of [[Binding.batch]]`],
      behavior = `An error saying the session acts only on its own batch, naming it, and nothing is checked`,
    });
}

// Decision: an id is 64 hex digits and more, which an agent copies wrong often enough to matter, so
// the server writes a marker's id from one it has checked, and moves every marker of a reworded
// criterion to its new id in one call. Compile already moves the markers of a criterion reworded in
// place before the compiler runs; a rename is for the pairs it could not see, such as a criterion
// that moved as well as changed. Marker lines are written only in the batch's own regions: a
// rename rewrites what [[Generation.rename]] rewrites, only the markers that name the file of the
// unit the new id belongs to, and an insertion is refused inside a region of a file outside the
// batch, so it never touches another unit's markers.
// Decision: the arguments a call gives say what it wants: replaces asks for a rename, and file,
// line, and entity ask for an insertion; a call that gives both, or neither whole, is refused.
/// id: the id a marker names afterwards: for a rename, the new id; for an insertion, the id of the criterion or test the new marker answers for, left out for a marker naming only its entity
/// replaces: for a rename, the id every marker to rewrite names now
/// file: for an insertion, the path of the output file to insert the marker into, relative to the root
/// line: for an insertion, the line of that file the marker is inserted before, counting from 1; one past its last line appends it
/// entity: for an insertion, the entity the marker names: an identifier, or an owner's identifier, a dot, and a member's name; a definition file's path and a colon before it limits it to that file
fn mark(session: Session, id?: string, replaces?: string, file?: string, line?: number, entity?: string) is tool,
  compilerTool: `Write a marker line into one of this compiler run's outputs, or rewrite to a new id every marker of its outputs that names an old one, so that no id is typed by hand` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `The output files of the batch's target are the files, recursively, under [[Target.outputDirectory]] of the batch's target under [[Binding.directory]], whose [[Path.extension]] is among [[Target.extensions]] of that target`,
    })
    .add({ behavior = `A marker in an output is read as [[Generation.accept]] reads a [[Marker]]` })
    .add({
      situation = `[[replaces]] is given, and [[id]] is not given or one of [[file]], [[line]], and [[entity]] is`,
      behavior = [`An error saying a rename takes replaces and id and nothing else`, `Nothing is written`],
    })
    .add({
      situation = `[[replaces]] is not given, and one of [[file]], [[line]], and [[entity]] is not given`,
      behavior = [`An error saying an insertion takes file, line, and entity, and optionally id`, `Nothing is written`],
    })
    .add({ behavior = `No file but an output file of the batch's target is written` })
    .add({ behavior = `No source map and no review record is written` });

  // Renaming
  @acceptanceCriteria
    .add({
      situation = [`[[replaces]] is given`, `[[id]] is not the id of a local criterion or test of a unit of the batch`],
      behavior = [
        `An error naming [[id]] and saying it is no criterion or test of the batch's units`,
        `Nothing is written`,
      ],
    })
    .add({
      situation = [`[[replaces]] is given`, `[[id]] is the id of a local criterion or test of a unit of the batch`],
      behavior = `Each output of [[Generation.rename]] of that unit, the output files of the batch's target as they are when the call arrives, and [[replaces]] mapped to [[id]], is [[Files.write]] at its path under [[Binding.directory]], and no other output is written`,
    })
    .add({
      behavior = `The markers rewritten are those [[Generation.rename]] rewrites`,
    })
    .add({
      situation = `Some marker is rewritten`,
      behavior = `The text counts the markers rewritten, then gives one line for each: the output path, a colon, its line, a space, and the marker as it reads afterwards after @lfy and a space`,
    })
    .add({
      situation = [`[[replaces]] is given`, `No marker is rewritten`],
      behavior = `An error saying that no marker of the output files of the batch's target naming that unit's file names [[replaces]]`,
    });

  // Inserting
  @acceptanceCriteria
    .add({
      situation = [
        `[[file]] is given`,
        `[[file]] is not the path, relative to the root, of one of the output files of the batch's target`,
      ],
      behavior = [
        `An error saying the file is not an output file of the batch's target, and that a new output is written before a marker is inserted into it`,
        `Nothing is written`,
      ],
    })
    .add({
      situation = [`[[line]] is given`, `[[line]] is less than 1 or more than one past the last line of [[file]]`],
      behavior = [`An error giving the count of the lines of [[file]]`, `Nothing is written`],
    })
    .add({
      situation = [
        `[[file]] and [[line]] are given`,
        `The last line of [[file]] before [[line]] that is read as a [[Marker]] names a file that is neither the [[File.path]] of a unit of the batch nor the file of an entity moved into one`,
      ],
      behavior = [
        `An error saying [[line]] falls in a region of another unit, naming the file that marker names and the unit of that file when it has one`,
        `Nothing is written`,
      ],
    })
    .add({
      behavior = `After any leading file path and colon is set aside from [[entity]], the identifier is what remains, or its part before the first dot when it holds one`,
    })
    .add({
      behavior = `The entity [[entity]] names is the entity of [[Unit.entities]] of a unit of the batch whose identifier is that identifier, or, when what remains holds a dot, that entity's member whose name follows the dot; when [[entity]] begins with a file path and a colon, only an entity declared in that file`,
    })
    .add({
      situation = [`[[entity]] is given`, `[[entity]] names no entity`],
      behavior = [
        `An error saying no unit of the batch declares [[entity]], listing the stems of its units`,
        `Nothing is written`,
      ],
    })
    .add({
      situation = [`[[entity]] is given`, `[[entity]] names entities of more than one file`],
      behavior = [
        `An error naming each of those files and saying a file path and a colon before the name chooses one`,
        `Nothing is written`,
      ],
    })
    .add({
      situation = [
        `[[entity]] and [[id]] are given`,
        `[[id]] is neither the id of a local criterion or test of the unit whose entity [[entity]] names nor that of one of [[Request.globals]]`,
      ],
      behavior = [
        `An error naming [[id]] and saying it is no criterion or test of that unit and no global one`,
        `Nothing is written`,
      ],
    })
    .add({
      behavior = `The inserted line is the spaces and tabs that begin the line at [[line]] before the insertion, or nothing when it is appended, then [[Target.markerComment]], a space, @lfy, a space, the path of the file that declares the entity relative to [[Workspace.root]], a colon, and [[entity]] without its file path and colon, then a # and [[id]] when [[id]] is given`,
    })
    .add({
      behavior = `The inserted line comes before the line that was at [[line]], ended by the line break the file's first line ends with, or by a line feed when it has none, and every other character of the file is kept`,
    })
    .add({
      situation = [`The line is appended`, `The file's last line has no line break`],
      behavior = `That line break is added to the file's last line first`,
    })
    .add({
      situation = `A line is inserted`,
      behavior = `The text gives the output path, a colon, the number of the inserted line, a space, and the inserted line`,
    });

  @test(
    {
      input = [
        Session@like(
          `Bound to a compiler run of batch a, whose unit a for def/a.lfy has the criterion of f with id f:f:9c0d, and whose output src/a.rs holds on lines 3 and 8 the markers // @lfy def/a.lfy:f#f:f:1f2e`,
        ),
        `f:f:9c0d`,
        `f:f:1f2e`,
        undefined,
        undefined,
        undefined,
      ],
      expect = ToolResult@like(
        `Not an error: 2 markers rewritten, src/a.rs:3 and src/a.rs:8, each now reading def/a.lfy:f#f:f:9c0d; nothing else of src/a.rs changed`,
      ),
    },
    {
      input = [
        Session@like(
          `The same session, with line 12 of src/a.rs reading four spaces and fn helper() {, and the rust target's marker comment //`,
        ),
        `f:f:9c0d`,
        undefined,
        `src/a.rs`,
        12,
        `f`,
      ],
      expect = ToolResult@like(
        `Not an error: src/a.rs:12 reading four spaces and // @lfy def/a.lfy:f#f:f:9c0d, and the line that was 12 is now 13`,
      ),
    },
    {
      input = [Session@like(`The same session`), `f:f:0000`, `f:f:1f2e`, undefined, undefined, undefined],
      expect = ToolResult@like(`An error naming f:f:0000, and src/a.rs unchanged`),
    },
  );
}

// Decision: the compiler's outcome is submitted while it is still working, checked when it arrives,
// and kept in its session for the CLI, so how a run ended never depends on the last lines of a
// final message; the last submission wins, so a compiler that changes its mind says so again.
/// outcome: done, blocked, or clarify
/// message: for blocked, the reason, quoting the criterion; for clarify, the one question; for done, a note that is no part of the outcome, or empty
fn submit(session: Session, outcome: string, message: string) is tool, compilerTool: `Say how this compiler run ended: done when every output is written, blocked when it cannot proceed, or clarify when only a person can decide` => ToolResult {
  @acceptanceCriteria
    .add({
      situation = `[[outcome]], compared without regard to case, is none of [[SubmittedOutcome]]`,
      behavior = [`An error naming done, blocked, and clarify`, `Nothing is recorded`],
    })
    .add({
      situation = [
        `[[outcome]], compared without regard to case, is blocked or clarify`,
        `[[message]] is empty or holds only white space`,
      ],
      behavior = [`An error saying blocked needs its reason and clarify its question`, `Nothing is recorded`],
    })
    .add({
      situation = `Neither error above is given`,
      behavior = `[[Session.submission]] becomes a [[Submission]] whose [[Submission.outcome]] is the member of [[SubmittedOutcome]] [[outcome]] names and whose [[Submission.message]] is [[message]], in place of any earlier one`,
    })
    .add({
      situation = `A [[Submission]] is recorded`,
      behavior = `The text says it was recorded, with its outcome, and that a later call of elfie_submit replaces it`,
    })
    .add({
      situation = `A [[Submission]] is recorded`,
      behavior = `The text says that the final message still ends with the line for the outcome: ELFIE: DONE, ELFIE: BLOCKED: and the reason, or ELFIE: CLARIFY: and the question`,
    })
    .add({ behavior = `Nothing is written` });

  @test(
    {
      input = [
        Session@like(`Bound to a compiler run with no submission`),
        `Blocked`,
        `f:f:9c0d contradicts f:f:1f2e on empty lists`,
      ],
      expect = ToolResult@like(
        `Not an error: recorded blocked, a later call replaces it, and the final message ends with ELFIE: BLOCKED: and the reason; the session's submission is blocked with that message`,
      ),
    },
    {
      input = [Session@like(`The same session`), `clarify`, ``],
      expect = ToolResult@like(`An error saying clarify needs its question, and the submission still blocked`),
    },
    {
      input = [Session@like(`The same session`), `finished`, ``],
      expect = ToolResult@like(`An error naming done, blocked, and clarify`),
    },
  );
}

// Decision: the source maps the tools below read are [[Generation.sourceMapsOf]] the workspace, as
// elfie_units reads them, so what a tool answers for an entity or an id is what the last acceptance
// recorded in elfie-compile/maps. In a session [[host]] serves for a verifier, the source maps its
// review was made with stand in for the recorded maps of those units, so the verifier reads the
// outputs it is judging. In a session it serves for a compiler, the maps of the batch's own units
// are read from the markers their output files hold now, so the compiler sees the regions it has
// just edited where they are.
// Decision: an output file named by its path, and every line elfie_search finds, are read with the
// markers the file holds when the call arrives, read as acceptance reads them, because a compiler
// that has just edited a file must see its regions where they are now, not where the last
// acceptance recorded them. The markers are read mechanically, never guessed from the code.
// Decision: what a caller wants of the regions is said by text: their code, or only where they are,
// which outlines a file in a few lines however long it is.
/// name: as elfie_find takes it, a requirement id, or the path of an output file relative to the root
/// target: the identifier of one target; every target when left out
/// text: whether each region's line is followed by its code; false gives only where the regions are, an outline of an output file
fn output(session: Session, name: string, target?: string, text: boolean = true) is tool: `Where generated code is, with its text or without it: every region that came from one entity, that answers for one criterion or test, or that one output file holds` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `An output file is a file under [[Target.outputDirectory]] of a target, limited to [[target]] when it is set, whose [[Path.extension]] is among [[Target.extensions]] of that target, under [[Binding.directory]], or under [[Workspace.root]] when [[Session.binding]] is undefined`,
    })
    // Decision: build and version-control directories are never outputs, though a target's output
    // directory may hold them; walking them would be slow and would find generated or vendored code.
    .add({
      behavior = `A file under a directory named target, .git, or node_modules, at any depth below [[Target.outputDirectory]], is no output file`,
    })
    .add({
      situation = `[[name]] is not the path of an output file`,
      behavior = `Every region is read from [[Generation.sourceMapsOf]] the workspace, limited to [[target]] when it is set`,
    })
    .add({
      behavior = `Each region is a line reading the output path, a colon, [[Marker.outputLine]], a dash, [[Marker.end]], a space, and [[Marker.entity]]`,
    })
    .add({
      situation = `The [[Marker]] of a region names a requirement`,
      behavior = `The line of the region ends with [[Marker.requirement]], after [[Marker.entity]]`,
    })
    .add({
      situation = `[[text]] is true`,
      behavior = `The line of each region is followed by the [[Files.read]] text of those lines of the output, in a fenced block`,
    })
    .add({ situation = `[[text]] is false`, behavior = `No line of an output follows the line of a region` })
    .add({
      situation = `[[name]] is the path of an output file`,
      behavior = `The regions are every [[Marker]] the file holds as [[Files.read]] reads it when the call arrives, read as [[Generation.accept]] reads them, in output order, with [[Marker.end]] derived as a source map derives it`,
    })
    .add({
      situation = `[[name]] is the path of an output file`,
      behavior = `A marker naming a file that is not in the program gives no region`,
    })
    .add({
      situation = [
        `[[name]] is not the path of an output file`,
        `[[Generation.regionsOf]] for [[name]] and [[target]] gives a [[Marker]]`,
      ],
      behavior = `The regions are every [[Marker]] of [[Generation.regionsOf]] for [[name]] and [[target]]`,
    })
    .add({
      situation = [
        `[[name]] is not the path of an output file`,
        `[[Generation.regionsOf]] for [[name]] and [[target]] gives no [[Marker]]`,
        `[[name]] is the id of a criterion or test of the lowered program, local or global`,
      ],
      behavior = `The text of that criterion or test comes first, then the regions are every [[Marker]] whose [[Marker.requirement]] is [[name]], in source map then output order`,
    })
    .add({ situation = `No region is found for [[name]]`, behavior = `The text says nothing is generated for it` })
    .add({
      situation = `[[target]] is set and is not a known target`,
      behavior = `An error naming the known targets`,
    });

  @test(
    {
      input = [
        Session@like(
          `Bound to a compiler run whose target writes .rs files under src, where src/a.rs, 9 lines long, holds the marker // @lfy def/a.lfy:A on line 1 and the marker // @lfy def/a.lfy:f#f:f:9c0d on line 6, though its recorded source map, made before an edit, puts f on line 4`,
        ),
        `src/a.rs`,
        undefined,
        false,
      ],
      expect = ToolResult@like(`Not an error: two lines and nothing else, src/a.rs:1-5 A and src/a.rs:6-9 f f:f:9c0d`),
    },
  );
}

/// pattern: a regular expression, matched against each line of the outputs without its line break
/// file: the path, relative to the root, of one output file or of a directory under an output directory, to search only under; every output when left out
// Decision: the regular expressions are those of the Rust regex crate, the library the compiler
// itself is written with: Perl-like classes and repetition, (?i) for a match without regard to
// case, and no look-around or backreference, so every search ends in time linear in the text.
// Decision: a search gives at most 200 lines, so one broad pattern cannot flood an agent's context,
// and the count of what was left out says how much narrower the next one must be.
fn search(session: Session, pattern: string, file?: string) is tool: `The lines of generated code that match a regular expression, each with where it is and the entity, and the criterion or test, of the region it is in` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `The targets searched are the [[Unit.target]] of the units of [[Binding.batch]] when [[Session.binding]] and its [[Binding.batch]] are set, and every target of [[Workspace.targets]] otherwise`,
    })
    .add({
      behavior = `The files searched are every file, recursively, under [[Target.outputDirectory]] of a target searched, under [[Binding.directory]], or under [[Workspace.root]] when [[Session.binding]] is undefined, whose [[Path.extension]] is among [[Target.extensions]] of that target`,
    })
    .add({
      situation = `[[file]] is given`,
      behavior = `Only the files searched that are [[file]] or under it are searched`,
    })
    .add({
      situation = `[[file]] is given and is neither a file searched nor a directory holding one`,
      behavior = [
        `An error saying [[file]] is not under an output directory of the session's targets`,
        `Nothing is searched`,
      ],
    })
    .add({ behavior = `Every file searched is read with [[Files.read]] when the call arrives` })
    .add({ behavior = `[[pattern]] is read as a regular expression in the syntax of the Rust regex crate` })
    .add({
      situation = `[[pattern]] is not a regular expression in that syntax`,
      behavior = [`An error carrying why it is not`, `Nothing is searched`],
    })
    .add({ behavior = `A line matches when [[pattern]] matches some part of it, without its line break` })
    .add({
      behavior = `The matching lines are given in the order of their paths relative to the root, compared by Unicode code point, then in line order`,
    })
    .add({
      behavior = `Each matching line given is one line reading its path relative to the root, a colon, its line number, a space, its region between square brackets, a colon, a space, and the line's text`,
    })
    .add({
      behavior = `The region of a line is the marker on the last line at or before it, in the file as read, that is read as a [[Marker]] as [[Generation.accept]] reads one and names a file of the program, spelled as the marker spells it after @lfy and a space`,
    })
    .add({
      situation = `No line at or before a matching line is read as a [[Marker]] naming a file of the program`,
      behavior = `Its region is a hyphen`,
    })
    .add({
      situation = `A matching line's text is longer than 500 Unicode characters`,
      behavior = `Only its first 500 Unicode characters are given, followed by … (U+2026)`,
    })
    .add({
      situation = `More than 200 lines match`,
      behavior = [
        `Only the first 200 are given`,
        `A last line gives the count of the matching lines left out and says that a file or a narrower pattern narrows the search`,
      ],
    })
    .add({
      situation = `No line matches`,
      behavior = `The text says that no line of the files searched matches, with the count of the files searched`,
    })
    .add({ behavior = `Nothing is written` });

  @test(
    {
      input = [
        Session@like(
          `Bound to a compiler run whose target writes .rs files under src, where src/a.rs holds the marker // @lfy def/a.lfy:f#f:f:9c0d on line 6 and reads fn helper() { on line 8, and src/b.rs holds no fn helper`,
        ),
        `fn helper[(]`,
        undefined,
      ],
      expect = ToolResult@like(`Not an error: one line reading src/a.rs:8 [def/a.lfy:f#f:f:9c0d]: fn helper() {`),
    },
    {
      input = [Session@like(`The same session`), `fn (`, undefined],
      expect = ToolResult@like(`An error saying why fn ( is not a regular expression`),
    },
  );
}

/// file: the path of an output file, relative to the root
/// line: a line of that file, counting from 1
fn source(session: Session, file: string, line: number) is tool: `Where one line of generated code came from: the definition file, the entity, and its line` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `The [[Marker]] read is the one of the [[SourceMap]] whose [[SourceMap.output]] is [[file]] whose [[Marker.outputLine]] is at most [[line]] and whose [[Marker.end]] is at least [[line]]`,
    })
    .add({ behavior = `The first line of the text reads [[Marker.file]], a colon, and [[Marker.line]]` })
    .add({
      situation = `The [[Marker]] read names an entity`,
      behavior = `The first line of the text ends with [[Marker.entity]]`,
    })
    .add({
      situation = `The [[Marker]] read names a requirement`,
      behavior = `[[Marker.requirement]] follows on the next line, then the text of that criterion or test, local or global, from the lowered program`,
    })
    .add({
      situation = `No source map has [[file]] as its output, or [[line]] is before its first marker`,
      behavior = `The text says no source map covers the line`,
    });
}

/// unit: the stem of a unit, as elfie_units lists it
/// target: the identifier of the unit's target; the first target in [[Workspace.targets]] order that has a unit with that stem when left out
fn changes(session: Session, unit: string, target?: string) is tool: `What differs for each entity of a unit since its outputs were last accepted` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `One line per [[Change]] of [[Generation.changes]] of the unit with that stem, reading [[Change.entity]], [[Change.kind]], and [[Change.detail]]`,
    })
    .add({
      situation = [
        `The root is a git repository`,
        `The source of the unit at its last accepted generation is recoverable from it`,
      ],
      behavior = `The previous text passed to [[Generation.changes]] is that source as git holds it, recovered through [[Process.run]] of git and never lowered`,
    })
    .add({
      situation = `The root is a git repository`,
      behavior = `The source of the unit at its last accepted generation is the most recent revision of its file, as git holds it, that its outputs were accepted from as [[SourceMap]] defines one, its text lowered as [[Generation.changes]] binds a previous text`,
    })
    .add({
      situation = [
        `The root is a git repository`,
        `The source of the unit at its last accepted generation is not recoverable`,
        `Git holds the unit's hash-matched source, as [[SourceMap]] defines one`,
      ],
      behavior = [
        `The previous text passed to [[Generation.changes]] is the hash-matched source as git holds it, never lowered`,
        `The text first says the source the outputs were accepted from is not known, that the changes are against the latest revision with the same lowered code, and that their criterion and test changes may not be those since acceptance`,
      ],
    })
    .add({ situation = `[[Unit.outputs]] of the unit is empty`, behavior = `The text says no previous output` })
    .add({
      situation = [
        `The unit has outputs`,
        `Neither its source at its last accepted generation nor its hash-matched source can be recovered`,
      ],
      behavior = `The text says so first, then lists every entity as added, as [[Generation.changes]] gives them with undefined`,
    })
    .add({
      situation = `[[Generation.changes]] of the unit gives no [[Change]]`,
      behavior = `The text says no changes`,
    })
    .add({ situation = `No unit has that stem`, behavior = `An error saying so` })
    .add({
      situation = [`[[Session.binding]] is set`, `The unit [[unit]] names is not a unit of [[Binding.batch]]`],
      behavior = `An error saying the session acts only on its own batch, naming it or the global review`,
    })
    .add({
      situation = `[[target]] is set and is not a known target`,
      behavior = `An error naming the known targets`,
    });
}

/// batch: the identifier of a batch, as elfie_units lists it, or the stem of one of its units
/// target: the identifier of the batch's target; the only target when left out
fn review(session: Session, batch: string, target?: string) is tool: `The full review request for one batch: every criterion and test with where the regions generated for its entities are, and how to report` => ToolResult {
  @acceptanceCriteria
    .add({
      situation = `[[Session.binding]] is undefined, or its [[Binding.role]] is compiler`,
      behavior = `[[ReviewRequest.instructions]] of [[Generation.review]] for the batch, with [[Generation.sourceMapsOf]] the workspace and no review records`,
    })
    .add({
      situation = [
        `[[Session.binding]] is set and its [[Binding.role]] is verifier`,
        `The batch [[batch]] names is [[Binding.batch]]`,
      ],
      behavior = `[[ReviewRequest.instructions]] of [[Binding.review]], the review request the session's verifier was given`,
    })
    .add({
      situation = `[[batch]] is the identifier of one batch and the stem of a unit of another batch`,
      behavior = `The batch whose identifier it is is meant`,
    })
    .add({
      situation = `No batch has [[batch]] as its identifier or holds a unit with it as its stem, or the target is ambiguous`,
      behavior = `An error saying which`,
    })
    .add({
      situation = [`[[Session.binding]] is set`, `The batch [[batch]] names is not [[Binding.batch]]`],
      behavior = `An error saying the session acts only on its own batch, naming it or the global review`,
    })
    .add({
      situation = `[[Plan.problems]] of the plan elfie_units shows is not empty`,
      behavior = `The review request is returned as for any plan, and [[Plan.problems]] is not mentioned`,
    });
}

fn globalReview(session: Session) is tool: `The review request for every global criterion and test, once for the whole program, with where the regions that answer for each are` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[ReviewRequest.instructions]] of [[Generation.globalReview]] of [[Generation.plan]] of the workspace and [[Generation.sourceMapsOf]] the workspace`,
    })
    .add({ situation = `No global criterion or test exists`, behavior = `The text says so` });
}

// Decision: a verdict is submitted as soon as it is judged and checked as it arrives, so a verdict
// with a wrong id is answered at once, while the verifier still knows what it meant, and none is
// lost to a final message that ends too soon or runs too long.
/// id: the id of the criterion or test, as the review request gives it; may be left out when file and line name it
/// file: the first half of the place the review request gives the criterion or test, such as def/a.lfy
/// line: the second half of that place
/// status: satisfied, violated, or unverifiable
/// evidence: the output path and line range judged, such as crates/elfie-core/src/x.rs:120-134; empty when none
/// note: why, in one line; for a violated one, what the code does instead
fn report(session: Session, id?: string, file?: string, line?: number, status: string, evidence: string, note: string) is tool: `Submit the verdict on one criterion or test of the review this session is for` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `The criterion or test reported on is the one [[Generation.reviewOf]] reads a review line as being for when the line holds [[id]], [[file]], [[line]], and [[status]], with [[Binding.program]] as its program`,
    })
    .add({
      situation = `[[status]], compared without regard to case, is none of [[ReviewStatus]]`,
      behavior = [`An error naming the three statuses`, `Nothing is recorded`],
    })
    .add({
      situation = [`[[status]] is one of [[ReviewStatus]]`, `No criterion or test is reported on`],
      behavior = [
        `An error naming the id, file, or line given, saying no criterion or test matches it`,
        `Nothing is recorded`,
      ],
    })
    .add({
      situation = [
        `[[status]] is one of [[ReviewStatus]]`,
        `The id of the criterion or test reported on is not among [[ReviewRequest.asked]] of [[Binding.review]]`,
      ],
      behavior = [`An error saying that id was not asked in this review`, `Nothing is recorded`],
    })
    .add({
      situation = [
        `[[status]] is one of [[ReviewStatus]]`,
        `The id of the criterion or test reported on is among [[ReviewRequest.asked]] of [[Binding.review]]`,
      ],
      behavior = `One [[Review]] for that id, with [[status]], [[evidence]], and [[note]], is appended to [[Session.reviews]]`,
    })
    .add({
      situation = [
        `A [[Review]] is appended to [[Session.reviews]]`,
        `[[Session.reviews]] already held one for the same id`,
      ],
      behavior = `The earlier one is removed`,
    })
    .add({
      situation = `A [[Review]] is appended to [[Session.reviews]]`,
      behavior = `The text says it was recorded, with its id and place`,
    })
    .add({
      situation = `A [[Review]] is appended to [[Session.reviews]]`,
      behavior = `The text then counts the ids of [[ReviewRequest.asked]] that no review of [[Session.reviews]] names, and lists the first five of them in the order asked`,
    })
    .add({
      situation = [
        `A [[Review]] is appended to [[Session.reviews]]`,
        `Every id of [[ReviewRequest.asked]] has a review`,
      ],
      behavior = `The text says every criterion and test asked has a verdict, and that the final message ends with ELFIE: REVIEWED`,
    })
    .add({ behavior = `Nothing is written` });

  @test(
    {
      input = [
        Session@like(
          `Bound to a verifier run whose review asked A:A:1f2e on def/a.lfy line 4 and A:A:9c0d on def/a.lfy line 7, with no review recorded`,
        ),
        undefined,
        `def/a.lfy`,
        7,
        `violated`,
        `src/a.rs:12-18`,
        `returns undefined instead of an empty list`,
      ],
      expect = ToolResult@like(`Not an error: recorded A:A:9c0d at def/a.lfy:7; 1 still missing: A:A:1f2e`),
    },
    {
      input = [
        Session@like(`The same session`),
        `A:A:77aa`,
        undefined,
        undefined,
        `satisfied`,
        ``,
        `ok`,
      ],
      expect = ToolResult@like(
        `An error naming A:A:77aa and saying no criterion or test matches it, and nothing recorded`,
      ),
    },
    {
      input = [
        Session@like(`The same session`),
        `A:A:1f2e`,
        undefined,
        undefined,
        `maybe`,
        ``,
        `unsure`,
      ],
      expect = ToolResult@like(`An error naming satisfied, violated, and unverifiable, and nothing recorded`),
    },
  );
}

// Decision: a verifier's turns, not its verdicts, set what a review costs, because every turn
// re-reads the whole context so far, so a verifier submits many verdicts in one call.
/// lines: one JSON object per line, with the keys id, file, line, status, evidence, and note, holding what report would be given; blank lines are skipped
fn reportMany(session: Session, lines: string) is tool: `Submit the verdicts on several criteria and tests of the review this session is for, one per line` => ToolResult {
  @acceptanceCriteria
    .add({ behavior = `A line of [[lines]] that holds only whitespace is skipped` })
    .add({
      situation = `A line of [[lines]] is a JSON object`,
      behavior = `It is handled as [[report]] given that line's id, file, line, status, evidence, and note`,
    })
    .add({
      situation = `A line of [[lines]] is a JSON object that lacks some of its keys`,
      behavior = `A lacking id, file, or line is left out, and a lacking status, evidence, or note is the empty string`,
    })
    .add({ behavior = `The lines of [[lines]] are handled in the order they are written` })
    .add({
      situation = `A line of [[lines]] holds more than whitespace and is not a JSON object`,
      behavior = [`An error for that line, saying it is not a JSON object`, `Nothing is recorded for it`],
    })
    .add({ behavior = `An error for one line never stops a later line from being handled` })
    .add({
      behavior = `The text has one line for each line of [[lines]] that is not skipped, in the same order, saying it was recorded, with its id and place, or giving its error`,
    })
    .add({
      behavior = `After those lines, the text counts the ids of [[ReviewRequest.asked]] that no review of [[Session.reviews]] names once every line is handled, and lists the first five of them in the order asked`,
    })
    .add({
      situation = `Every id of [[ReviewRequest.asked]] has a review once every line is handled`,
      behavior = `The text then says every criterion and test asked has a verdict, and that the final message ends with ELFIE: REVIEWED`,
    })
    .add({ situation = `No line of [[lines]] is recorded`, behavior = `[[ToolResult.isError]] is true` })
    .add({ situation = `Some line of [[lines]] is recorded`, behavior = `[[ToolResult.isError]] is false` })
    .add({ behavior = `Nothing is written` });

  @test(
    {
      input = [
        Session@like(
          `Bound to a verifier run whose review asked A:A:1f2e on def/a.lfy line 4 and A:A:9c0d on def/a.lfy line 7, with no review recorded`,
        ),
        string@like(
          `Three lines: a JSON object with file def/a.lfy, line 7, status violated, evidence src/a.rs:12-18, and note returns undefined; an empty line; and the words satisfied A:A:1f2e`,
        ),
      ],
      expect = ToolResult@like(
        `Not an error, with three lines of text: recorded A:A:9c0d at def/a.lfy:7; an error saying the line of words is not a JSON object; 1 still missing: A:A:1f2e`,
      ),
    },
    {
      input = [
        Session@like(`The same session, after that call`),
        string@like(
          `Two lines: a JSON object with id A:A:77aa, status satisfied, and note ok; and a JSON object with id A:A:1f2e, status satisfied, evidence src/a.rs:3-9, and note ok`,
        ),
      ],
      expect = ToolResult@like(
        `Not an error, with lines of text: an error naming A:A:77aa and saying no criterion or test matches it; recorded A:A:1f2e at def/a.lfy:4; 0 still missing; every criterion and test asked has a verdict, and the final message ends with ELFIE: REVIEWED`,
      ),
    },
  );
}

// Decision: an agent builds, tests, and lints through the tools below rather than a shell, so it
// runs only what the target's commands say, in its own run's directory, and the tools a session is
// offered say which of them the target has.
// Decision: build, test, and lint take a scope, so an agent whose own crate builds while another
// unit's crate is broken can still check its own; the scope means something only to a line that
// reads SCOPE.
/// scope: the part of the outputs to run on, as the target's ecosystem names it, such as a package for cargo; given to the command as SCOPE; all of them when left out
/// target: the identifier of the target; the target of the session's batch, or the only target, when left out
fn build(session: Session, scope?: string, target?: string) is tool, commandTool(Operation.build): `Run the target's build command in this run's directory, narrowed to a scope when one is given, and say whether it passed, with its exit code and the end of its output` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `The command's environment sets SCOPE to [[scope]], or to the empty string when it is left out`,
    });

  @test(
    {
      input = [
        Session@like(
          `Bound to a compiler run of batch a, whose only target t writes under out and has the build command: echo built; exit 3`,
        ),
        undefined,
        undefined,
      ],
      expect = ToolResult@like(
        `Not an error: the JSON of a CommandRun with target t, operation build, line echo built; exit 3, succeeded false, exitCode 3, output built and a newline, and omitted 0`,
      ),
    },
  );
}

/// filter: the words that narrow which tests run, given to the test command as TESTS; every test runs when left out
/// scope: the part of the outputs to run on, as the target's ecosystem names it, such as a package for cargo; given to the command as SCOPE; all of them when left out
/// target: the identifier of the target; the target of the session's batch, or the only target, when left out
fn test(session: Session, filter?: string, scope?: string, target?: string) is tool, commandTool(Operation.test): `Run the target's test command in this run's directory, narrowed by a filter and a scope when they are given, and say whether it passed, with its exit code and the end of its output` => ToolResult {
  @acceptanceCriteria
    .add({ situation = `[[filter]] is given`, behavior = `The command's environment sets TESTS to [[filter]]` })
    .add({ situation = `[[filter]] is left out`, behavior = `The command's environment sets TESTS to the empty string` })
    .add({
      behavior = `The command's environment sets SCOPE to [[scope]], or to the empty string when it is left out`,
    });

  @test(
    {
      input = [
        Session@like(`Bound to a compiler run whose only target has the test command: echo "[$TESTS]"`),
        `parse lex`,
        undefined,
        undefined,
      ],
      expect = ToolResult@like(
        `Not an error: the JSON of a CommandRun whose succeeded is true and whose output is [parse lex] and a newline`,
      ),
    },
    {
      input = [Session@like(`The same session`), undefined, undefined, undefined],
      expect = ToolResult@like(`Not an error: the JSON of a CommandRun whose output is [] and a newline`),
    },
  );
}

/// scope: the part of the outputs to run on, as the target's ecosystem names it, such as a package for cargo; given to the command as SCOPE; all of them when left out
/// target: the identifier of the target; the target of the session's batch, or the only target, when left out
fn lint(session: Session, scope?: string, target?: string) is tool, commandTool(Operation.lint): `Run the target's lint command in this run's directory, narrowed to a scope when one is given, and say whether it passed, with its exit code and the end of its output` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `The command's environment sets SCOPE to [[scope]], or to the empty string when it is left out`,
    });
}

/// target: the identifier of the target; the target of the session's batch, or the only target, when left out
fn format(session: Session, target?: string) is tool, commandTool(Operation.format): `Run the target's format check in this run's directory and say whether it passed, with its exit code and the end of its output` => ToolResult {}
