use "../generation/data";
use "../generation/main" as Generation;
use "../grammar/main" as Grammar;
use "../model/data";
use "../model/main" as Binder;
use "../query/main" as Query;
use "../workspace/data";
use "../workspace/main" as Loader;
use "./data";
use "./traits";
use "elfie/system/file" as Files;
use "elfie/system/process" as Process;

// Decision: the agent server never writes a file. During compilation the agent writes the outputs
// itself and asks the server to check them, so one path exists for writing and the CLI owns it.
external Protocol: `The Model Context Protocol, revision 2025-06-18, as the target ecosystem's library provides it` = undefined;

fn serve(root?: string): `Serve agents over standard input and output until the connection closes` => number {
  @acceptanceCriteria
    .add({
      behavior = `Speaks the [[Protocol]] over standard input and output; nothing else is ever written to standard output, and logging goes to standard error`,
    })
    .add({
      behavior = `On initialize, [[Session.workspace]] is [[Loader.load]] of [[root]], or of the current directory`,
    })
    .add({
      behavior = `Lists exactly the fns of this file that carry [[tool]], as [[tool]] says, and nothing else: no resources and no prompts, because one surface is enough to keep exact`,
    })
    .add({
      situation = `A call arrives`,
      behavior = `First, every file of the program whose modification time or size differs from [[Session.seen]] is re-read through [[Loader.change]] with undefined, a file that vanished the same way, and a changed elfie.json loads the workspace again; then the tool runs`,
    })
    .add({ behavior = `Returns 0 when standard input closes` });

  @test(
    {
      input = [string@like(`A root whose def holds a.lfy reading: const y = z;`)],
      expect = number@like(
        `A tools/list answer naming elfie_problems, elfie_find, elfie_entity, elfie_references, elfie_outline, elfie_grammar, elfie_units, elfie_request, elfie_check, elfie_output, elfie_source, elfie_changes, and elfie_review; a call of elfie_problems answering with one binder error at z`,
      ),
    },
  );
}

/// file: a path relative to the root; every file when left out
fn problems(session: Session, file?: string) is tool: `The problems of the program, or of one file: what the compiler, an editor, or a check would report` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `One line per [[Query.diagnosticsOf]] reading the file, a colon, the line, a colon, the column, a colon, the stage, the severity, and the message`,
    })
    .add({ situation = `There are none`, behavior = `The text says no problems` });
}

/// name: an identifier, or an owner's identifier, a dot, and a member's name; a file path and a colon before it limits the search to that file
fn find(session: Session, name: string) is tool: `Where things with a name are declared` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `One line per entity of [[Query.find]] reading the kind, the identifier, the file, the line, and the definition when there is one`,
    })
    .add({ situation = `Nothing matches`, behavior = `The text says so and suggests elfie_outline` });
}

/// name: as elfie_find takes it
fn entity(session: Session, name: string) is tool: `Everything known about the things with a name: definition, type, documentation, traits, members, criteria, tests, references, and source` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `For each entity of [[Query.find]], in order: the fields of [[Query.hoverOf]] with a heading each; the identifier of each trait in [[Entity.traits]]; each member's name, definition, and type; each of [[Entity.tests]] as input and expectation; the count of [[Binder.usagesOf]] its symbol with the file and line of each; then [[Query.sourceOf]] in a fenced block`,
    })
    .add({
      situation = `More than one entity matches`,
      behavior = `Each is separated by a rule and headed by its file, so the caller can narrow the name with a file path`,
    });
}

/// name: as elfie_find takes it
fn references(session: Session, name: string) is tool: `Every place things with a name are used` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `For each entity of [[Query.find]], one line per [[Binder.usagesOf]] its symbol reading the file, the line, the column, and the text of that line`,
    });
}

/// file: a path relative to the root
fn outline(session: Session, file: string) is tool: `The declarations of one file, nested as written` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[Query.outlineOf]] as an indented list: two spaces per level, then the kind, the name, and the line`,
    })
    .add({ situation = `The file is not in the program`, behavior = `An error saying so and listing the files that are` });
}

fn grammar(session: Session) is tool: `The grammar of Elfie: every terminal and every rule as EBNF, for an agent writing or reading Elfie` => ToolResult {
  @acceptanceCriteria
    .add({ behavior = `[[Grammar.terminalDocument]], a blank line, then [[Grammar.grammarDocument]]` });
}

/// target: the identifier of one target; every target when left out
fn units(session: Session, target?: string) is tool: `The units the compiler would produce, in order, why each needs generating, and how they are batched` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[Generation.plan]] of the workspace with the source maps read from each target's output directory and the violated units of the last global review read as the command line reads them, one line per unit reading the target, [[Unit.stem]], the reason or up to date, and the stems of its dependencies; then one line per batch reading its identifier and the stems it holds`,
    })
    .add({
      situation = `[[target]] is set`,
      behavior = `Only that target's units, and an error naming the known targets when it is not one`,
    });
}

/// batch: the identifier of a batch, as elfie_units lists it, or the stem of one of its units
/// target: the identifier of the batch's target; the only target when left out
fn request(session: Session, batch: string, target?: string) is tool: `The full request for one batch: what to produce, where, every criterion to satisfy, and how to report` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[Request.instructions]] of [[Generation.request]] for the batch, with the existing outputs read from disk and no previous source`,
    })
    .add({
      situation = `No batch has that identifier or holds a unit with that stem, or the target is ambiguous`,
      behavior = `An error saying which`,
    });
}

/// unit: the stem of a unit, as elfie_units lists it
/// target: the identifier of the unit's target; the only target when left out
fn check(session: Session, unit: string, target?: string) is tool: `Whether the outputs on disk satisfy the request for one unit, and what is wrong when they do not` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[Generation.accept]] of the unit against the request of its batch and the files under [[Target.outputDirectory]] that carry a [[Marker]] for the unit's file, read from disk`,
    })
    .add({
      situation = `Accepted`,
      behavior = `The text says so and lists the outputs; nothing is written, the CLI records source maps`,
    })
    .add({ situation = `Rejected`, behavior = `An error listing [[Verdict.problems]]` });
}

// Decision: the source maps every tool below reads come from each target's output directory, as
// elfie_units reads them, so what a tool answers is what the last acceptance recorded, never a guess
// from the text on disk.
/// name: as elfie_find takes it
/// target: the identifier of one target; every target when left out
fn output(session: Session, name: string, target?: string) is tool: `Where the generated code for one entity is: every region of every output that came from it, with its text` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `For each [[Marker]] of [[Generation.regionsOf]] for [[name]] and [[target]], with the source maps read as elfie_units reads them: a line reading the output path, a colon, [[Marker.outputLine]], a dash, and [[Marker.end]], then the [[Files.read]] text of those lines of the output in a fenced block`,
    })
    .add({ situation = `Nothing is generated for [[name]]`, behavior = `The text says so` })
    .add({
      situation = `[[target]] is set and is not a known target`,
      behavior = `An error naming the known targets`,
    });
}

/// file: the path of an output file, relative to the root
/// line: a line of that file, counting from 1
fn source(session: Session, file: string, line: number) is tool: `Where one line of generated code came from: the definition file, the entity, and its line` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `The [[Marker]] of the [[SourceMap]] whose [[SourceMap.output]] is [[file]] whose region covers [[line]], that is whose [[Marker.outputLine]] is at most [[line]] and whose [[Marker.end]] is at least [[line]]: a line reading [[Marker.file]], a colon, [[Marker.line]], and then [[Marker.entity]] when it names one`,
    })
    .add({
      situation = `The marker names a requirement`,
      behavior = `[[Marker.requirement]] follows on the next line, then the text of that criterion or test, local or global, from the lowered program`,
    })
    .add({
      situation = `No source map has [[file]] as its output, or [[line]] is before its first marker`,
      behavior = `The text says no source map covers the line`,
    });
}

/// unit: the stem of a unit, as elfie_units lists it
fn changes(session: Session, unit: string) is tool: `What differs for each entity of a unit since its outputs were last accepted` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[Generation.changes]] of the unit with that stem, of the first target in [[Workspace.targets]] order that has one, with the previous text recovered as the command line recovers [[Request.previous]]: the source at the last accepted generation, through [[Process.run]] of git when the root is a repository and that source is in it; one line per [[Change]] reading [[Change.entity]], [[Change.kind]], and [[Change.detail]]`,
    })
    .add({ situation = `[[Unit.outputs]] is empty`, behavior = `The text says no previous output` })
    .add({
      situation = `The unit has outputs and the previous text cannot be recovered`,
      behavior = `The text says so first, then every entity as added, as [[Generation.changes]] gives with undefined`,
    })
    .add({ situation = `Nothing differs`, behavior = `The text says no changes` })
    .add({ situation = `No unit has that stem`, behavior = `An error saying so` });
}

/// batch: the identifier of a batch, as elfie_units lists it, or the stem of one of its units
/// target: the identifier of the batch's target; the only target when left out
fn review(session: Session, batch: string, target?: string) is tool: `The full review request for one batch: every criterion and test with the regions generated for its entities, and how to report` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[ReviewRequest.instructions]] of [[Generation.review]] for the batch, with the source maps read as elfie_units reads them, so a verifier session can fetch its own request`,
    })
    .add({
      situation = `No batch has that identifier or holds a unit with that stem, or the target is ambiguous`,
      behavior = `An error saying which`,
    });
}

fn globalReview(session: Session) is tool: `The review request for every global criterion and test, once for the whole program, with the regions that answer for each` => ToolResult {
  @acceptanceCriteria
    .add({
      behavior = `[[ReviewRequest.instructions]] of [[Generation.globalReview]] of the plan elfie_units makes, with the source maps read as elfie_units reads them, so a verifier session can fetch the global review`,
    })
    .add({ situation = `No global criterion or test exists`, behavior = `The text says so` });
}
