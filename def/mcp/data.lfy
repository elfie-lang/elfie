use "../generation/data";
use "../interpret/data";
use "../workspace/data";
use "elfie/system/json" as Json;

d ToolArgument: `One argument of a tool, as the server lists it` {
  $name: `As the parameter is named` = string;
  $description: `What it is for` = string;
  $type: `string, number, or boolean` = string;
  $required: `Whether a call must give it` = boolean;
}

d Tool: `One tool as the server lists it` {
  $name: `What a call names it by` = string;
  $description: `What it does` = string;
  $arguments: `One per argument a call may give, in parameter order` = ToolArgument[];
}

d ToolResult: `What a call returns` {
  $text: `Plain text for the agent to read` = string;
  $isError: `Whether the call failed` = boolean;
}

d CommandRun: `What one run of a target's command came to, as a command tool returns it` {
  $target: `The identifier of the target whose command ran` = string;
  $operation: `The name of the operation whose command ran, as [[Operation]] spells its member` = string;
  $line: `The line that ran` = string;
  $succeeded: `Whether it exited with 0` = boolean;
  $exitCode: `Its exit code; -1 when it ended by a signal or could not be started` = number;
  $output: `What it wrote to standard output and standard error, kept short` = string;
  $omitted: `How many lines of what it wrote [[CommandRun.output]] leaves out` = number;
}

d Session: `One agent's connection` {
  $workspace: `The program as of the last call` = Workspace;
  $seen: `The modification time and size of every file of the program when it was last read, by path; empty in a hosted session, which never re-reads one` = object;
  $binding: `What a hosted session is bound to; undefined for a session over standard input and output` = Binding | undefined;
  $reviews: `Every review elfie_report recorded in the session, one per id, in the order recorded` = Review[];
}

enum Role: `What the agent of a hosted session is run as` {
  compiler = `the compiler of one batch`,
  verifier = `the verifier of one batch, or of the global review`,
}

// Decision: a hosted session answers for one run of one agent and nothing else, so what it is bound
// to is fixed when the CLI opens it and no call can change it.
d Binding: `What one hosted session is bound to, fixed when the CLI opens it` {
  $role: `What its agent is run as` = Role;
  $batch: `The batch the run is for; undefined for the global review` = Batch | undefined;
  $directory: `The absolute path of the directory the run is in: the batch's copy when it runs in one, the root otherwise` = string;
  $plan: `The plan the compile or verify made` = Plan;
  $program: `The program the compile lowered and planned; its workspace is the one the session reads definitions from` = Program;
  $review: `The review request given to a verifier run as its input; undefined for a compiler run` = ReviewRequest | undefined;
  $sourceMaps: `The source maps that review request was made with; empty for a compiler run` = SourceMap[];
}

d Host: `An agent server served over HTTP on this machine for the length of one compile or verify` {
  $url: `Where it listens: http://127.0.0.1, a colon, the port, and a slash` = string;
  $token: `What every request to it must carry as its bearer token` = string;
  $open: `Opens one hosted session bound to a [[Binding]] and returns the session's URL` = (binding: Binding) => string;
  $offered: `The names of the tools the session at a URL is offered, in the order the server lists them` = (url: string) => string[];
  $close: `Ends the session at a URL and returns [[Session.reviews]] of it` = (url: string) => Review[];
  $stop: `Ends every session that is still open and stops listening` = () => undefined;
}

// Decision: the CLI and the agent server both plan with the units the last global review found
// violated, so the file it is kept in and which units it found violated are stated here, once.
// It lives with the agent server's data because the CLI uses the agent server and never the
// other way round.
d GlobalReview extends ReviewReport: `The last global review of a project, as elfie-requests/global.reviews.json under its root holds it` {
  $requirements: `The SHA-256 of the ids of every global criterion and test it reviewed, as lowercase hex` = string;
  @acceptanceCriteria
    .add({
      behavior = `elfie-requests/global.reviews.json under the root holds [[Json.stringify]] of the last [[GlobalReview]]: one object with the keys requirements, reviews, and problems`,
    })
    .add({
      behavior = `The ids [[GlobalReview.requirements]] hashes are those of [[Program.criteria]] then [[Program.tests]], in that order`,
    })
    .add({
      situation = `elfie-requests/global.reviews.json under the root is missing`,
      behavior = `There is no last [[GlobalReview]], and no unit is among its violated units`,
    })
    .add({
      behavior = `The violated units of the last [[GlobalReview]] are the stems of every unit whose [[Unit.outputs]] hold a [[Marker]] whose [[Marker.requirement]] is the [[Review.id]] of one of [[GlobalReview.reviews]] whose [[Review.status]] is violated`,
    });
}
