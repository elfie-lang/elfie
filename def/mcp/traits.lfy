use "../generation/data";
use "../workspace/data";
use "./data";
use "elfie/system/json" as Json;
use "elfie/system/process" as Process;

// Decision: each tool is an ordinary fn carrying this trait, so the tool list is the context
// layer of this module and never a second copy of it. Argument descriptions come from the fn's
// documentation because a [[Parameter]] has no place for a description of its own.
// Decision: which tools a session is offered is stated by the entry point that serves it, so a
// tool fn says only what it does, and one tool set is never stated twice.

trait tool: `Exposed to agents as one tool of the server` {
  where (`The server lists its tools`) and (`{{@identifier}} is offered to the session`) -> `{{@identifier}} is listed as one [[Tool]]`;
  where (`The server lists its tools`) and (`{{@identifier}} is not offered to the session`) -> `{{@identifier}} is not listed`;
  where (`The server lists its tools`) -> `The result carries ttlMs 0 and cacheScope private`;
  where (`The server lists its tools`) -> `The [[Tool.name]] of {{@identifier}} is elfie_{{@identifier}}`;
  where (`The server lists its tools`) -> `The [[Tool.description]] of {{@identifier}} is {{@definition}}`;
  where (`The server lists its tools`) -> `The [[Tool.arguments]] of {{@identifier}} hold one [[ToolArgument]] per parameter that is not the [[Session]]`;
  where (`The server lists its tools`) -> `The [[ToolArgument.name]] and [[ToolArgument.type]] of an argument of {{@identifier}} are the name and type of its parameter`;
  where (`The server lists its tools`) -> `The [[ToolArgument.description]] of an argument of {{@identifier}} is the description of its parameter`;
  where (`The server lists its tools`) and (`A parameter of {{@identifier}} that is not the [[Session]] is neither optional nor has a default`) -> `The [[ToolArgument.required]] of its argument is true`;
  where (`The server lists its tools`) and (`A parameter of {{@identifier}} that is not the [[Session]] is optional or has a default`) -> `The [[ToolArgument.required]] of its argument is false`;
  where (`A call names elfie_{{@identifier}}`) and (`{{@identifier}} is offered to the session`) and (`Every argument it gives is a parameter of {{@identifier}}, of the parameter's type, and every required argument is given`) -> `{{@identifier}} is called with the session and the arguments`;
  where (`A call names elfie_{{@identifier}}`) and (`{{@identifier}} is not offered to the session`) -> `The result is an error saying elfie_{{@identifier}} is not offered to this session`;
  where (`A call names elfie_{{@identifier}}`) and (`{{@identifier}} is not offered to the session`) -> `{{@identifier}} is not called`;
  where (`A call names elfie_{{@identifier}}`) and (`{{@identifier}} returns`) -> `The [[ToolResult]] it returns is the call's result`;
  where (`A call names elfie_{{@identifier}}`) and (`{{@identifier}} is offered to the session`) and (`An argument is missing, unknown, or of the wrong type`) -> `The result is an error naming the argument`;
  where (`A call names elfie_{{@identifier}}`) and (`An argument is missing, unknown, or of the wrong type`) -> `{{@identifier}} is not called`;
  where (`A call names elfie_{{@identifier}}`) and (`{{@identifier}} fails`) -> `The result is an error carrying the failure`;
  where (`A call names elfie_{{@identifier}}`) and (`{{@identifier}} fails`) -> `The server goes on`;
}

// Decision: the tools of a compiler session act on the request the compiler was given, which only a
// hosted session's [[Binding]] holds, so what they share is stated once here, and which entry points
// offer them is stated by those entry points as for any tool.
trait compilerTool: `Acts on the batch and the request of the compiler run a hosted session is bound to` {
  where (`A call of elfie_{{@identifier}} arrives`) and (`{{@identifier}} is offered to the session`) and (`[[Session.binding]] is undefined, or its [[Binding.request]] is undefined`) -> [
    `The result is an error saying elfie_{{@identifier}} acts only in a session bound to a compiler run`,
    `Nothing is read or written`,
  ];
  where (`A call of elfie_{{@identifier}} arrives`) -> `The batch it acts on is [[Request.batch]] of [[Binding.request]], and the units it acts on are units of that batch`;
  where (`A call of elfie_{{@identifier}} reads or writes an output`) -> `The output is read or written under [[Binding.directory]], as it is when the call arrives`;
}

// Decision: the command tools differ only in the operation whose command they run, so what running
// one means is stated once here, and each tool fn adds only what is its own.
// Decision: a command needs a directory to run in, which only a hosted session's [[Binding]] gives,
// so which entry points offer a command tool, and when, is stated by them as for any tool.
// Decision: a command that exits with a code other than 0 is an answer, not a failure of the tool,
// so the agent reads why from the output and never from an error.
// Decision: commands run in one directory share its build artifacts and lock files, so they run one
// at a time, while a command in another directory never waits for them; a command that hangs is
// stopped after 30 minutes so the queue behind it always moves on.
// Decision: the output kept is the tail, where a build or a test run states its outcome, plus the
// earlier lines that name an error or a warning and the line after each, which is where a compiler
// says where; the limits keep a whole result to a few hundred lines.
trait commandTool(operation: Operation): `Runs the target's command for one operation in the directory of the session's run` {
  // The target
  where (`A call of elfie_{{@identifier}} gives a target`) -> `The target is the one of [[Workspace.targets]] whose [[Target.identifier]] is that target`;
  where (`A call of elfie_{{@identifier}} gives no target`) and (`[[Binding.batch]] is set`) -> `The target is the [[Unit.target]] of the units of [[Binding.batch]]`;
  where (`A call of elfie_{{@identifier}} gives no target`) and (`[[Binding.batch]] is undefined`) and (`[[Workspace.targets]] holds one target`) -> `The target is that one`;
  where (`A call of elfie_{{@identifier}} gives a target that is not the [[Target.identifier]] of any of [[Workspace.targets]]`) -> [
    `The result is an error naming the known targets`,
    `No command runs`,
  ];
  where (`A call of elfie_{{@identifier}} gives no target`) and (`[[Binding.batch]] is undefined`) and (`[[Workspace.targets]] holds several targets`) -> [
    `The result is an error naming the known targets`,
    `No command runs`,
  ];
  where (`A call of elfie_{{@identifier}} gives a target`) and (`That target is the [[Target.identifier]] of one of [[Workspace.targets]]`) and (`[[Binding.batch]] is set`) and (`That target is not the [[Unit.target]] of the units of [[Binding.batch]]`) -> [
    `The result is an error saying the session acts only on its own batch, naming the batch's target`,
    `No command runs`,
  ];
  where (`A call of elfie_{{@identifier}} has a target`) and (`[[Target.commands]] of the target holds no command for the operation ({{operation}}) whose [[Command.line]] is defined`) -> [
    `The result is an error naming the target and the operation and saying the target has no command for it`,
    `No command runs`,
  ];

  // Running
  where (`A call of elfie_{{@identifier}} runs the target's command`) -> `The [[Command.line]] of the command of [[Target.commands]] of the target for the operation ({{operation}}) runs through the platform shell as [[Process.stream]] runs a command, with no input, as the leader of a process group of its own`;
  where (`A call of elfie_{{@identifier}} runs the target's command`) -> `Its working directory is [[Target.outputDirectory]] of the target under [[Binding.directory]]`;
  where (`A call of elfie_{{@identifier}} runs the target's command`) -> `Its environment sets RUN_SCRIPT to [[Target.scriptRunner]] of the target, or to the empty string when that is undefined`;
  where (`A call of elfie_{{@identifier}} runs the target's command`) -> `elfie_{{@identifier}} returns only once the command has ended`;
  where (`The command is still running 30 minutes after it started`) -> [
    `It and every process of its group are stopped, and it has ended once they have`,
    `[[CommandRun.succeeded]] is false`,
    `[[CommandRun.exitCode]] is -1`,
    `[[CommandRun.output]] ends, after the lines kept as for any run, with a line reading [elfie: stopped after 30 minutes]`,
    `The next call waiting for the same [[Binding.directory]] runs its command`,
  ];
  where (`A call of elfie_{{@identifier}} is about to run the target's command`) and (`A call of a command tool, of this session or another, that arrived earlier for the same [[Binding.directory]] has not ended`) -> `The command starts only once every such call has ended, and the calls for one directory run their commands in the order they arrived`;

  // The result
  where (`The command has ended`) -> `[[ToolResult.text]] is [[Json.stringify]] of one [[CommandRun]] for it`;
  where (`The command has ended`) -> `[[ToolResult.isError]] is false, whatever its exit code`;
  where (`The command has ended`) -> `[[CommandRun.exitCode]] is the code of the [[Process.Exit]] the run returned`;
  where (`The command has ended`) -> `The lines it wrote are every line [[Process.stream]] passed to onLine, from both streams, in the order they arrived`;
  where (`The command has ended`) -> `Every line of [[CommandRun.output]] is ended by a newline`;
  where (`The command wrote at most 200 lines`) -> [
    `[[CommandRun.output]] begins with every line it wrote`,
    `[[CommandRun.omitted]] is 0`,
  ];
  where (`The command wrote more than 200 lines`) -> `[[CommandRun.output]] begins with the kept earlier lines, then a line reading [elfie: N lines omitted] with N the count of the lines left out, then the last 200 lines it wrote`;
  where (`The command wrote more than 200 lines`) -> `The kept earlier lines are the first 100, in the order written, of the lines before the last 200 that contain error or warning without regard to case, or that come directly after such a line`;
  where (`The command wrote more than 200 lines`) -> `[[CommandRun.omitted]] is the count of the lines it wrote that are neither kept earlier lines nor among the last 200`;
  where (`The command was not stopped`) -> `[[CommandRun.output]] holds nothing after the lines the rules above give it`;
  where (`A line the command wrote and [[CommandRun.output]] keeps is longer than 500 Unicode characters`) -> `Only its first 500 Unicode characters are kept, followed by … (U+2026)`;
  where (`A line is one elfie adds to [[CommandRun.output]]`) -> `It is never shortened`;
}
