use "../grammar/rules/expression";
use "../grammar/rules/file";
use "../grammar/rules/statement";
use "../grammar/traits";
use "../model/data";
use "../parser/data";
use "../workspace/data";
use "./data";
use "elfie/prelude/builtin";
use "elfie/prelude/trait" as Traits;
use "elfie/target" as Targets;

// Decision: compile-time code runs the way Rust runs it. Code that can add names (trait
// applications, ace statements, declaration bodies) runs in a loop with name resolution until
// nothing new appears, as macro expansion does; code that only yields a value is evaluated when
// something asks for it, as const evaluation does. Elfie lets one body both read the model and
// add names, which Rust does not, so reading everything a trait was applied to waits until
// nothing can apply it any more.
// Decision: expand, evaluate, and lower live in one module although the binder calls the first
// two, the workspace calls evaluate to read targets, and lowering runs after the workspace is
// loaded, because they share one classification, phaseOf, and one value model; the pipeline
// order is stated by each fn, not by the module.
// Decision: the parse tree is never rewritten, because the query, format, and LSP stages rely on
// it reproducing the source. Lowering builds a new tree whose nodes point back to it, as
// rust-analyzer does for macro expansions.

ace const compileTimeSites: `Where compile-time code is written` = `an [[Ace]], a [[TraitDeclaration]], a [[Where]], a [[With]], an [[IsClause]], an [[ExtendsClause]], the [[Block]] of a [[DataDeclaration]] or an [[AgentFunctionDeclaration]], a [[Call]] of apply on a trait, of add on an entity's acceptanceCriteria, knowledge, commands, or targets, or of test on an entity's context, or a statement directly in a [[SourceFile]] that is not a declaration`;

fn phaseOf(model: Model, node: Node): `Whether a node runs at compile time or is kept for runtime` => Phase {
  @acceptanceCriteria
    .add({
      situation = `[[node]] is, or is inside, one of: {{compileTimeSites}}`,
      behavior = `Returns [[Phase.compile]]`,
    })
    .add({
      situation = `[[node]] is a [[TemplateReference]] or [[TemplateExecution]] in a definition, a criterion, or a test`,
      behavior = `Returns [[Phase.compile]]`,
    })
    .add({
      situation = [
        `[[node]] is not, and is not inside, any of: {{compileTimeSites}}`,
        `[[node]] is not a [[TemplateReference]] or [[TemplateExecution]] in a definition, a criterion, or a test`,
      ],
      behavior = `Returns [[Phase.runtime]]`,
    });

  @test(
    {
      input = [Model@like(`bound from: scoped.apply(SourceFile);`), Node@like(`the expression statement`)],
      expect = Phase.compile,
    },
    {
      input = [Model@like(`bound from: function f() -> number { return 1; }`), Node@like(`the return`)],
      expect = Phase.runtime,
    },
    {
      input = [Model@like(`bound from: fn f() => number { where (\`a\`) -> \`b\`; }`), Node@like(`the where`)],
      expect = Phase.compile,
    },
    { input = [Model@like(`bound from: const c = 1;`), Node@like(`the declaration`)], expect = Phase.runtime },
    {
      input = [Model@like(`bound from: d A { $x: \`d\` = string; }`), Node@like(`the data declaration`)],
      expect = Phase.runtime,
    },
  );
}

fn expand(model: Model): `Run every piece of compile-time code that can add names, until nothing new appears` => Model {
  // Guarantees
  @acceptanceCriteria
    .add({
      behavior = `A [[Phase.compile]] statement sees names as the rest of the program does: throughout their [[Scope]], wherever they are declared, including the names that other compile-time statements add`,
    })
    .add({
      behavior = `[[TraitEntity.entities]] read in compile-time code holds every entity the trait is applied to anywhere in the program`,
    })
    .add({
      situation = `Every statement left to run is waiting to read what a trait was applied to, and none can run`,
      behavior = `A [[Problem]] naming the waiting statements and the traits they wait on is added at each, and none of them runs`,
    });

  // Rounds
  @acceptanceCriteria
    .add({
      behavior = [
        `It is a fixpoint in rounds: each round runs every [[Phase.compile]] statement not yet run whose names now resolve`,
        `A statement that reads [[TraitEntity.entities]] of a trait runs only in a round where no statement not yet run can apply that trait`,
        `Rounds repeat until one runs nothing`,
      ],
    })
    .add({
      situation = `The rounds have stopped and a [[Phase.compile]] statement not yet run still does not resolve`,
      behavior = `A [[Problem]] is added at the name that does not resolve`,
    })
    .add({
      behavior = `Running a statement changes only the model: symbols join scopes, members and values join entities, [[Applied]] records join entities, and criteria and tests join entities`,
    })
    .add({ behavior = `Running a statement never changes a [[Tree]]` });

  // Applying traits
  @acceptanceCriteria
    .add({
      situation = [
        `A [[Call]] is run whose left is a [[Member]] that resolves to [[Traits.Trait.apply]] on an expression that resolves to a trait`,
        `The first argument does not resolve to an [[alternationList]]`,
      ],
      behavior = `[[Traits.apply]] is performed with that trait as subject, the entity the first argument resolves to as target, and the other arguments as [[Applied.arguments]]`,
    })
    .add({
      situation = [
        `A [[Call]] is run whose left is a [[Member]] that resolves to [[Traits.Trait.apply]] on an expression that resolves to a trait`,
        `The first argument resolves to an [[alternationList]]`,
      ],
      behavior = `[[Traits.apply]] is performed with that trait as subject, every item of the [[alternationList]] as target, and the other arguments as [[Applied.arguments]]`,
    })
    .add({
      situation = `Two applied traits declare the same member`,
      behavior = `Most recently applied trait definition wins`,
    });

  // Calls
  @acceptanceCriteria
    .add({
      behavior = `Compile-time code may call an ace function, a function, and a fn carrying [[builtin]], which the interpreter performs natively`,
    })
    .add({
      behavior = `Whether a call is compile-time code is decided by where the call is written, never by where the function it calls is declared`,
    })
    // Decision: a fn's body is criteria and has nothing to run.
    .add({
      situation = `Compile-time code calls a fn not carrying [[builtin]]`,
      behavior = `A [[Problem]] is added at the call`,
    });

  // Targets
  @acceptanceCriteria
    .add({
      situation = `A [[Call]] of add on an entity's targets is run with an argument that does not resolve to a target const, as [[Targets.Target]] defines one`,
      behavior = [`A [[Problem]] at the argument says it names no target`, `Nothing is appended`],
    })
    .add({
      situation = `A [[Call]] of add on an entity's targets is run with a const already in that entity's targets`,
      behavior = [`A [[Problem]] at the call says the target was added twice`, `Nothing is appended`],
    })
    .add({
      situation = `A [[Call]] of add is run on the targets of a member, a parameter, or an enum member`,
      behavior = [`A [[Problem]] at the call says it is built with its owner`, `Nothing is appended`],
    })
    .add({
      situation = `A target const, as [[Targets.Target]] defines one, is run`,
      behavior = `Each layer of its value is applied to it with [[Traits.apply]], with the layer's arguments, in the guidance order of [[Targets.Target]]`,
    })
    .add({
      situation = `Two layers of a target const set a member other than provides, requires, or outputExtensions to different values`,
      behavior = `A [[Problem]] at the const names the member and both layers`,
    })
    .add({
      situation = `A slot of a target const's value holds something that is neither a trait nor a [[Traits.Layer]]`,
      behavior = [`A [[Problem]] at the const names the slot`, `That item is not applied`],
    })
    .add({
      situation = `A [[Call]] of [[Traits.layer]], or of layer on a trait, gives more arguments than the trait has parameters and none of them is spread, or fewer than it has parameters that are neither optional nor spread`,
      behavior = `A [[Problem]] at the call names the trait`,
    });

  @test(
    {
      input = [Model@like(`declared from: d A is t {} trait t { $x: \`d\` = string; }`)],
      expect = Model@like(`A carrying t and the member x, though t is declared after A; no problems`),
    },
    {
      input = [
        Model@like(
          `declared from: a.lfy reading trait p {} d X is p {} d All is list(...p@entities), and b.lfy using a.lfy reading d Y is p {}`,
        ),
      ],
      expect = Model@like(`The value of All holding X and Y`),
    },
    {
      input = [Model@like(`declared from: fn f() => number; ace const c = f();`)],
      expect = Model@like(`One [[Problem]] at the call of f, and c undefined`),
    },
    {
      input = [
        Model@like(
          `declared from a project file reading: trait l extends targetLanguage {} trait f extends targetLayout {} ace const t = targetOf({ output = "o", language = l, layout = f });`,
        ),
      ],
      expect = Model@like(`t carrying f, then l, among its traits; no problems`),
    },
    {
      input = [
        Model@like(
          `declared from a project file reading: trait l extends targetLanguage {} trait f(root: string) extends targetLayout whose one where statement's behavior reads it is under, then root rendered as a template value, ace const t = targetOf({ output = "o", language = l, layout = f.layer("o") });`,
        ),
      ],
      expect = Model@like(`A criterion of t contributed by f, reading it is under o`),
    },
    {
      input = [
        Model@like(
          `declared from a project file reading: trait l extends targetLanguage { .markerComment = "#"; } trait f extends targetLayout {} ace const t = targetOf({ output = "o", language = l, layout = f });`,
        ),
      ],
      expect = Model@like(`The value # for markerComment on t`),
    },
    {
      input = [
        Model@like(
          `declared from a project file reading: trait l extends targetLanguage {} trait f extends targetLayout {} ace const t = targetOf({ output = "o", language = l, layout = f }); d A { @targets.add(t); }`,
        ),
      ],
      expect = Model@like(`A's targets holding t; no problems`),
    },
    {
      input = [
        Model@like(
          `declared from: d A { @knowledge.add({ topic = \`a guide\`, kind = KnowledgeKind.reference, source = "docs/a.md", quote = true }); }`,
        ),
      ],
      expect = Model@like(`A's knowledge holding one item, a guide, contributed by A`),
    },
    {
      input = [Model@like(`declared from: d A { @targets.add(A); }`)],
      expect = Model@like(`A's targets empty, and one [[Problem]] at the argument of the add saying it names no target`),
    },
  );
}

fn evaluate(model: Model, node: Node): `The value of an expression, computed at compile time` => Value | Prompted {
  @acceptanceCriteria
    .add({ behavior = `Evaluates [[node]] in the scope it is written in, against [[model]]` })
    .add({ behavior = `The same node evaluated twice gives the same value` })
    .add({ behavior = `Evaluating a node never changes [[model]]` })
    .add({
      behavior = `A compile-time value may be read anywhere in its scope, before or after its declaration`,
    })
    .add({
      situation = `[[node]] is a call of like on an entity's context`,
      behavior = `Returns a [[Prompted]] of that entity's type with the prompt rendered`,
    })
    .add({
      situation = `[[node]] reads a layer other than value, dereferences, or reads the previous statement, and what it reads depends only on the model`,
      behavior = `Returns the value it reads`,
    })
    .add({
      situation = [
        `[[node]] is or holds a call of an ace function, or of a function declared outside the program's runtime code`,
        `The call's arguments do not depend on a parameter or variable that only has a value at runtime`,
      ],
      behavior = `The function is run and the call's value is what it returns, wherever the call is written`,
    })
    .add({
      situation = `[[node]] depends on a parameter or variable that only has a value at runtime`,
      behavior = `Returns undefined and adds no [[Problem]]`,
    })
    .add({
      situation = `Evaluating [[node]] needs its own value, directly or through other nodes`,
      behavior = `Returns undefined and adds a [[Problem]] naming the cycle`,
    });

  @test(
    { input = [Model@like(`bound from: ace const c = 1 + 2;`), Node@like(`the right side`)], expect = Value@like(`3`) },
    {
      input = [Model@like(`bound from: ace const a = b + 1; ace const b = 2;`), Node@like(`the right side of a`)],
      expect = Value@like(`3`),
    },
    {
      input = [Model@like(`bound from: d A {} const n = A@identifier;`), Node@like(`A@identifier`)],
      expect = Value@like(`the string A`),
    },
    {
      input = [Model@like(`bound from: const s = string@like(\`a word\`);`), Node@like(`the right side`)],
      expect = Prompted@like(`of string, prompt a word`),
    },
    {
      input = [
        Model@like(
          `bound from a library file declaring ace function wrap(t) { return t; } and a project file reading ace const c = wrap({ a = 1 });`,
        ),
        Node@like(`the right side of c`),
      ],
      expect = Value@like(`an object whose a is 1`),
    },
  );
}

fn lower(workspace: Workspace): `The program as generation sees it: runtime code only, with compile-time results in place` => Program {
  // What is dropped
  @acceptanceCriteria
    .add({
      behavior = [
        `A node whose [[phaseOf]] is [[Phase.compile]] has no lowered node, and neither does anything inside it`,
        `An ace function has no lowered node`,
      ],
    });

  // What is folded
  @acceptanceCriteria
    .add({
      behavior = [
        `The value of a file-level const is [[evaluate]] of its expression, lowered as one folded node`,
        `Inside runtime code, an expression that [[evaluate]] gives a value for without a runtime parameter or variable is one folded node holding that value`,
        `A call of like is one folded node holding its [[Prompted]]`,
      ],
    })
    .add({
      situation = `A [[VariableDeclaration]] with let is directly in a [[SourceFile]]`,
      behavior = `A [[Problem]] is added at it saying a file-level let is not allowed, and it is kept`,
    })
    // Decision: such a function will not exist at runtime.
    .add({
      situation = `Runtime code calls an ace function, or a function declared outside the program's runtime code, with an argument [[evaluate]] cannot give a value for`,
      behavior = `A [[Problem]] is added at the call`,
    });

  // Members
  @acceptanceCriteria
    .add({
      behavior = [
        `A kept declaration of a data or trait-carrying entity has one child lowered node per member of its entity, in member order, after its other kept children`,
        `A member node's entity is the member and its origin is the statement that declared the member`,
      ],
    })
    .add({
      situation = `A trait added the member of a lowered member node`,
      behavior = `The member node's origin is the statement in the trait's file that declared the member`,
    })
    .add({
      situation = `[[LoweredFile.text]] spells the type of a member node`,
      behavior = `It is [[typeTextOf]] that type, with each entity that an added [[Use]] takes an alias for spelled through that alias`,
    })
    .add({
      situation = `The type of a lowered member node names an entity that the member's owner's file does not see, through its own declarations, its uses, or the prelude`,
      behavior = `[[LoweredFile.text]] of the owner's file has one [[Use]] of the declaring file after the uses written in it, once however many members need it`,
    })
    .add({
      situation = [`Such a [[Use]] is added`, `The declaring file is a file of the project`],
      behavior = `Its path is written relative to the owner's file`,
    })
    .add({
      situation = [`Such a [[Use]] is added`, `The declaring file is a file of a package`],
      behavior = `Its path is the package's name, a slash, and the file's path relative to the [[Package.root]] without its extension`,
    })
    // Decision: the alias keeps each name in the owner's file meaning one entity.
    .add({
      situation = [
        `The type of a lowered member node names an entity that the member's owner's file does not see, through its own declarations, its uses, or the prelude`,
        `The owner's file already sees another entity with the same identifier`,
      ],
      behavior = [
        `That [[Use]] takes an alias, and [[LoweredFile.text]] spells the type through that alias`,
        `The alias is an identifier that names nothing else the owner's file sees: the declaring file's path relative to [[Workspace.sourceDirectory]] without its extension, each character that cannot be in an identifier replaced by an underscore, followed by the smallest number that makes it unused when it is not unused already`,
      ],
    });

  // Criteria and tests
  @acceptanceCriteria
    .add({
      behavior = [
        `Every criterion of every entity, other than one held by a target const, is lowered once, into a [[LoweredCriterion]] with its id, and never into the tree's children`,
        `Every test of every entity is lowered once, into a [[LoweredTest]] with its id, and never into the tree's children`,
      ],
    })
    .add({
      situation = `A local criterion is for an entity other than its file's own entity`,
      behavior = `It joins [[LoweredNode.criteria]] of the node whose entity it is for`,
    })
    .add({
      situation = `A local test is for an entity other than its file's own entity`,
      behavior = `It joins [[LoweredNode.tests]] of the node whose entity it is for`,
    })
    .add({
      situation = `A local criterion is for its file's own entity`,
      behavior = `It joins [[LoweredFile.criteria]] of that file`,
    })
    .add({
      situation = `A local test is for its file's own entity`,
      behavior = `It joins [[LoweredFile.tests]] of that file`,
    })
    .add({
      situation = `A criterion was added to global's context, or comes from a trait applied to global`,
      behavior = [
        `It is global: it is in [[Program.criteria]] once, with global in its id and no entity, and in no node or file`,
        `The same trait criterion reaching every entity through global is one global criterion, not one per entity`,
      ],
    })
    .add({
      situation = `A test was added to global's context, or comes from a trait applied to global`,
      behavior = `It is global: it is in [[Program.tests]] once, with global in its id and no entity, and in no node or file`,
    })
    // Decision: a target's criteria are guidance, and every request of the target already carries
    // them.
    .add({
      situation = `A criterion is held by a target const, as [[Targets.Target]] defines one: its own, from a layer, or from a trait a layer extends`,
      behavior = `It is in no [[LoweredNode.criteria]], no [[LoweredFile.criteria]], and not in [[Program.criteria]]`,
    });

  // What is kept
  @acceptanceCriteria
    .add({
      situation = [
        `A node's [[phaseOf]] is [[Phase.runtime]]`,
        `It is not inside a [[Phase.compile]] node or an ace function`,
        `It is not replaced by a folded node`,
        `It is not an [[ExpressionStatement]] whose expression is [[Phase.compile]]`,
      ],
      behavior = `It is kept with the same rule and its kept children in order`,
    })
    .add({
      situation = `A file of [[Workspace.files]] holds only compile-time statements`,
      behavior = `It lowers to an empty [[SourceFile]]`,
    })
    .add({
      situation = `A function that is not ace has statements in its body, and every one of them is [[Phase.compile]]`,
      behavior = `A [[Problem]] is added at the function saying its body is empty at runtime and it should be ace or hold runtime code`,
    });

  @test(
    {
      input = [
        Workspace@like(`def/a.lfy reading: trait t { $x: \`d\` = string; } d A is t { where (\`s\`) -> \`b\`; }`),
      ],
      expect = Program@like(
        `a.lfy lowered to a [[SourceFile]] holding one [[DataDeclaration]] node for A with no clause, one member node for x whose origin is in t, and one [[LoweredCriterion]] with situation s and an id beginning A:A:; no node for t`,
      ),
    },
    {
      input = [Workspace@like(`def/a.lfy reading: ace function q(t) { return t + "!"; } const c = q("x");`)],
      expect = Program@like(`a.lfy holding only the const c, whose value is one folded node holding the string x!`),
    },
    {
      input = [Workspace@like(`def/a.lfy reading: trait t {} d X {} function f() { t.apply(X); }`)],
      expect = Program@like(`The function f kept with an empty body, and one [[Problem]] at f`),
    },
    {
      input = [
        Workspace@like(
          `def/a.lfy reading: trait r {} d A is r {} function names() -> string[] { let out = []; for (const e in r@entities) { out.push(e@identifier); } return out; }`,
        ),
      ],
      expect = Program@like(
        `The function names kept, with r@entities folded to a list holding A, and e@identifier kept as written`,
      ),
    },
    {
      input = [
        Workspace@like(
          `def/a.lfy reading: trait g { where (\`any\`) -> \`holds\`; } g.apply(global); d A {} d B {}, and def/b.lfy reading: global@acceptanceCriteria.add({ behavior = \`all\` });`,
        ),
      ],
      expect = Program@like(
        `[[Program.criteria]] holding two global criteria, holds with an id beginning global:g: and all with an id beginning global:, and no criteria on the nodes of A and B`,
      ),
    },
  );
}
