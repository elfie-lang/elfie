use "../grammar/traits";
use "../lexer/data";
use "../model/data";
use "../parser/data";
use "../workspace/data";

enum Phase: `When a piece of source runs` {
  compile = `compile time: it runs while binding and leaves only its results`,
  runtime = `runtime: it is kept, and generated for a target`,
}

d Value: `What evaluating an expression at compile time gives` {
  where (`An expression is evaluated`) -> `The result is undefined, null, a boolean, a number, a string, a list or object of values, an entity, a scope, or a function with the scope it was written in`;
  where (`A value is written into a lowered tree`) -> `It is spelled as the literal of its kind; an entity or a scope is spelled as a reference to its declaration, and a function as a reference to the declaration it came from`;
}

d Prompted: `A value only the compiler can choose, left for generation to choose` {
  $valueType: `The type the chosen value must have` = Entity;
  $prompt: `The prompt that describes it, with its references and executions rendered` = string;
  where (`A call of like on an entity's context is evaluated`) -> `The result is a [[Prompted]], never a value the interpreter picks, so binding stays deterministic`;
}

d LoweredNode: `One node of the program as generation sees it: runtime code only, with compile-time results in place` {
  $rule: `The rule it satisfies` = Rule;
  $children: `Lowered nodes and tokens in source order; a folded node has none` = (LoweredNode | Token)[];
  $origin: `The node of the parse tree it was lowered from` = Node;
  $entity: `The entity it declares; undefined when it declares none` = Entity | undefined;
  $value: `What a folded node holds; undefined for a node kept as written` = Value | Prompted | undefined;
  @acceptanceCriteria
    .add({ behavior = `Every lowered node has an origin, so every place generation reads maps back to the source` })
    .add({ behavior = `No lowered node has a [[Phase.compile]] rule, except a folded node whose value is a [[Prompted]]` });
}

d LoweredFile: `One file as generation sees it` {
  $file: `The file it was lowered from` = File;
  $root: `The lowered [[SourceFile]]` = LoweredNode;
}

d Program: `A workspace with every file lowered: what generation reads` {
  $workspace: `The workspace lowered` = Workspace;
  $files: `One per file of [[Workspace.files]], in the same order` = LoweredFile[];
  $problems: `Every problem lowering added, in node order` = Problem[];
}
