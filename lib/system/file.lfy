use "../prelude/builtin";
use "./time";

// Decision: there is no entity for the file as a whole to carry shared rules, so each fn says
// them itself: a path is relative to the current directory unless it is absolute, and nothing
// outside the path given is touched.

d Stat is builtin: `What the file system knows about one path` {
  $size: `Its size in bytes; 0 for a directory` = number;
  $modified: `When its content last changed` = Instant;
  $isDirectory: `Whether it is a directory rather than a file` = boolean;
}

/// path: the file to read, relative to the current directory unless absolute
fn read(path: string) is builtin: `The text of a file; undefined when it cannot be read` => string | undefined {
  where (`A file exists at [[path]]`) and (`The file can be read`) and (`Its bytes are UTF-8`) -> `Returns its whole content decoded as UTF-8`;
  where (`Nothing is at [[path]], it is a directory, it cannot be read, or its bytes are not UTF-8`) -> `Returns undefined`;
  @acceptanceCriteria
    .add({ behavior = `Nothing outside [[path]] is touched` })
    .add({ behavior = `Nothing is written` });
  @test(
    { input = [string@like(`The path of a file holding hello`)], expect = `hello` },
    { input = [string@like(`A path where nothing exists`)], expect = undefined },
  );
}

/// path: the file to write, relative to the current directory unless absolute
/// text: what the file holds afterwards
fn write(path: string, text: string) is builtin: `Whether text was written as the whole content of a file` => boolean {
  where (`A file exists at [[path]]`) -> `Its content is replaced by [[text]], encoded as UTF-8`;
  where (`No file exists at [[path]]`) -> `It is created`;
  where (`No file exists at [[path]]`) -> `Every missing directory above it is created`;
  where (`The file or a directory above it cannot be created or written`) -> `Returns false`;
  where (`The file or a directory above it cannot be created or written`) -> `Whatever was written before the failure may remain`;
  @acceptanceCriteria
    .add({ behavior = `Nothing outside [[path]] and the directories above it is touched` })
    .add({
      sideEffects = [`The file at [[path]] is written`],
    })
    .add({
      situation = `The file holds [[text]] afterwards`,
      behavior = `Returns true`,
    });
  @test(
    { input = [string@like(`A path under a directory that exists`), `hello`], expect = true },
    { input = [string@like(`A path under a directory that does not exist`), `hello`], expect = true },
    { input = [string@like(`A path under a file, which cannot be a directory`), `hello`], expect = false },
  );
}

/// path: the file to append to, relative to the current directory unless absolute
/// text: what is added at the end
fn append(path: string, text: string) is builtin: `Whether text was added to the end of a file` => boolean {
  where (`No file exists at [[path]]`) -> `It is created`;
  where (`No file exists at [[path]]`) -> `Every missing directory above it is created`;
  where (`The file cannot be created or written`) -> `Returns false`;
  @acceptanceCriteria
    .add({ behavior = `Nothing outside [[path]] and the directories above it is touched` })
    .add({
      sideEffects = [`The file at [[path]] holds what it held before, unchanged, followed by [[text]] encoded as UTF-8`],
    })
    .add({
      situation = `[[text]] is at the end of the file afterwards`,
      behavior = `Returns true`,
    });
  @test(
    { input = [string@like(`The path of a file holding a`), `b`], expect = true },
    { input = [string@like(`A path where nothing exists`), `b`], expect = true },
  );
}

/// path: what to look for, relative to the current directory unless absolute
fn exists(path: string) is builtin: `Whether something is at a path` => boolean {
  where (`A file or a directory is at [[path]]`) -> `Returns true`;
  where (`Nothing is at [[path]], or it cannot be looked at`) -> `Returns false`;
  @acceptanceCriteria.add({ behavior = `Nothing is touched` });
  @test(
    { input = [string@like(`The path of a file`)], expect = true },
    { input = [string@like(`The path of a directory`)], expect = true },
    { input = [string@like(`A path where nothing exists`)], expect = false },
  );
}

/// path: the directory to list, relative to the current directory unless absolute
/// recursive: whether files in directories under it are listed too
fn list(path: string, recursive: boolean = false) is builtin: `The files in a directory, as paths relative to it, sorted` => string[] {
  where (`[[path]] is a directory`) -> `The result holds each file directly in [[path]]`;
  where (`[[path]] is a directory`) -> `The result holds no directory`;
  where (`[[path]] is a directory`) -> `The result is in ascending text order`;
  where (`[[path]] is a directory`) and (`[[recursive]] is true`) -> `The result holds each file in every directory under [[path]]`;
  where (`[[path]] is a directory`) and (`[[recursive]] is true`) -> `The segments of each path in the result are separated by /`;
  where (`[[path]] is not a directory, or cannot be read`) -> `Returns an empty list`;
  @acceptanceCriteria
    .add({ behavior = `Nothing outside [[path]] is touched` })
    .add({ behavior = `Nothing is written` });
  @test(
    {
      input = [string@like(`A directory holding b.lfy, a.lfy, and a directory sub holding c.lfy`)],
      expect = [`a.lfy`, `b.lfy`],
    },
    {
      input = [string@like(`A directory holding b.lfy, a.lfy, and sub/c.lfy`), true],
      expect = [`a.lfy`, `b.lfy`, `sub/c.lfy`],
    },
    { input = [string@like(`A path where nothing exists`)], expect = [] },
  );
}

/// path: the directory to create, relative to the current directory unless absolute
fn createDirectory(path: string) is builtin: `Whether a directory exists at a path afterwards` => boolean {
  where (`No directory is at [[path]]`) -> `It is created`;
  where (`No directory is at [[path]]`) -> `Every missing directory above it is created`;
  where (`A directory is already at [[path]]`) -> `Nothing changes`;
  where (`A file is at [[path]], or a directory cannot be created`) -> `Returns false`;
  @acceptanceCriteria
    .add({ behavior = `Nothing outside [[path]] and the directories above it is touched` })
    .add({
      sideEffects = [`Directories are created`],
    })
    .add({
      situation = `A directory is at [[path]] afterwards`,
      behavior = `Returns true`,
    });
  @test(
    { input = [string@like(`A path two levels under a directory that exists`)], expect = true },
    { input = [string@like(`The path of a directory that exists`)], expect = true },
    { input = [string@like(`The path of a file`)], expect = false },
  );
}

/// path: what to describe, relative to the current directory unless absolute
fn stat(path: string) is builtin: `What the file system knows about a path; undefined when nothing is there` => Stat | undefined {
  where (`A file or a directory is at [[path]]`) -> `Returns its [[Stat]]`;
  where (`Nothing is at [[path]], or it cannot be looked at`) -> `Returns undefined`;
  @acceptanceCriteria.add({ behavior = `Nothing is touched` });
  @test(
    {
      input = [string@like(`The path of a file holding five bytes`)],
      expect = Stat@like(`size 5, isDirectory false, modified when it was written`),
    },
    { input = [string@like(`The path of a directory`)], expect = Stat@like(`isDirectory true`) },
    { input = [string@like(`A path where nothing exists`)], expect = undefined },
  );
}

/// path: the file to remove, relative to the current directory unless absolute
fn remove(path: string) is builtin: `Whether one file was removed` => boolean {
  where (`A file is at [[path]]`) and (`The file can be removed`) -> `It is removed`;
  where (`A directory is at [[path]]`) -> `Nothing changes`;
  where (`A directory is at [[path]]`) -> `Returns false`;
  where (`Nothing is at [[path]], or the file cannot be removed`) -> `Returns false`;
  @acceptanceCriteria
    .add({ behavior = `Nothing outside [[path]] is touched` })
    .add({
      sideEffects = [`The file at [[path]] is deleted`],
    })
    .add({
      situation = `The file is gone because of this call`,
      behavior = `Returns true`,
    });
  @test(
    { input = [string@like(`The path of a file`)], expect = true },
    { input = [string@like(`The path of a directory`)], expect = false },
    { input = [string@like(`A path where nothing exists`)], expect = false },
  );
}
