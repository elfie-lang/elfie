use "../prelude/builtin";

// Decision: parse is also the name of the function in ./time; a file that uses both aliases one
// with use ... as.

d Json is builtin: `A value that JSON can carry: an object, a list, a string, a number, a boolean, or null` {
  /// key: the name of an entry of an object
  $get: `The entry of an object under a key; undefined when the value is not an object or has no such entry` = (
    key: string,
  ) => .[key];
  with Json$get {
    @test(
      { input = [{ a = 1 }, `a`], expect = 1 },
      { input = [{ a = 1 }, `b`], expect = undefined },
      { input = [[1, 2], `a`], expect = undefined },
    );
  }

  /// path: keys and list indexes joined by dots, such as targets.rust.output or files.0.path
  $at: `The value a dotted path reaches through nested objects and lists; undefined when any step is missing` = (
    path: string,
  ) => Json | undefined;
  with Json$at {
    where (`The value at a step is an object`) and (`The object has an entry under the key the step names`) -> `The walk continues into that entry`;
    where (`The value at a step is an object`) and (`The object has no entry under the key the step names`) -> `Returns undefined`;
    where (`The value at a step is a list`) and (`The step is a whole number that is an index of the list`) -> `The walk continues into the item at that index`;
    where (`The value at a step is a list`) and !(`The step is a whole number that is an index of the list`) -> `Returns undefined`;
    where (`The value at a step is neither an object nor a list`) -> `Returns undefined`;
    where (`The path is empty`) -> `Returns the value itself`;
    @test(
      { input = [{ a = { b = [1, 2] } }, `a.b.1`], expect = 2 },
      { input = [{ a = { b = [1, 2] } }, `a.c`], expect = undefined },
      { input = [{ a = 1 }, `a.b`], expect = undefined },
    );
  }

  $isObject: `Whether the value is an object` = () => boolean;
  with Json$isObject {
    where (`The value is an empty object`) -> `Returns true`;
    @test({ input = [{ a = 1 }], expect = true }, { input = [[1]], expect = false }, { input = [null], expect = false });
  }

  $isList: `Whether the value is a list` = () => boolean;
  with Json$isList {
    where (`The value is an empty list`) -> `Returns true`;
    @test(
      { input = [[1]], expect = true },
      { input = [{ a = 1 }], expect = false },
      { input = [`[1]`], expect = false },
    );
  }
}

/// text: JSON text
fn parse(text: string) is builtin: `The value JSON text carries; undefined when the text is not JSON` => Json | undefined {
  where (`[[text]] is one JSON value, with any whitespace around it`) -> `Returns that value`;
  where (`[[text]] holds an object`) -> `The object's keys keep the order the text gives them`;
  where (`[[text]] is empty, is not JSON, or holds more than one value`) -> `Returns undefined`;
  where (`An object repeats a key`) -> `The last one wins`;
  @test(
    { input = [`{"a": [1, 2], "b": null}`], expect = { a = [1, 2], b = null } },
    { input = [` "text" `], expect = `text` },
    { input = [`{"a": }`], expect = undefined },
    { input = [``], expect = undefined },
  );
}

enum Layout: `How stringify lays out its text` {
  compact = `One line, with no spaces outside strings`,
  readable = `One entry or item per line, indented by nesting level`,
}

/// value: what to write
/// layout: how the text is laid out
fn stringify(value: Json, layout: Layout = Layout.compact) is builtin: `JSON text carrying a value` => string {
  where (`[[layout]] is [[Layout.compact]]`) -> `The text has no line break`;
  where (`[[layout]] is [[Layout.compact]]`) -> `The text has no space outside strings`;
  where (`[[layout]] is [[Layout.readable]]`) -> `Each entry or item is on a line of its own`;
  where (`[[layout]] is [[Layout.readable]]`) -> `Each line is indented by two spaces per level of nesting`;
  where (`[[layout]] is [[Layout.readable]]`) -> `A space follows each colon`;
  where (`[[layout]] is [[Layout.readable]]`) -> `The text ends with a newline`;
  where (`[[layout]] is [[Layout.readable]]`) and (`The value holds an empty object or list`) -> `The empty object or list stays on one line`;
  where (`The value holds an object`) -> `Its keys are written in insertion order`;
  where (`The value holds a string`) -> `It is quoted with the escapes JSON requires and no others`;
  @test(
    { input = [{ a = [1, 2], b = `x` }], expect = `{"a":[1,2],"b":"x"}` },
    { input = [{ a = [1] }, Layout.readable], expect = `{\n  "a": [\n    1\n  ]\n}\n` },
    { input = [{}, Layout.readable], expect = `{}\n` },
  );
}
