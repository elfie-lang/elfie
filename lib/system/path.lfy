use "../prelude/builtin";

// Decision: every member test puts the receiver first in input, then the arguments.
// Decision: members that produce a path give a [[Path]], not a string, so that calls chain; a
// Path is a string all the same, and a parameter typed Path takes any string.
// Decision: segments is a signature rather than .split("/") because a Path has no split of its
// own; its criterion says what the split would give.

d Path is builtin: `A file system path, as text` {
  where (`Any path the language sees`) -> `Its separator is /, whatever the platform; the target converts when it hands a path to a platform whose separator differs and when it reads one back`;
  where (`A path is written in the compiler's own definitions`) -> `It is relative to the workspace root unless the definition says otherwise`;
  where (`A path ends in a separator`) -> `The trailing separator names nothing and every member ignores it`;

  /// segments: what is appended, in order
  $join: `The path with each segment appended after one separator` = (...segments: string[]) => Path;
  with Path$join {
    where (`A segment is empty`) -> `It adds nothing, so a/ and b join as a/b`;
    where (`A segment is absolute`) -> `It replaces everything before it`;
    where (`There are no segments`) -> `The result is the path itself, unchanged`;
    @test(
      { input = [`a`, `b`, `c.lfy`], expect = `a/b/c.lfy` },
      { input = [`a/`, `b`], expect = `a/b` },
      { input = [`a`, `/b`], expect = `/b` },
    );
  }

  $parent: `The path without its last segment; undefined at a root` = () => Path | undefined;
  with Path$parent {
    where (`The path has more than one segment`) -> `The result is every segment but the last, with the separators between them`;
    where (`The path is one segment, or the root /`) -> `Returns undefined`;
    where (`The path is one segment under the root, such as /a`) -> `Returns /`;
    @test(
      { input = [`a/b/c.lfy`], expect = `a/b` },
      { input = [`/a`], expect = `/` },
      { input = [`c.lfy`], expect = undefined },
      { input = [`/`], expect = undefined },
    );
  }

  $fileName: `The last segment` = () => string;
  with Path$fileName {
    where (`The path has segments`) -> `Returns the last one, extension included`;
    where (`The path is the root / or empty`) -> `Returns the empty string`;
    @test(
      { input = [`a/b/c.lfy`], expect = `c.lfy` },
      { input = [`c.lfy`], expect = `c.lfy` },
      { input = [`/`], expect = `` },
    );
  }

  $extension: `What follows the last dot of the file name, without the dot; undefined when there is none` = () => string | undefined;
  with Path$extension {
    where (`The file name has a dot that is not its first character`) -> `Returns the text after the last such dot`;
    where (`The file name has no dot, or only a leading one`) -> `Returns undefined`;
    where (`A dot appears in a directory segment only`) -> `It does not count; a.b/c has no extension`;
    @test(
      { input = [`a/b.tar.gz`], expect = `gz` },
      { input = [`a/b`], expect = undefined },
      { input = [`.bashrc`], expect = undefined },
      { input = [`a.b/c`], expect = undefined },
    );
  }

  $stem: `The file name without its extension` = () => {
    const name = .fileName();
    const extension = .extension();
    if (extension == undefined) {
      return name;
    }
    return name[0..(name.length - extension.length - 1)];
  };
  with Path$stem {
    @test(
      { input = [`a/b.tar.gz`], expect = `b.tar` },
      { input = [`a/b`], expect = `b` },
      { input = [`.bashrc`], expect = `.bashrc` },
    );
  }

  /// extension: the new extension, without a dot
  $withExtension: `The same path with its extension replaced, or added when it has none` = (extension: string) => {
    const name = .stem() + "." + extension;
    const parent = .parent();
    if (parent == undefined) {
      return name;
    }
    return parent.join(name);
  };
  with Path$withExtension {
    @test({ input = [`a/b.lfy`, `rs`], expect = `a/b.rs` }, { input = [`b`, `rs`], expect = `b.rs` });
  }

  /// base: the path the result is relative to
  $relative: `The path that names the same place from base; undefined when one is absolute and the other is not` = (
    base: Path,
  ) => Path | undefined;
  with Path$relative {
    where (`The path and base are both absolute, or both relative`) -> `Both are normalized, and the result is the segments of the path after the ones it shares with base, preceded by one .. for each segment base has beyond the shared ones`;
    where (`The path and base name the same place`) -> `Returns .`;
    where (`One of the path and base is absolute and the other is not`) -> `Returns undefined, because nothing relates them`;
    @test(
      { input = [`src/a/b.rs`, `src`], expect = `a/b.rs` },
      { input = [`src/a/b.rs`, `src/c`], expect = `../a/b.rs` },
      { input = [`src`, `src`], expect = `.` },
      { input = [`/src`, `src`], expect = undefined },
    );
  }

  $isAbsolute: `Whether the path begins at a root rather than at the current directory` = () => boolean;
  with Path$isAbsolute {
    where (`The path begins with /`) -> `Returns true`;
    where (`The path was read back from a platform with drive letters and begins with one`) -> `Returns true`;
    where (`The path does not begin with /, and does not begin with a drive letter after being read back from a platform with drive letters`) -> `Returns false`;
    @test({ input = [`/a/b`], expect = true }, { input = [`a/b`], expect = false }, { input = [``], expect = false });
  }

  $normalize: `The path with . segments removed and .. segments resolved textually, never by looking at the disk` = () => Path;
  with Path$normalize {
    where (`A segment is .`) -> `It is dropped`;
    where (`A segment is .. and a segment other than .. precedes it`) -> `Both are dropped`;
    where (`A segment is .. at the start of a relative path, or after other leading .. segments`) -> `It stays`;
    where (`A segment is .. at the root of an absolute path`) -> `It is dropped, since the root has no parent`;
    where (`Nothing is left`) -> `Returns . for a relative path and / for an absolute one`;
    @test(
      { input = [`a/./b/../c`], expect = `a/c` },
      { input = [`../a`], expect = `../a` },
      { input = [`/../a`], expect = `/a` },
      { input = [`a/..`], expect = `.` },
    );
  }

  $segments: `The text between the separators, in order` = () => string[];
  with Path$segments {
    where (`Any path`) -> `Returns what splitting the text at every separator gives, so an absolute path has an empty first segment and an empty path one empty segment`;
    @test({ input = [`a/b/c.lfy`], expect = [`a`, `b`, `c.lfy`] }, { input = [`/a`], expect = [``, `a`] });
  }

  /// base: the path that may lead this one
  $startsWith: `Whether base is this path or a directory above it, segment by segment` = (base: Path) => {
    const mine = .segments();
    const theirs = base.segments();
    if (theirs.length > mine.length) {
      return false;
    }
    for (const index of theirs) {
      if (mine[index] != theirs[index]) {
        return false;
      }
    }
    return true;
  };
  with Path$startsWith {
    @test(
      { input = [`src/a/b.rs`, `src/a`], expect = true },
      { input = [`src/ab/c.rs`, `src/a`], expect = false },
      { input = [`src`, `src`], expect = true },
    );
  }
}
