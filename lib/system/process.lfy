use "../prelude/builtin";

// Decision: a command is one string for the platform shell, not a program and an argument list,
// because the commands the compiler runs come from elfie.json and scripts as one line of text.
// Decision: the test of stream passes a real inline function and says what it must have been
// called with in the expectation, because there is no value of a function type to describe.

d Exit is builtin: `What a finished command left` {
  $code: `Its exit code; -1 when it ended by a signal or could not be started` = number;
  $stdout: `Everything it wrote to standard output` = string;
  $stderr: `Everything it wrote to standard error` = string;
  $succeeded: `Whether it exited with 0` = () => .code == 0;
  with Exit$succeeded {
    @test(
      { input = [{ code = 0, stdout = ``, stderr = `` }], expect = true },
      { input = [{ code = 1, stdout = ``, stderr = `` }], expect = false },
    );
  }
}

enum Stream: `One of the two text streams a process writes` {
  output = `standard output`,
  error = `standard error`,
}

/// command: the command line, for the platform shell
/// input: its standard input; empty when left out
/// directory: its working directory; the current one when left out
/// environment: variables added to the inherited environment, by name; an entry replaces an inherited one
fn run(command: string, input?: string, directory?: string, environment?: object) is builtin: `Runs a command through the platform shell and waits for it, capturing its output whole` => Exit {
  where (`[[input]] is set`) -> `[[input]] is written to the command's standard input`;
  where (`[[input]] is set`) -> `The command's standard input is closed once [[input]] is written`;
  where (`[[input]] is unset`) -> `The command's standard input is empty`;
  where (`[[directory]] is set`) -> `The command runs with [[directory]] as its working directory`;
  where (`[[directory]] is set`) and (`[[directory]] is relative`) -> `[[directory]] is resolved against the current directory`;
  where (`[[directory]] is unset`) -> `The command runs with the current directory as its working directory`;
  where (`[[environment]] is set`) -> `Each of its entries is set in the command's environment on top of the inherited one`;
  where (`[[environment]] is set`) -> `No variable of the inherited environment is removed`;
  where (`The shell cannot be started, or [[directory]] does not exist`) -> `Returns an [[Exit]] whose [[Exit.code]] is -1`;
  where (`The shell cannot be started, or [[directory]] does not exist`) -> `[[Exit.stderr]] describes the failure`;
  @acceptanceCriteria
    .add({ behavior = `[[command]] is run by the platform shell: sh -c on Unix, cmd /C on Windows` })
    .add({ behavior = `The call returns only once the command has exited` })
    .add({ behavior = `[[Exit.stdout]] and [[Exit.stderr]] are decoded as UTF-8` });
  @test(
    { input = [`echo hi`], expect = { code = 0, stdout = `hi\n`, stderr = `` } },
    { input = [`exit 3`], expect = Exit@like(`code 3`) },
    { input = [`cat`, `hello`], expect = { code = 0, stdout = `hello`, stderr = `` } },
    {
      input = [`pwd`, undefined, string@like(`A directory that exists`)],
      expect = Exit@like(`stdout naming that directory`),
    },
    {
      input = [`echo $ELFIE_PROBE`, undefined, undefined, { ELFIE_PROBE = `1` }],
      expect = { code = 0, stdout = `1\n`, stderr = `` },
    },
  );
}

/// command: the command line, for the platform shell
/// input: its standard input; empty when left out
/// directory: its working directory; the current one when left out
/// environment: variables added to the inherited environment, by name; an entry replaces an inherited one
/// onLine: called with each line as it arrives and the [[Stream]] it was written to
fn stream(
  command: string,
  input?: string,
  directory?: string,
  environment?: object,
  onLine?: (line: string, stream: Stream) => undefined,
) is builtin: `Runs a command as run does, passing each line of its output to onLine as it arrives` => Exit {
  where (`[[onLine]] is set`) and (`The command writes a line to standard output or standard error`) -> `[[onLine]] is called once with the line, without its line ending, and the [[Stream]] it was written to`;
  where (`[[onLine]] is set`) and (`The command writes a line to standard output or standard error`) -> `[[onLine]] is called for the line before the [[Exit]] is returned`;
  where (`[[onLine]] is set`) -> `[[onLine]] receives the lines in the order they arrived`;
  where (`[[onLine]] is set`) and (`The command ends a stream with text after its last line ending`) -> `[[onLine]] is called with that text and the [[Stream]] it was written to`;
  @acceptanceCriteria
    .add({ behavior = `Runs [[command]] as [[run]] does with the same arguments` })
    .add({
      behavior = `Returns the [[Exit]] that [[run]] would, with the whole output in [[Exit.stdout]] and [[Exit.stderr]]`,
    });
  @test(
    {
      input = [`echo a; echo b >&2`, undefined, undefined, undefined, (line, stream) => undefined],
      expect = Exit@like(`onLine was called with a and output, then with b and error`),
    },
    { input = [`echo hi`], expect = { code = 0, stdout = `hi\n`, stderr = `` } },
  );
}

/// name: the variable's name
fn environment(name: string) is builtin: `The value of an environment variable; undefined when it is not set` => string | undefined {
  where (`[[name]] is set in the process's environment`) -> `Returns its value, even when empty`;
  where (`[[name]] is not set`) -> `Returns undefined`;
  @test(
    { input = [`PATH`], expect = string@like(`The search path, not empty`) },
    { input = [`ELFIE_NO_SUCH_VARIABLE`], expect = undefined },
  );
}

fn currentDirectory() is builtin: `The process's working directory, as an absolute path` => string {
  @acceptanceCriteria
    .add({ behavior = `Returns the directory relative paths resolve against` })
    .add({ behavior = `The result has / as its separator` });
}

/// code: the exit code the process ends with
fn exit(code: number) is builtin: `Ends the process with an exit code; never returns` => undefined {
  @acceptanceCriteria
    .add({
      behavior = `The process ends at once with [[code]] as its exit code`,
      sideEffects = [`The process ends`],
    })
    .add({ behavior = `Standard output and standard error are flushed before the process ends` });
}

/// stream: the stream asked about
fn isTerminal(stream: Stream) is builtin: `Whether a stream is written to a terminal rather than a file or a pipe` => boolean {
  where (`[[stream]] is attached to a terminal`) -> `Returns true`;
  where (`[[stream]] is redirected to a file, a pipe, or nothing`) -> `Returns false`;
}
