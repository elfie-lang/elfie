use "../prelude/builtin";

// Decision: one Number holds integers and fractions alike; nothing here distinguishes them but isInteger.

d Number is builtin: `A number; integer or not` {
  where (`A number is written`) -> `Decimal digits with an optional fraction, such as 1_000.5`;
  where (`A number is written with underscores`) -> `They only group digits and do not change its value`;
  where (`Numbers meet +, -, *, /, %, or **`) -> `The result is a number`;
  where (`Numbers meet /`) -> `The result is never truncated`;
  where (`Numbers meet %`) -> `The result has the sign of the left side`;

  $floor: `The greatest integer not above the number` = () => number;
  with Number$floor {
    @test({ input = [1.7], expect = 1 });
    @test({ input = [-1.2], expect = -2 });
  }
  $ceil: `The least integer not below the number` = () => number;
  with Number$ceil {
    @test({ input = [1.2], expect = 2 });
    @test({ input = [-1.7], expect = -1 });
  }
  $round: `The nearest integer, halves away from zero` = () => number;
  with Number$round {
    @test({ input = [2.5], expect = 3 });
    @test({ input = [-2.5], expect = -3 });
  }
  $abs: `The number without its sign` = () => . < 0 ? -. : .;
  $toString: `The number as text` = () => string;
  with Number$toString {
    where (`The number is an integer`) -> `No fraction is written`;
    where (`The number has a fraction`) -> `The shortest decimal that reads back as the same number is written`;
    @test({ input = [42], expect = "42" });
    @test({ input = [0.1], expect = "0.1" });
  }
  $toFixed: `The number as text with exactly digits places after the point` = (digits: number) => string;
  with Number$toFixed {
    where (`The number has more places than digits`) -> `It is rounded, halves away from zero`;
    @test({ input = [1.005, 2], expect = "1.01" });
    @test({ input = [2, 1], expect = "2.0" });
  }
  $isInteger: `Whether the number has no fraction` = () => boolean;
  with Number$isInteger {
    @test({ input = [3], expect = true });
    @test({ input = [3.5], expect = false });
  }
  $min: `The lesser of the number and the other` = (other: number) => . < other ? . : other;
  $max: `The greater of the number and the other` = (other: number) => . > other ? . : other;
  $clamp: `The number held between low and high` = (low: number, high: number) => number;
  with Number$clamp {
    where (`low is greater than high`) -> `Returns high, whatever the number`;
    @test({ input = [12, 0, 10], expect = 10 });
    @test({ input = [5, 10, 0], expect = 0 });
  }
}

d Boolean is builtin: `true or false` {
  where (`Values meet &&`) and (`The left side is falsy`) -> `&& yields the left side`;
  where (`Values meet &&`) and (`The left side is truthy`) -> `&& yields the right side`;
  where (`Values meet ||`) and (`The left side is truthy`) -> `|| yields the left side`;
  where (`Values meet ||`) and (`The left side is falsy`) -> `|| yields the right side`;
  where (`A value meets !`) and (`The value is falsy`) -> `! yields true`;
  where (`A value meets !`) and (`The value is truthy`) -> `! yields false`;
  where (`The left side of && or || decides the result`) -> `The right side is not evaluated`;
  where (`A value is judged truthy or falsy`) -> `Only false, null, and undefined are falsy`;
  where (`A value is judged truthy or falsy`) -> `Every other value is truthy, 0, empty strings, and empty lists included`;

  $not: `The opposite` = () => !.;
}
