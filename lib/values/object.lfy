use "../prelude/builtin";

// Decision: an object is generic over its values only, since its keys are always strings.
// Decision: entries needs a pair type and a receiver of its own, so it is a top-level fn the
// member refers to, with its tests on the fn; the parameter is named source because object is a
// keyword. Pair is declared here because nothing else in the language is a tuple.

d Pair<K, V>: `A key with its value` {
  $key: `The key` = K;
  $value: `The value` = V;
}

d Object<V> is builtin: `Keys with values` {
  where (`An object is written`) -> `Keys and values go in braces, each key set with =, such as { a = 1, b = "x" }`;
  where (`An object is read with .key or .[key]`) and (`The key is present`) -> `Yields the key's value`;
  where (`An object is read with .key or .[key]`) and (`The key is absent`) -> `Yields undefined`;
  where (`A for loop written (const k of obj) visits an object`) -> `It visits the keys`;
  where (`A for loop written (const v in obj) visits an object`) -> `It visits the values`;
  where (`A for loop written (const v, k from obj) visits an object`) -> `It visits both the values and the keys`;
  where (`A type is written object`) -> `It is an open [[Object]] whose values are not known`;
  where (`[[Object.keys]], [[Object.values]], or [[Object.entries]] lists an object`) -> `It lists in the order the keys were first set`;

  $keys: `The keys` = () => string[];
  with Object$keys {
    @test({ input = [{ b = 1, a = 2 }], expect = ["b", "a"] });
    @test({ input = [{}], expect = [] });
  }
  $values: `The values` = () => V[];
  with Object$values {
    @test({ input = [{ b = 1, a = 2 }], expect = [1, 2] });
    @test({ input = [{}], expect = [] });
  }
  $entries: `Each key with its value` = entries;
  $get: `The value of the key, or undefined when absent` = (key: string) => .[key];
  $has: `Whether the key is present, whatever its value` = (key: string) => boolean;
  with Object$has {
    @test({ input = [{ a = undefined }, "a"], expect = true });
  }
  $merge: `A new object with this object's keys and then the other's` = (other: Object<V>) => Object<V>;
  with Object$merge {
    where (`A key is in both`) -> `The other's value wins`;
    where (`A key is in both`) -> `The key keeps its place from this object`;
    @acceptanceCriteria.add({ behavior = `Neither object is changed` });
    @test({ input = [{ a = 1, b = 2 }, { b = 3, c = 4 }], expect = { a = 1, b = 3, c = 4 } });
    @test({ input = [{}, { a = 1 }], expect = { a = 1 } });
  }
  $isEmpty: `Whether there are no keys` = () => boolean;
}

/// source: the receiver
fn entries<V>(source: Object<V>) is builtin: `Each key of the object with its value` => Pair<string, V>[] {
  where (`The object has keys`) -> `Returns one [[Pair]] per key, holding the key and its value`;
  where (`The object is empty`) -> `Returns an empty list`;
  @test({ input = [{ a = 1 }], expect = [{ key = "a", value = 1 }] });
  @test({ input = [{}], expect = [] });
}
