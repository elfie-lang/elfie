use "../prelude/builtin";
use "../prelude/kinds";
use "./number";

// Decision: every member test puts the receiver first in input, then the operation's arguments.
// Decision: only push changes the receiver; every other operation leaves it as it was and returns a new value.
// Decision: some and every are written with findIndex rather than find, so an item that is itself undefined counts.

d List is builtin: `An ordered sequence of values` {
  where (`A list is written`) -> `Items go in square brackets, such as [a, b]; ...a inside the brackets spreads a's items in place, such as [...a, ...b]`;
  where (`A list is indexed with .[i]`) -> `Yields the item at i counting from 0, or undefined when i is out of range`;
  where (`A list is indexed with a range .[a ... b]`) -> `Yields a new list of the items from a up to but not including b`;
  where (`A for loop visits a list`) -> `in visits the items, of the indices, and (const item, index from list) both`;

  $length: `The count of items` = number;
  with List$length {
    @test({ input = [[1, 2, 3]], expect = 3 });
    @test({ input = [[]], expect = 0 });
  }
  /// transform: (item, index) => the item's replacement
  $map: `Each item transformed, in order` = (transform: function) => Any[];
  with List$map {
    @test({ input = [[1, 2], (x) => x + 1], expect = [2, 3] });
    @test({ input = [[], (x) => x], expect = [] });
  }
  /// predicate: (item, index) => whether the item is kept
  $filter: `The items the predicate accepts, in order` = (predicate: function) => Any[];
  with List$filter {
    @test({ input = [[1, 2, 3], (x) => x > 1], expect = [2, 3] });
    @test({ input = [[1, 2], (x) => false], expect = [] });
  }
  /// predicate: (item) => whether the item is wanted
  $find: `The first item the predicate accepts, or undefined when none` = (predicate: function) => {
    for (const item in .) {
      if (predicate(item)) {
        return item;
      }
    }
    return undefined;
  };
  with List$find {
    @test({ input = [[1, 2, 3], (x) => x > 1], expect = 2 });
    @test({ input = [[1, 2], (x) => x > 5], expect = undefined });
  }
  /// predicate: (item) => whether the item is wanted
  $findIndex: `The index of the first item the predicate accepts, or -1 when none` = (predicate: function) => number;
  with List$findIndex {
    @test({ input = [[1, 2, 3], (x) => x > 1], expect = 1 });
    @test({ input = [[1, 2], (x) => x > 5], expect = -1 });
  }
  $includes: `Whether some item equals the value` = (value: Any) => boolean;
  with List$includes {
    where (`Items are compared`) -> `Equality is that of ==: without casting`;
    @test({ input = [[1, 2], 2], expect = true });
    @test({ input = [[1, 2], "2"], expect = false });
  }
  $indexOf: `The index of the first item equal to the value, or -1 when none` = (value: Any) => number;
  with List$indexOf {
    @test({ input = [["a", "b", "a"], "a"], expect = 0 });
    @test({ input = [["a"], "z"], expect = -1 });
  }
  $join: `The items' text, separated` = (separator: string = ",") => string;
  with List$join {
    where (`An item is not a string`) -> `Its text is that of [[Number.toString]] for a number, true or false for a boolean, and empty for null or undefined`;
    @test({ input = [[1, "b"], "-"], expect = "1-b" });
    @test({ input = [["a", "b"]], expect = "a,b" });
  }
  $push: `Appends the item to the list itself and yields the new length` = (item: Any) => number;
  with List$push {
    where (`Called`) -> `The receiver is changed in place: it gains the item at its end`;
    @test({ input = [[1], 2], expect = 2 });
    @test({ input = [[], "a"], expect = 1 });
  }
  $concat: `The items of this list followed by the other's` = (other: Any[]) => Any[];
  with List$concat {
    @test({ input = [[1], [2, 3]], expect = [1, 2, 3] });
    @test({ input = [[], []], expect = [] });
  }
  $slice: `The items from start up to but not including end, or to the end of the list` = (start: number, end?: number) => Any[];
  with List$slice {
    @test({ input = [[1, 2, 3], 1], expect = [2, 3] });
    @test({ input = [[1, 2, 3], 0, 2], expect = [1, 2] });
  }
  $first: `The first item, or undefined when empty` = () => .[0];
  with List$first {
    @test({ input = [[7, 8]], expect = 7 });
  }
  $last: `The last item, or undefined when empty` = () => .[.length - 1];
  with List$last {
    @test({ input = [[7, 8]], expect = 8 });
  }
  $isEmpty: `Whether there are no items` = () => .length == 0;
  with List$isEmpty {
    @test({ input = [[]], expect = true });
  }
  /// compare: (a, b) => negative when a goes first, positive when b does, zero when either
  $sort: `The items in order` = (compare?: function) => Any[];
  with List$sort {
    where (`compare is left out`) -> `Numbers order numerically and strings by code point; items that are neither keep their order`;
    where (`Two items compare equal`) -> `They keep their order`;
    @test({ input = [[3, 1, 2]], expect = [1, 2, 3] });
    @test({ input = [["b", "a"], (a, b) => a < b ? 1 : -1], expect = ["b", "a"] });
  }
  $reverse: `The items in the opposite order` = () => Any[];
  with List$reverse {
    @test({ input = [[1, 2, 3]], expect = [3, 2, 1] });
    @test({ input = [[]], expect = [] });
  }
  $flat: `The items with each item that is a list replaced by its items, one level deep` = () => Any[];
  with List$flat {
    @test({ input = [[1, [2, [3]]]], expect = [1, 2, [3]] });
    @test({ input = [[[], [1]]], expect = [1] });
  }
  /// predicate: (item) => whether the item counts
  $some: `Whether the predicate accepts any item` = (predicate: function) => .findIndex(predicate) >= 0;
  with List$some {
    @test({ input = [[1, 2], (x) => x > 1], expect = true });
  }
  /// predicate: (item) => whether the item counts
  $every: `Whether the predicate accepts every item` = (predicate: function) => .findIndex((item) => !predicate(item)) < 0;
  with List$every {
    @test({ input = [[1, 2], (x) => x > 1], expect = false });
  }
  $unique: `The items with later repeats dropped, the first occurrence kept` = () => {
    const kept = [];
    for (const item in .) {
      if (!kept.includes(item)) kept.push(item);
    }
    return kept;
  };
  with List$unique {
    @test({ input = [[1, 2, 1, 3, 2]], expect = [1, 2, 3] });
  }
  /// reducer: (accumulated, item, index) => the next accumulated value
  $reduce: `One value built by folding the reducer over the items from initial` = (reducer: function, initial: Any) => Any;
  with List$reduce {
    where (`The list is empty`) -> `Yields initial without calling reducer`;
    @test({ input = [[1, 2, 3], (sum, x) => sum + x, 0], expect = 6 });
    @test({ input = [[], (sum, x) => sum + x, 5], expect = 5 });
  }
}
