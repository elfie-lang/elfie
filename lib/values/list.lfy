use "../prelude/builtin";
use "./number";

// Decision: every member test puts the receiver first in input, then the operation's arguments.
// Decision: only push changes the receiver; every other operation leaves it as it was and returns a new value.
// Decision: some and every are written with findIndex rather than find, so an item that is itself undefined counts.
// Decision: map and reduce need a type parameter of their own and flat a receiver of List<List<T>>,
// neither of which an inline function can declare, so each is a top-level fn taking the list first;
// the member refers to it, and its criteria and tests live on the fn, receiver still first.
// Decision: every predicate and transform receives the item and its index, so a member's own body
// passes both along.

d List<T> is builtin: `An ordered sequence of values` {
  where (`A list is written`) -> `Items go in square brackets, such as [a, b]; ...a inside the brackets spreads a's items in place, such as [...a, ...b]`;
  where (`A list is indexed with .[i]`) and (`i is in range`) -> `Yields the item at i counting from 0`;
  where (`A list is indexed with .[i]`) and (`i is out of range`) -> `Yields undefined`;
  where (`A list is indexed with a range .[a ... b]`) -> `Yields a new list of the items from a up to but not including b`;
  where (`A for loop with in visits a list`) -> `It visits the items`;
  where (`A for loop with of visits a list`) -> `It visits the indices`;
  where (`A for loop written (const item, index from list) visits a list`) -> `It visits both the items and the indices`;
  where (`A type is written T[]`) -> `It is [[List]] with T as its one type argument`;

  $length: `The count of items` = number;
  with List$length {
    @test({ input = [[1, 2, 3]], expect = 3 });
    @test({ input = [[]], expect = 0 });
  }
  $map: `Each item transformed, in order` = map;
  /// predicate: whether the item at the index is kept
  $filter: `The items the predicate accepts, in order` = (predicate: (item: T, index: number) => boolean) => T[];
  with List$filter {
    @test({ input = [[1, 2, 3], (x) => x > 1], expect = [2, 3] });
    @test({ input = [[1, 2], (x) => false], expect = [] });
  }
  /// predicate: whether the item at the index is wanted
  $find: `The first item the predicate accepts, or undefined when none` = (
    predicate: (item: T, index: number) => boolean,
  ) => {
    for (const item, index from .) {
      if (predicate(item, index)) {
        return item;
      }
    }
    return undefined;
  };
  with List$find {
    @test({ input = [[1, 2, 3], (x) => x > 1], expect = 2 });
    @test({ input = [[1, 2], (x) => x > 5], expect = undefined });
  }
  /// predicate: whether the item at the index is wanted
  $findIndex: `The index of the first item the predicate accepts, or -1 when none` = (
    predicate: (item: T, index: number) => boolean,
  ) => number;
  with List$findIndex {
    @test({ input = [[1, 2, 3], (x) => x > 1], expect = 1 });
    @test({ input = [[1, 2], (x) => x > 5], expect = -1 });
  }
  $includes: `Whether some item equals the value` = (value: T) => boolean;
  with List$includes {
    where (`Items are compared`) -> `Equality is that of ==: without casting`;
    @test({ input = [[1, 2], 2], expect = true });
    @test({ input = [[1, 2], "2"], expect = false });
  }
  $indexOf: `The index of the first item equal to the value, or -1 when none` = (value: T) => number;
  with List$indexOf {
    @test({ input = [["a", "b", "a"], "a"], expect = 0 });
    @test({ input = [["a"], "z"], expect = -1 });
  }
  $join: `The items' text, separated` = (separator: string = ",") => string;
  with List$join {
    where (`An item is a number`) -> `Its text is that of [[Number.toString]]`;
    where (`An item is true`) -> `Its text is true`;
    where (`An item is false`) -> `Its text is false`;
    where (`An item is null or undefined`) -> `Its text is empty`;
    @test({ input = [[1, "b"], "-"], expect = "1-b" });
    @test({ input = [["a", "b"]], expect = "a,b" });
  }
  $push: `Appends the item to the list itself and yields the new length` = (item: T) => number;
  with List$push {
    where (`Called`) -> `The receiver is changed in place: it gains the item at its end`;
    @test({ input = [[1], 2], expect = 2 });
    @test({ input = [[], "a"], expect = 1 });
  }
  $concat: `The items of this list followed by the other's` = (other: T[]) => T[];
  with List$concat {
    @test({ input = [[1], [2, 3]], expect = [1, 2, 3] });
    @test({ input = [[], []], expect = [] });
  }
  $slice: `The items from start up to but not including end, or to the end of the list` = (start: number, end?: number) => T[];
  with List$slice {
    @test({ input = [[1, 2, 3], 1], expect = [2, 3] });
    @test({ input = [[1, 2, 3], 0, 2], expect = [1, 2] });
  }
  $first: `The first item, or undefined when empty` = () => .[0];
  with List$first {
    @test({ input = [[7, 8]], expect = 7 });
  }
  $last: `The last item, or undefined when empty` = () => .[.length - 1];
  with List$last {
    @test({ input = [[7, 8]], expect = 8 });
  }
  $isEmpty: `Whether there are no items` = () => .length == 0;
  with List$isEmpty {
    @test({ input = [[]], expect = true });
  }
  /// compare: negative when a goes first, positive when b does, zero when either
  $sort: `The items in order` = (compare?: (a: T, b: T) => number) => T[];
  with List$sort {
    where (`compare is left out`) and (`Two items are numbers`) -> `They order numerically`;
    where (`compare is left out`) and (`Two items are strings`) -> `They order by code point`;
    where (`compare is left out`) and (`An item is neither a number nor a string`) -> `It keeps its order`;
    where (`Two items compare equal`) -> `They keep their order`;
    @test({ input = [[3, 1, 2]], expect = [1, 2, 3] });
    @test({ input = [["b", "a"], (a, b) => a < b ? 1 : -1], expect = ["b", "a"] });
  }
  $reverse: `The items in the opposite order` = () => T[];
  with List$reverse {
    @test({ input = [[1, 2, 3]], expect = [3, 2, 1] });
    @test({ input = [[]], expect = [] });
  }
  $flat: `The items of each item, one level deep` = flat;
  /// predicate: whether the item at the index counts
  $some: `Whether the predicate accepts any item` = (predicate: (item: T, index: number) => boolean) => .findIndex(
    predicate,
  ) >= 0;
  with List$some {
    @test({ input = [[1, 2], (x) => x > 1], expect = true });
  }
  /// predicate: whether the item at the index counts
  $every: `Whether the predicate accepts every item` = (predicate: (item: T, index: number) => boolean) => .findIndex((
    item,
    index,
  ) => !predicate(item, index)) < 0;
  with List$every {
    @test({ input = [[1, 2], (x) => x > 1], expect = false });
  }
  $unique: `The items with later repeats dropped, the first occurrence kept` = () => {
    const kept = [];
    for (const item in .) {
      if (!kept.includes(item)) kept.push(item);
    }
    return kept;
  };
  with List$unique {
    @test({ input = [[1, 2, 1, 3, 2]], expect = [1, 2, 3] });
  }
  $reduce: `One value built by folding the reducer over the items from initial` = reduce;
}

/// list: the receiver
/// transform: the replacement of the item at the index
fn map<T, U>(list: List<T>, transform: (item: T, index: number) => U) => List<U> {
  where (`The list has items`) -> `Calls transform once per item with the item and its index, and returns the results in the same order`;
  where (`The list is empty`) -> `Returns an empty list without calling transform`;
  @test({ input = [[1, 2], (x) => x + 1], expect = [2, 3] });
  @test({ input = [[], (x) => x], expect = [] });
}

/// list: the receiver, whose items are lists
fn flat<T>(list: List<List<T>>) => List<T> {
  where (`The list has items`) -> `Returns the items of each item in order, one level deep, so an item's own items that are lists stay lists`;
  where (`The list is empty`) -> `Returns an empty list`;
  @test({ input = [[[1], [2, [3]]]], expect = [1, 2, [3]] });
  @test({ input = [[[], [1]]], expect = [1] });
}

/// list: the receiver
/// reducer: the next accumulated value from the one so far and the item at the index
/// initial: the accumulated value before the first item
fn reduce<T, U>(list: List<T>, reducer: (accumulated: U, item: T, index: number) => U, initial: U) => U {
  where (`The list has items`) -> `Calls reducer once per item in order, with what the previous call returned, initial for the first, and yields what the last call returned`;
  where (`The list is empty`) -> `Yields initial without calling reducer`;
  @test({ input = [[1, 2, 3], (sum, x) => sum + x, 0], expect = 6 });
  @test({ input = [[], (sum, x) => sum + x, 5], expect = 5 });
}
