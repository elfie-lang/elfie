use "../criteria/command";
use "../criteria/criterion";
use "../criteria/knowledge";
use "./builtin";

d Entity is builtin: `What every declared thing is seen as through its context layer` {
  $identifier: `The declared name; undefined when anonymous` = string | undefined;
  $definition: `The description provided for it; undefined when there is none` = string | undefined;
  $type: `The declared or inferred type; the entity itself for a data, trait, type, or enum` = Entity | undefined;
  $typeParameters: `The type parameters the declaration lists, in order; empty when none` = Entity[];
  $typeArguments: `The arguments the type was written with when it is generic, in order; empty otherwise` = Entity[];
  $acceptanceCriteria: `Its own criteria first, then each trait's in application order` = Criterion[];
  $traits: `Every trait applied to it, direct or inherited, in application order` = Entity[];
  $references: `Every entity referenced with a bracketed reference in its definition, documentation, or value` = Entity[];
  $itemType: `What a list-typed entity holds; undefined otherwise` = Entity | undefined;
  $like: `A value of its type that a prompt describes` = (prompt: string) => @type;
  with Entity$like {
    where (`Called with a prompt`) -> `The compiler chooses the value, at compile time`;
    where (`Generated code runs`) -> `It never calls [[Entity.like]]`;
    where (`A test's input or expect is a call of [[Entity.like]]`) -> `Any value the prompt describes satisfies it`;
    where (`A test's input is a call of [[Entity.like]]`) -> `The generated test passes the value the compiler chose`;
    where (`A test's expect is a call of [[Entity.like]]`) -> `The generated test checks that the result is what the prompt describes, never that it equals one fixed value`;
    @test({ input = [string, `the empty string`], expect = "" });
  }
  $test: `Adds cases the entity must satisfy, and returns the entity` = (...tests: Test[]) => @;
  with Entity$test {
    where (`Called with tests`) -> `Appends each argument to [[Entity.tests]] in order`;
    where (`A test is added to a member whose value is a signature`) -> `The test's input is the receiver first, then one argument per parameter of the signature, in order`;
    @test({
      input = [string, { input = "a", expect = "a" }],
      expect = string@like(`string, with that one test as the last of its tests`),
    });
  }
  $tests: `Every test added, in order` = Test[];
  $knowledge: `What the compiler is given to read for it: its own items first, then each trait's in application order` = Knowledge[];
  $commands: `Shell commands for its operations: its own first, then each trait's, in guidance order for a target const and in application order otherwise` = Command[];
  $targets: `The target consts added to it, in the order they were added` = Entity[];
  with Entity$targets {
    where (`add is called on it with the name of a target const`) and (`The const is not already in the list`) and (`The list is not that of a member, a parameter, or an enum member`) -> `The const is appended`;
    where (`add is called on it`) -> `The call yields the list, so calls chain`;
    where (`add is called on it with anything but the name of a target const`) -> `A problem at the argument says it names no target`;
    where (`add is called on it with a const already in the list`) -> `A problem at the call says the target was added twice`;
    where (`add is called on the targets of a member, a parameter, or an enum member`) -> `A problem at the call says it is built with its owner`;
    where (`An entity's own list is not empty`) -> `It is built for the targets in it, and no others`;
    where (`An entity's own list is empty`) and (`The list of the anonymous entity of its file is not empty`) -> `It is built for its file's targets`;
    where (`An entity's own list and its file's list are empty`) -> `It is built for global's targets`;
    where (`An entity is a trait, an ace function, or anything else evaluated only at compile time`) -> `It is never built, whatever its lists say`;
    where (`An entity is declared in a file of a package`) -> `It is never built, whatever its lists say`;
  }
  where (`The context accessor is followed by a name on any entity`) -> `The name resolves among these members`;
  where (`The context accessor is followed by no name on any entity`) -> `The layer alone is the entity itself`;
  where (`A bracketed reference appears in its definition, documentation, or value`) -> `The referenced entity is added to [[Entity.references]]`;
}
