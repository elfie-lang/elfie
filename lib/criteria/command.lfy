use "../prelude/builtin";

// Decision: like criterion.lfy, this file uses nothing from the prelude but builtin, because
// entity.lfy uses it; the contributor is typed as object for the same reason.
// Decision: a target names a shell command for each operation, so the compiler need not know
// the tool.
// Decision: a command is handed to the compiler in its request and run by the agent, by hand or
// through a tool of the agent server, never by acceptance, so acceptance stays structural.
// Decision: a test command narrows the tests it runs by reading TESTS rather than by taking
// arguments, so one line serves both a whole run and a narrowed one, and a line that ignores TESTS
// still runs every test. SCOPE narrows a build, test, or lint command to part of the outputs the
// same way, so an agent can check its own part while another part is broken.
// Decision: a test command allows stubs by reading ALLOW_STUBS, the same way, so a line that ignores
// it still fails on a stub, which is the strict outcome.
// Guidance order is defined on the Target of lib/target/main.lfy, which this file cannot use.

enum Operation: `What a command is for` {
  install = `install: fetch every dependency the manifest lists`,
  add = `add: add one dependency`,
  build = `build: compile or type-check the outputs`,
  test = `test: run the tests`,
  lint = `lint: run the linters`,
  format = `format: check the formatting without changing anything`,
  run = `run: start what was built`,
}

d Command is builtin: `A shell command for one operation` {
  $operation: `What it is for` = Operation;
  $line: `What sh -c runs in the target's output directory` = string | undefined;
  $contributor: `The entity whose body holds it, seen through its context layer: the entity itself or one of its traits` = object;
  where (`An add call on an entity's commands is bound with an object holding an operation`) -> `One command with that operation and line is appended to that entity's commands, in the order the calls are written`;
  where (`A command is written in a trait's body, or in a with block inside one`) -> `The contributor is the trait, and the command joins each entity the trait is applied to`;
  where (`A command is written in an entity's own body`) -> `The contributor is the entity itself`;

  // Choosing
  where (`A target const has, for an operation, a command that none of its traits contributed`) -> `The first such command is the operation's command, whatever its traits hold`;
  where (`A target const has commands for an operation`) and (`Its traits contributed every one of them`) -> `The operation's command is the first of them in guidance order`;
  where (`An operation's command has no line`) -> `The operation has no command`;

  // Running
  where (`A command runs`) -> `RUN_SCRIPT is set to the script runner of the target's ecosystem`;
  where (`An add command runs`) -> `NAME is set to the dependency's name`;
  where (`An add command runs`) and (`The dependency pins a version`) -> `VERSION is set to that version`;
  where (`An add command runs`) and (`The dependency pins no version`) -> `VERSION is empty`;
  where (`A test command runs`) and (`Its caller gave a filter`) -> `TESTS is set to that filter`;
  where (`A test command runs`) and (`Its caller gave no filter`) -> `TESTS is empty`;
  where (`The line of a test command reads TESTS`) and (`TESTS is empty or unset`) -> `The line runs every test`;
  where (`The line of a test command reads TESTS`) and (`TESTS is not empty`) -> `The line runs only the tests its test runner selects with the words of TESTS as filters`;
  where (`The line of a test command reads TESTS`) -> `The words of TESTS reach the test runner as written, never expanded as file patterns`;
  where (`A test command runs`) and (`Its caller allows stubs`) -> `ALLOW_STUBS is set to 1`;
  where (`A test command runs`) and (`Its caller does not allow stubs`) -> `ALLOW_STUBS is empty`;
  where (`The line of a test command reads ALLOW_STUBS`) and (`ALLOW_STUBS is empty or unset`) -> `The line succeeds only when every test it runs passes, as a line that does not read it does`;
  where (`The line of a test command reads ALLOW_STUBS`) and (`ALLOW_STUBS is not empty`) -> `The line succeeds when the outputs build and every failing test it runs failed by reaching a stub, its failure message holding the stub marker of the target's language`;
  where (`The line of a test command reads ALLOW_STUBS`) and (`ALLOW_STUBS is not empty`) -> `The line fails when the outputs do not build, when a test fails for any other reason, or when a test process ends before it reports its results`;
  where (`A build, test, or lint command runs`) and (`Its caller gave a scope`) -> `SCOPE is set to that scope`;
  where (`A build, test, or lint command runs`) and (`Its caller gave no scope`) -> `SCOPE is empty`;
  where (`The line of a build, test, or lint command reads SCOPE`) and (`SCOPE is empty or unset`) -> `The line runs on every output`;
  where (`The line of a build, test, or lint command reads SCOPE`) and (`SCOPE is not empty`) -> `The line runs only on the part of the outputs SCOPE names, as the target's ecosystem names such a part, such as a package for cargo`;
}
