use "./target";

// Layouts: how a unit's output path is spelled from its stem, the source path relative to the
// source directory without .lfy. A marker trait extends one or more of these.

/// root: the directory outputs are spelled under, relative to the root; empty when another layout trait chooses the directory
/// extension: the extension of an output file, without the dot
trait modulePerFile(root: string, extension: string) extends target: `Each unit gives one file named by its stem` {
  where (`A unit's stem does not end in main`) -> `Its one output is {{root}} then the stem then a dot and {{extension}}, one directory per segment of the stem`;
  where (`A unit's stem ends in main`) -> `Its one output is the file the language names for the module of the stem's directory, spelled by the extending trait`;
  where (`A directory holds a module file and other outputs`) -> `The module file declares each of the others as the language declares a submodule`;
}

/// prefixes: each key is the first segment of a stem and its value the directory, relative to the root, that such units are written under
/// fallback: the directory, relative to the root, for units whose first segment is no key of prefixes
trait cratePerPrefix(prefixes: object, fallback: string) extends target: `Units are grouped into directories by the first segment of their stems` {
  where (`The first segment of a unit's stem is a key of {{prefixes}}`) -> `The unit is written under that key's directory, with the first segment dropped from the path`;
  where (`The first segment of a unit's stem is no key of {{prefixes}}`) -> `The unit is written under {{fallback}}, with the whole stem as the path`;
  where (`Units of two directories depend on each other`) -> `The dependency is declared between the directories as the language declares one between packages, never a copy`;
}
