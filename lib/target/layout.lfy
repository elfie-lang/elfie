use "../values/object";
use "./target";

// Layouts: how a unit's output path is spelled from its stem, the source path relative to the
// source directory without .lfy. A layout layer extends targetLayout, directly or through the
// traits below.

trait targetLayout extends target: `The role of a layout: where each unit's outputs go` {
  where (`A unit is planned`) -> `Its outputs' paths, relative to the project root, are spelled from its stem as the layout says`;
}

/// extension: the extension of an output file, without the dot
/// root: the directory outputs are spelled under, relative to the project root; left out when another layout trait chooses the directory
trait modulePerFile(extension: string, root?: string) extends targetLayout: `Each unit gives one file named by its stem` {
  where (`A unit's stem does not end in main`) -> `Its one output is the stem then a dot and {{extension}}, one directory per segment of the stem, under {{root ?? "the directory another layout trait chooses"}}`;
  where (`A unit's stem ends in main`) -> `Its one output is the file the language names for the module of the stem's directory, spelled by the extending trait`;
  where (`A directory holds the file the language names for the module of that directory, and other outputs`) -> `That module file declares each of the others as the language declares a submodule`;
}

/// prefixes: each key is the first segment of a stem and its value the directory, relative to the project root, that such units are written under
/// fallback: the directory, relative to the project root, for units whose first segment is no key of prefixes
trait cratePerPrefix(prefixes: Object<string>, fallback: string) extends targetLayout: `Units are grouped into directories by the first segment of their stems` {
  where (`The first segment of a unit's stem is a key of {{prefixes}}`) -> `The unit is written under that key's directory, with the first segment dropped from the path`;
  where (`The first segment of a unit's stem is no key of {{prefixes}}`) -> `The unit is written under {{fallback}}, with the whole stem as the path`;
  where (`Units of two directories depend on each other`) -> `The dependency is declared between the directories as the language declares one between packages, never a copy`;
}
