use "../prelude/builtin";
use "./target";

// Decision: a unit is rejected when an entity of it has no marker, so every entity built for the
// target is named at least once in the outputs.
// Decision: a marker names an entity, never a line, because a name survives edits that move lines.

/// The role of a language: what a target's code is written in. The extending trait says what each
/// kind of declaration becomes and what each builtin of the standard library is bound to; this
/// trait says that it must, how markers are written, and how the result is judged.
trait targetLanguage extends target: `The role of a language: every kind of declaration has a spelling in it` {
  $language: `The language and edition, as its own tools name it` = string;
  $fileExtension: `The extension of a source file of the language, without the dot` = string;
  $markerComment: `How a line comment begins in the language` = string;

  // Kinds
  where (`A d declaration is built`) -> [
    `It becomes the type the extending trait says a data becomes, with one field or method per member`,
    `That type satisfies the declaration's criteria`,
  ];
  where (`A fn declaration is built`) -> `It becomes the function the extending trait says a fn becomes, whose body satisfies every criterion and test`;
  where (`A function declaration is built`) -> `It is translated statement by statement into the extending trait's spelling of a function, with nothing added`;
  where (`A trait declaration is built`) -> `It emits nothing of its own`;
  where (`A type or enum declaration is built`) -> `It becomes the nearest equivalent the extending trait names for a structural type or a set of named values`;
  where (`An alias declaration is built`) -> `It becomes a second name for what it names, in the extending trait's spelling of one`;
  where (`An external declaration is built`) -> `It is bound to what the target dependency it names provides, as the extending trait says`;
  where (`A @test is built`) -> `It becomes one test in the language's own test framework, placed where the extending trait says`;
  where (`An acceptance criterion can be checked mechanically`) -> `It becomes one test named after its entity`;

  // Standard library
  where (`A data carrying [[builtin]] is used`) -> `Its instances are the native type the extending trait names for it`;
  where (`A member of a data carrying [[builtin]] whose value is a signature is called`) -> `The call is the native operation the extending trait names for it`;
  where (`A member of a data carrying [[builtin]] is written out in full`) -> `It is translated as written, in terms of the other members, where it is used or once into one shared module of the target that every unit may call`;
  where (`A fn carrying [[builtin]] is called`) -> `The call is the native function the extending trait names for it`;
  where (`A fn carries [[builtin]]`) -> `No body is generated for it`;
  where (`The extending trait names no native binding for a builtin the unit uses`) -> `The compiler stops on that unit and names the builtin`;

  // Markers
  where (`An item of a unit's output comes from an entity`) -> `It carries a line comment beginning with [[targetLanguage.markerComment]], then @lfy, a space, the source path relative to the project root, a colon, and the entity's name`;
  where (`An item of a unit's output comes from a member`) -> `The entity's name in its marker is the member's owner's identifier, a dot, and the member's name`;
  where (`An item of a unit's output is a test, or code written to satisfy one criterion`) -> `The entity's name in its marker is followed by a # and the id of that criterion or test`;
  where (`An entity of the unit has no marker in any output`) -> `The unit is rejected`;
  where (`A marker is written`) -> `It names an entity, never a line`;

  // Quality
  where (`A unit's outputs are written`) -> `The target's build, test, and lint commands succeed on the outputs with no warnings`;
}
