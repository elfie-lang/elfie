use "../prelude/builtin";
use "../prelude/trait";
use "./ecosystem";
use "./framework";
use "./interface";
use "./language";
use "./layout";
use "./platform";
use "./runtime";
use "./target";

// Decision: only a project's own consts declare targets; a package provides presets, and each
// project names its own targets.

type Dependency: `Something generated code needs from the target's ecosystem` {
  name: `The name the ecosystem knows it by` = string,
  version: `The version asked for, as the ecosystem spells it; none is pinned when left out` = string | undefined,
}

/// Each slot holds layers of one role, so any language, runtime, platform, ecosystem, framework,
/// interface, and layout can be put together, and their capabilities say whether they fit. A slot
/// holds a trait alone, or a [[Layer]] when the trait takes arguments.
d Target is builtin: `One artifact the project is built into, such as a crate, an app, or a script. A target const declares each: an ace const of a project file whose declared type is Target, or whose value is a call of a function whose output is Target` {
  $output: `The directory everything it writes is under, relative to the project root` = string;
  $language: `What its code is written in: a layer extending [[targetLanguage]]` = Trait | Layer;
  $runtime: `What runs its code, when something other than the platform does: a layer extending [[targetRuntime]]` = Trait | Layer | undefined;
  $platforms: `Where it runs: layers extending [[targetPlatform]]; none when left out` = (Trait | Layer)[] | undefined;
  $ecosystem: `Where its dependencies come from and what manages them: a layer extending [[targetEcosystem]]` = Trait | Layer | undefined;
  $frameworks: `What its code is built on, in order: layers extending [[targetFramework]]; none when left out` = (Trait | Layer)[] | undefined;
  $interfaces: `What it offers the people and programs that use it: layers extending [[targetInterface]]; none when left out` = (Trait | Layer)[] | undefined;
  $layout: `Where its files go: a layer extending [[targetLayout]]` = Trait | Layer;
  $layers: `Anything else the compiler is told, such as a house style: layers extending [[target]]; none when left out` = (Trait | Layer)[] | undefined;
  $dependencies: `What its generated code needs from its ecosystem; none when left out` = Dependency[] | undefined;

  // Declaring
  where (`A target const is declared`) -> `It declares one target, whose identifier is the const's name`;
  where (`A const that is not a target const holds a Target`) -> `It declares no target`;
  where (`A target is declared`) -> `Each of its layers is applied to its const with the layer's arguments, in guidance order`;

  // Roles
  where (`A slot holds a layer that does not extend that slot's role`) -> `A problem at the const names the slot and the layer`;
  where (`The target has dependencies and no ecosystem`) -> `A problem at the const says dependencies need an ecosystem`;

  // Guidance
  where (`The compiler is handed a request for a unit of a target`) -> [
    `The guidance is the const's own criteria, then each trait's criteria in guidance order`,
    `Guidance order is the traits of the layers, slot by slot in the order layers, interfaces, frameworks, layout, runtime, platforms, ecosystem, language, and each slot in its own order; then the traits those extend, nearest first; each trait once, at its first place`,
  ];
  where (`A criterion is guidance of a target`) -> [
    `It is neither a local nor a global requirement`,
    `No unit answers for it`,
    `No review checks it`,
  ];

  // Output
  where (`Two targets have the same output, or one's output is inside the other's`) -> `A problem at both consts names the directory`;
  where (`An output's extension is neither the language's file extension nor among the target's output extensions`) -> `The unit is rejected, naming the output`;
}

/// target: the record, written in braces
ace function targetOf(target: Target): `Gives a record written in braces the type [[Target]]` -> Target {
  return target;
}
