use "./target";

/// A target whose outputs are a surface others call rather than a library: a command line, a
/// server, an editor integration. A placeholder for the LSP, MCP, and CLI targets to grow into.
trait targetInterface extends target: `A target that is a surface others call: a command line, a server, an editor integration` {
  $protocol: `The protocol the surface speaks, as its specification names it; undefined for a plain command line` = string | undefined;

  where (`An fn is marked as exposed by a trait of the surface`) -> `It is one operation of the surface, named and described as that trait says`;
  where (`A call of an operation arrives`) -> `The arguments are checked against the fn's parameters before it runs, and a bad argument is reported without running it`;
  where (`An operation fails`) -> `The failure is reported through the surface and never ends the process`;
  where (`The surface has a channel`) -> `Nothing but [[targetInterface.protocol]] is written to it; logging goes elsewhere`;
}
