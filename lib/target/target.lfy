/// What every layer of a target extends, through the trait of its role. Each layer is applied to
/// its target const, so a layer's criteria are guidance the compiler receives with every request,
/// its knowledge is given to the compiler to read, and its commands are listed for it to run. A
/// target is assembled from packages and is never a change to the compiler.
trait target: `A layer of a target: one thing the compiler is told about building for it` {
  $provides: `Capabilities this layer gives its target, such as http-server or node-api` = string[];
  $requires: `Capabilities some layer of its target must provide` = string[];
  $outputExtensions: `Extensions, without the dot, that outputs may have besides the language's own` = string[];
  .provides = [];
  .requires = [];
  .outputExtensions = [];

  // Capabilities
  where (`Several layers of one target set provides, requires, or outputExtensions`) -> `The target has every item any of them set, each once, in guidance order`;
  where (`Two layers of one target set any other member to different values`) -> `A problem at the target's const names the member and both layers`;
  where (`A capability a layer of a target requires is provided by no layer of that target`) -> `A problem at the target's const names the target and the capability`;

  // Guidance
  where (`The compiler is handed a request for a batch of units of the target`) -> `It treats each criterion of the guidance as a rule of the target`;
  where (`Two criteria of the guidance conflict for the unit at hand, or one reads two ways for it`) -> `The compiler stops on that unit and quotes the criterion`;
  where (`A choice for the unit at hand is settled by no criterion, knowledge, or test, and only a person can make it`) -> `The compiler asks one question that names the choice`;

  // Dependencies
  where (`Code is generated for the target`) -> `It calls only what the target's standard library, platforms, runtime, and dependencies provide`;

  // Outputs
  where (`An output is written`) -> `Its path is under the target's output directory`;
  where (`A unit of the target is compiled`) -> `Nothing outside the target's output directory is written`;
}
