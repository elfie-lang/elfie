use "elfie/target/ecosystem";
use "elfie/target/runtime";

/// Bun is two layers, a runtime and a package manager; either can be used without the other.

trait bun extends targetRuntime: `Bun 1.2` {
  .runtime = "Bun 1.2 or later";
  .provides = ["javascript-runtime", "node-api"];
  .requires = ["javascript-language"];
  @acceptanceCriteria
    .add({ behavior = `Every package.json script that runs a tool runs it through bun --bun` })
    .add({
      behavior = `Files are read and written with Bun.file and Bun.write, and the environment is read from Bun.env`,
    })
    .add({
      behavior = `Tests use bun:test; each test file sits beside its output, named like it with .test before the extension`,
    });
  @commands
    .add({ operation = Operation.test, line = "bun test" })
    .add({ operation = Operation.run, line = "$RUN_SCRIPT start" });
}

trait bunPackages extends targetEcosystem: `Packages from the npm registry, managed with bun install` {
  .ecosystem = "bun";
  .manifest = "package.json";
  .lockfile = "bun.lock";
  .scriptRunner = "bun run";
  .provides = ["npm-registry"];
  .requires = ["javascript-language"];
  @commands
    .add({ operation = Operation.install, line = "bun install" })
    .add({ operation = Operation.add, line = 'bun add "$NAME${VERSION:+@$VERSION}"' });
}
