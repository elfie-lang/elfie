use "cli";
use "elfie/target/ecosystem";
use "elfie/target/framework";
use "elfie/target/language";
use "elfie/target/layout";

/// Rust: the language, Cargo as its ecosystem, the layouts of a crate and of a workspace of crates,
/// and clap for command lines.

trait rust extends targetLanguage: `Rust 2024` {
  .language = "Rust 2024";
  .fileExtension = "rs";
  .markerComment = "//";
  .stubLine = 'todo!("elfie stub: {{unit}}: {{reason}}")';
  .stubMarker = "elfie stub:";
  .provides = ["rust"];

  // Kinds
  @acceptanceCriteria
    .add({
      situation = `A d declaration's members are not alternatives`,
      behavior = `The d declaration becomes a struct`,
    })
    .add({ situation = `A d declaration's members are alternatives`, behavior = `The d declaration becomes an enum` })
    .add({ behavior = `A type declaration becomes a struct` })
    .add({ behavior = `An enum declaration becomes an enum with a method giving each member's value` })
    .add({ behavior = `A fn declaration becomes a pub fn` })
    .add({ behavior = `The dependency an external declaration names is a crate` })
    .add({ behavior = `A test is a #[test] function` });

  // Defaults
  // A dependent that builds a struct with ..Default::default() still builds when a field is added
  // whose type has a Default, so most data changes break no other unit's code. A struct expression
  // that sets every field takes no ..Default::default(), because clippy's needless_update rejects
  // it under -D warnings.
  @acceptanceCriteria
    .add({
      situation = [`A d declaration becomes a struct`, `The type of every field implements Default`],
      behavior = `The struct derives Default`,
    })
    .add({
      situation = `Code builds a value of a struct that derives Default and is output by another unit`,
      behavior = `The struct expression ends with ..Default::default() after the fields it sets, unless it sets every field`,
    });

  // Standard library
  @acceptanceCriteria
    .add({ behavior = `List is Vec<T>` })
    .add({ behavior = `Boolean is bool` })
    .add({ behavior = `Nullish is Option<T>` })
    .add({ situation = `A String value is not only read`, behavior = `String is String` })
    .add({ situation = `A String value is only read`, behavior = `String is &str` })
    .add({ behavior = `A Number that is a length, an index, a line, or a column is usize` })
    .add({ behavior = `Any other Number is f64` })
    .add({ situation = `An Object holds JSON`, behavior = `Object is serde_json::Map` })
    .add({ situation = `The use of an Object names the value type`, behavior = `Object is BTreeMap<String, _>` })
    .add({ behavior = `Path is std::path` })
    .add({ behavior = `The file functions are std::fs` })
    .add({ behavior = `Json is serde_json` })
    .add({ behavior = `run and stream are std::process::Command through sh -c` })
    .add({ behavior = `isTerminal is std::io::IsTerminal of stdout or stderr` })
    .add({ behavior = `Instant is std::time::SystemTime` })
    .add({
      situation = `A builtin operation of Instant or of time has no counterpart in std::time, as RFC 3339 text has none`,
      behavior = `It is written out over std::time`,
    });

  // Generics
  @acceptanceCriteria
    .add({
      behavior = `A declaration with type parameters becomes a generic item with the same parameters, in the same order and with the same names`,
    })
    .add({
      situation = `The target has a trait matching the data or trait of an extends constraint on a type parameter`,
      behavior = `The extends constraint becomes a trait bound`,
    })
    .add({
      situation = `The target has no trait matching the data or trait of an extends constraint on a type parameter`,
      behavior = `The bound is dropped`,
    })
    .add({
      situation = `The target has no trait matching the data or trait of an extends constraint on a type parameter`,
      behavior = `A comment on the item names the constraint`,
    })
    .add({
      behavior = `A type argument that is a primitive maps to the same Rust type as that primitive does outside a type argument`,
    })
    .add({ situation = `A parameter's type is a function type (A) => B`, behavior = `The parameter is impl Fn(A) -> B` })
    .add({
      situation = `A member of a data has a function type (A) => B`,
      behavior = `The member is Box<dyn Fn(A) -> B>`,
    });
}

trait cargo extends targetEcosystem: `Crates from crates.io, managed with Cargo` {
  .ecosystem = "cargo";
  .manifest = "Cargo.toml";
  .lockfile = "Cargo.lock";
  .provides = ["cargo"];
  .requires = ["rust"];
  // libtest reads each word after -- as a substring of the test names to run, and runs every test
  // when there is none, so an empty or unset TESTS runs them all; set -f keeps the shell from
  // expanding a word as a file pattern. SCOPE names one package, passed as -p only when it is set.
  // With ALLOW_STUBS set, the test line runs every test binary (--no-fail-fast) and reads libtest's
  // report: each "test NAME ... FAILED" line, the "---- NAME stdout ----" section holding that
  // test's panic message, one "test result:" line per binary, and cargo's "Running" and
  // "Doc-tests" line per binary it starts. It succeeds when cargo test did, or when some test
  // failed, every failed test's section holds elfie stub: (the rust trait's stub marker), and every
  // binary started reported a result, so a build error or a crashed binary still fails it with
  // cargo's exit code. Without ALLOW_STUBS the line is the plain cargo test it always was.
  // Decision: the stub check is written inline in the test line, not as a script in this package,
  // because a command runs in the target's output directory with only RUN_SCRIPT, NAME, VERSION,
  // TESTS, SCOPE, and ALLOW_STUBS set, so no line can find a file of a package, which may live
  // anywhere elfie.json points.
  // Decision: the line uses only POSIX sh and awk, with no temporary file: cargo's exit code is
  // passed to awk as the last line of the stream, and awk prints every other line as it comes.
  @commands
    .add({ operation = Operation.add, line = 'cargo add "$NAME${VERSION:+@$VERSION}"' })
    .add({ operation = Operation.build, line = 'cargo build ${SCOPE:+-p "$SCOPE"}' })
    .add({
      operation = Operation.test,
      line = 'set -f; if [ -z "$ALLOW_STUBS" ]; then cargo test ${SCOPE:+-p "$SCOPE"} -- $TESTS; else \
{ cargo test --no-fail-fast --color never ${SCOPE:+-p "$SCOPE"} -- $TESTS 2>&1; echo "elfie-cargo-status $?"; } | awk \' \
/^elfie-cargo-status [0-9]+$/ { status = $2; next } \
{ print; fflush() } \
/^ +(Running|Doc-tests) / { started++ } \
/^test .* [.][.][.] FAILED$/ { failed[substr($0, 6, length($0) - 16)] = 1; nfailed++ } \
/^failures:$/ || /^test result: / { section = "" } \
/^---- .* stdout ----$/ { section = substr($0, 6, length($0) - 17) } \
section != "" && index($0, "elfie stub:") { stubbed[section] = 1 } \
/^test result: / { results++; for (name in failed) if (!(name in stubbed)) bad = 1; split("", failed); split("", stubbed) } \
END { exit (status == 0 || (nfailed > 0 && !bad && results == started)) ? 0 : status }\'; fi',
    })
    .add({ operation = Operation.lint, line = 'cargo clippy ${SCOPE:+-p "$SCOPE"} --all-targets -- -D warnings' })
    .add({ operation = Operation.format, line = "cargo fmt --check" });
}

// Decision: cargoCrate stops rather than edit the Cargo.toml at the project root, because that file
// is outside the crate's directory.

/// name: the package name its Cargo.toml gives
/// root: the crate's directory, relative to the project root
/// source: the directory, relative to the source directory, whose main.lfy is the crate's root module
/// binary: whether that root module is src/main.rs rather than src/lib.rs
trait cargoCrate(name: string, root: string, source: string, binary: boolean) extends targetLayout: `One member crate of the Cargo workspace at the project root` {
  .requires = ["rust", "cargo"];
  const rootFile = binary? "main.rs": "lib.rs";
  where (`A unit's stem is {{source}}/main`) -> `It is {{root}}/src/{{rootFile}}`;
  where (`A unit's stem ends in main and is not {{source}}/main`) -> `It is mod.rs in its directory under {{root}}/src, with any leading {{source}}/ dropped`;
  where (`A unit's stem ends in main and is not {{source}}/main`) -> `Its mod.rs declares each other output of that directory as a module`;
  where (`A unit's stem does not end in main`) -> `It is {{root}}/src/ then the stem with any leading {{source}}/ dropped, then .rs`;
  where (`A directory under {{root}}/src holds outputs and no unit writes its mod.rs, nor the file beside it named after the directory`) -> `The compiler stops on the first unit there and names the directory`;
  where (`Any unit is written`) -> [
    `{{root}}/Cargo.toml names package {{name}}`,
    `{{root}}/Cargo.toml sets edition 2024`,
    `{{root}}/Cargo.toml lists the target's dependencies`,
  ];
  where (`The Cargo.toml at the project root does not list {{root}} among its workspace members`) -> `The compiler stops on the first unit and says so`;
}

/// crates: each key is the first segment of a stem; its value the source directory, relative to the project root, that such units are written under
/// fallback: the source directory for units whose first segment is no key of crates
/// binaries: the keys of the crates whose root module is src/main.rs
trait cargoWorkspace(crates: Object<string>, fallback: string, binaries: string[]) extends cratePerPrefix(
    crates,
    fallback,
  ),
  modulePerFile("rs"): `Several member crates of one Cargo workspace, chosen by the first segment of each stem` {
  .requires = ["rust", "cargo"];
  @acceptanceCriteria
    .add({
      situation = [`A file's stem is main`, `The file is not the root of its crate`],
      behavior = `Within its crate's directory the file is mod.rs`,
    })
    .add({
      situation = [
        `A file's stem is main`,
        `The file is the root of a crate whose key is not among {{binaries.join(", ")}}`,
      ],
      behavior = `Within its crate's directory the file is lib.rs`,
    })
    .add({
      situation = [
        `A file's stem is main`,
        `The file is the root of a crate whose key is among {{binaries.join(", ")}}`,
      ],
      behavior = `Within its crate's directory the file is main.rs`,
    })
    .add({ behavior = `Each crate's Cargo.toml names only the dependencies its own outputs use, from the target's` });
}

trait clap extends targetFramework: `Command lines parsed with clap 4 and its derive feature` {
  .provides = ["argument-parser"];
  .requires = ["rust"];
  where (`Code parses the command line`) -> `It uses clap 4 with its derive feature`;
  where (`An fn carries [[command]] with a name`) -> `It is one variant of a #[derive(Subcommand)] enum whose fields are its parameters with #[arg] attributes`;
  where (`An fn carries [[command]] with a name`) -> `main dispatches on its variant`;
  where (`An fn carries [[command]] with an empty name`) -> `Its parameters are the fields of the #[derive(Parser)] struct itself`;
}
