use "elfie/target/language";
use "elfie/target/layout";

/// The Rust target: what the compiler produces for this repository. Applied to global, it
/// marks every entity of every project file as built for Rust.
trait rust extends targetLanguage, cratePerPrefix(
  { lsp = "crates/elfie-lsp/src", mcp = "crates/elfie-mcp/src", cli = "crates/elfie-cli/src" },
  "crates/elfie-core/src",
), modulePerFile("", "rs"): `Built as Rust 2024 in a Cargo workspace of crates` {
  .language = "Rust 2024";
  .fileExtension = "rs";
  .nativeEcosystem = "cargo";
  .outputDirectory = "crates";
  .markerComment = "//";

  // Layout
  @acceptanceCriteria
    .add({
      situation = [
        `A file's stem is main`,
        `The file is not the root of its crate`,
      ],
      behavior = `Within its crate's directory the file is mod.rs`,
    })
    .add({
      situation = [
        `A file's stem is main`,
        `The file is the root of a crate other than the cli crate`,
      ],
      behavior = `Within its crate's directory the file is lib.rs`,
    })
    .add({
      situation = [
        `A file's stem is main`,
        `The file is the root of the cli crate`,
      ],
      behavior = `Within its crate's directory the file is main.rs`,
    })
    .add({
      behavior = `A marker is a line comment reading // @lfy followed by the source path relative to the repository root, a colon, and the entity's name`,
    });

  // Kinds
  @acceptanceCriteria
    .add({
      situation = `A d declaration's members are not alternatives`,
      behavior = `The d declaration becomes a struct`,
    })
    .add({ situation = `A d declaration's members are alternatives`, behavior = `The d declaration becomes an enum` })
    .add({
      behavior = `A type declaration becomes a struct; an enum declaration an enum with a method giving each member's value`,
    })
    .add({
      behavior = `A fn declaration becomes a pub fn whose body satisfies every criterion and test; a function declaration is translated statement by statement`,
    })
    .add({
      behavior = `A trait declaration becomes nothing of its own; the members it adds become fields or methods of each entity that carries it, and its criteria become that entity's`,
    })
    .add({ behavior = `An external declaration is bound to the crate its native dependency names` })
    .add({
      behavior = `Every @test case becomes a #[test], and every acceptance criterion that a test can check becomes one, marked with the line of the criterion`,
    });

  // Standard library
  @acceptanceCriteria
    .add({ behavior = `List is Vec<T>; Boolean is bool; Nullish is Option<T>` })
    .add({ situation = `A String value is not only read`, behavior = `String is String` })
    .add({ situation = `A String value is only read`, behavior = `String is &str` })
    .add({
      situation = `No criterion says a Number value counts things: a length, an index, a line, or a column`,
      behavior = `Number is f64`,
    })
    .add({
      situation = `A criterion says a Number value counts things: a length, an index, a line, or a column`,
      behavior = `Number is usize`,
    })
    .add({ situation = `An Object holds JSON`, behavior = `Object is serde_json::Map` })
    .add({ situation = `The use of an Object names the value type`, behavior = `Object is BTreeMap<String, _>` })
    .add({
      behavior = `Path is std::path; the file functions are std::fs; Json is serde_json; run and stream are std::process::Command through sh -c`,
    })
    .add({
      behavior = `Instant is std::time::SystemTime, formatted and parsed by hand as RFC 3339 the way now_rfc3339 in elfie-core does; chrono is not used`,
    })
    .add({
      behavior = `A builtin fn or member is never generated, only called; a member of a builtin data written out in full is translated where it is used`,
    });

  // Generics
  @acceptanceCriteria
    .add({
      behavior = `A declaration with type parameters becomes a generic item with the same parameters, in the same order and with the same names`,
    })
    .add({
      situation = `The target has a trait matching the data or trait of an extends constraint on a type parameter`,
      behavior = `The extends constraint becomes a trait bound`,
    })
    .add({
      situation = `The target has no trait matching the data or trait of an extends constraint on a type parameter`,
      behavior = `The bound is dropped and a comment on the item names the constraint`,
    })
    .add({
      behavior = `List<T> and T[] are Vec<T>; a type argument that is a primitive maps to the same Rust type as that primitive does outside a type argument`,
    })
    .add({
      behavior = `A parameter whose type is a function type (A) => B is impl Fn(A) -> B; a member of a data whose type is a function type is Box<dyn Fn(A) -> B>`,
    });

  // Quality
  @acceptanceCriteria
    .add({ behavior = `cargo build, cargo test, and cargo clippy for the whole workspace pass without warnings` })
    .add({ behavior = `Nothing outside the target's output directory is written` });
}

rust.apply(global);
